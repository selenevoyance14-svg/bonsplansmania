\":\\\"0.5px\\\"},\\\"children\\\":[\\\"$undefined\\\",\\\" \\\",\\\"$undefined\\\"]}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"card-title\\\",\\\"children\\\":\\\"Code Promo Thalgo Mars 2026 : Jusqu'a 62% de Reduction\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"card-excerpt\\\",\\\"children\\\":\\\"Tous les codes promo Thalgo mars 2026 : 50% Kit Citadine, Evasion Marine 99€, newsletter 10%, jusqu'a 62% sur selection. Bons plans verifies.\\\"}]]}]]}],[\\\"$\\\",\\\"a\\\",\\\"codes-promo-beaute-2026-toutes-les-offres\\\",{\\\"href\\\":\\\"/article/codes-promo-beaute-2026-toutes-les-offres\\\",\\\"className\\\":\\\"card\\\",\\\"style\\\":{\\\"textDecoration\\\":\\\"none\\\"},\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"position\\\":\\\"relative\\\",\\\"height\\\":\\\"160px\\\",\\\"overflow\\\":\\\"hidden\\\"},\\\"children\\\":[\\\"$\\\",\\\"$L1e\\\",null,{\\\"src\\\":\\\"/images/articles/codes-promo-beaute-2026-toutes-les-offres.svg\\\",\\\"alt\\\":\\\"Codes promo beauté 2026 - toutes les offres et réductions du moment\\\",\\\"fill\\\":true,\\\"style\\\":{\\\"objectFit\\\":\\\"cover\\\"},\\\"sizes\\\":\\\"33vw\\\"}]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"card-body\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"style\\\":{\\\"fontSize\\\":\\\"0.72rem\\\",\\\"fontWeight\\\":600,\\\"color\\\":\\\"var(--primary)\\\",\\\"textTransform\\\":\\\"uppercase\\\",\\\"letterSpacing\\\":\\\"0.5px\\\"},\\\"children\\\":[\\\"🏷️\\\",\\\" \\\",\\\"Bon Plan\\\"]}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"card-title\\\",\\\"children\\\":\\\"Codes Promo Beauté 2026 — Toutes les Offres du Moment en Un Seul Endroit\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"card-excerpt\\\",\\\"children\\\":\\\"Sephora, Yves Rocher, L'Occitane, Lookfantastic, Nuxe, Léa Nature... Retrouvez tous les codes promo beauté actifs en mars 2026 mis à jour régulièrement.\\\"}]]}]]}]]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"1a:[\\\"$\\\",\\\"nav\\\",null,{\\\"style\\\":{\\\"margin\\\":\\\"40px 0\\\",\\\"padding\\\":\\\"24px\\\",\\\"background\\\":\\\"var(--muted, #f3f4f6)\\\",\\\"borderRadius\\\":\\\"16px\\\"},\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"style\\\":{\\\"fontSize\\\":\\\"1rem\\\",\\\"marginBottom\\\":\\\"12px\\\"},\\\"children\\\":\\\"Explorer par catégorie\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"display\\\":\\\"flex\\\",\\\"flexWrap\\\":\\\"wrap\\\",\\\"gap\\\":\\\"8px\\\"},\\\"children\\\":[[\\\"$\\\",\\\"a\\\",\\\"bon-plan\\\",{\\\"href\\\":\\\"/categorie/bon-plan\\\",\\\"style\\\":{\\\"padding\\\":\\\"6px 14px\\\",\\\"borderRadius\\\":\\\"999px\\\",\\\"background\\\":\\\"white\\\",\\\"fontSize\\\":\\\"0.82rem\\\",\\\"color\\\":\\\"var(--text, #374151)\\\",\\\"textDecoration\\\":\\\"none\\\",\\\"fontWeight\\\":500,\\\"border\\\":\\\"1px solid var(--border, #e5e7eb)\\\"},\\\"children\\\":[\\\"🏷️\\\",\\\" \\\",\\\"Bons Plans\\\"]}],[\\\"$\\\",\\\"a\\\",\\\"test-gratuit\\\",{\\\"href\\\":\\\"/categorie/test-gratuit\\\",\\\"style\\\":{\\\"padding\\\":\\\"6px 14px\\\",\\\"borderRadius\\\":\\\"999px\\\",\\\"background\\\":\\\"white\\\",\\\"fontSize\\\":\\\"0.82rem\\\",\\\"color\\\":\\\"var(--text, #374151)\\\",\\\"textDecoration\\\":\\\"none\\\",\\\"fontWeight\\\":500,\\\"border\\\":\\\"1px solid var(--border, #e5e7eb)\\\"},\\\"children\\\":[\\\"🎁\\\",\\\" \\\",\\\"Tests Gratuits\\\"]}],[\\\"$\\\",\\\"a\\\",\\\"concours\\\",{\\\"href\\\":\\\"/categorie/concours\\\",\\\"style\\\":{\\\"padding\\\":\\\"6px 14px\\\",\\\"borderRadius\\\":\\\"999px\\\",\\\"background\\\":\\\"white\\\",\\\"fontSize\\\":\\\"0.82rem\\\",\\\"color\\\":\\\"var(--text, #374151)\\\",\\\"textDecoration\\\":\\\"none\\\",\\\"fontWeight\\\":500,\\\"border\\\":\\\"1px solid var(--border, #e5e7eb)\\\"},\\\"children\\\":[\\\"🏆\\\",\\\" \\\",\\\"Concours\\\"]}],[\\\"$\\\",\\\"a\\\",\\\"box-beaute\\\",{\\\"href\\\":\\\"/categorie/box-beaute\\\",\\\"style\\\":{\\\"padding\\\":\\\"6px 14px\\\"