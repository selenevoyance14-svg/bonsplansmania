ng\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"code-promo\"}]\n24:[\"$\",\"a\",\"box-beaute\",{\"href\":\"/marque/box-beaute\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"box-beaute\"}]\n25:[\"$\",\"a\",\"beaute\",{\"href\":\"/marque/beaute\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"beaute\"}]\n26:[\"$\",\"a\",\"cosmetique\",{\"href\":\"/marque/cosmetique\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"cosmetique\"}]\na:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n27:I[27201,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/d2be314c3ece3fbe.js\"],\"IconMark\"]\n8:null\nc:[[\"$\",\"title\",\"0\",{\"children\":\"Code Promo Glowria Mars 2026 : SPRING -15% + Box des 16,5...\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Codes promo Glowria mars 2026 verifies : SPRING -15% 1ere box, box Blooming Season 85€ de valeur des 16,50€, parrainage 3€. Aucun echantillon.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"manifest\",\"href\":\"/manifest.json\",\"crossOrigin\":\"$undefined\"}],[\"$\",\"meta\",\"3\",{\"name\":\"keywords\",\"content\":\"bons plans beauté,tests produits gratuits,concours beauté,box beauté,réductions cosmétiques,codes promo beaut