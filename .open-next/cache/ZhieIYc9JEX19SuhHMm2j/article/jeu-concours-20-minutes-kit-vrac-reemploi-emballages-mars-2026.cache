s/6e48aeeec84550f8.js\"],\"default\"]\nf:[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":13,\"height\":13,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-external-link\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1q9fwt\",{\"d\":\"M15 3h6v6\"}],[\"$\",\"path\",\"gplh6r\",{\"d\":\"M10 14 21 3\"}],[\"$\",\"path\",\"a6xqqp\",{\"d\":\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"}],\"$undefined\"]}]\n10:[\"$\",\"div\",null,{\"className\":\"article-hero-image\",\"style\":{\"background\":\"#fff\",\"borderRadius\":\"12px\",\"overflow\":\"hidden\",\"display\":\"flex\",\"justifyContent\":\"center\",\"alignItems\":\"center\",\"maxHeight\":\"450px\"},\"children\":[\"$\",\"$L1c\",null,{\"src\":\"/images/articles/jeu-concours-20-minutes-kit-vrac-reemploi-emballages-mars-2026.svg\",\"alt\":\"Jeu concours 20 Minutes kit vrac réemploi mars 2026\",\"width\":800,\"height\":450,\"style\":{\"width\":\"100%\",\"height\":\"100%\",\"objectFit\":\"contain\",\"maxHeight\":\"450px\"},\"priority\":true}]}]\n11:[\"$\",\"$L1d\",null,{}]\n12:[\"$\",\"$L1e\",null,{}]\n1f:T111f,<p>\n<h2>2 kits vrac & réemploi à gagner</h2><p>À l'occasion du <strong>Mois du Vrac et du Réemploi</strong> (mars 2026), <strong>20 Minutes</strong> en partenariat avec <strong>Vrac & Réemploi</strong> met en jeu <strong>2 kits complets</strong> pour mieux consommer au quotidien et dire adieu aux emballages à usage unique.</p><p><div class=\"cta-inline\"><a href=\"https://www.20minutes.fr/arts-stars/loisirs/4204138-20260302-jeu-concours-tentez-gagner-kit-vrac-reemploi-lutter-contre-emballages-superflus\" class=\"btn btn-primary btn-sm\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Participer au jeu concours <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/><polyline points=\"15 3 21 3 21 9\"/><line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\"/></svg></a></div><h2>Le lot à gagner</h2><div class=\"table-wrapper\"><table class=\"comparison-table\"><thead><tr>\n<th><strong>Lot</strong></th><th>1 kit vrac & réemploi complet</th>\n</tr></thead><tbody>\n<tr>\n<td><strong>Nombre de gagnants</strong></td>\n<td><strong>2</strong></td>\n</tr>\n<tr>\n<td><strong>Partenaire</strong></td>\n<td>Vrac & Réemploi</td>\n</tr>\n<tr>\n<td><strong>Thème</strong></td>\n<td>Consommation responsable, zéro déchet</td>\n</tr>\n</tbody></table></div><p>Le kit contient tout le nécessaire pour commencer à consommer en vrac et adopter le réemploi au quotidien : sacs réutilisables, contenants, bocaux, et accessoires pratiques pour faire ses courses sans emballages superflus.</p><p><div id=\"ezoic-pub-ad-placeholder-203\" class=\"ad-container\" style=\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\"></div><h2>Comment participer</h2><p>1. Rendez-vous sur la <a href=\"https://www.20minutes.fr/arts-stars/loisirs/4204138-20260302-jeu-concours-tentez-gagner-kit-vrac-reemploi-lutter-contre-emballages-superflus\" target=\"_blank\" rel=\"nofollow sponsored noopener\">page du concours 20 Minutes</a>\n2. <strong>Remplissez le formulaire</strong> de participation\n3. Validez — c'est tout !</p><p><div class=\"cta-inline\"><a href=\"https://www.20minutes.fr/arts-stars/loisirs/4204138-20260302-jeu-concours-tentez-gagner-kit-vrac-reemploi-lutter-contre-emballages-superflus\" class=\"btn btn-primary btn-sm\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Participer au jeu concours <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/><polyline points=\"15 3 21 3 21 9\"/><line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\"/></svg></a></div><h2>Mars : le Mois du Vrac et du Réemploi</h2><p>Chaque année en mars, la France célèbre le <strong>Mois du Vrac et du Réemploi</strong>. L'objectif : sensibiliser le public aux pratiques de consommation durable et lutter contre les emballages à usage unique.</p><h3>Pourquoi le vrac ?</h3><ul><li>🌍 <strong>-30% de déchets</strong> en moyenne pour un foyer qui passe au vrac</li>\n<li>💰 <strong>10-30% moins cher</strong> que les produits emballés</li>\n<li>🧴 <strong>Zéro plastique</strong> inutile</li>\n<li>♻️ <strong>Réemploi</strong> des contenants</li>\n</ul>\n<h3>Ce qu'on peut acheter en vrac</h3><div class=\"table-wrapper\"><table class=\"comparison-table\"><thead><tr>\n<th>Rayon</th><th>Exemples</th>\n</tr></thead><tbody>\n<tr>\n<td><strong>Épicerie sèche</strong></td>\n<td>Pâtes, riz, céréales, légumineuses</td>\n</tr>\n<tr>\n<td><strong>Fruits secs</strong></td>\n<td>Noix, amandes, noisettes</td>\n</tr>\n<tr>\n<td><strong>Hygiène</strong></td>\n<td>Lessive, savon, shampoing</td>\n</tr>\n<tr>\n<td><strong>Boissons</strong></td>\n<td>Jus, vin, huile</td>\n</tr>\n<tr>\n<td><strong>Produits ménagers</strong></td>\n<td>Liquide vaisselle, nettoyant</td>\n</tr>\n</tbody></table></div><h2>Pourquoi participer</h2><ul><li>✅ <strong>Gratuit</strong> — simple formulaire</li>\n<li>✅ <strong>Kit complet</strong> pour commencer le vrac</li>\n<li>✅ <strong>Geste écologique</strong> concret</li>\n<li>✅ <strong>Économies</strong> à long terme sur les courses</li>\n<li>✅ Soutenu par <strong>20 Minutes</strong> et <strong>Vrac & Réemploi</strong></li>\n</ul>\n<hr>\n</p>13:[\"$\",\"div\",null,{\"className\":\"article-content\",\"children\":[\"$\",\"div\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"$1f\"}}]}]\n14:[\"$\",\"$L1d\",null,{}]\n15:[\"$\",\"div\",null,{\"style\":{\"textAlign\":\"center\",\"margin\":\"40px 0\",\"padd