"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"card-excerpt\\\",\\\"children\\\":\\\"Bon plan Blissim : -30% sur toute la marque Korres et un duo Secrets de Loly offert (gelee Boost Curl + shampoing Perfect Match) des 39 euros avec le code DUOCHEVEUX.\\\"}]]}]]}]]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"1a:[\\\"$\\\",\\\"nav\\\",null,{\\\"style\\\":{\\\"margin\\\":\\\"40px 0\\\",\\\"padding\\\":\\\"24px\\\",\\\"background\\\":\\\"var(--muted, #f3f4f6)\\\",\\\"borderRadius\\\":\\\"16px\\\"},\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"style\\\":{\\\"fontSize\\\":\\\"1rem\\\",\\\"marginBottom\\\":\\\"12px\\\"},\\\"children\\\":\\\"Explorer par catégorie\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"display\\\":\\\"flex\\\",\\\"flexWrap\\\":\\\"wrap\\\",\\\"gap\\\":\\\"8px\\\"},\\\"children\\\":[[\\\"$\\\",\\\"a\\\",\\\"bon-plan\\\",{\\\"href\\\":\\\"/categorie/bon-plan\\\",\\\"style\\\":{\\\"padding\\\":\\\"6px 14px\\\",\\\"borderRadius\\\":\\\"999px\\\",\\\"background\\\":\\\"white\\\",\\\"fontSize\\\":\\\"0.82rem\\\",\\\"color\\\":\\\"var(--text, #374151)\\\",\\\"textDecoration\\\":\\\"none\\\",\\\"fontWeight\\\":500,\\\"border\\\":\\\"1px solid var(--border, #e5e7eb)\\\"},\\\"children\\\":[\\\"🏷️\\\",\\\" \\\",\\\"Bons Plans\\\"]}],[\\\"$\\\",\\\"a\\\",\\\"test-gratuit\\\",{\\\"href\\\":\\\"/categorie/test-gratuit\\\",\\\"style\\\":{\\\"padding\\\":\\\"6px 14px\\\",\\\"borderRadius\\\":\\\"999px\\\",\\\"background\\\":\\\"white\\\",\\\"fontSize\\\":\\\"0.82rem\\\",\\\"color\\\":\\\"var(--text, #374151)\\\",\\\"textDecoration\\\":\\\"none\\\",\\\"fontWeight\\\":500,\\\"border\\\":\\\"1px solid var(--border, #e5e7eb)\\\"},\\\"children\\\":[\\\"🎁\\\",\\\" \\\",\\\"Tests Gratuits\\\"]}],[\\\"$\\\",\\\"a\\\",\\\"concours\\\",{\\\"href\\\":\\\"/categorie/concours\\\",\\\"style\\\":{\\\"padding\\\":\\\"6px 14px\\\",\\\"borderRadius\\\":\\\"999px\\\",\\\"background\\\":\\\"white\\\",\\\"fontSize\\\":\\\"0.82rem\\\",\\\"color\\\":\\\"var(--tex