k\",\"rel\":\"nofollow sponsored noopener\",\"children\":[\"Voir les offres Nike & Jordan enfant\",\" \",\"$Lf\"]}]]}]]}],\"$L10\",\"$L11\",\"$L12\",\"$L13\",\"$L14\",\"$L15\"]}],\"$L16\",\"$L17\",\"$L18\",\"$L19\"]}]}],\"$L1a\",\"$L1b\"]\n1c:I[5500,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"Image\"]\n1d:I[96788,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\n1e:I[1586,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\n20:I[67277,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\nf:[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":13,\"height\":13,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-external-link\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1q9fwt\",{\"d\":\"M15 3h6v6\"}],[\"$\",\"path\",\"gplh6r\",{\"d\":\"M10 14 21 3\"}],[\"$\",\"path\",\"a6xqqp\",{\"d\":\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"}],\"$undefined\"]}]\n10:[\"$\",\"div\",null,{\"className\":\"article-hero-image\",\"style\":{\"background\":\"#fff\",\"borderRadius\":\"12px\",\"overflow\":\"hidden\",\"display\":\"flex\",\"justifyContent\":\"center\",\"alignItems\":\"center\",\"maxHeight\":\"450px\"},\"children\":[\"$\",\"$L1c\",null,{\"src\":\"/images/articles/bon-plan-nike-jordan-junior-enfant-bebe-jusqu-a-85-pourcent-2026.svg\",\"alt\":\"Nike Jordan junior enfant bebe jusqu'a -85% promo 2026\",\"width\":800,\"height\":450,\"style\":{\"width\":\"100%\",\"height\":\"100%\",\"objectFit\":\"contain\",\"maxHeight\":\"450px\"},\"priority\":true}]}]\n11:[\"$\",\"$L1d\",null,{}]\n12:[\"$\",\"$L1e\",null,{}]\n1f:T104f,<p>\n<h2>Nike & Jordan : jusqu'a -85% sur la collection enfant</h2><p>Nike et Jordan cassent les prix sur la collection <strong>Junior, Enfant et Bebe</strong> avec des reductions allant jusqu'a <strong>-85%</strong>. Baskets, survetements, t-shirts, vestes, casquettes — tout y passe. C'est le moment d'habiller les enfants en Nike et Jordan sans se ruiner.</p><p>-85% sur du Nike et Jordan, ca ne se refuse pas.</p><hr><p><div class=\"cta-inline\"><a href=\"https://lk.gt/aCVmb\" class=\"btn btn-primary btn-sm\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Voir les offres Nike & Jordan enfant <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/><polyline points=\"15 3 21 3 21 9\"/><line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\"/></svg></a></div><h2>Ce qu'on trouve dans la selection</h2><p>Les deux marques couvrent tous les besoins des enfants sportifs et stylés :</p><h3>Nike</h3>\n<ul><li><strong>Baskets</strong> : Air Max, Air Force 1, Dunk Low en version junior et enfant</li>\n<li><strong>Survetements</strong> : ensembles complets pour le sport ou le quotidien</li>\n<li><strong>T-shirts et sweats</strong> : le logo Swoosh classique dans toutes les couleurs</li>\n<li><strong>Vestes</strong> : coupe-vent, vestes zippees, doudounes</li>\n<li><strong>Casquettes</strong> : modeles ajustables pour enfant</li>\n</ul>\n<h3>Jordan</h3>\n<ul><li><strong>Baskets</strong> : Jordan 1, Jordan 4, Jordan Max Aura en version junior</li>\n<li><strong>Vetements</strong> : t-shirts, sweats et pantalons avec le logo Jumpman</li>\n<li><strong>Ensembles</strong> : coordonnes veste + pantalon pour un look complet</li>\n<li><strong>Casquettes</strong> : modeles Jordan classiques</li>\n</ul>\n<hr></p><p><div id=\"ezoic-pub-ad-placeholder-203\" class=\"ad-container\" style=\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\"></div><h2>Les tailles disponibles</h2><div class=\"table-wrapper\"><table class=\"comparison-table\"><thead><tr>\n<th>Categorie</th><th>Ages</th><th>Tailles</th>\n</tr></thead><tbody>\n<tr>\n<td><strong>Bebe</strong></td>\n<td>0-2 ans</td>\n<td>17-27</td>\n</tr>\n<tr>\n<td><strong>Enfant</strong></td>\n<td>3-7 ans</td>\n<td>27.5-35</td>\n</tr>\n<tr>\n<td><strong>Junior</strong></td>\n<td>8-15 ans</td>\n<td>35.5-40</td>\n</tr>\n</tbody></table></div><p>Les tailles enfant et junior en Nike et Jordan sont tres demandees — les meilleures affaires partent vite a ce niveau de reduction.</p><hr><p><div class=\"cta-inline\"><a href=\"https://lk.gt/aCVmb\" class=\"btn btn-primary btn-sm\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Voir les offres Nike & Jordan enfant <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/><polyline points=\"15 3 21 3 21 9\"/><line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\"/></svg></a></div><h2>Pourquoi c'est un vrai bon plan</h2><p>Les vetements et chaussures enfant s'usent vite — les pieds grandissent, les genoux trouent les pantalons. Acheter du Nike et Jordan a -85%, c'est :</p><ul><li><strong>Qualite premium</strong> au prix du fast fashion</li>\n<li><strong>Durabilite</strong> : les produits Nike tiennent bien dans le temps</li>\n<li><strong>Style</strong> : les enfants adorent porter du Nike et Jordan</li>\n<li><strong>Revente possible</strong> : certains modeles Jordan gardent une bonne valeur meme en occasion</li>\n</ul>\n<hr></p><h2>Notre avis</h2><p>Jusqu'a -85% sur Nike et Jordan enfant, c'est une des meilleures promos qu'on ait vues sur ces marques. Les parents savent a quel point les vetements et chaussures enfant coutent cher — surtout en grandes marques sport. A ce niveau de reduction, on peut equiper les enfants pour la saison sans exploser le budget. Les collections Nike et Jordan sont solides en qualite et les enfants adorent les porter. Les stocks sont limites a ces prix-la, donc si vous voyez la bonne taille, n'hesitez pas.\n</p>13:[\"$\",\"div\",null,{\"className\":\"article-content\",\"children\":[\"$\",\"div\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"$1f\"}}]}]\n14:[\"$\",\"$L1d\",null,{}]\n15:[\"$\",\"div\",null,{\"style\":{\"textAlign\":\"center\",\"margin\":\"40px 0\",\"padding\":\"32px\",\"background\":\"linear-gradient(135deg, #FFF0F0 0%, #FFF8F0 100%)\",\"borderRadius\":\"16px\",\"border\":\"2px solid #FECDD3\"},\"children\":[[\"$\",\"p\",null,{\"style\":{\"fontWeight\":800,\"fontSize\":\"1.2rem\",\"marginBottom\":\"16px\",\"color\":\"var(--foreground)\"},\"children\":\"Profiter de cette offre\"}],[\"$\",\"a\",null,{\"href\":\"https://lk.gt/aCVmb\",\"className\":\"btn btn-primary\",\"target\":\"_blank\",\"rel\":\"nofollow sponsored noopener\",\"style\":{\"padding\":\"14px 32px\",\"fontSize\":\"1rem\"},\"children\":[\"Voir les offres Nike & Jordan enfant\",\" \",[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":15,\"height\":15,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-external-link\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1q9fwt\",{\"d\":\"M15 3h6v6\"}],[\"$\",\"path\",\"gplh6r\",{\"d\":\"M10 14 21 3\"}],[\"$\",\"path\",\"a6xqqp\",{\"d\":\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"}],\"$undefined\"]}]]}]]}]\n16:[\"$\",\"$L1d\",null,{}]\n17:[\"$\",\"section\",null,{\"className\":\"related-articles\",\"children\":[[\"$\",\"h2\",null,{\"children\":\"A lire aussi\"}],[\"$\",\"div\",null,{\"className\":\"articles-grid\",\"style\":{\"gridTemplateColumns\":\"repeat(auto-fit, minmax(280px, 1fr))\"},\"children\":[[\"$\",\"a\",\"bon-plan-le-coq-spor