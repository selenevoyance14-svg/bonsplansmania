coration\":\"none\",\"fontWeight\":500},\"children\":\"réduction alimentaire\"}]\na:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n2a:I[27201,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/d2be314c3ece3fbe.js\"],\"IconMark\"]\n8:null\nc:[[\"$\",\"title\",\"0\",{\"children\":\"Bon Plan Too Good To Go : Paniers Anti-Gaspi dès 3,99€ (-...\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Too Good To Go : paniers surprise anti-gaspi dès 3,99€ (valeur 12-20€). Supermarchés, restos, boulangeries. Jusqu'à -80%. Appli gratuite.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"manifest\",\"href\":\"/manifest.json\",\"crossOrigin\":\"$undefined\"}],[\"$\",\"meta\",\"3\",{\"name\":\"keywords\",\"content\":\"bons plans beauté,tests produits gratuits,concours beauté,box beauté,réductions cosmétiques,codes promo beauté,échantillons gratuits\"}],[\"$\",\"link\",\"4\",{\"rel\":\"canonical\",\"href\":\"https://bonsplansmania.fr/article/bon-plan-too-good-to-go-paniers-antigaspi-3-99-euros-2026\"}],[\"$\",\"meta\",\"5\",{\"property\":\"og:title\",\"content\":\"Bon Plan Too Good To Go : Paniers Anti-Gaspi dès 3,99€ (Valeur 12-20€)\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:description\",\"content\":\"Too Good To Go propose des paniers surprise anti-gaspi dès 3,99€ dans tous les commerces : supermarchés, restos, boulangeries. Jusqu'à -80%.\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:image\",\"content\":\"http://localhost:3000/images/articles/bon-plan-too-good-to-go-paniers-antigaspi-3-99-euros-2026.svg\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:type\",\"content\":\"article\"}],[\"$\",\"meta\",\"9\",{\"property\":\"article:published_time\",\"content\":\"2026-02-24\"}],[\"$\",\"meta\",\"10\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"11\",{\"name\":\"twitter:title\",\"content\":\"Bons Plans Mania — Bons plans beauté & 