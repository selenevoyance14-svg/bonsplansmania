003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eGommage\\u003c/td\\u003e\\n\\u003ctd\\u003e30€\\u003c/td\\u003e\\n\\u003ctd\\u003eSucre + huile\\u003c/td\\u003e\\n\\u003ctd\\u003e2€\\u003c/td\\u003e\\n\\u003ctd\\u003e28€\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eMasques\\u003c/td\\u003e\\n\\u003ctd\\u003e50€\\u003c/td\\u003e\\n\\u003ctd\\u003eMiel + yaourt\\u003c/td\\u003e\\n\\u003ctd\\u003e5€\\u003c/td\\u003e\\n\\u003ctd\\u003e45€\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eCotons jetables\\u003c/td\\u003e\\n\\u003ctd\\u003e40€\\u003c/td\\u003e\\n\\u003ctd\\u003eCotons lavables\\u003c/td\\u003e\\n\\u003ctd\\u003e3€\\u003c/td\\u003e\\n\\u003ctd\\u003e37€\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003eTotal\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e365€\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e50€\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e315€\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\u003c/table\\u003e\\u003c/div\\u003e\\u003chr\\u003e\\u003cp\\u003e\\u003cdiv id=\\\"ezoic-pub-ad-placeholder-206\\\" class=\\\"ad-container\\\" style=\\\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\\\"\\u003e\\u003c/div\\u003e\\u003ch2\\u003eNotre avis\\u003c/h2\\u003e\\u003cp\\u003eOn a fait la transition petit a petit. Le premier produit a tester c'est l'huile de coco en demaquillant — c'est bluffant, ca enleve tout et ca laisse la peau douce. Ensuite le gel d'aloe vera en creme de jour, c'est frais et leger.\\u003c/p\\u003e\\u003cp\\u003eLe beurre de karite en hiver c'est devenu notre indispensable : mains, levres, pieds — il repare tout. Et l'huile de jojoba en serum du soir, c'est le meilleur anti-age naturel qu'on ait teste.\\u003c/p\\u003e\\u003cp\\u003eLes cotons lavables, il faut un petit temps d'adaptation mais une fois qu'on a le reflexe de les mettre dans le filet de lavage, c'est aussi simple que les jetables.\\u003c/p\\u003e\\u003cp\\u003ePour approfondir : \\u003ca href=\\\"https://www.amazon.fr/s?k=slow+cosmetique+julien+kaibeck\\u0026tag=lebrunnathali-21\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003ele livre \\\"Slow cosmetique\\\" de Julien Kaibeck\\u003c/a\\u003e est la reference en beaute naturelle.\\n\\u003c/p\\u003e\"])</script><script>self.__next_f.push([1,\"15:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"article-content\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"$21\\\"}}]}]\\n16:[\\\"$\\\",\\\"$L1f\\\",null,{}]\\n17:[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"textAlign\\\":\\\"center\\\",\\\"margin\\\":\\\"40px 0\\\",\\\"padding\\\":\\\"32px\\\",\\\"background\\\":\\\"linear-gradient(135deg, #FFF0F0 0%, #FFF8F0 100%)\\\",\\\"borderRadius\\\":\\\"16px\\\",\\\"border\\\":\\\"2px solid #FECDD3\\\"},\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"style\\\":{\\\"fontWeight\\\":800,\\\"fontSize\\\":\\\"1.2rem\\\",\\\"marginBottom\\\":\\\"16px\\\",\\\"color\\\":\\\"var(--foreground)\\\"},\\\"children\\\":\\\"Profiter de cette offre\\\"}],[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://www.amazon.fr/s?k=huile+vegetale+beurre+karite+soin+naturel\\u0026tag=lebrunnathali-21\\\",\\\"className\\\":\\\"btn btn-primary\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"nofollow sponsored noopener\\\",\\\"style\\\":{\\\"padding\\\":\\\"14px 32px\\\",\\\"fontSize\\\":\\\"1rem\\\"},\\\"children\\\":[\\\"Voir les soins sur Amazon\\\",\\\" \\\",[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":15,\\\"height\\\":15,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeL