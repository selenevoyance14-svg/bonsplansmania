rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"anti-âge\"}]\n25:[\"$\",\"a\",\"acide hyaluronique\",{\"href\":\"/marque/acide-hyaluronique\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"acide hyaluronique\"}]\n26:[\"$\",\"a\",\"soins visage\",{\"href\":\"/marque/soins-visage\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"soins visage\"}]\n27:[\"$\",\"a\",\"skincare\",{\"href\":\"/marque/skincare\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"skincare\"}]\n28:[\"$\",\"a\",\"made in france\",{\"href\":\"/marque/made-in-france\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"made in france\"}]\na:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n29:I[27201,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/d2be314c3ece3fbe.js\"],\"IconMark\"]\n8:null\nc:[[\"$\",\"title\",\"0\",{\"children\":\"Dr Pierre Ricaud avis test soins anti-âge 2026\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"On a testé 5 produits Dr Pierre Ricaud : crème jour, sérum hyaluronique, crème nuit, contour yeux, gommage. Yuka 100/100, notre verdict complet.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"mani