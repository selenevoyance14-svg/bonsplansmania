48aeeec84550f8.js\\\"],\\\"default\\\"]\\n22:I[67277,[\\\"/_next/static/chunks/cf200c391baea40a.js\\\",\\\"/_next/static/chunks/6e48aeeec84550f8.js\\\"],\\\"default\\\"]\\nf:[\\\"$\\\",\\\"path\\\",\\\"1q9fwt\\\",{\\\"d\\\":\\\"M15 3h6v6\\\"}]\\n10:[\\\"$\\\",\\\"path\\\",\\\"gplh6r\\\",{\\\"d\\\":\\\"M10 14 21 3\\\"}]\\n11:[\\\"$\\\",\\\"path\\\",\\\"a6xqqp\\\",{\\\"d\\\":\\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\\"}]\\n12:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"article-hero-image\\\",\\\"style\\\":{\\\"background\\\":\\\"#fff\\\",\\\"borderRadius\\\":\\\"12px\\\",\\\"overflow\\\":\\\"hidden\\\",\\\"display\\\":\\\"flex\\\",\\\"justifyContent\\\":\\\"center\\\",\\\"alignItems\\\":\\\"center\\\",\\\"maxHeight\\\":\\\"450px\\\"},\\\"children\\\":[\\\"$\\\",\\\"$L1e\\\",null,{\\\"src\\\":\\\"/images/articles/dr-pierre-ricaud-avis-test-soins-anti-age-2026.svg\\\",\\\"alt\\\":\\\"Dr Pierre Ricaud avis test soins anti-âge\\\",\\\"width\\\":800,\\\"height\\\":450,\\\"style\\\":{\\\"width\\\":\\\"100%\\\",\\\"height\\\":\\\"100%\\\",\\\"objectFit\\\":\\\"contain\\\",\\\"maxHeight\\\":\\\"450px\\\"},\\\"priority\\\":true}]}]\\n13:[\\\"$\\\",\\\"$L1f\\\",null,{}]\\n14:[\\\"$\\\",\\\"$L20\\\",null,{}]\\n21:T2559,\"])</script><script>self.__next_f.push([1,\"\\u003cp\\u003e\\n# Dr Pierre Ricaud : On a Testé 5 Soins Anti-Âge\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003eDr Pierre Ricaud\\u003c/strong\\u003e, c'est une marque française spécialisée dans l'anti-âge depuis 1986. Formulés en Île-de-France, fabriqués en Bretagne, les produits misent sur la science et les ingrédients naturels. On a testé 5 soins de la gamme pour voir ce que ça vaut vraiment.\\u003c/p\\u003e\\u003ch2\\u003eCrème de Jour Acide Hyaluronique + Galanga — le pilier\\u003c/h2\\u003e\\u003cp\\u003eLa crème de jour est le produit central de la routine. Sa formule combine \\u003cstrong\\u003eacide hyaluronique\\u003c/strong\\u003e et \\u003cstrong\\u003eflavonoïdes de galanga bio\\u003c/strong\\u003e pour relancer la production naturelle d'acide hyaluronique par la peau. 93% d'ingrédients d'origine naturelle, sans parabènes, sans filtres UV controversés.\\u003c/p\\u003e\\u003cp\\u003eLa texture est épaisse et veloutée, fond agréablement sur la peau. Le parfum est subtil. On l'applique le matin sur peau propre, avant le maquillage.\\u003c/p\\u003e\\u003cdiv class=\\\"product-card\\\"\\u003e\\u003cspan class=\\\"product-card-badge\\\"\\u003eYuka 100/100\\u003c/span\\u003e\\u003cdiv class=\\\"product-card-info\\\"\\u003e\\u003cstrong class=\\\"product-card-name\\\"\\u003eCrème de Jour Acide Hyaluronique + Galanga\\u003c/strong\\u003e\\u003cp class=\\\"product-card-desc\\\"\\u003e93% naturel, Yuka 100/100, Que Choisir A. Le pilier de la routine anti-âge Pierre Ricaud.\\u003c/p\\u003e\\u003cdiv class=\\\"product-card-rating\\\"\\u003e\\u003cspan class=\\\"product-card-stars\\\"\\u003e★★★★★\\u003c/span\\u003e \\u003cstrong\\u003e4.8/5\\u003c/strong\\u003e\\u003c/div\\u003e\\u003c/div\\u003e\\u003cdiv class=\\\"product-card-action\\\"\\u003e\\u003ca href=\\\"https://tidd.ly/4toJf2t\\\" class=\\\"btn btn-primary btn-sm\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eVoir sur Pierre Ricaud \\u003csvg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"13\\\" height=\\\"13\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"\\u003e\\u003cpath d=\\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\\"/\\u003e\\u003cpolyline points=\\\"15 3 21 3 21 9\\\"/\\u003e\\u003cline x1=\\\"10\\\" y1=\\\"14\\\" x2=\\\"21\\\" y2=\\\"3\\\"/\\u003e\\u003c/svg\\u003e\\u003c/a\\u003e\\u003c/div\\u003e\\u003c/div\\u003e\\u003cp\\u003e\\u003cdiv class=\\\"cta-inline\\\"\\u003e\\u003ca href=\\\"https://tidd.ly/4toJf2t\\\" class=\\\"btn btn-primary btn-sm\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eDécouvrir Dr Pierre Ricaud \\u003csvg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"13\\\" height=\\\"13\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"\\u003e\\u003cpath d=\\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\\"/\\u003e\\u003cpolyline points=\\\"15 3 21 3 21 9\\\"/\\u003e\\u003cline x1=\\\"10\\\" y1=\\\"14\\\" x2=\\\"21\\\" y2=\\\"3\\\"/\\u003e\\u003c/svg\\u003e\\u003c/a\\u003e\\u003c/div\\u003e\\u003ch2\\u003eSérum Acide Hyaluronique + Galanga Bio — le booster\\u003c/h2\\u003e\\u003cp\\u003eCe sérum s'applique avant la crème pour en renforcer l'efficacité. La texture est liquide et légèrement crémeuse, pénètre instantanément sans laisser de film. 96% d'ingrédients d'origine naturelle et format rechargeable, on apprécie la démarche éco.\\u003c/p\\u003e\\u003cp\\u003eIl apporte un boost antioxydant et prépare la peau à recevoir la crème. Le duo sérum + crème fonctionne vraiment bien ensemble.\\u003c/p\\u003e\\u003cdiv class=\\\"product-card\\\"\\u003e\\u003cspan class=\\\"product-card-badge\\\"\\u003eYuka 100/100\\u003c/span\\u003e\\u003cdiv class=\\\"product-card-info\\\"\\u003e\\u003cstrong class=\\\"product-card-name\\\"\\u003eSérum Acide Hyaluronique + Galanga Bio\\u003c/strong\\u003e\\u003cp class=\\\"product-card-desc\\\"\\u003e96% naturel, format rechargeable. Yuka 100/100, Que Choisir A. Le complément idéal de la crème.\\u003c/p\\u003e\\u003cdiv class=\\\"product-card-rating\\\"\\u003e\\u003cspan class=\\\"product-card-stars\\\"\\u003e★★★★★\\u003c/span\\u003e \\u003cstrong\\u003e4.7/5\\u003c/strong\\u003e\\u003c/div\\u003e\\u003c/div\\u003e\\u003cdiv class=\\\"product-card-action\\\"\\u003e\\u003ca href=\\\"https://tidd.ly/4toJf2t\\\" class=\\\"btn btn-primary btn-sm\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eVoir sur Pierre Ricaud \\u003csvg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"13\\\" height=\\\"13\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"\\u003e\\u003cpath d=\\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\\"/\\u003e\\u003cpolyline points=\\\"15 3 21 3 21 9\\\"/\\u003e\\u003cline x1=\\\"10\\\" y1=\\\"14\\\" x2=\\\"21\\\" y2=\\\"3\\\"/\\u003e\\u003c/svg\\u003e\\u003c/a\\u003e\\u003c/div\\u003e\\u003c/div\\u003e\\u003cp\\u003e\\u003cdiv id=\\\"ezoic-pub-ad-placeholder-203\\\" class=\\\"ad-container\\\" style=\\\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\\\"\\u003e\\u003c/div\\u003e\\u003ch2\\u003eCrème de Nuit Probiotiques + Micro-ARN de Lavande — la réparatrice\\u003c/h2\\u003e\\u003cp\\u003eLa crème de nuit mise sur les \\u003cstrong\\u003eprobiotiques\\u003c/strong\\u003e et les \\u003cstrong\\u003emicro-ARN de lavande bio\\u003c/strong\\u003e pour renforcer la barrière cutanée et rééquilibrer la flore de la peau pendant le sommeil. C'est la texture la plus riche de la gamme, avec de l'acide salicylique en plus.\\u003c/p\\u003e\\u003cp\\u003eElle hydrate bien sans tacher les oreillers, ce qui est un vrai plus. Le parfum est un peu plus prononcé que la crème de jour. Attention si tu as la peau sensible : l'acide salicylique peut picoter.\\u003c/p\\u003e\\u003cdiv class=\\\"product-card\\\"\\u003e\\u003cdiv class=\\\"product-card-info\\\"\\u003e\\u003cstrong class=\\\"product-card-name\\\"\\u003eCrème de Nuit Probiotiques + Micro-ARN de Lavande\\u003c/strong\\u003e\\u003cp class=\\\"product-card-desc\\\"\\u003eTexture riche réparatrice, renforce la barrière cutanée pendant le sommeil. Yuka 72/100.\\u003c/p\\u003e\\u003cdiv class=\\\"product-card-rating\\\"\\u003e\\u003cspan class=\\\"product-card-stars\\\"\\u003e★★★★☆\\u003c/span\\u003e \\u003cstrong\\u003e4.2/5\\u003c/strong\\u003e\\u003c/div\\u003e\\u003c/div\\u003e\\u003cdiv class=\\\"product-card-action\\\"\\u003e\\u003ca href=\\\"https://tidd.ly/4toJf2t\\\" class=\\\"btn btn-primary btn-sm\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eVoir sur Pierre Ricaud \\u003csvg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"13\\\" height=\\\"13\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"\\u003e\\u003cpath d=\\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\\"/\\u003e\\u003cpolyline points=\\\"15 3 21 3 21 9\\\"/\\u003e\\u003cline x1=\\\"10\\\" y1=\\\"14\\\" x2=\\\"21\\\" y2=\\\"3\\\"/\\u003e\\u003c/svg\\u003e\\u003c/a\\u003e\\u003c/div\\u003e\\u003c/div\\u003e\\u003cp\\u003e\\u003cdiv class=\\\"cta-inline\\\"\\u003e\\u003ca href=\\\"https://tidd.ly/4toJf2t\\\" class=\\\"btn btn-primary btn-sm\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eDécouvrir Dr Pierre Ricaud \\u003csvg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"13\\\" height=\\\"13\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"\\u003e\\u003cpath d=\\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\\"/\\u003e\\u003cpolyline points=\\\"15 3 21 3 21 9\\\"/\\u003e\\u003cline x1=\\\"10\\\" y1=\\\"14\\\" x2=\\\"21\\\" y2=\\\"3\\\"/\\u003e\\u003c/svg\\u003e\\u003c/a\\u003e\\u003c/div\\u003e\\u003ch2\\u003eContour des Yeux Acide Hyaluronique — le discret\\u003c/h2\\u003e\\u003cp\\u003eUn soin ciblé pour les pattes d'oie et les rides du contour de l'oeil. La formule est clean avec aucun ingrédient à risque. Il complète parfaitement la routine matin et soir.\\u003c/p\\u003e\\u003cdiv class=\\\"product-card\\\"\\u003e\\u003cspan class=\\\"product-card-badge\\\"\\u003eYuka 100/100\\u003c/span\\u003e\\u003cdiv class=\\\"product-card-info\\\"\\u003e\\u003cstrong class=\\\"product-card-name\\\"\\u003eContour des Yeux Acide Hyaluronique\\u003c/strong\\u003e\\u003cp class=\\\"product-card-desc\\\"\\u003eSoin ciblé pattes d'oie et rides, compo parfaite avec zéro ingrédient à risque. Yuka 100/100.\\u003c/p\\u003e\\u003cdiv class=\\\"product-card-rating\\\"\\u003e\\u003cspan class=\\\"product-card-stars\\\"\\u003e★★★★★\\u003c/span\\u003e \\u003cstrong\\u003e4.5/5\\u003c/strong\\u003e\\u003c/div\\u003e\\u003c/div\\u003e\\u003cdiv class=\\\"product-card-action\\\"\\u003e\\u003ca href=\\\"https://tidd.ly/4toJf2t\\\" class=\\\"btn btn-primary btn-sm\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eVoir sur Pierre Ricaud \\u003csvg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"13\\\" height=\\\"13\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"\\u003e\\u003cpath d=\\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\\"/\\u003e\\u003cpolyline points=\\\"15 3 21 3 21 9\\\"/\\u003e\\u003cline x1=\\\"10\\\" y1=\\\"14\\\" x2=\\\"21\\\" y2=\\\"3\\\"/\\u003e\\u003c/svg\\u003e\\u003c/a\\u003e\\u003c/div\\u003e\\u003c/div\\u003e\\u003ch2\\u003eGommage Argile + Prébiotiques — le nettoyage profond\\u003c/h2\\u003e\\u003cp\\u003eUn gommage à base d'\\u003cstrong\\u003eargile et de micrograins\\u003c/strong\\u003e enrichi en prébiotiques. A utiliser 1 à 2 fois par semaine. Il nettoie en profondeur et laisse la peau toute douce. La formule est excellente avec un Yuka de 93/100.\\u003c/p\\u003e\\u003cdiv class=\\\"product-card\\\"\\u003e\\u003cdiv class=\\\"product-card-info\\\"\\u003e\\u003cstrong class=\\\"product-card-name\\\"\\u003eGommage Argile + Prébiotiques\\u003c/strong\\u003e\\u003cp class=\\\"product-card-desc\\\"\\u003eArgile et micrograins, enrichi en prébiotiques. Peau nette et lumineuse. Yuka 93/100.\\u003c/p\\u003e\\u003cdiv class=\\\"product-card-rating\\\"\\u003e\\u003cspan class=\\\"product-card-stars\\\"\\u003e★★★★☆\\u003c/span\\u003e \\u003cstrong\\u003e4.4/5\\u003c/strong\\u003e\\u003c/div\\u003e\\u003c/div\\u003e\\u003cdiv class=\\\"product-card-action\\\"\\u003e\\u003ca href=\\\"https://tidd.ly/4toJf2t\\\" class=\\\"btn btn-primary btn-sm\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eVoir sur Pierre Ricaud \\u003csvg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"13\\\" height=\\\"13\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"\\u003e\\u003cpath d=\\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\\"/\\u003e\\u003cpolyline points=\\\"15 3 21 3 21 9\\\"/\\u003e\\u003cline x1=\\\"10\\\" y1=\\\"14\\\" x2=\\\"21\\\" y2=\\\"3\\\"/\\u003e\\u003c/svg\\u003e\\u003c/a\\u003e\\u003c/div\\u003e\\u003c/div\\u003e\\u003cp\\u003e\\u003cdiv id=\\\"ezoic-pub-ad-placeholder-206\\\" class=\\\"ad-container\\\" style=\\\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\\\"\\u003e\\u003c/div\\u003e\\u003ch2\\u003eCe qu'on retient de Dr Pierre Ricaud\\u003c/h2\\u003e\\u003cul\\u003e\\u003cli\\u003e\\u003cstrong\\u003eMarque française depuis 1986\\u003c/strong\\u003e — formulée en Ile-de-France, fabriquée en Bretagne\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eExpertise anti-âge\\u003c/strong\\u003e — études cliniques à l'appui\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eNotes Yuka exceptionnelles\\u003c/strong\\u003e — 3 produits à 100/100\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eFormats rechargeables\\u003c/strong\\u003e — démarche éco-responsable\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eVente en ligne exclusive\\u003c/strong\\u003e — uniquement sur le site officiel avec des promos régulières\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch2\\u003eNotre avis global\\u003c/h2\\u003e\\u003cp\\u003eDr Pierre Ricaud nous a vraiment convaincues. Les scores Yuka parlent d'eux-mêmes : trois produits à 100/100, c'est rare pour une gamme complète. Le duo crème de jour + sérum est le coeur de la routine et il est irréprochable en termes de composition. La crème de nuit est un peu en retrait niveau compo mais reste efficace. Ce qui nous plaît, c'est le sérieux scientifique derrière chaque formule et la fabrication 100% française. Si tu cherches une routine anti-âge clean et efficace, Dr Pierre Ricaud est un excellent choix.\\n\\u003c/p\\u003e\"])</script><script>self.__next_f.push([1,\"15:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"article-content\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"$21\\\"}}]}]\\n16:[\\\"$\\\",\\\"$L1f\\\",null,{}]\\n17:[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"textAlign\\\":\\\"center\\\",\\\"margin\\\":\\\"40px 0\\\",\\\"padding\\\":\\\"32px\\\",\\\"background\\\":\\\"linear-gradient(135deg, #FFF0F0 0%, #FFF8F0 100%)\\\",\\\"borderRadius\\\":\\\"16px\\\",\\\"border\\\":\\\"2px solid #FECDD3\\\"},\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"style\\\":{\\\"fontWeight\\\":800,\\\"fontSize\\\":\\\"1.2rem\\\",\\\"marginBottom\\\":\\\"16px\\\",\\\"color\\\":\\\"var(--foreground)\\\"},\\\"children\\\":\\\"Profiter de cette offre\\\"}],[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://tidd.ly/4toJf2t\\\",\\\"className\\\":\\\"btn btn-primary\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"nofollow sponsored noopener\\\",\\\"style\\\":{\\\"padding\\\":\\\"14px 32px\\\",\\\"fontSize\\\":\\\"1rem\\\"},\\\"children\\\":[\\\"Découvrir Dr Pierre Ricaud\\\",\\\" \\\",[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":15,\\\"height\\\":15,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-external-link\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":[[\\\"$\\\",\\\"path\\\",\\\"1q9fwt\\\