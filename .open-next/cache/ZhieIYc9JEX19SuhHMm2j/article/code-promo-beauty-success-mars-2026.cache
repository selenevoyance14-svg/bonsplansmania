\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"card-excerpt\\\",\\\"children\\\":\\\"Codes promo Lookfantastic avril 2026 : offres de Paques jusqu'a -40%, code PLUS10 pour -10% supplementaires, -25% Armani. Livraison offerte des 60 euros.\\\"}]]}]]}],[\\\"$\\\",\\\"a\\\",\\\"code-promo-beaute-produit-10-pourcent-permanent-2026\\\",{\\\"href\\\":\\\"/article/code-promo-beaute-produit-10-pourcent-permanent-2026\\\",\\\"className\\\":\\\"card\\\",\\\"style\\\":{\\\"textDecoration\\\":\\\"none\\\"},\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"position\\\":\\\"relative\\\",\\\"height\\\":\\\"160px\\\",\\\"overflow\\\":\\\"hidden\\\"},\\\"children\\\":[\\\"$\\\",\\\"$L1e\\\",null,{\\\"src\\\":\\\"/images/articles/code-promo-beaute-produit-10-pourcent-permanent-2026.svg\\\",\\\"alt\\\":\\\"Code promo Beaute Produit -10% BEAUTE10\\\",\\\"fill\\\":true,\\\"style\\\":{\\\"objectFit\\\":\\\"cover\\\"},\\\"sizes\\\":\\\"33vw\\\"}]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"card-body\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"style\\\":{\\\"fontSize\\\":\\\"0.72rem\\\",\\\"fontWeight\\\":600,\\\"color\\\":\\\"var(--primary)\\\",\\\"textTransform\\\":\\\"uppercase\\\",\\\"letterSpacing\\\":\\\"0.5px\\\"},\\\"children\\\":[\\\"$undefined\\\",\\\" \\\",\\\"$undefined\\\"]}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"card-title\\\",\\\"children\\\":\\\"Code Promo Beaute Produit : -10% permanent avec le code BEAUTE10\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"card-excerpt\\\",\\\"children\\\":\\\"Code promo Beaute Produit : -10% de remise permanente avec le code BEAUTE10. Cosmetiques, soins visage, corps, maquillage et accessoires beaute.\\\"}]]}]]}],[\\\"$\\\",\\\"a\\\",\\\"belle-au-naturel-coffrets-beaute-bio-fete-des-meres-2026\\\",{\\\"href\\\":\\\"/article/belle-au-naturel-coffrets-beaute-bio-fete-des-meres-2026\\\",\\\"className\\\":\\\"card\\\",\\\"style\\\":{\\\"textDecoration\\\":\\\"none\\\"},\\\"children\\\":[