t>self.__next_f.push([1,\"e:I[83608,[\\\"/_next/static/chunks/cf200c391baea40a.js\\\",\\\"/_next/static/chunks/6e48aeeec84550f8.js\\\"],\\\"default\\\"]\\n\"])</script><script>self.__next_f.push([1,\"5:[[\\\"$\\\",\\\"script\\\",null,{\\\"type\\\":\\\"application/ld+json\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"{\\\\\\\"@context\\\\\\\":\\\\\\\"https://schema.org\\\\\\\",\\\\\\\"@type\\\\\\\":\\\\\\\"Article\\\\\\\",\\\\\\\"headline\\\\\\\":\\\\\\\"Fête des mères à moins de 30 euros : 6 idées cadeaux bien-être\\\\\\\",\\\\\\\"description\\\\\\\":\\\\\\\"Pas besoin de se ruiner pour faire plaisir. 6 idées cadeaux bien-être pour la fête des mères 2026 à moins de 30 euros.\\\\\\\",\\\\\\\"datePublished\\\\\\\":\\\\\\\"2026-04-08\\\\\\\",\\\\\\\"dateModified\\\\\\\":\\\\\\\"2026-04-08\\\\\\\",\\\\\\\"image\\\\\\\":\\\\\\\"https://bonsplansmania.fr/images/articles/idees-cadeaux-bien-etre-fete-des-meres-moins-30-euros-2026.svg\\\\\\\",\\\\\\\"mainEntityOfPage\\\\\\\":{\\\\\\\"@type\\\\\\\":\\\\\\\"WebPage\\\\\\\",\\\\\\\"@id\\\\\\\":\\\\\\\"https://bonsplansmania.fr/article/idees-cadeaux-bien-etre-fete-des-meres-moins-30-euros-2026\\\\\\\"},\\\\\\\"author\\\\\\\":{\\\\\\\"@type\\\\\\\":\\\\\\\"Organization\\\\\\\",\\\\\\\"name\\\\\\\":\\\\\\\"Bons Plans Mania\\\\\\\",\\\\\\\"url\\\\\\\":\\\\\\\"https://bonsplansmania.fr\\\\\\\"},\\\\\\\"publisher\\\\\\\":{\\\\\\\"@type\\\\\\\":\\\\\\\"Organization\\\\\\\",\\\\\\\"name\\\\\\\":\\\\\\\"Bons Plans Mania\\\\\\\",\\\\\\\"url\\\\\\\":\\\\\\\"https://bonsplansmania.fr\\\\\\\",\\\\\\\"logo\\\\\\\":{\\\\\\\"@type\\\\\\\":\\\\\\\"ImageObject\\\\\\\",\\\\\\\"url\\\\\\\":\\\\\\\"https://bonsplansmania.fr/icon.svg\\\\\\\"}}}\\\"}}],null,[\\\"$\\\",\\\"script\\\",null,{\\\"type\\\":\\\"application/ld+json\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"{\\\\\\\"@context\\\\\\\":\\\\\\\"https://schema.org\\\\\\\",\\\\\\\"@type\\\\\\\":\\\\\\\"BreadcrumbList\\\\\\\",\\\\\\\"itemListElement\\\\\\\":[{\\\\\\\"@type\\