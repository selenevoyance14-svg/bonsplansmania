-success-5-cadeaux-fete-des-meres-moins-15-euros-2026\\\",{\\\"href\\\":\\\"/article/beauty-success-5-cadeaux-fete-des-meres-moins-15-euros-2026\\\",\\\"className\\\":\\\"card\\\",\\\"style\\\":{\\\"textDecoration\\\":\\\"none\\\"},\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"position\\\":\\\"relative\\\",\\\"height\\\":\\\"160px\\\",\\\"overflow\\\":\\\"hidden\\\"},\\\"children\\\":[\\\"$\\\",\\\"$L1e\\\",null,{\\\"src\\\":\\\"/images/articles/beauty-success-baija-moana-coffret-2026.webp\\\",\\\"alt\\\":\\\"Coffret Baïja Moana mousse de douche et crème mains fête des mères\\\",\\\"fill\\\":true,\\\"style\\\":{\\\"objectFit\\\":\\\"cover\\\"},\\\"sizes\\\":\\\"33vw\\\"}]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"card-body\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"style\\\":{\\\"fontSize\\\":\\\"0.72rem\\\",\\\"fontWeight\\\":600,\\\"color\\\":\\\"var(--primary)\\\",\\\"textTransform\\\":\\\"uppercase\\\",\\\"letterSpacing\\\":\\\"0.5px\\\"},\\\"children\\\":[\\\"🏷️\\\",\\\" \\\",\\\"Bon Plan\\\"]}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"card-title\\\",\\\"children\\\":\\\"Fête des mères : 5 coffrets cadeaux à moins de 15€ chez Beauty Success\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"card-excerpt\\\",\\\"children\\\":\\\"5 idées cadeaux fête des mères à moins de 15€ chez Beauty Success. Maquillage, roses de savon, soins Baïja, Algologie, pinceaux. Dès 12,95€.\\\"}]]}]]}],[\\\"$\\\",\\\"a\\\",\\\"fete-des-meres-10-cadeaux-beaute-pas-cher-beauty-success-2026\\\",{\\\"href\\\":\\\"/article/fete-des-meres-10-cadeaux-beaute-pas-cher-beauty-success-2026\\\",\\\"className\\\":\\\"card\\\",\\\"style\\\":{\\\"textDecoration\\\":\\\"none\\\"},\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"position\\\":\\\"relative\\\",\\\"height\\\":\\\"160px\\\",\\\"overflow\\\":\\\"hidden\\\"},\\\"children\\\":[\\\"$\\\",\\\"$L1e\\\",null,{\\\"src\\\":\\\"/images/articles/fete-des-meres-10-cadeaux-beaute