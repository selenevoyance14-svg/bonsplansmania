\\\"},\\\"children\\\":[\\\"✨\\\",\\\" \\\",\\\"Beauté\\\"]}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"card-title\\\",\\\"children\\\":\\\"Belle au Naturel : coffrets cadeaux beauté bio dès 25€, idéal fête des mères\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"card-excerpt\\\",\\\"children\\\":\\\"Plus de 50 coffrets cadeaux beauté 100% bio et made in France chez Belle au Naturel. Dès 25€, le cadeau parfait pour la fête des mères 2026.\\\"}]]}]]}]]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"1a:[\\\"$\\\",\\\"nav\\\",null,{\\\"style\\\":{\\\"margin\\\":\\\"40px 0\\\",\\\"padding\\\":\\\"24px\\\",\\\"background\\\":\\\"var(--muted, #f3f4f6)\\\",\\\"borderRadius\\\":\\\"16px\\\"},\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"style\\\":{\\\"fontSize\\\":\\\"1rem\\\",\\\"marginBottom\\\":\\\"12px\\\"},\\\"children\\\":\\\"Explorer par catégorie\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"display\\\":\\\"flex\\\",\\\"flexWrap\\\":\\\"wrap\\\",\\\"gap\\\":\\\"8px\\\"},\\\"children\\\":[[\\\"$\\\",\\\"a\\\",\\\"test-gratuit\\\",{\\\"href\\\":\\\"/categorie/test-gratuit\\\",\\\"style\\\":{\\\"padding\\\":\\\"6px 14px\\\",\\\"borderRadius\\\":\\\"999px\\\",\\\"background\\\":\\\"white\\\",\\\"fontSize\\\":\\\"0.82rem\\\",\\\"color\\\":\\\"var(--text, #374151)\\\",\\\"textDecoration\\\":\\\"none\\\",\\\"fontWeight\\\":500,\\\"border\\\":\\\"1px solid var(--border, #e5e7eb)\\\"},\\\"children\\\":[\\\"🎁\\\",\\\" \\\",\\\"Tests Gratuits\\\"]}],[\\\"$\\\",\\\"a\\\",\\\"concours\\\",{\\\"href\\\":\\\"/categorie/concours\\\",\\\"style\\\":{\\\"padding\\\":\\\"6px 14px\\\",\\\"borderRadius\\\":\\\"999px\\\",\\\"background\\\":\\\"white\\\",\\\"fontSize\\\":\\\"0.82rem\\\",\\\"color\\\":\\\"var(--text, #374151)\\\",\\\"textDecoration\\\":\\\"none\\\",\\\"fontWeight\\\":500,\\\"border\\\":\\\"1px solid var(--border, #e5e7eb)\\\"},\\\"children\\\":[\\\"🏆\\\",\\\" \\\",\\\"Concours\\\"]}],[\\\"$\\\",\\\"a\\\",\\\"box-beaute\\\",{\\\"href\\\":\\\"/categorie/box-beaute\\\",\\\"style\\\":{\\\"padding\\\":\\\"6px 14px\\\",\\\"borderRadius\\\":\\\"999px\\\",\\\"background\\\":\\\"white\\\",\\\"fontSize\\\":\\\"0.82rem\\\",\\\"color\\\":\\\"var(--text, #374151)\\\",\\\"textDecoration\\\":\\\"none\\\",\\\"fontWeight\\\":500,\\\"border\\\":\\\"1px solid var(--border, #e5e7eb)\\\"},\\\"children\\\":[\\\"💄\\\",\\\" \\\",\\\"Box Beauté\\\"]}],[\\\"$\\\",\\\"a\\\",\\\"code-promo\\\",{\\\"href\\\":\\\"/categorie/code-promo\\\",\\\"style\\\":{\\\"padding\\\":\\\"6px 14px\\\",\\\"borderRadius\\\":\\\"999px\\\",\\\"background\\\":\\\"white\\\",\\\"fontSize\\\":\\\"0.82rem\\\",\\\"color\\\":\\\"var(--text, #374151)\\\",\\\"textDecoration\\\":\\\"none\\\",\\\"fontWeight\\\":500,\\\"border\\\":\\\"1px solid var(--border, #e5e7eb)\\\"},\\\"children\\\":[\\\"🎟️\\\",\\\" \\\",\\\"Codes Promo\\\"]}],[\\\"$\\\",\\\"a\\\",\\\"beaute\\\",{\\\"href\\\":\\\"/categorie/beaute\\\",\\\"style\\\":{\\\"padding\\\":\\\"6px 14px\\\",\\\"borderRadius\\\":\\\"999px\\\",\\\"background\\\":\\\"white\\\",\\\"fontSize\\\":\\\"0.82rem\\\",\\\"color\\\":\\\"var(--text, #374151)\\\",\\\"textDecoration\\\":\\\"none\\\",\\\"fontWeight\\\":500,\\\"border\\\":\\\"1px solid var(--border, #e5e7eb)\\\"},\\\"children\\\":[\\\"✨\\\",\\\" \\\",\\\"Beauté\\\"]}]]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"1b:[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"maxWidth\\\":\\\"780px\\\",\\\"margin\\\":\\\"0 auto\\\"},\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"display\\\":\\\"flex\\\",\\\"alignItems\\\":\\\"center\\\",\\\"gap\\\":\\\"12px\\\",\\\"flexWrap\\\":\\\"wrap\\\",\\\"margin\\\":\\\"32px 0 16px\\\"},\\\"children\\\":[[\\\"$\\\",\\\"$L22\\\",null,{\\\"slug\\\":\\\"idees-cadeaux-bien-etre-fete-des-meres-moins-30-euros-2026\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"style\\\":{\\\"fontSize\\\":\\\"0.85rem\\\",\\\"color\\\":\\\"var(--text-muted, #6b7280)\\\"},\\\"children\\\":\\\"Partager :\\\"}],[[\\\"$\\\",\\\"a\\\",\\\"WhatsApp\\\"