bo Planet propose des codes promo mode : -30% dès l'achat d'un jean et d'un article, -15% sur la première commande via la newsletter et 2,5% de cashback avec iGraal.\"}]]}]]}],[\"$\",\"a\",\"code-promo-blancheporte-mars-2026\",{\"href\":\"/article/code-promo-blancheporte-mars-2026\",\"className\":\"card\",\"style\":{\"textDecoration\":\"none\"},\"children\":[[\"$\",\"div\",null,{\"style\":{\"position\":\"relative\",\"height\":\"160px\",\"overflow\":\"hidden\"},\"children\":[\"$\",\"$L12\",null,{\"src\":\"/images/articles/code-promo-blancheporte-mars-2026.svg\",\"alt\":\"Codes promo Blancheporte mars 2026\",\"fill\":true,\"style\":{\"objectFit\":\"cover\"},\"sizes\":\"33vw\"}]}],[\"$\",\"div\",null,{\"className\":\"card-body\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"fontSize\":\"0.72rem\",\"fontWeight\":600,\"color\":\"var(--primary)\",\"textTransform\":\"uppercase\",\"letterSpacing\":\"0.5px\"},\"children\":[\"$undefined\",\" \",\"$undefined\"]}],[\"$\",\"h3\",null,{\"className\":\"card-title\",\"children\":\"Code Promo Blancheporte Mars 2026 : Jusqu'à 40% de Réduction\"}],[\"$\",\"p\",null,{\"className\":\"card-excerpt\",\"children\":\"Tous les codes promo Blancheporte valables en mars 2026 : 40% de réduction, livraison gratuite avec ENVOIOFFERT, soldes jusqu'à -50%.\"}]]}]]}]]}]]}]\nc:[\"$\",\"nav\",null,{\"style\":{\"margin\":\"40px 0\",\"padding\":\"24px\",\"background\":\"var(--muted, #f3f4f6)\",\"borderRadius\":\"16px\"},\"children\":[[\"$\",\"h3\",null,{\"style\":{\"fontSize\":\"1rem\",\"marginBottom\":\"12px\"},\"children\":\"Explorer par catégorie\"}],[\"$\",\"div\",null,{\"style\":{\"display\":\"flex\",\"flexWrap\":\"wrap\",\"gap\":\"8px\"},\"children\":[[\"$\",\"a\",\"test-gratuit\",{\"href\":\"/categorie/test-gratuit\",\"style\":{\"padding\":\"6px 14px\",\"borderRadius\":\"999px\",\"background\":\"white\",\"fontSize\":\"0.82rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500,\"border\":\"1px solid var(--border