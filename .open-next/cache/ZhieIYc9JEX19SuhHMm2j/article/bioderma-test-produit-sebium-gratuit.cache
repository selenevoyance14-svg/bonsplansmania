",\\\"@type\\\":\\\"Article\\\",\\\"headline\\\":\\\"Bioderma : Testez la Gamme Sébium Gratuitement (300 Testeuses Sélectionnées)\\\",\\\"description\\\":\\\"Bioderma sélectionne 300 testeuses pour tester gratuitement la gamme Sébium : Kerato+ Body, Kerato+ Cover et Lotion pour peaux mixtes, grasses et acnéiques. Comment participer ?\\\",\\\"datePublished\\\":\\\"2026-03-03\\\",\\\"dateModified\\\":\\\"2026-03-03\\\",\\\"image\\\":\\\"https://bonsplansmania.fr/images/articles/bioderma-test-produit-sebium-gratuit.svg\\\",\\\"mainEntityOfPage\\\":{\\\"@type\\\":\\\"WebPage\\\",\\\"@id\\\":\\\"https://bonsplansmania.fr/article/bioderma-test-produit-sebium-gratuit\\\"},\\\"author\\\":{\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"Bons Plans Mania\\\",\\\"url\\\":\\\"https://bonsplansmania.fr\\\"},\\\"publisher\\\":{\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"Bons Plans Mania\\\",\\\"url\\\":\\\"https://bonsplansmania.fr\\\",\\\"logo\\\":{\\\"@type\\\":\\\"ImageObject\\\",\\\"url\\\":\\\"https://bonsplansmania.fr/icon.svg\\\"}}}\"}}],null,[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"BreadcrumbList\\\",\\\"itemListElement\\\":[{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":1,\\\"name\\\":\\\"Accueil\\\",\\\"item\\\":\\\"https://bonsplansmania.fr\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":2,\\\"name\\\":\\\"Test Gratuit\\\",\\\"item\\\":\\\"https://bonsplansmania.fr/categorie/test-gratuit\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":3,\\\"name\\\":\\\"Bioderma : Testez la Gamme Sébium Gratuitement (300 Testeuses Sélectionnées)\\\"}]}\"}}],[\"$\",\"$Le\",null,{\"activePage\":\"/blog\"}],[\"$\",\"main\",null,{\"className\":\"article-page\",\"children\":[\"$\",\"div\",null,{\"className\":\"container\",\"children\":[[\"$\",\"nav\",null,{\"className\":\"breadcrumbs\",\"children\":[[\"$\",\"a\",null,{\"href\":\"/\",\"children\":