\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":13,\\\"height\\\":13,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-clock\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":[[\\\"$\\\",\\\"path\\\",\\\"mmk7yg\\\",{\\\"d\\\":\\\"M12 6v6l4 2\\\"}],[\\\"$\\\",\\\"circle\\\",\\\"1mglay\\\",{\\\"cx\\\":\\\"12\\\",\\\"cy\\\":\\\"12\\\",\\\"r\\\":\\\"10\\\"}],\\\"$undefined\\\"]}],\\\" \\\",\\\"3 min\\\"]}]]}],[\\\"$\\\",\\\"h1\\\",null,{\\\"children\\\":\\\"Bioderma : Testez la Gamme Sébium Gratuitement (300 Testeuses Sélectionnées)\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"article-subtitle\\\",\\\"children\\\":\\\"Bioderma sélectionne 300 testeuses pour tester gratuitement la gamme Sébium : Kerato+ Body, Kerato+ Cover et Lotion pour peaux mixtes, grasses et acnéiques. Comment participer ?\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"article-rating-bar\\\",\\\"children\\\":[\\\"$undefined\\\",\\\"$undefined\\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://www.bioderma.fr/test-produit-du-moment\\\",\\\"className\\\":\\\"btn btn-primary btn-sm\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"nofollow sponsored noopener\\\",\\\"children\\\":[\\\"Candidater au test Bioderma Sébium\\\",\\\" \\\",\\\"$Lf\\\"]}]]}]]}],\\\"$L10\\\",\\\"$L11\\\",\\\"$L12\\\",\\\"$L13\\\",\\\"$L14\\\",\\\"$L15\\\"]}],\\\"$L16\\\",\\\"$L17\\\",\\\"$L18\\\",\\\"$L19\\\"]}]}],\\\"$L1a\\\",\\\"$L1b\\\"]\\n\"])</script><script>self.__next_f.push([1,\"1c:I[5500,[\\\"/_next/static/chunks/cf200c391baea40a.js\\\",\\\"/_next/static/chunks/6e48aeeec84550f8.js\\\"],\\\"Image\\\"]\\n1d:I[96788,[\\\"/_next/static/chunks/cf200c391baea40a.js\\\",\\\"/_next/static/chunks/6e48aeeec84550f8.js\\\"],\\\"default\\\"]\\n1e:I[1586,[\\\"/_next/static/chunks/cf200c391baea40a.js\\\",\\\"/_next/static/chunks/6e48aeeec84550f8.js\\\"],\\\"default\\\"]\\n20:I[67277,[\\\"/_next/static/chunks/cf200c391baea40a.js\\\",\\\"/_next/static/chunks/6e48aeeec84550f8.js\\\"],\\\"default\\\"]\\nf:[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":13,\\\"height\\\":13,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-external-link\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":[[\\\"$\\\",\\\"path\\\",\\\"1q9fwt\\\",{\\\"d\\\":\\\"M15 3h6v6\\\"}],[\\\"$\\\",\\\"path\\\",\\\"gplh6r\\\",{\\\"d\\\":\\\"M10 14 21 3\\\"}],[\\\"$\\\",\\\"path\\\",\\\"a6xqqp\\\",{\\\"d\\\":\\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\\"}],\\\"$undefined\\\"]}]\\n10:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"article-hero-image\\\",\\\"style\\\":{\\\"background\\\":\\\"#fff\\\",\\\"borderRadius\\\":\\\"12px\\\",\\\"overflow\\\":\\\"hidden\\\",\\\"display\\\":\\\"flex\\\",\\\"justifyContent\\\":\\\"center\\\",\\\"alignItems\\\":\\\"center\\\",\\\"maxHeight\\\":\\\"450px\\\"},\\\"children\\\":[\\\"$\\\",\\\"$L1c\\\",null,{\\\"src\\\":\\\"/images/articles/bioderma-test-produit-sebium-gratuit.svg\\\",\\\"alt\\\":\\\"Bioderma test produit gratuit gamme Sébium\\\",\\\"width\\\":800,\\\"height\\\":450,\\\"style\\\":{\\\"width\\\":\\\"100%\\\",\\\"height\\\":\\\"100%\\\",\\\"objectFit\\\":\\\"contain\\\",\\\"maxHeight\\\":\\\"450px\\\"},\\\"priority\\\":true}]}]\\n11:[\\\"$\\\",\\\"$L1d\\\",null,{}]\\n12:[\\\"$\\\",\\\"$L1e\\\",null,{}]\\n1f:T182f,\"])</script><script>self.__next_f.push([1,\"\\u003cp\\u003e\\n\\u003ch2\\u003eBioderma — Test gratuit de la gamme Sébium\\u003c/h2\\u003e\\u003cp\\u003e\\u003cstrong\\u003eBioderma\\u003c/strong\\u003e, la marque dermatologique de référence, cherche \\u003cstrong\\u003e300 testeuses\\u003c/strong\\u003e pour tester gratuitement sa gamme \\u003cstrong\\u003eSébium\\u003c/strong\\u003e — spécialement conçue pour les peaux mixtes, grasses et sujettes aux imperfections.\\u003c/p\\u003e\\u003cp\\u003eUn tirage au sort parmi les candidatures désignera les heureuses élues. Participation entièrement gratuite.\\u003c/p\\u003e\\u003chr\\u003e\\u003cp\\u003e\\u003cdiv class=\\\"cta-inline\\\"\\u003e\\u003ca href=\\\"https://www.bioderma.fr/test-produit-du-moment\\\" class=\\\"btn btn-primary btn-sm\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eCandidater au test Bioderma Sébium \\u003csvg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"13\\\" height=\\\"13\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"\\u003e\\u003cpath d=\\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\\"/\\u003e\\u003cpolyline points=\\\"15 3 21 3 21 9\\\"/\\u003e\\u003cline x1=\\\"10\\\" y1=\\\"14\\\" x2=\\\"21\\\" y2=\\\"3\\\"/\\u003e\\u003c/svg\\u003e\\u003c/a\\u003e\\u003c/div\\u003e\\u003ch2\\u003eLes produits à tester\\u003c/h2\\u003e\\u003cp\\u003eLa gamme Sébium de Bioderma est dédiée aux \\u003cstrong\\u003epeaux mixtes à grasses\\u003c/strong\\u003e et aux problématiques d'imperfections. Trois références sont proposées au test :\\u003c/p\\u003e\\u003ch3\\u003eSébium Kerato+ Body — Spray triple action corps\\u003c/h3\\u003e\\nLa version corps du Kerato+, en spray pratique. Ce soin cible les imperfections du corps (dos, épaules, décolleté) avec une action triple : exfoliante, purifiante et apaisante.\\u003c/p\\u003e\\u003cp\\u003eIdéal pour traiter les petits boutons et points noirs sur les zones difficiles d'accès.\\u003c/p\\u003e\\u003ch3\\u003eSébium Kerato+ Cover — La version teintée du best-seller\\u003c/h3\\u003e\\nLe produit phare de la gamme dans une version \\u003cstrong\\u003eteintée\\u003c/strong\\u003e. Sébium Kerato+ est déjà reconnu pour son efficacité sur les imperfections — cette version couvre tout en traitant.\\u003c/p\\u003e\\u003cp\\u003eDouble action : correction des imperfections + teinte unifiante pour un teint naturel et mat.\\u003c/p\\u003e\\u003ch3\\u003eSébium Lotion — Lotion astringente purifiante\\u003c/h3\\u003e\\nUne lotion purifiante pour resserrer les pores et éliminer l'excès de sébum. À utiliser après le nettoyage pour parfaire la routine anti-imperfections.\\u003c/p\\u003e\\u003chr\\u003e\\u003cp\\u003e\\u003cdiv id=\\\"ezoic-pub-ad-placeholder-203\\\" class=\\\"ad-container\\\" style=\\\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\\\"\\u003e\\u003c/div\\u003e\\u003ch2\\u003eQui est concerné ?\\u003c/h2\\u003e\\u003cp\\u003eLa gamme Sébium s'adresse aux personnes qui ont :\\n\\u003cul\\u003e\\u003cli\\u003eUne \\u003cstrong\\u003epeau mixte à grasse\\u003c/strong\\u003e\\u003c/li\\u003e\\n\\u003cli\\u003eDes \\u003cstrong\\u003eimperfections\\u003c/strong\\u003e (boutons, points noirs)\\u003c/li\\u003e\\n\\u003cli\\u003eDes \\u003cstrong\\u003epores dilatés\\u003c/strong\\u003e\\u003c/li\\u003e\\n\\u003cli\\u003eUne \\u003cstrong\\u003etendance acnéique\\u003c/strong\\u003e\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\nSi vous vous reconnaissez dans ce profil, c'est le test parfait pour vous.\\u003c/p\\u003e\\u003chr\\u003e\\u003cp\\u003e\\u003cdiv class=\\\"cta-inline\\\"\\u003e\\u003ca href=\\\"https://www.bioderma.fr/test-produit-du-moment\\\" class=\\\"btn btn-primary btn-sm\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eCandidater au test Bioderma Sébium \\u003csvg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"13\\\" height=\\\"13\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"\\u003e\\u003cpath d=\\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\\"/\\u003e\\u003cpolyline points=\\\"15 3 21 3 21 9\\\"/\\u003e\\u003cline x1=\\\"10\\\" y1=\\\"14\\\" x2=\\\"21\\\" y2=\\\"3\\\"/\\u003e\\u003c/svg\\u003e\\u003c/a\\u003e\\u003c/div\\u003e\\u003ch2\\u003eComment participer ?\\u003c/h2\\u003e\\u003cp\\u003eLa participation est \\u003cstrong\\u003esimple et gratuite\\u003c/strong\\u003e :\\u003c/p\\u003e\\u003cp\\u003e1. \\u003cstrong\\u003eRendez-vous\\u003c/strong\\u003e sur \\u003ca href=\\\"https://www.bioderma.fr/test-produit-du-moment\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003ebioderma.fr/test-produit-du-moment\\u003c/a\\u003e\\n2. \\u003cstrong\\u003eRemplissez le formulaire\\u003c/strong\\u003e en ligne (quelques minutes)\\n3. \\u003cstrong\\u003eUn tirage au sort\\u003c/strong\\u003e désigne 300 testeuses parmi toutes les candidatures reçues\\n4. \\u003cstrong\\u003eLes sélectionnées reçoivent\\u003c/strong\\u003e le produit Sébium directement chez elles\\u003c/p\\u003e\\u003chr\\u003e\\u003ch2\\u003ePourquoi tenter sa chance ?\\u003c/h2\\u003e\\u003cp\\u003e\\u003cstrong\\u003eUne marque dermatologique reconnue\\u003c/strong\\u003e\\nBioderma, c'est la marque fondée sur le concept d'écobiologie — des soins qui respectent et renforcent la barrière cutanée. Recommandée par les dermatologues, elle est disponible en pharmacie et parapharmacie.\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003e300 places, c'est généreux\\u003c/strong\\u003e\\nBeaucoup de tests beauté sélectionnent 10, 20 ou 50 personnes. Ici, \\u003cstrong\\u003e300 testeuses\\u003c/strong\\u003e sont recherchées — vos chances de sélection sont vraiment élevées.\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003eDes produits à forte valeur\\u003c/strong\\u003e\\nLes soins Bioderma Sébium coûtent entre 10 et 20 € en pharmacie. Tester gratuitement 1 ou plusieurs produits de cette gamme représente une vraie économie.\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003eUn test utile si vous avez la peau grasse\\u003c/strong\\u003e\\nVous allez tester en conditions réelles, sur votre peau. Si ça fonctionne, vous aurez découvert votre nouveau soin préféré — et sinon, vous aurez au moins essayé gratuitement.\\u003c/p\\u003e\\u003chr\\u003e\\u003cp\\u003e\\u003cdiv id=\\\"ezoic-pub-ad-placeholder-206\\\" class=\\\"ad-container\\\" style=\\\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\\\"\\u003e\\u003c/div\\u003e\\u003ch2\\u003eLa gamme Sébium en bref\\u003c/h2\\u003e\\u003cdiv class=\\\"table-wrapper\\\"\\u003e\\u003ctable class=\\\"comparison-table\\\"\\u003e\\u003cthead\\u003e\\u003ctr\\u003e\\n\\u003cth\\u003eProduit\\u003c/th\\u003e\\u003cth\\u003ePour\\u003c/th\\u003e\\u003cth\\u003eAction principale\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\u003c/thead\\u003e\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003eSébium Kerato+ Body\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eImperfections corps\\u003c/td\\u003e\\n\\u003ctd\\u003eTriple action : exfolie, purifie, apaise\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003eSébium Kerato+ Cover\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eImperfections visage\\u003c/td\\u003e\\n\\u003ctd\\u003eTraite + couvre avec teinte naturelle\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003eSébium Lotion\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003ePeau grasse / pores\\u003c/td\\u003e\\n\\u003ctd\\u003eAstringente, purifiante, matifiante\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\u003c/table\\u003e\\u003c/div\\u003e\\u003chr\\u003e\\u003ch2\\u003eEn résumé\\u003c/h2\\u003e\\u003cdiv class=\\\"table-wrapper\\\"\\u003e\\u003ctable class=\\\"comparison-table\\\"\\u003e\\u003cthead\\u003e\\u003ctr\\u003e\\n\\u003cth\\u003e\\u003c/th\\u003e\\u003cth\\u003eDétails\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\u003c/thead\\u003e\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003eMarque\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eBioderma\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003eGamme\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eSébium — peaux mixtes, grasses, acnéiques\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003eProduits\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eKerato+ Body · Kerato+ Cover · Lotion\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003eNombre de testeuses\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e300 sélectionnées par tirage au sort\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003eParticipation\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eFormulaire gratuit en ligne\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003eMise à jour\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eFévrier 2026 — campagne active\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\u003c/table\\u003e\\u003c/div\\u003e\\n\\u003c/p\\u003e\"])</script><script>self.__next_f.push([1,\"13:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"article-content\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"$1f\\\"}}]}]\\n14:[\\\"$\\\",\\\"$L1d\\\",null,{}]\\n15:[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"textAlign\\\":\\\"center\\\",\\\"margin\\\":\\\"40px 0\\\",\\\"padding\\\":\\\"32px\\\",\\\"background\\\":\\\"linear-gradient(135deg, #FFF0F0 0%, #FFF8F0 100%)\\\",\\\"borderRadius\\\":\\\"16px\\\",\\\"border\\\":\\\"2px solid #FECDD3\\\"},\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"style\\\":{\\\"fontWeight\\\":800,\\\"fontSize\\\":\\\"1.2rem\\\",\\\"marginBottom\\\":\\\"16px\\\",\\\"color\\\":\\\"var(--foreground)\\\"},\\\"children\\\":\\\"Profiter de cette offre\\\"}],[\\