n Plan\\\"]}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"card-title\\\",\\\"children\\\":\\\"Toutes les aides pouvoir d'achat en 2026 : chèques, primes et bons plans de l'État\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"card-excerpt\\\",\\\"children\\\":\\\"Récapitulatif complet des aides pouvoir d'achat en 2026 : chèque énergie, prime activité, indemnité carburant, aide alimentaire et plus.\\\"}]]}]]}],[\\\"$\\\",\\\"a\\\",\\\"8-autobronzants-bien-notes-yuka-eviter-masque-grossesse-2026\\\",{\\\"href\\\":\\\"/article/8-autobronzants-bien-notes-yuka-eviter-masque-grossesse-2026\\\",\\\"className\\\":\\\"card\\\",\\\"style\\\":{\\\"textDecoration\\\":\\\"none\\\"},\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"position\\\":\\\"relative\\\",\\\"height\\\":\\\"160px\\\",\\\"overflow\\\":\\\"hidden\\\"},\\\"children\\\":[\\\"$\\\",\\\"$L1c\\\",null,{\\\"src\\\":\\\"/images/articles/autobronzants-yuka-masque-grossesse-2026.png\\\",\\\"alt\\\":\\\"8 autobronzants bien notés sur Yuka pour éviter le masque de grossesse\\\",\\\"fill\\\":true,\\\"style\\\":{\\\"objectFit\\\":\\\"cover\\\"},\\\"sizes\\\":\\\"33vw\\\"}]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"card-body\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"style\\\":{\\\"fontSize\\\":\\\"0.72rem\\\",\\\"fontWeight\\\":600,\\\"color\\\":\\\"var(--primary)\\\",\\\"textTransform\\\":\\\"uppercase\\\",\\\"letterSpacing\\\":\\\"0.5px\\\"},\\\"children\\\":[\\\"✨\\\",\\\" \\\",\\\"Beauté\\\"]}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"card-title\\\",\\\"children\\\":\\\"8 autobronzants bien notés sur Yuka qui évitent le masque de grossesse\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"card-excerpt\\\",\\\"children\\\":\\\"Sélection de 8 autobronzants bien notés sur Yuka, sûrs pendant la grossesse. Les Petits Prodiges, Aroma-Zone, Weleda, Garnier, SVR, Clarins. Dès 7,95€.\\\"}]]}]]}]]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"18:[\\\"$\\\",