"$L13\",\"$L14\",false]}],\"$L15\",\"$L16\",\"$L17\",\"$L18\"]}]}],false,\"$L19\"]\n1a:I[5500,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"Image\"]\n1b:I[96788,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\n1c:I[1586,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\n1e:I[67277,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\nf:[\"$\",\"p\",null,{\"className\":\"article-subtitle\",\"children\":\"Grand jeu Intermarché avec Président : gagnez 1 voyage nature 5000€, 4 séjours en cabane 2000€ ou 40 casques audio JBL 349,99€. Du 17 au 29 mars 2026.\"}]\n10:[\"$\",\"div\",null,{\"className\":\"article-hero-image\",\"style\":{\"background\":\"#fff\",\"borderRadius\":\"12px\",\"overflow\":\"hidden\",\"display\":\"flex\",\"justifyContent\":\"center\",\"alignItems\":\"center\",\"maxHeight\":\"450px\"},\"children\":[\"$\",\"$L1a\",null,{\"src\":\"/images/articles/concours-intermarche-president-voyage-casques-jbl-2026.svg\",\"alt\":\"Concours Intermarché Président voyage 5000€ séjours cabane casques JBL 2026\",\"width\":800,\"height\":450,\"style\":{\"width\":\"100%\",\"height\":\"100%\",\"objectFit\":\"contain\",\"maxHeight\":\"450px\"},\"priority\":true}]}]\n11:[\"$\",\"$L1b\",null,{}]\n12:[\"$\",\"$L1c\",null,{}]\n1d:T951,<p>\n# Concours Intermarché x Président : Voyage, Séjours et Casques JBL à Gagner</p><p><strong>Intermarché</strong> s'associe à <strong>Président</strong> pour un grand jeu concours avec des lots exceptionnels : un <strong>voyage de 5000€</strong>, des <strong>séjours en cabane</strong> et des <strong>casques audio JBL</strong> !</p><hr><h2>Les lots à gagner</h2><div class=\"table-wrapper\"><table class=\"comparison-table\"><thead><tr>\n<th>Lot</th><th>Quantité</th><th>Valeur unitaire</th>\n</tr></thead><tbody>\n<tr>\n<td><strong>Voyage \"Nature et Inclusion\"</strong></td>\n<td>1</td>\n<td><strong>5 000€</strong></td>\n</tr>\n<tr>\n<td><strong>Séjour en cabane</strong></td>\n<td>4</td>\n<td><strong>2 000€</strong></td>\n</tr>\n<tr>\n<td><strong>Casque audio JBL</strong></td>\n<td>40</td>\n<td><strong>349,99€</strong></td>\n</tr>\n</tbody></table></div><p><strong>Valeur totale des lots : plus de 27 000€ !</strong></p><h2>Comment participer</h2><p>1. <strong>Rendez-vous</strong> sur <a href=\"https://www.grandjeu.intermarche.com/\" target=\"_blank\" rel=\"nofollow sponsored noopener\">grandjeu.intermarche.com</a>\n2. <strong>Utilisez votre carte de fidélité</strong> Intermarché (jeu réservé aux porteurs de la carte)\n3. <strong>Jouez</strong> et tentez de remporter un des 45 lots !</p><p><div id=\"ezoic-pub-ad-placeholder-203\" class=\"ad-container\" style=\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\"></div><h2>Conditions</h2><ul><li><strong>Dates</strong> : du <strong>17 au 29 mars 2026</strong></li>\n<li><strong>Jeu avec obligation d'achat</strong></li>\n<li><strong>Carte de fidélité</strong> Intermarché requise</li>\n<li>Résidents France métropolitaine + Corse, majeurs</li>\n<li>Partenaire : Président</li>\n</ul>\n<h2>Récapitulatif</h2><div class=\"table-wrapper\"><table class=\"comparison-table\"><thead><tr>\n<th></th><th>Détails</th>\n</tr></thead><tbody>\n<tr>\n<td><strong>Organisateur</strong></td>\n<td>Intermarché x Président</td>\n</tr>\n<tr>\n<td><strong>Lot principal</strong></td>\n<td>Voyage \"Nature et Inclusion\" — 5 000€</td>\n</tr>\n<tr>\n<td><strong>Total lots</strong></td>\n<td>45 lots (1 voyage + 4 séjours + 40 casques JBL)</td>\n</tr>\n<tr>\n<td><strong>Fin du jeu</strong></td>\n<td>29 mars 2026</td>\n</tr>\n<tr>\n<td><strong>Condition</strong></td>\n<td>Carte de fidélité Intermarché + achat</td>\n</tr>\n</tbody></table></div>\n</p>13:[\"$\",\"div\",null,{\"className\":\"article-content\",\"children\":[\"$\",\"div\",null,{\"dangerouslySetInnerHTML\":{\"__html\"