2rem\",\"fontWeight\":600,\"color\":\"var(--primary)\",\"textTransform\":\"uppercase\",\"letterSpacing\":\"0.5px\"},\"children\":[\"✨\",\" \",\"Beauté\"]}],[\"$\",\"h3\",null,{\"className\":\"card-title\",\"children\":\"Luxeol : on fait le point sur la marque capillaire qui monte (et nos produits preferes)\"}],[\"$\",\"p\",null,{\"className\":\"card-excerpt\",\"children\":\"Notre avis sur les soins capillaires Luxeol. Shampoings sans parabenes, keratine, ortie, solutions anti-chute : on te dit tout sur cette marque francaise qui cartonne.\"}]]}]]}],[\"$\",\"a\",\"cocunat-routine-boucles-definies-promo-amazon-2026\",{\"href\":\"/article/cocunat-routine-boucles-definies-promo-amazon-2026\",\"className\":\"card\",\"style\":{\"textDecoration\":\"none\"},\"children\":[[\"$\",\"div\",null,{\"style\":{\"position\":\"relative\",\"height\":\"160px\",\"overflow\":\"hidden\"},\"children\":[\"$\",\"$L1c\",null,{\"src\":\"/images/articles/cocunat-routine-boucles-definies-2026.jpg\",\"alt\":\"Routine complète Cocunat boucles définies 7 produits et turban\",\"fill\":true,\"style\":{\"objectFit\":\"cover\"},\"sizes\":\"33vw\"}]}],[\"$\",\"div\",null,{\"className\":\"card-body\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"fontSize\":\"0.72rem\",\"fontWeight\":600,\"color\":\"var(--primary)\",\"textTransform\":\"uppercase\",\"letterSpacing\":\"0.5px\"},\"children\":[\"🏷️\",\" \",\"Bon Plan\"]}],[\"$\",\"h3\",null,{\"className\":\"card-title\",\"children\":\"Cocunat Routine Boucles Définies à 121€ au lieu de 187€ : -35% sur Amazon\"}],[\"$\",\"p\",null,{\"className\":\"card-excerpt\",\"children\":\"La routine complète Cocunat pour cheveux bouclés à -35% sur Amazon. 7 produits + turban, sans sulfate ni silicone. Avant/après bluffant.\"}]]}]]}]]}]]}]\n18:[\"$\",\"nav\",null,{\"style\":{\"margin\":\"40px 0\",\"padding\":\"24px\",\"background\":\"var(--muted, #f3f4f6)\",\"borderRadius\":\"16px\"},\"children\":[[\"$\",\"h3\",null,{\"style\":{\"fontSize\":\"1rem\",\"marginBottom\":\"12px\"},\"children\":\"Explorer par catégorie\"}],[\"$\",\"div\",null,{\"style\":{\"display\":\"flex\",\"flexWrap\":\"wrap\",\"gap\":\"8px\"},\"children\":[[\"$\",\"a\",\"bon-plan\",{\"href\":\"/categorie/bon-plan\",\"style\":{\"padding\":\"6px 14px\",\"borderRadius\":\"999px\",\"background\":\"white\",\"fontSize\":\"0.82rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500,\"border\":\"1px solid var(--border, #e5e7eb)\"},\"children\":[\"🏷️\",\" \",\"Bons Plans\"]}],[\"$\",\"a\",\"test-gratuit\",{\"href\":\"/categorie/test-gratuit\",\"style\":{\"padding\":\"6px 14px\",\"borderRadius\":\"999px\",\"background\":\"white\",\"fontSize\":\"0.82rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500,\"border\":\"1px solid var(--border, #e5e7eb)\"},\"children\":[\"🎁\",\" \",\"Tests Gratuits\"]}],[\"$\",\"a\",\"concours\",{\"href\":\"/categorie/concours\",\"style\":{\"padding\":\"6px 14px\",\"borderRadius\":\"999px\",\"background\":\"white\",\"fontSize\":\"0.82rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500,\"border\":\"1px solid var(--border, #e5e7eb)\"},\"children\":[\"🏆\",\" \",\"Concours\"]}],[\"$\",\"a\",\"box-beaute\",{\"href\":\"/categorie/box-beaute\",\"style\":{\"padding\":\"6px 14px\",\"borderRadius\":\"999px\",\"background\":\"white\",\"fontSize\":\"0.82rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500,\"border\":\"1px solid var(--border, #e5e7eb)\"},\"children\":[\"💄\",\" \",\"Box Beauté\"]}],[\"$\",\"a\",\"code-promo\",{\"href\":\"/categorie/code-promo\",\"style\":{\"padding\":\"6px 14px\",\"borderRadius\":\"999px\",\"background\":\"white\",\"fontSize\":\"0.82rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500,\"border\":\"1px solid var(--border, #e5e7eb)\"},\"children\":[\"🎟️\",\" \",\"Codes Promo\"]}]]}]]}]\n19:[\"$\",\"div\",null,{\"style\":{\"maxWidth\":\"780px\",\"margin\":\"0 auto\