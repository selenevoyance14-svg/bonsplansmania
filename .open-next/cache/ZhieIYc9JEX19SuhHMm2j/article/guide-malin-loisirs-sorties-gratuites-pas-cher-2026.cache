\"},\"sizes\":\"33vw\"}]}],[\"$\",\"div\",null,{\"className\":\"card-body\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"fontSize\":\"0.72rem\",\"fontWeight\":600,\"color\":\"var(--primary)\",\"textTransform\":\"uppercase\",\"letterSpacing\":\"0.5px\"},\"children\":[\"🏷️\",\" \",\"Bon Plan\"]}],[\"$\",\"h3\",null,{\"className\":\"card-title\",\"children\":\"Guide Malin Beaute : Soins Naturels Efficaces a Moins de 5€\"}],[\"$\",\"p\",null,{\"className\":\"card-excerpt\",\"children\":\"Remplace tes cosmetiques par des soins naturels pas chers et efficaces. Huiles vegetales, beurre de karite, accessoires reutilisables. 300€ d'economie/an.\"}]]}]]}],[\"$\",\"a\",\"mafamillezen-concours-13-jeux-societe-famille-2026\",{\"href\":\"/article/mafamillezen-concours-13-jeux-societe-famille-2026\",\"className\":\"card\",\"style\":{\"textDecoration\":\"none\"},\"children\":[[\"$\",\"div\",null,{\"style\":{\"position\":\"relative\",\"height\":\"160px\",\"overflow\":\"hidden\"},\"children\":[\"$\",\"$L1c\",null,{\"src\":\"/images/articles/mafamillezen-concours-13-jeux-societe-2026.png\",\"alt\":\"Concours Mafamillezen 13 jeux de societe famille a gagner\",\"fill\":true,\"style\":{\"objectFit\":\"cover\"},\"sizes\":\"33vw\"}]}],[\"$\",\"div\",null,{\"className\":\"card-body\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"fontSize\":\"0.72rem\",\"fontWeight\":600,\"color\":\"var(--primary)\",\"textTransform\":\"uppercase\",\"letterSpacing\":\"0.5px\"},\"children\":[\"🏆\",\" \",\"Concours\"]}],[\"$\",\"h3\",null,{\"className\":\"card-title\",\"children\":\"Mafamillezen : 13 jeux de societe a gagner (Festival de Cannes 2026)\"}],[\"$\",\"p\",null,{\"className\":\"card-excerpt\",\"children\":\"Jeu concours gratuit Mafamillezen : 13 jeux de societe pour toute la famille a gagner, dont des nomines au Festival des jeux de Cannes 2026. Tirage le 4 mai.\"}]]}]]}]]}]]}]\n18:[\"$\",\"nav\",null,{\"style\":{\"margin\":\"40px 0\",\"padding\":\"24px\",\"background\":\"var(--muted, #f3f4f6)