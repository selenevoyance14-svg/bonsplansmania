a\",\"$L1b\"]\n1c:I[5500,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"Image\"]\n1d:I[96788,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\n1e:I[1586,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\n20:I[67277,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\nf:[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":13,\"height\":13,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-external-link\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1q9fwt\",{\"d\":\"M15 3h6v6\"}],[\"$\",\"path\",\"gplh6r\",{\"d\":\"M10 14 21 3\"}],[\"$\",\"path\",\"a6xqqp\",{\"d\":\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"}],\"$undefined\"]}]\n10:[\"$\",\"div\",null,{\"className\":\"article-hero-image\",\"style\":{\"background\":\"#fff\",\"borderRadius\":\"12px\",\"overflow\":\"hidden\",\"display\":\"flex\",\"justifyContent\":\"center\",\"alignItems\":\"center\",\"maxHeight\":\"450px\"},\"children\":[\"$\",\"$L1c\",null,{\"src\":\"/images/articles/m6-amour-dans-le-pre-mccain-concours-2026.svg\",\"alt\":\"Jeu concours M6 L'Amour est dans le Pré x McCain 2026\",\"width\":800,\"height\":450,\"style\":{\"width\":\"100%\",\"height\":\"100%\",\"objectFit\":\"contain\",\"maxHeight\":\"450px\"},\"priority\":true}]}]\n11:[\"$\",\"$L1d\",null,{}]\n12:[\"$\",\"$L1e\",null,{}]\n1f:Tbf1,<p>\n<strong>M6</strong> s'associe à <strong>McCain</strong> dans le cadre de l'émission <strong>L'Amour est dans le Pré</strong> pour un grand jeu concours avec <strong>50 Wonderpass Wonderbox</strong> d'une valeur de <strong>159€ chacun</strong> à gagner !</p><h2>Les lots à gagner</h2><ul><li><strong>50 Wonderpass Wonderbox</strong> d'une valeur de <strong>159€</strong> chacun</li>\n<li>Dotation totale : <strong>7 950€</strong></li>\n</ul>\nUn Wonderpass vous donne accès à <strong>des milliers d'expériences</strong> au choix :\n<ul><li><strong>Séjours</strong> — week-ends romantiques, nuits insolites</li>\n<li><strong>Spa et bien-être</strong> — massages, soins, hammams</li>\n<li><strong>Gastronomie</strong> — restaurants étoilés, ateliers cuisine</li>\n<li><strong>Aventure</strong> — saut en parachute, vol en hélicoptère, karting</li>\n</ul>\n<div class=\"cta-inline\"><a href=\"https://www.m6.fr/jeux-concours/l-amour-est-dans-le-pre-et-mc-cain\" class=\"btn btn-primary btn-sm\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Participer au jeu M6 x McCain <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/><polyline points=\"15 3 21 3 21 9\"/><line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\"/></svg></a></div><h2>Comment participer ?</h2><p>1. Rendez-vous sur la page du jeu sur <strong>m6.fr</strong>\n2. Remplissez le formulaire de participation\n3. Validez votre inscription\n4. <strong>50 gagnants</strong> seront tirés au sort</p><p>La participation est <strong>gratuite</strong>.</p><p><div id=\"ezoic-pub-ad-placeholder-203\" class=\"ad-container\" style=\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\"></div><h2>L'Amour est dans le Pré saison 21</h2><p>La saison 21 de L'Amour est dans le Pré est actuellement diffusée sur M6 avec <strong>14 agriculteurs</strong> à la recherche de l'amour. L'émission présentée par Karine Le Marchand est l'un des programmes les plus populaires de la chaîne.</p><p><div class=\"cta-inline\"><a href=\"https://www.m6.fr/jeux-concours/l-amour-est-dans-le-pre-et-mc-cain\" class=\"btn btn-primary btn-sm\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Participer au jeu M6 x McCain <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/><polyline points=\"15 3 21 3 21 9\"/><line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\"/></svg></a></div><h2>Pourquoi participer ?</h2><ul><li><strong>50 gagnants</strong> — beaucoup de chances</li>\n<li><strong>159€ par lot</strong> — une belle valeur</li>\n<li><strong>Wonderbox</strong> — des milliers d'expériences au choix</li>\n<li><strong>Gratuit</strong> — participation sans achat</li>\n<li><strong>M6</strong> — jeu officiel de la chaîne</li>\n</ul>13:[\"$\",\"div\",null,{\"className\":\"article-content\",\"children\":[\"$\",\"div\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"$1f\"}}]}]\n14:[\"$\",\"$L1d\",null,{}]\n15:[\"$\",\"div\",null,{\"style\":{\"textAlign\":\"center\",\"margin\":\"40px 0\",\"padding\":\"32px\",\"background\":\"linear-gradient(135deg, #FFF0F0 0%, #FFF8F0 100%)\",\"borderRadius\":\"16px\",\"border\":\"2px solid #FECDD3\"},\"children\":[[\"$\",\"p\",null,{\"style\":{\"fontWeight\":800,\"fontSize\":\"1.2rem\",\"marginBottom\":\"16px\",\"color\":\"var(--foreground)\"},\"children\":\"Profiter de cette offre\"}],[\"$\",\"a\",null,{\"href\":\"https://www.m6.fr/jeux-concours/l-amour-est-dans-le-pre-et-mc-cain\",\"className\":\"btn btn-primary\",\"target\":\"_blank\",\"rel\":\"nofollow sponsored noopener\",\"style\":{\"padding\":\"14px 32px\",\"fontSize\":\"1rem\"},\"children\":[\"Participer au jeu M6 x McCain\",\" \",[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":15,\"height\":15,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-external-l