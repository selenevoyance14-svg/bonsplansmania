\\":[\\\"🏆\\\",\\\" \\\",\\\"Concours\\\"]}],[\\\"$\\\",\\\"a\\\",\\\"box-beaute\\\",{\\\"href\\\":\\\"/categorie/box-beaute\\\",\\\"style\\\":{\\\"padding\\\":\\\"6px 14px\\\",\\\"borderRadius\\\":\\\"999px\\\",\\\"background\\\":\\\"white\\\",\\\"fontSize\\\":\\\"0.82rem\\\",\\\"color\\\":\\\"var(--text, #374151)\\\",\\\"textDecoration\\\":\\\"none\\\",\\\"fontWeight\\\":500,\\\"border\\\":\\\"1px solid var(--border, #e5e7eb)\\\"},\\\"children\\\":[\\\"💄\\\",\\\" \\\",\\\"Box Beauté\\\"]}],[\\\"$\\\",\\\"a\\\",\\\"code-promo\\\",{\\\"href\\\":\\\"/categorie/code-promo\\\",\\\"style\\\":{\\\"padding\\\":\\\"6px 14px\\\",\\\"borderRadius\\\":\\\"999px\\\",\\\"background\\\":\\\"white\\\",\\\"fontSize\\\":\\\"0.82rem\\\",\\\"color\\\":\\\"var(--text, #374151)\\\",\\\"textDecoration\\\":\\\"none\\\",\\\"fontWeight\\\":500,\\\"border\\\":\\\"1px solid var(--border, #e5e7eb)\\\"},\\\"children\\\":[\\\"🎟️\\\",\\\" \\\",\\\"Codes Promo\\\"]}],[\\\"$\\\",\\\"a\\\",\\\"beaute\\\",{\\\"href\\\":\\\"/categorie/beaute\\\",\\\"style\\\":{\\\"padding\\\":\\\"6px 14px\\\",\\\"borderRadius\\\":\\\"999px\\\",\\\"background\\\":\\\"white\\\",\\\"fontSize\\\":\\\"0.82rem\\\",\\\"color\\\":\\\"var(--text, #374151)\\\",\\\"textDecoration\\\":\\\"none\\\",\\\"fontWeight\\\":500,\\\"border\\\":\\\"1px solid var(--border, #e5e7eb)\\\"},\\\"children\\\":[\\\"✨\\\",\\\" \\\",\\\"Beauté\\\"]}]]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"19:[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"maxWidth\\\":\\\"780px\\\",\\\"margin\\\":\\\"0 auto\\\"},\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"display\\\":\\\"flex\\\",\\\"alignItems\\\":\\\"center\\\",\\\"gap\\\":\\\"12px\\\",\\\"flexWrap\\\":\\\"wrap\\\",\\\"margin\\\":\\\"32px 0 16px\\\"},\\\"children\\\":[[\\\"$\\\",\\\"$L20\\\",null,{\\\"slug\\\":\\\"parfums-sol-de-janeiro-secret-faire-tenir-odeur-toute-journee\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"style\\\":{\\\"fontSize\\\":\\\"0.85rem\\\",\\\"color\\\":\\\"va