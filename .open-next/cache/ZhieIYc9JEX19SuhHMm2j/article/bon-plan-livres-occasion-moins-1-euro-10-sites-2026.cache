icle/la-belle-adresse-remboursement-40-pourcent-schwarzkopf-beaute-2026\",\"className\":\"card\",\"style\":{\"textDecoration\":\"none\"},\"children\":[[\"$\",\"div\",null,{\"style\":{\"position\":\"relative\",\"height\":\"160px\",\"overflow\":\"hidden\"},\"children\":[\"$\",\"$L1e\",null,{\"src\":\"/images/articles/la-belle-adresse-schwarzkopf-40-pourcent-rembourse-2026.png\",\"alt\":\"La Belle Adresse 40% remboursés sur Schwarzkopf Gliss Palette\",\"fill\":true,\"style\":{\"objectFit\":\"cover\"},\"sizes\":\"33vw\"}]}],[\"$\",\"div\",null,{\"className\":\"card-body\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"fontSize\":\"0.72rem\",\"fontWeight\":600,\"color\":\"var(--primary)\",\"textTransform\":\"uppercase\",\"letterSpacing\":\"0.5px\"},\"children\":[\"🏷️\",\" \",\"Bon Plan\"]}],[\"$\",\"h3\",null,{\"className\":\"card-title\",\"children\":\"La Belle Adresse : 40% remboursés sur Schwarzkopf et offres beauté du moment\"}],[\"$\",\"p\",null,{\"className\":\"card-excerpt\",\"children\":\"Profitez de 40% remboursés sur les produits Schwarzkopf, Palette et Gliss via La Belle Adresse. Coupons et remboursements sur ticket de caisse.\"}]]}]]}],[\"$\",\"a\",\"recyclivre-colis-mystere-50-livres-gratuit-concours-2026\",{\"href\":\"/article/recyclivre-colis-mystere-50-livres-gratuit-concours-2026\",\"className\":\"card\",\"style\":{\"textDecoration\":\"none\"},\"children\":[[\"$\",\"div\",null,{\"style\":{\"position\":\"relative\",\"height\":\"160px\",\"overflow\":\"hidden\"},\"children\":[\"$\",\"$L1e\",null,{\"src\":\"/images/articles/recyclivre-colis-mystere-50-livres-concours-2026.png\",\"alt\":\"RecycLivre colis mystere 50 livres a gagner\",\"fill\":true,\"style\":{\"objectFit\":\"cover\"},\"sizes\":\"33vw\"}]}],[\"$\",\"div\",null,{\"className\":\"card-body\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"fontSize\":\"0.72rem\",\"fontWeight\":600,\"color\":\"var(--primary)\",\"textTransform\":\"uppercase\",\"letterSpacing\":\"0.5px\"},\"children\":[\"🏆\",\" \",\"Concours\"]}],[\"$\",\"h3\",null,{\"className\":\"card-title\",\"children\":\"RecycLivre : gagnez un colis mystere de 50 livres\"}],[\"$\",\"p\",null,{\"className\":\"card-excerpt\",\"children\":\"Jeu concours gratuit RecycLivre : tentez de remporter un colis mystere contenant 50 livres soigneusement selectionnes. Inscription par email jusqu'au 22 avril 2026.\"}]]}]]}]]}]]}]\n1a:[\"$\",\"nav\",null,{\"style\":{\"margin\":\"40px 0\",\"padding\":\"24px\",\"background\":\"var(--muted, #f3f4f6)\",\"borderRadius\":\"16px\"},\"children\":[[\"$\",\"h3\",null,{\"style\":{\"fontSize\":\"1rem\",\"marginBottom\":\"12px\"},\"children\":\"Explorer par catégorie\"}],[\"$\",\"div\",null,{\"style\":{\"display\":\"flex\",\"flexWrap\":\"wrap\",\"gap\":\"8px\"},\"children\":[[\"$\",\"a\",\"test-gratuit\",{\"href\":\"/categorie/test-gratuit\",\"style\":{\"padding\":\"6px 14px\",\"borderRadius\":\"999px\",\"background\":\"white\",\"fontSize\":\"0.82rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500,\"border\":\"1px solid var(--border, #e5e7eb)\"},\"children\":[\"🎁\",\" \",\"Tests Gratuits\"]}],[\"$\",\"a\",\"concours\",{\"href\":\"/categorie/concours\",\"style\":{\"padding\":\"6px 14px\",\"borderRadius\":\"999px\",\"background\":\"white\",\"fontSize\":\"0.82rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500,\"border\":\"1px solid var(--border, #e5e7eb)\"},\"children\":[\"🏆\",\" \",\"Concours\"]}],[\"$\",\"a\",\"box-beaute\",{\"href\":\"/categorie/box-beaute\",\"style\":{\"padding\":\"6px 14px\",\"borderRadius\":\"999px\",\"background\":\"white\",\"fontSize\":\"0.82rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500,\"border\":\"1px solid var(--border, #e5e7eb)\"},\"children\":[\"💄\",\" \",\"Box Beauté\"]}],[\"$\",\"a\",\"code-promo\",{\"href\":\"/categorie/code-promo\",\"style\":{\"padding\":\"6px 14px\",\"borderRadius\":\"999px\",\"background\":\"white\",\"fontSize\":\"0.82re