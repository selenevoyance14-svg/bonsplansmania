mage\",\"content\":\"http://localhost:3000/images/articles/adopt-brumes-corps-cheveux-moins-15-euros-remplacer-parfum-ete-2026.svg\"}],[\"$\",\"link\",\"14\",{\"rel\":\"icon\",\"href\":\"/favicon.svg\",\"type\":\"image/svg+xml\"}],[\"$\",\"link\",\"15\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"sizes\":\"32x32\"}],[\"$\",\"link\",\"16\",{\"rel\":\"apple-touch-icon\",\"href\":\"/apple-touch-icon.png\"}],[\"$\",\"$L22\",\"17\",{}]]\n","/article/$d$slug/__PAGE__":"1:\"$Sreact.fragment\"\n2:I[83608,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\n12:I[5500,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"Image\"]\n13:I[96788,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\n14:I[1586,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\n16:I[67277,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\n18:I[97367,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/d2be314c3ece3fbe.js\"],\"OutletBoundary\"]\n19:\"$Sreact.suspense\"\n0:{\"buildId\":\"ZhieIYc9JEX19SuhHMm2j\",\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"Article\\\",\\\"headline\\\":\\\"Adopt : ces brumes corps et cheveux à moins de 15€ vont remplacer votre parfum cet été\\\",\\\"description\\\":\\\"Les nouvelles brumes Adopt corps et cheveux à 14,95€ : 9 senteurs, formules vegan, fabrication française. Notre avis sur l'alternative parfum de l'été 2026.\\\",\\\"datePublished\\\":\\\"2026-04-04\\\",\\\"dateModified\\\":\\\"2026-04-04\\\",\\\"image\\\":\\\"https://bonsplansmania.fr/images/articles/adopt-brumes-corps-cheveux-moins-15-euros-remplacer-parfum-ete-2026.svg\\\",\\\"