c/chunks/6e48aeeec84550f8.js\\\"],\\\"default\\\"]\\n20:I[67277,[\\\"/_next/static/chunks/cf200c391baea40a.js\\\",\\\"/_next/static/chunks/6e48aeeec84550f8.js\\\"],\\\"default\\\"]\\nf:[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":13,\\\"height\\\":13,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-external-link\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":[[\\\"$\\\",\\\"path\\\",\\\"1q9fwt\\\",{\\\"d\\\":\\\"M15 3h6v6\\\"}],[\\\"$\\\",\\\"path\\\",\\\"gplh6r\\\",{\\\"d\\\":\\\"M10 14 21 3\\\"}],[\\\"$\\\",\\\"path\\\",\\\"a6xqqp\\\",{\\\"d\\\":\\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\\"}],\\\"$undefined\\\"]}]\\n10:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"article-hero-image\\\",\\\"style\\\":{\\\"background\\\":\\\"#fff\\\",\\\"borderRadius\\\":\\\"12px\\\",\\\"overflow\\\":\\\"hidden\\\",\\\"display\\\":\\\"flex\\\",\\\"justifyContent\\\":\\\"center\\\",\\\"alignItems\\\":\\\"center\\\",\\\"maxHeight\\\":\\\"450px\\\"},\\\"children\\\":[\\\"$\\\",\\\"$L1c\\\",null,{\\\"src\\\":\\\"/images/articles/thalgo-spiruline-boost-detox-eclat-printemps-routine-2026.svg\\\",\\\"alt\\\":\\\"Thalgo Spiruline Boost routine détox éclat printemps\\\",\\\"width\\\":800,\\\"height\\\":450,\\\"style\\\":{\\\"width\\\":\\\"100%\\\",\\\"height\\\":\\\"100%\\\",\\\"objectFit\\\":\\\"contain\\\",\\\"maxHeight\\\":\\\"450px\\\"},\\\"priority\\\":true}]}]\\n11:[\\\"$\\\",\\\"$L1d\\\",null,{}]\\n12:[\\\"$\\\",\\\"$L1e\\\",null,{}]\\n1f:T1479,\"])</script><script>self.__next_f.push([1,\"\\u003cp\\u003e\\n\\u003ch2\\u003eThalgo Spiruline Boost : détoxifier sa peau après l'hiver\\u003c/h2\\u003e\\u003cp\\u003eLa fatigue, le stress, les toxines accumulées durant l'hiver marquent notre visage. La peau perd sa vitalité, son éclat et sa fraîcheur. Avec l'arrivée du printemps, \\u003cstrong\\u003eThalgo\\u003c/strong\\u003e propose une routine détox complète avec sa gamme \\u003cstrong\\u003eSpiruline Boost\\u003c/strong\\u003e pour repartir sur de bonnes bases : reminéraliser, stimuler le renouvellement cellulaire et booster les mécanismes antioxydants.\\u003c/p\\u003e\\u003chr\\u003e\\u003cp\\u003e\\u003cdiv class=\\\"cta-inline\\\"\\u003e\\u003ca href=\\\"https://fnty.co/c/r-cMrFgmkP\\\" class=\\\"btn btn-primary btn-sm\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eDécouvrir la gamme Spiruline Boost \\u003csvg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"13\\\" height=\\\"13\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"\\u003e\\u003cpath d=\\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\\"/\\u003e\\u003cpolyline points=\\\"15 3 21 3 21 9\\\"/\\u003e\\u003cline x1=\\\"10\\\" y1=\\\"14\\\" x2=\\\"21\\\" y2=\\\"3\\\"/\\u003e\\u003c/svg\\u003e\\u003c/a\\u003e\\u003c/div\\u003e\\u003ch2\\u003eLes 3 produits de la routine\\u003c/h2\\u003e\\u003ch3\\u003eShooter Détox et Énergie — cure de 7 jours\\u003c/h3\\u003e\\u003cp\\u003eLe \\u003cstrong\\u003eSpiruline Boost Shooter Détox et Énergie\\u003c/strong\\u003e agit de l'intérieur. C'est une boisson énergisante et anti-radicalaire à base de :\\u003c/p\\u003e\\u003cul\\u003e\\u003cli\\u003e\\u003cstrong\\u003eSpiruline bio\\u003c/strong\\u003e — superfood énergisante\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eMagnésium marin\\u003c/strong\\u003e — anti-fatigue\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eVitamine C\\u003c/strong\\u003e — coup de fouet antioxydant\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eChlorelle bio\\u003c/strong\\u003e — aide à éliminer les toxines et les métaux lourds\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\nEn cure de 7 jours, un stick par jour. C'est le premier geste de la détox pour nettoyer l'organisme de l'intérieur avant de travailler la peau.\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003eFormat\\u003c/strong\\u003e : boîte de 7 sticks\\u003c/p\\u003e\\u003chr\\u003e\\u003ch3\\u003eMasque Pro Peeling Éclat — 10 minutes chrono\\u003c/h3\\u003e\\u003cp\\u003eLe \\u003cstrong\\u003eSpiruline Boost Masque Pro Peeling Éclat\\u003c/strong\\u003e est un masque-pinceau d'inspiration professionnelle. Il contient :\\u003c/p\\u003e\\u003cul\\u003e\\u003cli\\u003e\\u003cstrong\\u003eFerments Acides d'Algues Micro-Éclatées\\u003c/strong\\u003e + \\u003cstrong\\u003eAHA/PHA à 10%\\u003c/strong\\u003e — action peeling-like\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eSpiruline\\u003c/strong\\u003e — énergisante\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eMagnésium marin\\u003c/strong\\u003e + \\u003cstrong\\u003eAcide Hyaluronique\\u003c/strong\\u003e — défatiguent et défroissent les traits\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\nEn 10 minutes, il stimule le renouvellement cellulaire pour un \\u003cstrong\\u003eeffet peau neuve immédiat\\u003c/strong\\u003e. Les peaux ternes, fatiguées et marquées retrouvent de la lumière.\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003eFormat\\u003c/strong\\u003e : tube pinceau 50 ml\\u003c/p\\u003e\\u003chr\\u003e\\u003ch3\\u003eSérum Intensif Énergisant — résultats en 14 jours\\u003c/h3\\u003e\\u003cp\\u003eLe \\u003cstrong\\u003eSpiruline Boost Sérum Intensif Énergisant\\u003c/strong\\u003e est le soin le plus concentré de la gamme :\\u003c/p\\u003e\\u003cul\\u003e\\u003cli\\u003e\\u003cstrong\\u003eSpiruline\\u003c/strong\\u003e boostée en \\u003cstrong\\u003eMagnésium marin\\u003c/strong\\u003e\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eAcide Hyaluronique\\u003c/strong\\u003e — lisse les rides\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eFerment des abysses océaniques\\u003c/strong\\u003e — bouclier anti-radicalaire\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\nEn 14 jours d'utilisation, la peau est lissée, détoxifiée, l'éclat du teint est ravivé et les marques de fatigue estompées.\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003eFormat\\u003c/strong\\u003e : tube pompe 30 ml\\u003c/p\\u003e\\u003chr\\u003e\\u003cp\\u003e\\u003cdiv id=\\\"ezoic-pub-ad-placeholder-203\\\" class=\\\"ad-container\\\" style=\\\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\\\"\\u003e\\u003c/div\\u003e\\u003ch2\\u003eLa routine complète\\u003c/h2\\u003e\\u003cdiv class=\\\"table-wrapper\\\"\\u003e\\u003ctable class=\\\"comparison-table\\\"\\u003e\\u003cthead\\u003e\\u003ctr\\u003e\\n\\u003cth\\u003eÉtape\\u003c/th\\u003e\\u003cth\\u003eProduit\\u003c/th\\u003e\\u003cth\\u003eDurée\\u003c/th\\u003e\\u003cth\\u003eAction\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\u003c/thead\\u003e\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e1. Intérieur\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eShooter Détox\\u003c/td\\u003e\\n\\u003ctd\\u003eCure 7 jours\\u003c/td\\u003e\\n\\u003ctd\\u003eÉlimine les toxines, énergise l'organisme\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e2. Peeling\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eMasque Éclat\\u003c/td\\u003e\\n\\u003ctd\\u003e10 min\\u003c/td\\u003e\\n\\u003ctd\\u003eRenouvellement cellulaire, éclat immédiat\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e3. Soin quotidien\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eSérum Énergisant\\u003c/td\\u003e\\n\\u003ctd\\u003e14 jours\\u003c/td\\u003e\\n\\u003ctd\\u003eLisse, détoxifie, ravive l'éclat\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\u003c/table\\u003e\\u003c/div\\u003e\\u003cp\\u003eOn peut utiliser les trois produits en synergie ou individuellement selon ses besoins. Le shooter pour une détox rapide, le masque pour un coup d'éclat avant un événement, le sérum pour un traitement de fond.\\u003c/p\\u003e\\u003chr\\u003e\\u003cp\\u003e\\u003cdiv class=\\\"cta-inline\\\"\\u003e\\u003ca href=\\\"https://fnty.co/c/r-cMrFgmkP\\\" class=\\\"btn btn-primary btn-sm\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eDécouvrir la gamme Spiruline Boost \\u003csvg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"13\\\" height=\\\"13\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"\\u003e\\u003cpath d=\\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\\"/\\u003e\\u003cpolyline points=\\\"15 3 21 3 21 9\\\"/\\u003e\\u003cline x1=\\\"10\\\" y1=\\\"14\\\" x2=\\\"21\\\" y2=\\\"3\\\"/\\u003e\\u003c/svg\\u003e\\u003c/a\\u003e\\u003c/div\\u003e\\u003ch2\\u003eNotre avis\\u003c/h2\\u003e\\u003cp\\u003eThalgo est une marque de thalassothérapie reconnue depuis des décennies — leurs formules à base d'actifs marins sont parmi les plus efficaces du marché. La gamme Spiruline Boost coche toutes les cases d'une bonne routine de printemps : on détoxifie de l'intérieur avec le shooter, on fait peau neuve avec le masque peeling, et on traite en profondeur avec le sérum. Les 10% d'AHA/PHA dans le masque c'est une concentration sérieuse — on est sur du résultat visible dès la première utilisation. C'est le bon moment pour remettre sa peau en forme après l'hiver.\\n\\u003c/p\\u003e\"])</script><script>self.__next_f.push([1,\"13:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"article-content\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"$1f\\\"}}]}]\\n14:[\\\"$\\\",\\\"$L1d\\\",null,{}]\\n15:[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"textAlign\\\":\\\"center\\\",\\\"margin\\\":\\\"40px 0\\\",\\\"padding\\\":\\\"32px\\\",\\\"background\\\":\\\"linear-gradient(135deg, #FFF0F0 0%, #FFF8F0 100%)\\\",\\\"bor