-articles\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"children\\\":\\\"A lire aussi\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"articles-grid\\\",\\\"style\\\":{\\\"gridTemplateColumns\\\":\\\"repeat(auto-fit, minmax(280px, 1fr))\\\"},\\\"children\\\":[[\\\"$\\\",\\\"a\\\",\\\"lancome-echantillon-gratuit-la-nuit-tresor-rouge-drama-2026\\\",{\\\"href\\\":\\\"/article/lancome-echantillon-gratuit-la-nuit-tresor-rouge-drama-2026\\\",\\\"className\\\":\\\"card\\\",\\\"style\\\":{\\\"textDecoration\\\":\\\"none\\\"},\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"position\\\":\\\"relative\\\",\\\"height\\\":\\\"160px\\\",\\\"overflow\\\":\\\"hidden\\\"},\\\"children\\\":[\\\"$\\\",\\\"$L1c\\\",null,{\\\"src\\\":\\\"/images/articles/lancome-echantillon-gratuit-la-nuit-tresor-rouge-drama-2026.svg\\\",\\\"alt\\\":\\\"Echantillon gratuit parfum La Nuit Tresor Rouge Drama Lancome 2026\\\",\\\"fill\\\":true,\\\"style\\\":{\\\"objectFit\\\":\\\"cover\\\"},\\\"sizes\\\":\\\"33vw\\\"}]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"card-body\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"style\\\":{\\\"fontSize\\\":\\\"0.72rem\\\",\\\"fontWeight\\\":600,\\\"color\\\":\\\"var(--primary)\\\",\\\"textTransform\\\":\\\"uppercase\\\",\\\"letterSpacing\\\":\\\"0.5px\\\"},\\\"children\\\":[\\\"🎁\\\",\\\" \\\",\\\"Test Gratuit\\\"]}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"card-title\\\",\\\"children\\\":\\\"Lancome : echantillon gratuit du parfum La Nuit Tresor Rouge Drama\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"card-excerpt\\\",\\\"children\\\":\\\"Tentez de recevoir un echantillon gratuit du parfum La Nuit Tresor Rouge Drama de Lancome. Formulaire simple, livraison a domicile.\\\"}]]}]]}],[\\\"$\\\",\\\"a\\\",\\\"nubiance-test-gratuit-creme-eclat-anti-taches-ambassadrice-2026\\\",{\\\"href\\\":\\\"/article/nubiance-test-gratuit-creme-eclat-anti-taches-ambassadrice-2026\\\",\\\"className\\\":\\\"card\\\",\\