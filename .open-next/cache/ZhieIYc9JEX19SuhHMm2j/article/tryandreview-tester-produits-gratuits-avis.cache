\",\"avis-consommateur\",{\"href\":\"/marque/avis-consommateur\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"avis-consommateur\"}]\na:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n25:I[27201,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/d2be314c3ece3fbe.js\"],\"IconMark\"]\n8:null\nc:[[\"$\",\"title\",\"0\",{\"children\":\"Try and Review : Testez des Produits Gratuits Beauté, Foo...\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Try and Review permet de tester gratuitement +30 000 produits (beauté, food, maison, électronique). Inscription gratuite, produits reçus chez vous.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"manifest\",\"href\":\"/manifest.json\",\"crossOrigin\":\"$undefined\"}],[\"$\",\"meta\",\"3\",{\"name\":\"keywords\",\"content\":\"bons plans beauté,tests produits gratuits,concours beauté,box beauté,réductions cosmétiques,codes promo beauté,échantillons gratuits\"}],[\"$\",\"link\",\"4\",{\"rel\":\"canonical\",\"href\":\"https://bonsplansmania.fr/article/tryandreview-tester-produits-gratuits-avis\"}],[\"$\",\"meta\",\"5\",{\"property\":\"og:title\",\"content\":\"Try and Review : Testez 30 000 Produits Gratuits et Donnez Votre Avis\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:description\",\"content\":\"Try and Review est une plateforme gratuite pour tester des produits beauté, food, maison, high-tech... 30 000 produits disponibles. Comment s'inscrire et être sélectionné ?\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:image\",\"content\":\"http://localhost:3000/images/articles/tryandreview-tester-produits-gratuits-avis.svg\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:type\",\"content\":\"article\"}],[\"$\",\"meta\",\"9\",{\"property\":\"ar