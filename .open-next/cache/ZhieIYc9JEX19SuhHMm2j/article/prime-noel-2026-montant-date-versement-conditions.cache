,{\"rel\":\"manifest\",\"href\":\"/manifest.json\",\"crossOrigin\":\"$undefined\"}],[\"$\",\"meta\",\"3\",{\"name\":\"keywords\",\"content\":\"bons plans beauté,tests produits gratuits,concours beauté,box beauté,réductions cosmétiques,codes promo beauté,échantillons gratuits\"}],[\"$\",\"link\",\"4\",{\"rel\":\"canonical\",\"href\":\"https://bonsplansmania.fr/article/prime-noel-2026-montant-date-versement-conditions\"}],[\"$\",\"meta\",\"5\",{\"property\":\"og:title\",\"content\":\"Prime de Noël 2026 : montant, date de versement et qui y a droit\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:description\",\"content\":\"La prime de Noël est versée en décembre aux bénéficiaires du RSA et de l'ASS. Montant selon la situation familiale et date de versement.\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:image\",\"content\":\"http://localhost:3000/images/articles/prime-noel-2026-montant-date-versement-conditions.svg\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:type\",\"content\":\"article\"}],[\"$\",\"meta\",\"9\",{\"property\":\"article:published_time\",\"content\":\"2026-04-01\"}],[\"$\",\"meta\",\"10\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"11\",{\"name\":\"twitter:title\",\"content\":\"Bons Plans Mania — Bons plans beauté & tests gratuits\"}],[\"$\",\"meta\",\"12\",{\"name\":\"twitter:description\",\"content\":\"Les meilleurs bons plans beauté, tests gratuits, concours et avis box beauté.\"}],[\"$\",\"meta\",\"13\",{\"name\":\"twitter:image\",\"content\":\"http://localhost:3000/images/articles/prime-noel-2026-montant-date-versement-conditions.svg\"}],[\"$\",\"link\",\"14\",{\"rel\":\"icon\",\"href\":\"/favicon.svg\",\"type\":\"image/svg+xml\"}],[\"$\",\"link\",\"15\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"sizes\":\"32x32\"}],[\"$\",\"link\",\"16\",{\"rel\":\"apple-touch-icon\",\"href\":\"/apple-touch-icon.png\"}],[\"$\",\"$L25\",\"17\",{}]]\n","/article/$d$slug/__PAGE__":"1:\"$Sreact.fragment\"\n2:I[83608,[\"/_next/stati