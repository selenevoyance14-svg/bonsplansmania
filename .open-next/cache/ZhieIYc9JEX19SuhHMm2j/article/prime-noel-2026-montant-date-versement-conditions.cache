son\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"Article\\\",\\\"headline\\\":\\\"Prime de Noël 2026 : montant, date de versement et qui y a droit\\\",\\\"description\\\":\\\"La prime de Noël est versée en décembre aux bénéficiaires du RSA et de l'ASS. Montant selon la situation familiale et date de versement.\\\",\\\"datePublished\\\":\\\"2026-04-01\\\",\\\"dateModified\\\":\\\"2026-04-01\\\",\\\"image\\\":\\\"https://bonsplansmania.fr/images/articles/prime-noel-2026-montant-date-versement-conditions.svg\\\",\\\"mainEntityOfPage\\\":{\\\"@type\\\":\\\"WebPage\\\",\\\"@id\\\":\\\"https://bonsplansmania.fr/article/prime-noel-2026-montant-date-versement-conditions\\\"},\\\"author\\\":{\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"Bons Plans Mania\\\",\\\"url\\\":\\\"https://bonsplansmania.fr\\\"},\\\"publisher\\\":{\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"Bons Plans Mania\\\",\\\"url\\\":\\\"https://bonsplansmania.fr\\\",\\\"logo\\\":{\\\"@type\\\":\\\"ImageObject\\\",\\\"url\\\":\\\"https://bonsplansmania.fr/icon.svg\\\"}}}\"}}],null,[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"BreadcrumbList\\\",\\\"itemListElement\\\":[{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":1,\\\"name\\\":\\\"Accueil\\\",\\\"item\\\":\\\"https://bonsplansmania.fr\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":2,\\\"name\\\":\\\"Bon Plan\\\",\\\"item\\\":\\\"https://bonsplansmania.fr/categorie/bon-plan\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":3,\\\"name\\\":\\\"Prime de Noël 2026 : montant, date de versement et qui y a droit\\\"}]}\"}}],[\"$\",\"$Le\",null,{\"activePage\":\"/blog\"}],[\"$\",\"main\",null,{\"className\":\"article-page\",\"children\":[\"$\",\"div\",null,{\"className\":\"container\",\"children\":[[\"$\",\"nav\",null,{\"className\":\"breadcrumbs\",\"children\":[[\"