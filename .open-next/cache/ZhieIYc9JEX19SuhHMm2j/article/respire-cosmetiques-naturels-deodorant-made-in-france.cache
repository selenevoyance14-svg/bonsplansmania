cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\n1e:I[1586,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\n20:I[67277,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\nf:[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":13,\"height\":13,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-external-link\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1q9fwt\",{\"d\":\"M15 3h6v6\"}],[\"$\",\"path\",\"gplh6r\",{\"d\":\"M10 14 21 3\"}],[\"$\",\"path\",\"a6xqqp\",{\"d\":\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"}],\"$undefined\"]}]\n10:[\"$\",\"div\",null,{\"className\":\"article-hero-image\",\"style\":{\"background\":\"#fff\",\"borderRadius\":\"12px\",\"overflow\":\"hidden\",\"display\":\"flex\",\"justifyContent\":\"center\",\"alignItems\":\"center\",\"maxHeight\":\"450px\"},\"children\":[\"$\",\"$L1c\",null,{\"src\":\"/images/articles/respire-cosmetiques-naturels-deodorant-made-in-france.svg\",\"alt\":\"Respire cosmétiques naturels made in France déodorant bio soin visage\",\"width\":800,\"height\":450,\"style\":{\"width\":\"100%\",\"height\":\"100%\",\"objectFit\":\"contain\",\"maxHeight\":\"450px\"},\"priority\":true}]}]\n11:[\"$\",\"$L1d\",null,{}]\n12:[\"$\",\"$L1e\",null,{}]\n1f:T11e2,<p>\n<h2>Respire : des cosmétiques naturels pour une beauté saine et transparente</h2><p><strong>Respire</strong> est une marque française fondée en 2018 par <strong>Justine Hutteau</strong>, avec une conviction forte : la beauté efficace n'a pas besoin d'ingrédients douteux. Tous les produits Respire contiennent <strong>au minimum 95% d'ingrédients d'origine naturelle</strong>, sont fabriqués en France, et certifiés <strong>vegan et cruelty-free</strong>.</p><p>En 2026, le <strong>Sérum Glow & Protect Respire</strong> a été couronné <strong>Meilleur Produit Pharma 2026</strong>.</p><hr><p><div class=\"cta-inline\"><a href=\"https://www.respire.co/\" class=\"btn btn-primary btn-sm\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Découvrir Respire <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/><polyline points=\"15 3 21 3 21 9\"/><line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\"/></svg></a></div><h2>La gamme Respire</h2><h3>Déodorants naturels — la gamme signature</h3>\nLe déodorant Respire est le produit phare de la marque. Il <strong>ne bloque pas la transpiration</strong> (contrairement aux anti-transpirants à base d'aluminium) mais absorbe l'humidité et neutralise les odeurs.</p><ul><li><strong>Efficacité prouvée : 48h</strong></li>\n<li>Disponible en <strong>roll-on</strong> et <strong>stick</strong></li>\n<li>Sans aluminium, sans alcool, sans parabens</li>\n<li>Adapté aux peaux sensibles</li>\n<li>Formats rechargeables disponibles</li>\n</ul>\n<h3>Soins visage</h3>\n<ul><li>Crèmes hydratantes avec actifs naturels ciblés</li>\n<li>Sérums (dont le <strong>Sérum Glow & Protect</strong>, lauréat 2026)</li>\n<li>Nettoyants doux</li>\n</ul>\n<h3>Hygiène naturelle</h3>\n<ul><li><strong>Shampoing solide</strong> : zéro plastique, formule concentrée</li>\n<li><strong>Savon surgras</strong> : nettoyage doux et nourrissant</li>\n<li><strong>Dentifrice</strong> : formule naturelle, sans fluor ajouté</li>\n<li><strong>Spray solaire</strong> aux filtres minéraux</li>\n</ul>\n<hr></p><p><div id=\"ezoic-pub-ad-placeholder-203\" class=\"ad-container\" style=\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\"></div><h2>Les engagements Respire</h2><div class=\"table-wrapper\"><table class=\"comparison-table\"><thead><tr>\n<th>Engagement</th><th>Détail</th>\n</tr></thead><tbody>\n<tr>\n<td>Naturalité</td>\n<td><strong>95%+</strong> d'ingrédients d'origine naturelle</td>\n</tr>\n<tr>\n<td>Fabrication</td>\n<td>100% <strong>Made in France</strong></td>\n</tr>\n<tr>\n<td>Ingrédients</td>\n<td>Récoltés en France ou en Europe</td>\n</tr>\n<tr>\n<td>Certification</td>\n<td>Vegan & Cruelty-free</td>\n</tr>\n<tr>\n<td>Empreinte carbone</td>\n<td>Réduite grâce au sourcing local</td>\n</tr>\n</tbody></table></div><hr><p><div class=\"cta-inline\"><a href=\"https://www.respire.co/\" class=\"btn btn-primary btn-sm\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Découvrir Respire <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/><polyline points=\"15 3 21 3 21 9\"/><line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\"/></svg></a></div><h2>Pourquoi Respire se démarque</h2><h3>Transparence totale sur les formules</h3>\nRespire publie la liste complète des ingrédients avec leurs origines. Pas de marketing opaque — vous savez exactement ce que vous mettez sur votre peau.</p><h3>Des produits qui fonctionnent vraiment</h3>\nLes déodorants Respire sont désormais en pharmacie — gage de qualité et d'efficacité reconnu. Le bouche-à-oreille a propulsé la marque parmi les références de la beauté naturelle française.</p><h3>Le format rechargeable</h3>\nRespire propose des <strong>formats rechargeables</strong> sur ses déodorants et certains soins, pour réduire les emballages plastiques.</p><hr><h2>Notre avis</h2><p><strong>Note : 4.5/5</strong> — Respire est une des meilleures marques de cosmétiques naturels françaises du moment. Les déodorants tiennent vraiment leurs promesses (efficacité 48h sans aluminium), le sérum visage a été récompensé en 2026, et les engagements éco-responsables sont concrets. Si vous cherchez à basculer vers une routine beauté plus naturelle sans compromis sur l'efficacité, Respire est le point de départ idéal.\n</p>13:[\"$\",\"div\",null,{\"className\":\"article-content\",\"children\":[\"$\",\"div\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"$1f\"}}]}]\n14:[\"$\",\"$L1d\",null,{}]\n15:[\"$\",\"div\",null,{\"style\":{\"textAlign\":\"center\",\"margin\":\"40px 0\",\"padding\":\"32px\",\"background\":\"linear-gradient(135deg, #FFF0F0 0%, #FFF8F0 100%)\",\"borderRadius\":\"16px\",\"border\":\"2px solid #FECDD3\"},\"children\":[[\"$\",\"p\",null,{\"style\":{\"fontWeight\":800,\"fontSize\":\"1.2rem\",\"marginBottom\":\"16px\",\"color\":\"var(--foreground)\"},\"children\":\"Profiter de cette offre\"}],[\"$\",\"a\",null,{\"href\":\"https://www.respire.co/\",\"className\":\"btn btn-primary\",\"target\":\"_blank\",\"rel\":\"nofollow sponsored noopener\",\"style\":{\"padding\":\"14px 32px\",\"fontSize\":\"1rem\"},\"children\":[\"Découvrir Respire\",\" \",[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":15,\"height\":15,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-external-link\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1q9fwt\",{\"d\":\"M15 3h6v6\"}],[\"$\",\"path\",\"gplh6r\",{\"d\":\"M10 14 21 3\"}],[\"$\",\"path\",\"a6xqqp\",{\"d\":\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"}],\"$undefined\"]}]]}]]}]\n16:[\"$\",\"$L1d\",null,{}]\n17:[\"$\",\"section\",null,{\"className\":\"related-articles\",\"children\":[[\"$\",\"h2\",null,{\"children\":\"A lire aussi\"}],[\"$\",\"div\",null,{\"className\":\"articles-grid\",\"style\":{\"gridTemplateColumns\":\"repeat(auto-fit, minmax(280px, 1fr))\"},\"children\":[[\"$\",\"a\",\"dplantes-cosmetiques-complements-naturels-plantes\",{\"href\":\"/article/dplan