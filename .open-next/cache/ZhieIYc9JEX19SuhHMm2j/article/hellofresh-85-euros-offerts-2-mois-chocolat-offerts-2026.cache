3:[\"$\",\"a\",\"box repas\",{\"href\":\"/marque/box-repas\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"box repas\"}]\n24:[\"$\",\"a\",\"cuisine\",{\"href\":\"/marque/cuisine\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"cuisine\"}]\n25:[\"$\",\"a\",\"réduction\",{\"href\":\"/marque/rduction\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"réduction\"}]\n26:[\"$\",\"a\",\"chocolat\",{\"href\":\"/marque/chocolat\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"chocolat\"}]\n27:[\"$\",\"a\",\"sans engagement\",{\"href\":\"/marque/sans-engagement\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"sans engagement\"}]\n28:[\"$\",\"a\",\"2026\",{\"href\":\"/marque/2026\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"2026\"}]\na:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n29:I[27201,[\"/_next/static/chunk