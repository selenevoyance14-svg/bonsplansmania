\\"card-excerpt\\\",\\\"children\\\":\\\"Bon plan Amazon : cocotte-minute Seb Clipsominut' Perfect 6L à 109,99€ au lieu de 157,99€. -30%, minuteur, induction, fabriquée en France, garantie 10 ans.\\\"}]]}]]}],[\\\"$\\\",\\\"a\\\",\\\"biotyfull-box-eclosion-radieuse-6-routines-16-produits-15-euros-2026\\\",{\\\"href\\\":\\\"/article/biotyfull-box-eclosion-radieuse-6-routines-16-produits-15-euros-2026\\\",\\\"className\\\":\\\"card\\\",\\\"style\\\":{\\\"textDecoration\\\":\\\"none\\\"},\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"position\\\":\\\"relative\\\",\\\"height\\\":\\\"160px\\\",\\\"overflow\\\":\\\"hidden\\\"},\\\"children\\\":[\\\"$\\\",\\\"$L1c\\\",null,{\\\"src\\\":\\\"/images/articles/biotyfull-box-eclosion-radieuse-6-routines-15-euros.png\\\",\\\"alt\\\":\\\"Biotyfull Box Eclosion Radieuse 6 routines 16 produits beaute pour 15 euros\\\",\\\"fill\\\":true,\\\"style\\\":{\\\"objectFit\\\":\\\"cover\\\"},\\\"sizes\\\":\\\"33vw\\\"}]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"card-body\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"style\\\":{\\\"fontSize\\\":\\\"0.72rem\\\",\\\"fontWeight\\\":600,\\\"color\\\":\\\"var(--primary)\\\",\\\"textTransform\\\":\\\"uppercase\\\",\\\"letterSpacing\\\":\\\"0.5px\\\"},\\\"children\\\":[\\\"💄\\\",\\\" \\\",\\\"Box Beauté\\\"]}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"card-title\\\",\\\"children\\\":\\\"Biotyfull Box : 16 produits beaute (337€) pour 15€ sans engagement\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"card-excerpt\\\",\\\"children\\\":\\\"Offre flash Biotyfull Box : 6 routines beaute avec 16 produits d'une valeur de 337€ pour seulement 15€ sans engagement. Box Eclosion Radieuse 100% Innovation.\\\"}]]}]]}]]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"18:[\\\"$\\\",\\\"nav\\\",null,{\\\"style\\\":{\\\"margin\\\":\\\"40px 0\\\",\\\"padding\\\":\\\"24px\\\",\\\"background\\\":\\\"var(--muted, #f3f4f6)\\\",\\\"borderRadius\\\":\\\"16px\\\"},\