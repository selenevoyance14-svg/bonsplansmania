//www.w3.org/2000/svg\",\"width\":13,\"height\":13,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-external-link\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1q9fwt\",{\"d\":\"M15 3h6v6\"}],[\"$\",\"path\",\"gplh6r\",{\"d\":\"M10 14 21 3\"}],[\"$\",\"path\",\"a6xqqp\",{\"d\":\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"}],\"$undefined\"]}]\n4:[\"$\",\"div\",null,{\"className\":\"article-hero-image\",\"style\":{\"background\":\"#fff\",\"borderRadius\":\"12px\",\"overflow\":\"hidden\",\"display\":\"flex\",\"justifyContent\":\"center\",\"alignItems\":\"center\",\"maxHeight\":\"450px\"},\"children\":[\"$\",\"$L12\",null,{\"src\":\"/images/articles/jeu-concours-starwax-80-ans-10000-euros-cadeaux-2026.svg\",\"alt\":\"Jeu concours Starwax 80 ans 10000 euros de cadeaux 2026\",\"width\":800,\"height\":450,\"style\":{\"width\":\"100%\",\"height\":\"100%\",\"objectFit\":\"contain\",\"maxHeight\":\"450px\"},\"priority\":true}]}]\n5:[\"$\",\"$L13\",null,{}]\n6:[\"$\",\"$L14\",null,{}]\n15:Tabe,<p>\n<h2>Grand Jeu Starwax 80 Ans : +10 000€ de Cadeaux à Gagner !</h2><p><strong>Starwax</strong> fête ses <strong>80 ans</strong> et vous gâte avec un jeu concours exceptionnel : plus de <strong>10 000€ de cadeaux</strong> à remporter !</p><hr><p><div class=\"cta-inline\"><a href=\"https://jeux-concours.starwax.fr/80-ans-starwax/\" class=\"btn btn-primary btn-sm\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Participer au jeu concours <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/><polyline points=\"15 3 21 3 21 9\"/><line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\"/></svg></a></div><h2>Les 3 Lots Exceptionnels</h2><div class=\"table-wrapper\"><table class=\"comparison-table\"><thead><tr>\n<th>Lot</th><th>Cadeau</th>\n</tr></thead><tbody>\n<tr>\n<td><strong>Lot 1</strong></td>\n<td>Robot aspirateur laveur haut de gamme</td>\n</tr>\n<tr>\n<td><strong>Lot 2</strong></td>\n<td>Robot pâtissier <strong>KitchenAid</strong></td>\n</tr>\n<tr>\n<td><strong>Lot 3</strong></td>\n<td>Barbecue <strong>Kamado</strong></td>\n</tr>\n</tbody></table></div><hr><p><div id=\"ezoic-pub-ad-placeholder-203\" class=\"ad-container\" style=\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\"></div><h2>300 Cartes Cadeaux</h2><p>En plus des 3 lots principaux, <strong>300 cartes cadeaux</strong> sont à gagner !</p><hr><p><div class=\"cta-inline\"><a href=\"https://jeux-concours.starwax.fr/80-ans-starwax/\" class=\"btn btn-primary btn-sm\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Participer au jeu concours <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/><polyline points=\"15 3 21 3 21 9\"/><line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\"/></svg></a></div><h2>Comment participer ?</h2><p>1. Rendez-vous sur la page du jeu concours Starwax\n2. Remplissez le formulaire de participation\n3. Tentez votre chance pour l'un des 303 lots</p><hr><h2>Infos pratiques</h2><div class=\"table-wrapper\"><table class=\"comparison-table\"><thead><tr>\n<th><strong>Organisateur</strong></th><th>Starwax (80 ans)</th>\n</tr></thead><tbody>\n<tr>\n<td><strong>Valeur totale</strong></td>\n<td>+ de 10 000€</td>\n</tr>\n<tr>\n<td><strong>Nombre de lots</strong></td>\n<td>3 lots exceptionnels + 300 cartes cadeaux</td>\n</tr>\n<tr>\n<td><strong>Participation</strong></td>\n<td>Gratuite</td>\n</tr>\n</tbody></table></div><p>> 80 ans ça se fête — et avec plus de 300 lots, vous avez toutes vos chances !\n</p>7:[\"$\",\"div\",null,{\"className\":\"article-content\",\"children\":[\"$\",\"div\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"$15\"}}]}]\n8:[\"$\",\"$L13\",null,{}]\n9:[\"$\",\"div\",null,{\"style\":{\"textAlign\":\"center\",\"margin\":\"40px 0\",\"padding\":\"32px\",\"background\":\"linear-gradient(135deg, #FFF0F0 0%, #FFF8F0 100%)\",\"borderRadius\":\"16px\",\"border\":\"2px solid #FECDD3\"},\"children\":[[\"$\",\"p\",null,{\"style\":{\"fontWeight\":800,\"fontSize\":\"1.2rem\",\"marginBottom\":\"16px\",\"color\":\"var(--foreground)\"},\"children\":\"Profiter de cette offre\"}],[\"$\",\"a\",null,{\"href\":\"https://jeux-concours.starwax.fr/80-ans-starwax/\",\"className\":\"btn btn-primary\",\"target\":\"_blank\",\"rel\":\"nofollow sponsored noopener\",\"style\":{\"padding\":\"14px 32px\",\"fontSize\":\"1rem\"},\"children\":[\"Participer au jeu concours\",\" \",[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":15,\"height\":15,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-external-link\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1q9fwt\",{\"d\":\"M15 3h6v6\"}],[\"$\",\"path\",\"gplh6r\",{\"d\":\"M10 14 21 3\"}],[\"$\",\"path\",\"a6xqqp\",{\"d\":\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"}],\"$undefined\"]}]]}]]}]\na:[\"$\",\"$L13\",null,{}]\nb:[\"$\",\"section\",null,{\"className\":\"related-articles\",\"children\":[[\"$\",\"h2\",null,{\"children\":\"A lire aussi\"}],[\"$\",\"div\",null,{\"className\":\"articles-grid\",\"style\":{\"gridTemplateColumns\":\"repeat(auto-fit, minmax(280px, 1fr))\"},\"children\":[[\"$\",\"a\",\"femme-actuelle-grand-jeu-voyage-decouverte-sejours-2026\",{\"href\":\"/article/femme-actuelle-grand-jeu-voyage-decouverte-sejours-2026\",\"className\":\"card\",\"style\":{\"textDecoration\":\"none\"},\"children\":[[\"$\",\"div\",null,{\"style\