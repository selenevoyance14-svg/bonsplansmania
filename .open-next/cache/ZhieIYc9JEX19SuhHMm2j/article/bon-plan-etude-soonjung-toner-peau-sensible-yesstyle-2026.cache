ight\\\":13,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-external-link\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":[[\\\"$\\\",\\\"path\\\",\\\"1q9fwt\\\",{\\\"d\\\":\\\"M15 3h6v6\\\"}],[\\\"$\\\",\\\"path\\\",\\\"gplh6r\\\",{\\\"d\\\":\\\"M10 14 21 3\\\"}],[\\\"$\\\",\\\"path\\\",\\\"a6xqqp\\\",{\\\"d\\\":\\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\\"}],\\\"$undefined\\\"]}]\\n10:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"article-hero-image\\\",\\\"style\\\":{\\\"background\\\":\\\"#fff\\\",\\\"borderRadius\\\":\\\"12px\\\",\\\"overflow\\\":\\\"hidden\\\",\\\"display\\\":\\\"flex\\\",\\\"justifyContent\\\":\\\"center\\\",\\\"alignItems\\\":\\\"center\\\",\\\"maxHeight\\\":\\\"450px\\\"},\\\"children\\\":[\\\"$\\\",\\\"$L1c\\\",null,{\\\"src\\\":\\\"/images/articles/bon-plan-etude-soonjung-toner-peau-sensible-yesstyle-2026.svg\\\",\\\"alt\\\":\\\"Bon plan Etude SoonJung toner peau sensible YesStyle\\\",\\\"width\\\":800,\\\"height\\\":450,\\\"style\\\":{\\\"width\\\":\\\"100%\\\",\\\"height\\\":\\\"100%\\\",\\\"objectFit\\\":\\\"contain\\\",\\\"maxHeight\\\":\\\"450px\\\"},\\\"priority\\\":true}]}]\\n11:[\\\"$\\\",\\\"$L1d\\\",null,{}]\\n12:[\\\"$\\\",\\\"$L1e\\\",null,{}]\\n1f:Te1c,\"])</script><script>self.__next_f.push([1,\"\\u003cp\\u003e\\n\\u003ch2\\u003eLe toner conçu pour les peaux ultra-sensibles\\u003c/h2\\u003e\\u003cp\\u003eLe \\u003cstrong\\u003eEtude SoonJung pH 5.5 Relief Toner\\u003c/strong\\u003e est la référence K-Beauty pour les \\u003cstrong\\u003epeaux sensibles, réactives et irritées\\u003c/strong\\u003e. Sa formule minimaliste à \\u003cstrong\\u003e97% d'ingrédients naturels\\u003c/strong\\u003e apaise et hydrate sans jamais irriter.\\u003c/p\\u003e\\u003cp\\u003e\\u003cdiv class=\\\"cta-inline\\\"\\u003e\\u003ca href=\\\"https://ystyle.co/kqCm2\\\" class=\\\"btn btn-primary btn-sm\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eVoir le prix sur YesStyle \\u003csvg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"13\\\" height=\\\"13\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"\\u003e\\u003cpath d=\\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\\"/\\u003e\\u003cpolyline points=\\\"15 3 21 3 21 9\\\"/\\u003e\\u003cline x1=\\\"10\\\" y1=\\\"14\\\" x2=\\\"21\\\" y2=\\\"3\\\"/\\u003e\\u003c/svg\\u003e\\u003c/a\\u003e\\u003c/div\\u003e\\u003ch2\\u003ePourquoi c'est la référence peaux sensibles\\u003c/h2\\u003e\\u003cul\\u003e\\u003cli\\u003e🛡️ \\u003cstrong\\u003epH 5.5\\u003c/strong\\u003e : pH identique à celui de la peau saine\\u003c/li\\u003e\\n\\u003cli\\u003e🌿 \\u003cstrong\\u003ePanthenol (B5)\\u003c/strong\\u003e : apaise et répare les irritations\\u003c/li\\u003e\\n\\u003cli\\u003e🧬 \\u003cstrong\\u003eMadecassoside\\u003c/strong\\u003e : dérivé de centella, anti-inflammatoire puissant\\u003c/li\\u003e\\n\\u003cli\\u003e❌ \\u003cstrong\\u003e0 irritant\\u003c/strong\\u003e : sans parfum, sans colorant, sans alcool, sans huile essentielle\\u003c/li\\u003e\\n\\u003cli\\u003e✅ \\u003cstrong\\u003e97% naturel\\u003c/strong\\u003e : formule minimaliste ultra-douce\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003cdiv id=\\\"ezoic-pub-ad-placeholder-203\\\" class=\\\"ad-container\\\" style=\\\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\\\"\\u003e\\u003c/div\\u003e\\u003ch2\\u003eSoonJung, c'est quoi ?\\u003c/h2\\u003e\\u003cp\\u003e\\u003cstrong\\u003eSoonJung\\u003c/strong\\u003e (순정 = \\\"pur\\\") est la gamme hypoallergénique d'\\u003cstrong\\u003eEtude\\u003c/strong\\u003e (anciennement Etude House), l'une des marques coréennes les plus emblématiques. Créée spécialement pour les peaux sensibles, la gamme est devenue un pilier de la dermocosmétique coréenne.\\u003c/p\\u003e\\u003cp\\u003e\\u003cdiv class=\\\"cta-inline\\\"\\u003e\\u003ca href=\\\"https://ystyle.co/kqCm2\\\" class=\\\"btn btn-primary btn-sm\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eVoir le prix sur YesStyle \\u003csvg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"13\\\" height=\\\"13\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"\\u003e\\u003cpath d=\\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\\"/\\u003e\\u003cpolyline points=\\\"15 3 21 3 21 9\\\"/\\u003e\\u003cline x1=\\\"10\\\" y1=\\\"14\\\" x2=\\\"21\\\" y2=\\\"3\\\"/\\u003e\\u003c/svg\\u003e\\u003c/a\\u003e\\u003c/div\\u003e\\u003ch2\\u003eLa gamme SoonJung complète\\u003c/h2\\u003e\\u003cdiv class=\\\"table-wrapper\\\"\\u003e\\u003ctable class=\\\"comparison-table\\\"\\u003e\\u003cthead\\u003e\\u003ctr\\u003e\\n\\u003cth\\u003eProduit\\u003c/th\\u003e\\u003cth\\u003eAction\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\u003c/thead\\u003e\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003epH 5.5 Relief Toner\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eApaise et équilibre (le bestseller)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e2x Barrier Intensive Cream\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eRépare la barrière cutanée\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e10-Free Moist Emulsion\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eHydratation légère quotidienne\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003eWhip Cleanser\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eNettoyage ultra-doux\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003eCica Balm\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eSoin ciblé zones irritées\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\u003c/table\\u003e\\u003c/div\\u003e\\u003ch2\\u003eComment l'utiliser\\u003c/h2\\u003e\\u003cp\\u003e1. Après le double nettoyage\\n2. Versez le toner dans vos paumes ou sur un coton\\n3. Appliquez en \\u003cstrong\\u003etapotant doucement\\u003c/strong\\u003e sur le visage\\n4. \\u003cstrong\\u003eSuperposez 2-3 couches\\u003c/strong\\u003e si la peau est très sèche (méthode 7 skin)\\n5. Poursuivez avec votre sérum et crème\\u003c/p\\u003e\\u003cdiv class=\\\"table-wrapper\\\"\\u003e\\u003ctable class=\\\"comparison-table\\\"\\u003e\\u003cthead\\u003e\\u003ctr\\u003e\\n\\u003cth\\u003e\\u003cstrong\\u003eContenu\\u003c/strong\\u003e\\u003c/th\\u003e\\u003cth\\u003e200 ml\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\u003c/thead\\u003e\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003ePrix environ\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e~10€ sur YesStyle\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\u003c/table\\u003e\\u003c/div\\u003e\\u003cp\\u003e⚠️ \\u003cem\\u003ePrix indicatif, vérifiez le prix actuel sur YesStyle.\\u003c/em\\u003e\\u003c/p\\u003e\\u003cp\\u003e\\u003chr\\u003e\\n\\u003c/p\\u003e\"])</script><script>self.__next_f.push([1,\"13:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"article-content\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"$1f\\\"}}]}]\\n14:[\\\"$\\\",\\\"$L1d\\\",null,{}]\\n15:[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"textAlign\\\":\\\"center\\\",\\\"margin\\\":\\\"40px 0\\\",\\\"padding\\\":\\\"32px\\\",\\\"background\\\":\\\"linear-gradient(135deg, #FFF0F0 0%, #FFF8F0 100%)\\\",\\\"borderRadius\\\":\\\"16px\\\",\\\"border\\\":\\\"2px solid #FECDD3\\\"},\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"style\\\":{\\\"fontWeight\\\":800,\\\"fontSize\\\":\\\"1.2rem\\\",\\\"marginBottom