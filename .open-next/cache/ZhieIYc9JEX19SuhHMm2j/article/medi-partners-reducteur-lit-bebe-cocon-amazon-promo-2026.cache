\",\"borderRadius\":\"999px\",\"background\":\"white\",\"fontSize\":\"0.82rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500,\"border\":\"1px solid var(--border, #e5e7eb)\"},\"children\":[\"🏆\",\" \",\"Concours\"]}],[\"$\",\"a\",\"box-beaute\",{\"href\":\"/categorie/box-beaute\",\"style\":{\"padding\":\"6px 14px\",\"borderRadius\":\"999px\",\"background\":\"white\",\"fontSize\":\"0.82rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500,\"border\":\"1px solid var(--border, #e5e7eb)\"},\"children\":[\"💄\",\" \",\"Box Beauté\"]}],[\"$\",\"a\",\"code-promo\",{\"href\":\"/categorie/code-promo\",\"style\":{\"padding\":\"6px 14px\",\"borderRadius\":\"999px\",\"background\":\"white\",\"fontSize\":\"0.82rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500,\"border\":\"1px solid var(--border, #e5e7eb)\"},\"children\":[\"🎟️\",\" \",\"Codes Promo\"]}],[\"$\",\"a\",\"beaute\",{\"href\":\"/categorie/beaute\",\"style\":{\"padding\":\"6px 14px\",\"borderRadius\":\"999px\",\"background\":\"white\",\"fontSize\":\"0.82rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500,\"border\":\"1px solid var(--border, #e5e7eb)\"},\"children\":[\"✨\",\" \",\"Beauté\"]}]]}]]}]\n13:[\"$\",\"div\",null,{\"style\":{\"maxWidth\":\"780px\",\"margin\":\"0 auto\"},\"children\":[[\"$\",\"div\",null,{\"style\":{\"display\":\"flex\",\"alignItems\":\"center\",\"gap\":\"12px\",\"flexWrap\":\"wrap\",\"margin\":\"32px 0 16px\"},\"children\":[[\"$\",\"$L22\",null,{\"slug\":\"medi-partners-reducteur-lit-bebe-cocon-amazon-promo-2026\"}],[\"$\",\"span\",null,{\"style\":{\"fontSize\":\"0.85rem\",\"color\":\"var(--text-muted, #6b7280)\"},\"children\":\"Partager :\"}],[[\"$\",\"a\",\"WhatsApp\",{\"href\":\"https://wa.me/?text=R%C3%A9ducteur%20de%20lit%20b%C3%A9b%C3%A9%20Medi%20Partners%20%3A%2047%2C49%E2%82%AC%20au%20lieu%20de%2055%2C99%E2%82%AC%20(-14%25)%20-%20https%3A%2F%2Fbon