rSpacing\\\":\\\"0.5px\\\"},\\\"children\\\":[\\\"🏷️\\\",\\\" \\\",\\\"Bon Plan\\\"]}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"card-title\\\",\\\"children\\\":\\\"Weleda : -20% gamme Sport Arnica + -10% soins Minceur\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"card-excerpt\\\",\\\"children\\\":\\\"Bon plan Weleda : -20% sur toute la gamme Sport Arnica et -10% sur les soins Minceur. Reduction automatique, sur weleda.fr. Jusqu'au 30 avril 2026.\\\"}]]}]]}]]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"18:[\\\"$\\\",\\\"nav\\\",null,{\\\"style\\\":{\\\"margin\\\":\\\"40px 0\\\",\\\"padding\\\":\\\"24px\\\",\\\"background\\\":\\\"var(--muted, #f3f4f6)\\\",\\\"borderRadius\\\":\\\"16px\\\"},\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"style\\\":{\\\"fontSize\\\":\\\"1rem\\\",\\\"marginBottom\\\":\\\"12px\\\"},\\\"children\\\":\\\"Explorer par catégorie\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"display\\\":\\\"flex\\\",\\\"flexWrap\\\":\\\"wrap\\\",\\\"gap\\\":\\\"8px\\\"},\\\"children\\\":[[\\\"$\\\",\\\"a\\\",\\\"bon-plan\\\",{\\\"href\\\":\\\"/categorie/bon-plan\\\",\\\"style\\\":{\\\"padding\\\":\\\"6px 14px\\\",\\\"borderRadius\\\":\\\"999px\\\",\\\"background\\\":\\\"white\\\",\\\"fontSize\\\":\\\"0.82rem\\\",\\\"color\\\":\\\"var(--text, #374151)\\\",\\\"textDecoration\\\":\\\"none\\\",\\\"fontWeight\\\":500,\\\"border\\\":\\\"1px solid var(--border, #e5e7eb)\\\"},\\\"children\\\":[\\\"🏷️\\\",\\\" \\\",\\\"Bons Plans\\\"]}],[\\\"$\\\",\\\"a\\\",\\\"concours\\\",{\\\"href\\\":\\\"/categorie/concours\\\",\\\"style\\\":{\\\"padding\\\":\\\"6px 14px\\\",\\\"borderRadius\\\":\\\"999px\\\",\\\"background\\\":\\\"white\\\",\\\"fontSize\\\":\\\"0.82rem\\\",\\\"color\\\":\\\"var(--text, #374151)\\\",\\\"textDecoration\\\":\\\"none\\\",\\\"fontWeight\\\":500,\\\"border\\\":\\\"1px solid var(--border, #e5e7eb)\\\"},\\\"children\\\":[\\\"🏆\\\",\\\" \\\",\\\"Concours\\\"]}],[\\\"$\\\",\\\"a\\\",\\\"box-beaute\\\",{\\\"href\\\":\\\"/c