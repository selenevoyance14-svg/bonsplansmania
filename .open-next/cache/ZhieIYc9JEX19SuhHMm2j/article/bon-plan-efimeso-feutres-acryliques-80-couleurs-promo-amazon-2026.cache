:\"none\",\"fontWeight\":500},\"children\":\"dessin\"}]\n27:[\"$\",\"a\",\"peinture\",{\"href\":\"/marque/peinture\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"peinture\"}]\n28:[\"$\",\"a\",\"multi-surfaces\",{\"href\":\"/marque/multi-surfaces\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"multi-surfaces\"}]\n29:[\"$\",\"a\",\"amazon\",{\"href\":\"/marque/amazon\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"amazon\"}]\n2a:[\"$\",\"a\",\"promo\",{\"href\":\"/marque/promo\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"promo\"}]\na:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n2b:I[27201,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/d2be314c3ece3fbe.js\"],\"IconMark\"]\n8:null\nc:[[\"$\",\"title\",\"0\",{\"children\":\"Efimeso 80 Feutres Acryliques -43% : 18E Amazon\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Coffret 80 feutres acryliques Efimeso à 18,17E au lieu de 31,99E. Marqueurs peinture multi-surfaces, pointe pinceau, base eau. 4,3/5 sur 795 avis.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"manifest\",\"href\":\"/manifest.json\",\"crossOrigin\":\"$undefined\"}],[\"$\",\"meta\",\"3\",{\"name\":\"keywords\",\"