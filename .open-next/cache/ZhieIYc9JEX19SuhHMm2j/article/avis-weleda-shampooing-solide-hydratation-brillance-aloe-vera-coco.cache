oe vera huile de coco\\\",\\\"width\\\":800,\\\"height\\\":450,\\\"style\\\":{\\\"width\\\":\\\"100%\\\",\\\"height\\\":\\\"100%\\\",\\\"objectFit\\\":\\\"contain\\\",\\\"maxHeight\\\":\\\"450px\\\"},\\\"priority\\\":true}]}]\\n1d:[\\\"$\\\",\\\"$L22\\\",null,{}]\\n1e:[\\\"$\\\",\\\"$L2d\\\",null,{}]\\n2e:T19e3,\"])</script><script>self.__next_f.push([1,\"\\u003cp\\u003e\\n\\u003ch2\\u003eWeleda Shampooing Solide Hydratation \\u0026 Brillance : notre verdict\\u003c/h2\\u003e\\u003cp\\u003eOn monte en gamme avec ce shampooing solide signe \\u003cstrong\\u003eWeleda\\u003c/strong\\u003e, la marque pionniere de la cosmetique naturelle depuis 1921. Certifie \\u003cstrong\\u003eNATRUE\\u003c/strong\\u003e et \\u003cstrong\\u003eB Corp\\u003c/strong\\u003e, ce shampooing promet hydratation et brillance pour les cheveux normaux a secs. Avec sa formule 100% d'origine naturelle, c'est clairement un cran au-dessus des shampooings solides de supermarche. On l'a teste.\\u003c/p\\u003e\\u003chr\\u003e\\u003cp\\u003e\\u003cdiv class=\\\"cta-inline\\\"\\u003e\\u003ca href=\\\"https://amzn.to/4uOAWPk\\\" class=\\\"btn btn-primary btn-sm\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eVoir le prix sur Amazon \\u003csvg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"13\\\" height=\\\"13\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"\\u003e\\u003cpath d=\\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\\"/\\u003e\\u003cpolyline points=\\\"15 3 21 3 21 9\\\"/\\u003e\\u003cline x1=\\\"10\\\" y1=\\\"14\\\" x2=\\\"21\\\" y2=\\\"3\\\"/\\u003e\\u003c/svg\\u003e\\u003c/a\\u003e\\u003c/div\\u003e\\u003ch2\\u003eLa fiche produit\\u003c/h2\\u003e\\u003cdiv class=\\\"table-wrapper\\\"\\u003e\\u003ctable class=\\\"comparison-table\\\"\\u003e\\u003cthead\\u003e\\u003ctr\\u003e\\n\\u003cth\\u003e\\u003c/th\\u003e\\u003cth\\u003eDetails\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\u003c/thead\\u003e\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003eMarque\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eWeleda (depuis 1921)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003eProduit\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eShampooing Solide Hydratation \\u0026 Brillance\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003eFormat\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eSolide (50g)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003eEquivalence\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e2 flacons de 190 ml\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003eType de cheveux\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eNormaux a secs\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003eActifs\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eAloe vera bio, huile de coco bio, proteines de chanvre\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003eComposition\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e100% d'origine naturelle\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003eSans\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eSilicone\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003eCertifications\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eNATRUE, B Corp\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003ePrix\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eEnviron 7 €\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\u003c/table\\u003e\\u003c/div\\u003e\\u003chr\\u003e\\u003cp\\u003e\\u003cdiv id=\\\"ezoic-pub-ad-placeholder-203\\\" class=\\\"ad-container\\\" style=\\\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\\\"\\u003e\\u003c/div\\u003e\\u003ch2\\u003eLa composition : un vrai plus par rapport a la concurrence\\u003c/h2\\u003e\\u003cp\\u003eC'est la que Weleda se demarque clairement. La formule est \\u003cstrong\\u003e100% d'origine naturelle\\u003c/strong\\u003e (pas 94% comme chez Garnier) et repose sur trois actifs bio :\\u003c/p\\u003e\\u003cul\\u003e\\u003cli\\u003e\\u003cstrong\\u003eAloe vera bio\\u003c/strong\\u003e — hydratant reconnu, il apporte de l'eau aux cheveux deshydrates sans les alourdir. C'est un ingredient phare des soins capillaires naturels.\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eHuile de coco bio\\u003c/strong\\u003e — nourrit en profondeur et apporte de la brillance. Elle penetre bien la fibre capillaire pour un resultat longue duree.\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eProteines de chanvre\\u003c/strong\\u003e — c'est l'ingredient original de la formule. Elles renforcent la fibre capillaire et apportent de la souplesse. Un actif qu'on ne retrouve pas chez les concurrents grand public.\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\nLa certification \\u003cstrong\\u003eNATRUE\\u003c/strong\\u003e garantit un niveau d'exigence superieur aux labels classiques : pas de parfums synthetiques, pas de conservateurs controverses, pas de matieres premieres petrochimiques.\\u003c/p\\u003e\\u003chr\\u003e\\u003cp\\u003e\\u003cdiv class=\\\"cta-inline\\\"\\u003e\\u003ca href=\\\"https://amzn.to/4uOAWPk\\\" class=\\\"btn btn-primary btn-sm\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eVoir le prix sur Amazon \\u003csvg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"13\\\" height=\\\"13\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"\\u003e\\u003cpath d=\\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\\"/\\u003e\\u003cpolyline points=\\\"15 3 21 3 21 9\\\"/\\u003e\\u003cline x1=\\\"10\\\" y1=\\\"14\\\" x2=\\\"21\\\" y2=\\\"3\\\"/\\u003e\\u003c/svg\\u003e\\u003c/a\\u003e\\u003c/div\\u003e\\u003ch2\\u003eL'experience sensorielle\\u003c/h2\\u003e\\u003cp\\u003eWeleda a soigne l'experience. Le parfum est un melange raffraichissant de \\u003cstrong\\u003ecitron, eucalyptus et fleur d'oranger\\u003c/strong\\u003e. Ca change des odeurs sucrées ou neutres des shampooings solides classiques — ici on est sur quelque chose de frais et tonifiant sous la douche.\\u003c/p\\u003e\\u003cp\\u003eLa mousse est fine et agreable. Le pain glisse bien sur les cheveux et le cuir chevelu sans accrocher. Le rincage est rapide et net.\\u003c/p\\u003e\\u003chr\\u003e\\u003ch2\\u003eLe resultat sur les cheveux\\u003c/h2\\u003e\\u003cp\\u003eSur cheveux normaux a secs, le Weleda delivre exactement ce qu'il promet :\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003eCe qu'on a aime :\\u003c/strong\\u003e\\n\\u003cul\\u003e\\u003cli\\u003eBrillance naturelle visible des le premier lavage — c'est le point fort\\u003c/li\\u003e\\n\\u003cli\\u003eCheveux souples et faciles a coiffer sans apres-shampooing\\u003c/li\\u003e\\n\\u003cli\\u003eHydratation qui dure, les cheveux ne sont pas secs en fin de journee\\u003c/li\\u003e\\n\\u003cli\\u003eParfum frais et elegant qui reste subtilement\\u003c/li\\u003e\\n\\u003cli\\u003eFormule 100% naturelle irreprochable\\u003c/li\\u003e\\n\\u003cli\\u003eTolere dermatologiquement — zero irritation du cuir chevelu\\u003c/li\\u003e\\n\\u003cli\\u003eLe pain est bien moule, agreable a tenir en main\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003cstrong\\u003eCe qu'on a moins aime :\\u003c/strong\\u003e\\n\\u003cul\\u003e\\u003cli\\u003eLe prix est plus eleve que les Garnier (environ 7€ vs 5€)\\u003c/li\\u003e\\n\\u003cli\\u003eLe format de 50g (vs 60g chez Garnier) dure un peu moins longtemps\\u003c/li\\u003e\\n\\u003cli\\u003ePas toujours facile a trouver en supermarche — Amazon reste le plus simple\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\u003c/p\\u003e\\u003cp\\u003e\\u003cdiv id=\\\"ezoic-pub-ad-placeholder-206\\\" class=\\\"ad-container\\\" style=\\\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\\\"\\u003e\\u003c/div\\u003e\\u003ch2\\u003eWeleda vs Garnier Ultra Doux : le match\\u003c/h2\\u003e\\u003cdiv class=\\\"table-wrapper\\\"\\u003e\\u003ctable class=\\\"comparison-table\\\"\\u003e\\u003cthead\\u003e\\u003ctr\\u003e\\n\\u003cth\\u003e\\u003c/th\\u003e\\u003cth\\u003eWeleda Hydratation\\u003c/th\\u003e\\u003cth\\u003eGarnier Tresors de Miel\\u003c/th\\u003e\\u003cth\\u003eGarnier Delicatesse Avoine\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\u003c/thead\\u003e\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003eComposition\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e100% naturelle\\u003c/td\\u003e\\n\\u003ctd\\u003e94% vegetale\\u003c/td\\u003e\\n\\u003ctd\\u003e94% vegetale\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003eCertification\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eNATRUE + B Corp\\u003c/td\\u003e\\n\\u003ctd\\u003eAucune\\u003c/td\\u003e\\n\\u003ctd\\u003eAucune\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003ePour\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eNormaux a secs\\u003c/td\\u003e\\n\\u003ctd\\u003eFragiles, cassants\\u003c/td\\u003e\\n\\u003ctd\\u003eDelicats, fins\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003ePoint fort\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eBrillance + qualite\\u003c/td\\u003e\\n\\u003ctd\\u003eNourrissant\\u003c/td\\u003e\\n\\u003ctd\\u003eLegeret\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003ePrix\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e~ 7 €\\u003c/td\\u003e\\n\\u003ctd\\u003e~ 5 €\\u003c/td\\u003e\\n\\u003ctd\\u003e~ 5 €\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003ePoids\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e50g\\u003c/td\\u003e\\n\\u003ctd\\u003e60g\\u003c/td\\u003e\\n\\u003ctd\\u003e60g\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\u003c/table\\u003e\\u003c/div\\u003e\\u003chr\\u003e\\u003ch2\\u003eNotre note : 4,5/5\\u003c/h2\\u003e\\u003cp\\u003eLe Weleda Hydratation \\u0026 Brillance est le meilleur shampooing solide qu'on ait teste dans cette selection. La formule 100% naturelle, les certifications serieuses et le resultat sur les cheveux justifient le petit supplement de prix. Il perd un demi-point uniquement pour le format 50g un peu chiche et le prix legerement superieur. Si vous etes prete a mettre 2 euros de plus que le Garnier, foncez.\\u003c/p\\u003e\\u003cp\\u003e\\u003ca href=\\\"https://amzn.to/4uOAWPk\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eVoir le shampooing solide Weleda sur Amazon\\u003c/a\\u003e\\n\\u003c/p\\u003e\"])</script><script>self.__next_f.push([1,\"1f:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"article-content\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"$2e\\\"}}]}]\\n20:[\\\"$\\\",\\\"$L22\\\",null,{}]\\n21:[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"textAlign\\\":\\\"center\\\",\\\"margin\\\":\\\"40px 0\\\",\\\"padding\\\":\\\"32px\\\",\\\"background\\\":\\\"linear-gradient(135deg, #FFF0F0 0%, #FFF8F0 100%)\\\",\\\"borderRadius\\\":\\\"16px\\\",\\\"border\\\":\\\"2px solid #FECDD3\\\"},\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"style\\\":{\\\"fontWeight\\\":800,\\\"fontSize\\\":\\\"1.2rem\\\",\\\"marginBottom\\\":\\\"16px\\\",\\\"color\\\":\\\"var(--foreground)\\\"},\\\"children\\\":\\\"Profiter de cette offre\\\"}],[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https:/