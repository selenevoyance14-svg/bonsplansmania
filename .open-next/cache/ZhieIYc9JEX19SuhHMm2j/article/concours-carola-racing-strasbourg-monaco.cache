\\n\"])</script><script>self.__next_f.push([1,\"1c:I[5500,[\\\"/_next/static/chunks/cf200c391baea40a.js\\\",\\\"/_next/static/chunks/6e48aeeec84550f8.js\\\"],\\\"Image\\\"]\\n1d:I[96788,[\\\"/_next/static/chunks/cf200c391baea40a.js\\\",\\\"/_next/static/chunks/6e48aeeec84550f8.js\\\"],\\\"default\\\"]\\n1e:I[1586,[\\\"/_next/static/chunks/cf200c391baea40a.js\\\",\\\"/_next/static/chunks/6e48aeeec84550f8.js\\\"],\\\"default\\\"]\\n20:I[67277,[\\\"/_next/static/chunks/cf200c391baea40a.js\\\",\\\"/_next/static/chunks/6e48aeeec84550f8.js\\\"],\\\"default\\\"]\\nf:[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":13,\\\"height\\\":13,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-external-link\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":[[\\\"$\\\",\\\"path\\\",\\\"1q9fwt\\\",{\\\"d\\\":\\\"M15 3h6v6\\\"}],[\\\"$\\\",\\\"path\\\",\\\"gplh6r\\\",{\\\"d\\\":\\\"M10 14 21 3\\\"}],[\\\"$\\\",\\\"path\\\",\\\"a6xqqp\\\",{\\\"d\\\":\\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\\"}],\\\"$undefined\\\"]}]\\n10:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"article-hero-image\\\",\\\"style\\\":{\\\"background\\\":\\\"#fff\\\",\\\"borderRadius\\\":\\\"12px\\\",\\\"overflow\\\":\\\"hidden\\\",\\\"display\\\":\\\"flex\\\",\\\"justifyContent\\\":\\\"center\\\",\\\"alignItems\\\":\\\"center\\\",\\\"maxHeight\\\":\\\"450px\\\"},\\\"children\\\":[\\\"$\\\",\\\"$L1c\\\",null,{\\\"src\\\":\\\"/images/articles/concours-carola-racing-strasbourg-monaco.svg\\\",\\\"alt\\\":\\\"Concours Carola Racing Club Strasbourg vs Monaco expérience VIP\\\",\\\"width\\\":800,\\\"height\\\":450,\\\"style\\\":{\\\"width\\\":\\\"100%\\\",\\\"height\\\":\\\"100%\\\",\\\"objectFit\\\":\\\"contain\\\",\\\"maxHeight\\\":\\\"450px\\\"},\\\"priority\\\":true}]}]\\n11:[\\\"$\\\",\\\"$L1d\\\",null,{}]\\n12:[\\\"$\\\",\\\"$L1e\\\",null,{}]\\n1f:T1387,\"])</script><script>self.__next_f.push([1,\"\\u003cp\\u003e\\n\\u003ch2\\u003eConcours Carola — Une expérience VIP au Racing Club de Strasbourg\\u003c/h2\\u003e\\u003cp\\u003e\\u003cstrong\\u003eCarola\\u003c/strong\\u003e, la marque d'eau minérale alsacienne, organise un concours exceptionnel : gagner une \\u003cstrong\\u003ejournée VIP inoubliable\\u003c/strong\\u003e au cœur du Racing Club de Strasbourg pour le match \\u003cstrong\\u003eRacing vs Monaco le 16 mai\\u003c/strong\\u003e.\\u003c/p\\u003e\\u003cp\\u003eUne expérience habituellement inaccessible au grand public — et vous pouvez la remporter !\\u003c/p\\u003e\\u003chr\\u003e\\u003cp\\u003e\\u003cdiv class=\\\"cta-inline\\\"\\u003e\\u003ca href=\\\"https://www.carola.fr/jeux/\\\" class=\\\"btn btn-primary btn-sm\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eParticiper au concours Carola \\u003csvg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"13\\\" height=\\\"13\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"\\u003e\\u003cpath d=\\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\\"/\\u003e\\u003cpolyline points=\\\"15 3 21 3 21 9\\\"/\\u003e\\u003cline x1=\\\"10\\\" y1=\\\"14\\\" x2=\\\"21\\\" y2=\\\"3\\\"/\\u003e\\u003c/svg\\u003e\\u003c/a\\u003e\\u003c/div\\u003e\\u003ch2\\u003eCe que vous pouvez gagner\\u003c/h2\\u003e\\u003ch3\\u003eUne journée VIP complète au Racing Club de Strasbourg\\u003c/h3\\u003e\\u003cp\\u003eLe lot comprend tout ce qu'il faut pour vivre le match comme jamais :\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003e🏟️ Visite des coulisses du stade\\u003c/strong\\u003e\\nAccédez aux espaces réservés au staff et aux joueurs — les vestiaires, les tunnels, les zones habituellement fermées au public.\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003e📸 Accueil des équipes en zone mixte\\u003c/strong\\u003e\\nSoyez présente à l'arrivée des équipes, dans la zone mixte où les joueurs croisent les journalistes et partenaires officiels.\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003e🍽️ Repas gastronomique servi à table\\u003c/strong\\u003e\\nUn dîner gastronomique dans un cadre exceptionnel, au cœur du stade, avant le coup d'envoi.\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003e👕 Maillot officiel du Racing\\u003c/strong\\u003e\\nUn maillot officiel du Racing Club de Strasbourg remis en cadeau — le souvenir parfait de cette journée unique.\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003e🎟️ Places au plus près du terrain\\u003c/strong\\u003e\\nLes meilleures places pour vivre le match Racing vs Monaco au plus près de l'action.\\u003c/p\\u003e\\u003chr\\u003e\\u003cp\\u003e\\u003cdiv id=\\\"ezoic-pub-ad-placeholder-203\\\" class=\\\"ad-container\\\" style=\\\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\\\"\\u003e\\u003c/div\\u003e\\u003ch2\\u003eComment participer\\u003c/h2\\u003e\\u003cp\\u003eLa participation est \\u003cstrong\\u003egratuite\\u003c/strong\\u003e et se fait en 3 étapes :\\u003c/p\\u003e\\u003cp\\u003e1. \\u003cstrong\\u003eRemplissez le formulaire\\u003c/strong\\u003e sur le site Carola\\n2. \\u003cstrong\\u003eTéléchargez votre preuve d'achat\\u003c/strong\\u003e d'un produit Carola\\n3. \\u003cstrong\\u003eSuivez Carola sur les réseaux sociaux\\u003c/strong\\u003e pour valider votre participation\\u003c/p\\u003e\\u003cp\\u003eC'est tout ! Le tirage au sort désignera les gagnants.\\u003c/p\\u003e\\u003chr\\u003e\\u003cp\\u003e\\u003cdiv class=\\\"cta-inline\\\"\\u003e\\u003ca href=\\\"https://www.carola.fr/jeux/\\\" class=\\\"btn btn-primary btn-sm\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eParticiper au concours Carola \\u003csvg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"13\\\" height=\\\"13\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"\\u003e\\u003cpath d=\\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\\"/\\u003e\\u003cpolyline points=\\\"15 3 21 3 21 9\\\"/\\u003e\\u003cline x1=\\\"10\\\" y1=\\\"14\\\" x2=\\\"21\\\" y2=\\\"3\\\"/\\u003e\\u003c/svg\\u003e\\u003c/a\\u003e\\u003c/div\\u003e\\u003ch2\\u003ePourquoi tenter sa chance ?\\u003c/h2\\u003e\\u003cp\\u003eCe type d'expérience VIP n'est \\u003cstrong\\u003ejamais accessible au grand public\\u003c/strong\\u003e. Entre la visite des coulisses, le repas gastronomique et les places premium, la valeur estimée du lot dépasse largement \\u003cstrong\\u003e500€\\u003c/strong\\u003e.\\u003c/p\\u003e\\u003cp\\u003eLe match Racing vs Monaco le 16 mai s'annonce comme un choc de Ligue 1 — un cadre parfait pour une journée mémorable.\\u003c/p\\u003e\\u003chr\\u003e\\u003ch2\\u003eConseils pour votre participation\\u003c/h2\\u003e\\u003cp\\u003e\\u003cstrong\\u003eGardez vos tickets de caisse\\u003c/strong\\u003e\\nVous avez besoin d'une preuve d'achat d'un produit Carola. Gardez vos tickets ou téléchargez votre reçu numérique si vous achetez en ligne.\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003eSuivez Carola sur les réseaux\\u003c/strong\\u003e\\nL'abonnement aux réseaux sociaux Carola est nécessaire pour valider la participation — pensez-y avant d'envoyer le formulaire.\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003eParticipez vite\\u003c/strong\\u003e\\nLes concours de ce type ont souvent une date limite. Plus vous participez tôt, plus vous avez de temps si une correction est nécessaire sur votre dossier.\\u003c/p\\u003e\\u003chr\\u003e\\u003cp\\u003e\\u003cdiv id=\\\"ezoic-pub-ad-placeholder-206\\\" class=\\\"ad-container\\\" style=\\\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\\\"\\u003e\\u003c/div\\u003e\\u003ch2\\u003eEn résumé\\u003c/h2\\u003e\\u003cdiv class=\\\"table