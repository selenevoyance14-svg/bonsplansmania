rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500,\"border\":\"1px solid var(--border, #e5e7eb)\"},\"children\":[\"💄\",\" \",\"Box Beauté\"]}],[\"$\",\"a\",\"code-promo\",{\"href\":\"/categorie/code-promo\",\"style\":{\"padding\":\"6px 14px\",\"borderRadius\":\"999px\",\"background\":\"white\",\"fontSize\":\"0.82rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500,\"border\":\"1px solid var(--border, #e5e7eb)\"},\"children\":[\"🎟️\",\" \",\"Codes Promo\"]}],[\"$\",\"a\",\"beaute\",{\"href\":\"/categorie/beaute\",\"style\":{\"padding\":\"6px 14px\",\"borderRadius\":\"999px\",\"background\":\"white\",\"fontSize\":\"0.82rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500,\"border\":\"1px solid var(--border, #e5e7eb)\"},\"children\":[\"✨\",\" \",\"Beauté\"]}]]}]]}]\n19:[\"$\",\"div\",null,{\"style\":{\"maxWidth\":\"780px\",\"margin\":\"0 auto\"},\"children\":[[\"$\",\"div\",null,{\"style\":{\"display\":\"flex\",\"alignItems\":\"center\",\"gap\":\"12px\",\"flexWrap\":\"wrap\",\"margin\":\"32px 0 16px\"},\"children\":[[\"$\",\"$L20\",null,{\"slug\":\"guide-malin-batch-cooking-cuisine-economique-2026\"}],[\"$\",\"span\",null,{\"style\":{\"fontSize\":\"0.85rem\",\"color\":\"var(--text-muted, #6b7280)\"},\"children\":\"Partager :\"}],[[\"$\",\"a\",\"WhatsApp\",{\"href\":\"https://wa.me/?text=Guide%20Malin%20Batch%20Cooking%20%3A%20Cuisine%20une%20Fois%2C%20Mange%20Toute%20la%20Semaine%20-%20https%3A%2F%2Fbonsplansmania.fr%2Farticle%2Fguide-malin-batch-cooking-cuisine-economique-2026\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"style\":{\"padding\":\"6px 14px\",\"borderRadius\":\"999px\",\"background\":\"#25d366\",\"color\":\"white\",\"fontSize\":\"0.82rem\",\"fontWeight\":600,\"textDecoration\":\"none\"},\"children\":\"WhatsApp\"}],[\"$\",\"a\",\"Facebook\",{\"href\":\"https://www.facebook.com/sharer/sharer.php?u=https%3A%2F%2Fbonsplansmania.fr%2Farticle%