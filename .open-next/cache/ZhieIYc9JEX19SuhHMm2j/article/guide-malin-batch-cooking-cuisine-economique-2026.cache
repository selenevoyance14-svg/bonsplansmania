\\":[\\\"$\\\",\\\"$L1c\\\",null,{\\\"src\\\":\\\"/images/articles/guide-malin-batch-cooking-cuisine-economique-2026.svg\\\",\\\"alt\\\":\\\"Guide malin batch cooking cuisine economique 2026\\\",\\\"width\\\":800,\\\"height\\\":450,\\\"style\\\":{\\\"width\\\":\\\"100%\\\",\\\"height\\\":\\\"100%\\\",\\\"objectFit\\\":\\\"contain\\\",\\\"maxHeight\\\":\\\"450px\\\"},\\\"priority\\\":true}]}]\\n11:[\\\"$\\\",\\\"$L1d\\\",null,{}]\\n12:[\\\"$\\\",\\\"$L1e\\\",null,{}]\\n1f:T30e6,\"])</script><script>self.__next_f.push([1,\"\\u003cp\\u003e\\n\\u003ch2\\u003eLe batch cooking, c'est quoi ?\\u003c/h2\\u003e\\u003cp\\u003eLe principe est simple : tu cuisines \\u003cstrong\\u003e2 a 3 heures le dimanche\\u003c/strong\\u003e et tu as tes repas pour toute la semaine. Pas de prise de tete le soir en rentrant du boulot, pas de tentations fast-food, pas de gaspillage. Resultat : tu economises \\u003cstrong\\u003e150 a 200€ par mois\\u003c/strong\\u003e sur le budget courses et tu manges mieux.\\u003c/p\\u003e\\u003chr\\u003e\\u003cp\\u003e\\u003cdiv class=\\\"cta-inline\\\"\\u003e\\u003ca href=\\\"https://www.amazon.fr/s?k=batch+cooking+livre+boites+conservation\\u0026tag=lebrunnathali-21\\\" class=\\\"btn btn-primary btn-sm\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eVoir le materiel sur Amazon \\u003csvg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"13\\\" height=\\\"13\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"\\u003e\\u003cpath d=\\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\\"/\\u003e\\u003cpolyline points=\\\"15 3 21 3 21 9\\\"/\\u003e\\u003cline x1=\\\"10\\\" y1=\\\"14\\\" x2=\\\"21\\\" y2=\\\"3\\\"/\\u003e\\u003c/svg\\u003e\\u003c/a\\u003e\\u003c/div\\u003e\\u003ch2\\u003eLe materiel indispensable\\u003c/h2\\u003e\\u003cp\\u003ePour bien demarrer, il te faut quelques basiques. Un investissement de 50 a 80€ qui se rentabilise des le premier mois.\\u003c/p\\u003e\\u003ch3\\u003eConservation\\u003c/h3\\u003e\\u003cdiv class=\\\"table-wrapper\\\"\\u003e\\u003ctable class=\\\"comparison-table\\\"\\u003e\\u003cthead\\u003e\\u003ctr\\u003e\\n\\u003cth\\u003eMateriel\\u003c/th\\u003e\\u003cth\\u003ePourquoi\\u003c/th\\u003e\\u003cth\\u003eLien\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\u003c/thead\\u003e\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003ca href=\\\"https://www.amazon.fr/s?k=boites+conservation+verre+couvercle+lot+meal+prep\\u0026tag=lebrunnathali-21\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eBoites en verre avec couvercle (lot)\\u003c/a\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eCongelation, micro-ondes, four — elles font tout\\u003c/td\\u003e\\n\\u003ctd\\u003eAmazon\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003ca href=\\\"https://www.amazon.fr/s?k=boite+repas+compartiment+verre+meal+prep\\u0026tag=lebrunnathali-21\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eBoites compartimentees\\u003c/a\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003ePour emporter au bureau avec feculent + legume + proteine\\u003c/td\\u003e\\n\\u003ctd\\u003eAmazon\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003ca href=\\\"https://www.amazon.fr/s?k=sac+congelation+reutilisable+silicone\\u0026tag=lebrunnathali-21\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eSacs congelation reutilisables\\u003c/a\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003ePlus ecolo que les sacs jetables\\u003c/td\\u003e\\n\\u003ctd\\u003eAmazon\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003ca href=\\\"https://www.amazon.fr/s?k=etiquettes+autocollantes+congelation+date\\u0026tag=lebrunnathali-21\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eEtiquettes autocollantes\\u003c/a\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003ePour noter la date et le contenu\\u003c/td\\u003e\\n\\u003ctd\\u003eAmazon\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\u003c/table\\u003e\\u003c/div\\u003e\\u003ch3\\u003ePreparation\\u003c/h3\\u003e\\u003cdiv class=\\\"table-wrapper\\\"\\u003e\\u003ctable class=\\\"comparison-table\\\"\\u003e\\u003cthead\\u003e\\u003ctr\\u003e\\n\\u003cth\\u003eMateriel\\u003c/th\\u003e\\u003cth\\u003ePourquoi\\u003c/th\\u003e\\u003cth\\u003eLien\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\u003c/thead\\u003e\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003ca href=\\\"https://www.amazon.fr/s?k=mandoline+cuisine+legumes+professionnelle\\u0026tag=lebrunnathali-21\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eMandoline de cuisine\\u003c/a\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eCoupe les legumes en 2 minutes au lieu de 15\\u003c/td\\u003e\\n\\u003ctd\\u003eAmazon\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003ca href=\\\"https://www.amazon.fr/s?k=planche+a+decouper+grande+cuisine+bois\\u0026tag=lebrunnathali-21\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003ePlanche a decouper XXL\\u003c/a\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003ePlus c'est grand, plus c'est rapide\\u003c/td\\u003e\\n\\u003ctd\\u003eAmazon\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003ca href=\\\"https://www.amazon.fr/s?k=couteau+chef+cuisine+inox+professionnel\\u0026tag=lebrunnathali-21\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eCouteau de chef\\u003c/a\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eUn bon couteau change tout\\u003c/td\\u003e\\n\\u003ctd\\u003eAmazon\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\u003c/table\\u003e\\u003c/div\\u003e\\u003ch3\\u003eCuisson\\u003c/h3\\u003e\\u003cdiv class=\\\"table-wrapper\\\"\\u003e\\u003ctable class=\\\"comparison-table\\\"\\u003e\\u003cthead\\u003e\\u003ctr\\u003e\\n\\u003cth\\u003eMateriel\\u003c/th\\u003e\\u003cth\\u003ePourquoi\\u003c/th\\u003e\\u003cth\\u003eLien\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\u003c/thead\\u003e\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003ca href=\\\"https://www.amazon.fr/s?k=plaque+cuisson+four+grande+legumes\\u0026tag=lebrunnathali-21\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003ePlaque de cuisson four grande\\u003c/a\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eRotir legumes et viandes en quantite\\u003c/td\\u003e\\n\\u003ctd\\u003eAmazon\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003ca href=\\\"https://www.amazon.fr/s?k=cocotte+minute+autocuiseur+inox\\u0026tag=lebrunnathali-21\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eCocotte-minute / autocuiseur\\u003c/a\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eLegumineuses et viandes en 20 min au lieu de 2h\\u003c/td\\u003e\\n\\u003ctd\\u003eAmazon\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003ca href=\\\"https://www.amazon.fr/s?k=plat+gratin+grand+four+ceramique\\u0026tag=lebrunnathali-21\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003ePlat a gratin grand format\\u003c/a\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eLasagnes, gratins, parmentiers pour la semaine\\u003c/td\\u003e\\n\\u003ctd\\u003eAmazon\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\u003c/table\\u003e\\u003c/div\\u003e\\u003chr\\u003e\\u003cp\\u003e\\u003cdiv id=\\\"ezoic-pub-ad-placeholder-203\\\" class=\\\"ad-container\\\" style=\\\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\\\"\\u003e\\u003c/div\\u003e\\u003ch2\\u003eComment organiser ta session\\u003c/h2\\u003e\\u003ch3\\u003eEtape 1 : planifier le menu (15 min le samedi)\\u003c/h3\\u003e\\u003cp\\u003eChoisis \\u003cstrong\\u003e5 diners\\u003c/strong\\u003e pour la semaine. Les dejeuners seront les restes de la veille. Voici un exemple de semaine :\\u003c/p\\u003e\\u003cdiv class=\\\"table-wrapper\\\"\\u003e\\u003ctable class=\\\"comparison-table\\\"\\u003e\\u003cthead\\u003e\\u003ctr\\u003e\\n\\u003cth\\u003eJour\\u003c/th\\u003e\\u003cth\\u003eDiner\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\u003c/thead\\u003e\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eLundi\\u003c/td\\u003e\\n\\u003ctd\\u003eGratin de legumes + poulet\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eMardi\\u003c/td\\u003e\\n\\u003ctd\\u003eChili con carne + riz\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eMercredi\\u003c/td\\u003e\\n\\u003ctd\\u003eQuiche lorraine + salade\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eJeudi\\u003c/td\\u003e\\n\\u003ctd\\u003eCurry de pois chiches + riz\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eVendredi\\u003c/td\\u003e\\n\\u003ctd\\u003ePates bolognaise\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\u003c/table\\u003e\\u003c/div\\u003e\\u003ch3\\u003eEtape 2 : faire les courses (45 min)\\u003c/h3\\u003e\\u003cp\\u003eFais une \\u003cstrong\\u003eliste unique\\u003c/strong\\u003e a partir du menu. Achete en quantite : 2 kg de carottes, 1 kg d'oignons, 1 kg de riz. Les basiques (riz, pates, legumineuses, epices) s'achetent en gros sur Amazon pour moins cher :\\u003c/p\\u003e\\u003cul\\u003e\\u003cli\\u003e\\u003ca href=\\\"https://www.amazon.fr/s?k=riz+basmati+5kg\\u0026tag=lebrunnathali-21\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eRiz basmati 5 kg\\u003c/a\\u003e — revient a 2€/kg au lieu de 3-4€ en supermarche\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003ca href=\\\"https://www.amazon.fr/s?k=pois+chiches+secs+bio+1kg\\u0026tag=lebrunnathali-21\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003ePois chiches secs 1 kg\\u003c/a\\u003e — 3x moins cher que les conserves\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003ca href=\\\"https://www.amazon.fr/s?k=epices+cuisine+lot+grand+format\\u0026tag=lebrunnathali-21\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eEpices en pot grand format\\u003c/a\\u003e — cumin, paprika, curry, curcuma\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3\\u003eEtape 3 : cuisiner (2 a 3h le dimanche)\\u003c/h3\\u003e\\u003cp\\u003eL'ordre est important pour optimiser le temps :\\u003c/p\\u003e\\u003cp\\u003e1. \\u003cstrong\\u003eLance le four\\u003c/strong\\u003e — rotis les legumes et viandes (40 min sans rien faire)\\n2. \\u003cstrong\\u003ePendant ce temps, prepare\\u003c/strong\\u003e — epluche, coupe, hache\\n3. \\u003cstrong\\u003eLance les feculents\\u003c/strong\\u003e — riz, pates, lentilles (cuisson passive)\\n4. \\u003cstrong\\u003eFais les sauces\\u003c/strong\\u003e — bolognaise, curry, bechamel\\n5. \\u003cstrong\\u003eAssemble\\u003c/strong\\u003e — remplis les boites, etiquette, range au frigo/congelateur\\u003c/p\\u003e\\u003ch3\\u003eEtape 4 : stocker\\u003c/h3\\u003e\\u003cul\\u003e\\u003cli\\u003e\\u003cstrong\\u003eFrigo\\u003c/strong\\u003e : les repas de lundi a mercredi\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eCongelateur\\u003c/strong\\u003e : les repas de jeudi et vendredi\\u003c/li\\u003e\\n\\u003cli\\u003eSors le repas du congelateur la veille au soir\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\u003c/p\\u003e\\u003cp\\u003e\\u003cdiv class=\\\"cta-inline\\\"\\u003e\\u003ca href=\\\"https://www.amazon.fr/s?k=batch+cooking+livre+boites+conservation\\u0026tag=lebrunnathali-21\\\" class=\\\"btn btn-primary btn-sm\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eVoir le materiel sur Amazon \\u003csvg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"13\\\" height=\\\"13\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"\\u003e\\u003cpath d=\\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\\"/\\u003e\\u003cpolyline points=\\\"15 3 21 3 21 9\\\"/\\u003e\\u003cline x1=\\\"10\\\" y1=\\\"14\\\" x2=\\\"21\\\" y2=\\\"3\\\"/\\u003e\\u003c/svg\\u003e\\u003c/a\\u003e\\u003c/div\\u003e\\u003ch2\\u003e5 recettes batch cooking qui marchent a tous les coups\\u003c/h2\\u003e\\u003ch3\\u003e1. Base bolognaise (pour 8 portions)\\u003c/h3\\u003e\\u003cp\\u003eSert pour : pates bolo, lasagnes, chili, tacos, gratin\\u003c/p\\u003e\\u003cul\\u003e\\u003cli\\u003e1 kg de viande hachee (ou \\u003ca href=\\\"https://www.amazon.fr/s?k=proteine+soja+texturee+bio\\u0026tag=lebrunnathali-21\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eproteine de soja texturee\\u003c/a\\u003e pour la version veggie)\\u003c/li\\u003e\\n\\u003cli\\u003e2 boites de tomates pelees\\u003c/li\\u003e\\n\\u003cli\\u003e3 oignons, 3 carottes, 3 gousses d'ail\\u003c/li\\u003e\\n\\u003cli\\u003eHuile d'olive, sel, poivre, herbes de Provence\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\nFais revenir les oignons et carottes en des, ajoute la viande, puis les tomates. Laisse mijoter 30 min. Repartis dans 4 boites de 2 portions.\\u003c/p\\u003e\\u003ch3\\u003e2. Curry de legumes (pour 6 portions)\\u003c/h3\\u003e\\u003cul\\u003e\\u003cli\\u003e2 boites de \\u003ca href=\\\"https://www.amazon.fr/s?k=lait+de+coco+cuisine+bio\\u0026tag=lebrunnathali-21\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003elait de coco\\u003c/a\\u003e\\u003c/li\\u003e\\n\\u003cli\\u003e1 kg de legumes de saison coupes en morceaux\\u003c/li\\u003e\\n\\u003cli\\u003e1 boite de pois chiches\\u003c/li\\u003e\\n\\u003cli\\u003e2 cuilleres a soupe de \\u003ca href=\\\"https://www.amazon.fr/s?k=pate+curry+rouge+cuisine+thai\\u0026tag=lebrunnathali-21\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003epate de curry\\u003c/a\\u003e\\u003c/li\\u003e\\n\\u003cli\\u003eRiz basmati a cote\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\nFais revenir les legumes, ajoute la pate de curry et le lait de coco, laisse mijoter 20 min. Ajoute les pois chiches en fin de cuisson.\\u003c/p\\u003e\\u003ch3\\u003e3. Quiche universelle (pour 6 parts)\\u003c/h3\\u003e\\u003cul\\u003e\\u003cli\\u003e1 pate brisee (ou \\u003ca href=\\\"https://www.amazon.fr/s?k=rouleau+patisserie+bois\\u0026tag=lebrunnathali-21\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003efait maison\\u003c/a\\u003e : farine + beurre + eau)\\u003c/li\\u003e\\n\\u003cli\\u003e4 oeufs + 20 cl de creme\\u003c/li\\u003e\\n\\u003cli\\u003eGarniture au choix : lardons/poireaux, chevre/epinards, thon/tomates\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\nMelange oeufs + creme, ajoute la garniture, verse sur la pate, four 35 min a 180°C. Se mange froide le lendemain.\\u003c/p\\u003e\\u003ch3\\u003e4. Soupe XXL (pour 8 bols)\\u003c/h3\\u003e\\u003cul\\u003e\\u003cli\\u003e1,5 kg de legumes (poireaux, carottes, pommes de terre, courgettes)\\u003c/li\\u003e\\n\\u003cli\\u003e1 litre de bouillon\\u003c/li\\u003e\\n\\u003cli\\u003eSel, poivre, muscade\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\nTout dans la cocotte, 20 min, mixe. Repartis dans des boites pour la semaine. Un \\u003ca href=\\\"https://www.amazon.fr/s?k=mixeur+plongeant+puissant\\u0026tag=lebrunnathali-21\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003emixeur plongeant\\u003c/a\\u003e est indispensable.\\u003c/p\\u003e\\u003ch3\\u003e5. Riz saute tout-en-un (pour 4 portions)\\u003c/h3\\u003e\\u003cul\\u003e\\u003cli\\u003e400g de riz cuit (de la veille c'est encore mieux)\\u003c/li\\u003e\\n\\u003cli\\u003e2 oeufs\\u003c/li\\u003e\\n\\u003cli\\u003eLegumes coupes fin (carottes, petits pois, poivrons)\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003ca href=\\\"https://www.amazon.fr/s?k=sauce+soja+kikkoman\\u0026tag=lebrunnathali-21\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eSauce soja\\u003c/a\\u003e + \\u003ca href=\\\"https://www.amazon.fr/s?k=huile+sesame+cuisine+asiatique\\u0026tag=lebrunnathali-21\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003ehuile de sesame\\u003c/a\\u003e\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\nFais sauter les legumes, ajoute le riz, pousse sur le cote, brouille les oeufs, melange le tout avec la sauce soja.\\u003c/p\\u003e\\u003chr\\u003e\\u003ch2\\u003eCombien tu economises\\u003c/h2\\u003e\\u003cdiv class=\\\"table-wrapper\\\"\\u003e\\u003ctable class=\\\"comparison-table\\\"\\u003e\\u003cthead\\u003e\\u003ctr\\u003e\\n\\u003cth\\u003ePoste\\u003c/th\\u003e\\u003cth\\u003eSans batch cooking\\u003c/th\\u003e\\u003cth\\u003eAvec batch cooking\\u003c/th\\u003e\\u003cth\\u003eEconomie/mois\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\u003c/thead\\u003e\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eCourses\\u003c/td\\u003e\\n\\u003ctd\\u003e500-600€\\u003c/td\\u003e\\n\\u003ctd\\u003e300-400€\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e150-200€\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eFast-food/livraison\\u003c/td\\u003e\\n\\u003ctd\\u003e80-150€\\u003c/td\\u003e\\n\\u003ctd\\u003e0-20€\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e80-130€\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eGaspillage\\u003c/td\\u003e\\n\\u003ctd\\u003e50-80€\\u003c/td\\u003e\\n\\u003ctd\\u003e10-15€\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e40-65€\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003eTotal\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e630-830€\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e310-435€\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e270-395€\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\u003c/table\\u003e\\u003c/div\\u003e\\u003cp\\u003ePour une famille de 4, ca peut representer \\u003cstrong\\u003e3 000 a 4 000€ d'economie par an\\u003c/strong\\u003e.\\u003c/p\\u003e\\u003chr\\u003e\\u003cp\\u003e\\u003cdiv id=\\\"ezoic-pub-ad-placeholder-206\\\" class=\\\"ad-container\\\" style=\\\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\\\"\\u003e\\u003c/div\\u003e\\u003ch2\\u003ePour aller plus loin\\u003c/h2\\u003e\\u003cul\\u003e\\u003cli\\u003e\\u003ca href=\\\"https://www.amazon.fr/s?k=en+2h+je+cuisine+pour+toute+la+semaine\\u0026tag=lebrunnathali-21\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eLivre \\\"En 2h je cuisine pour toute la semaine\\\"\\u003c/a\\u003e — le bestseller du batch cooking en France\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003ca href=\\\"https://www.amazon.fr/s?k=simplissime+batch+cooking\\u0026tag=lebrunnathali-21\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eLivre \\\"Simplissime batch cooking\\\"\\u003c/a\\u003e — recettes ultra simples\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003ca href=\\\"https://www.amazon.fr/s?k=batch+cooking+vegetarien+livre\\u0026tag=lebrunnathali-21\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eLivre \\\"Mon batch cooking vegetarien\\\"\\u003c/a\\u003e — version sans viande, encore plus economique\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\u003c/p\\u003e\\u003ch2\\u003eNotre avis\\u003c/h2\\u003e\\u003cp\\u003eOn pratique le batch cooking depuis un moment et le plus dur c'est de s'y mettre. La premiere session prend un peu plus de temps parce qu'on cherche ses marques. Mais des la deuxieme semaine, ca roule. Le dimanche apres-midi tu cuisines en ecoutant un podcast, et le reste de la semaine tu profites.\\u003c/p\\u003e\\u003cp\\u003eLe vrai game changer c'est les boites en verre compartimentees. Tu sors ta boite du frigo le matin, tu la mets dans ton sac, et le midi t'as un repas complet fait maison. Plus de sandwich a 8€ ou de menu fast-food a 12€. Sur un mois, ca change tout.\\n\\u003c/p\\u003e\"])</script><script>self.__next_f.push([1,\"13:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"article-content\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"$1f\\\"}}]}]\\n14:[\\\"$\\\",\\\"$L1d\\\",null,{}]\\n15:[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"textAlign\\\":\\\"center\\\",\\\"margin\\\":\\\"40px 0\\\",\\\"padding\\\":\\\"32px\\\",\\\"background\\\":\\\"linear-gradient(135deg, #FFF0F0 0%, #FFF8F0 100%)\\\",\\\"borderRadius\\\":\\\"16px\\\",\\\"border\\\":\\\"2px solid #FECDD3\\\"},\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"style\\\":{\\\"fontWeight\\\":800,\\\"fontSize\\\":\\\"1.2rem\\\",\\\"marginBottom\\\":\\\"16px\\\",\\\"color\\\":\\\"var(--foreground)\\\"},\\\"children\\\":\\\"Profiter de cette offre\\\"}],[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://www.amazon.fr/s?k=batch+cooking+livre+boites+conservation\\u0026tag=lebrunnathali-21\\\",\\\"className\\\":\\\"btn btn-primary\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"nofollow sponsored noopener\\\",\\\"style\\\":{\\\"padding\\\":\\\"14px 32px\\\",\\\"fontSize\\\":\\\"1rem\\\"},\\\"children\\\":[\\\"Voir le materiel sur Amazon\\\",\\\" \\\",[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":15,\\\"height\\\":15,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-external-link\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":[[\\\"$\\\",\\\"path\\\",\\\"1q9fwt\\\",{\\\"d\\\":\\\"M15 3h6v6\\\"}],[\\\"$\\\",\\\"path\\\",\\\"gplh6r\\\",{\\\"d\\\":\\\"M10 14 21 3\\\"}],[\\\"$\\\",\\\"path\\\",\\\"a6xqqp\\\",{\\\"d\\\":\\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\\"}],\\\"$undefined\\\"]}]]}]]}]\\n16:[\\\"$\\\",\\\"$L1d\\\",null,{}]\\n\"])</script><s