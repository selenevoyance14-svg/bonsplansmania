\",null,{\\\"name\\\":\\\"next-size-adjust\\\",\\\"content\\\":\\\"\\\"}]]}],false]],\\\"m\\\":\\\"$undefined\\\",\\\"G\\\":[\\\"$d\\\",[]],\\\"S\\\":true}\\n\"])</script><script>self.__next_f.push([1,\"e:I[83608,[\\\"/_next/static/chunks/cf200c391baea40a.js\\\",\\\"/_next/static/chunks/6e48aeeec84550f8.js\\\"],\\\"default\\\"]\\n\"])</script><script>self.__next_f.push([1,\"5:[[\\\"$\\\",\\\"script\\\",null,{\\\"type\\\":\\\"application/ld+json\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"{\\\\\\\"@context\\\\\\\":\\\\\\\"https://schema.org\\\\\\\",\\\\\\\"@type\\\\\\\":\\\\\\\"Article\\\\\\\",\\\\\\\"headline\\\\\\\":\\\\\\\"Dogofriends : Testez Gratuitement des Produits pour Chien et Chat\\\\\\\",\\\\\\\"description\\\\\\\":\\\\\\\"Dogofriends sélectionne des propriétaires d'animaux pour tester des croquettes et produits gratuits pendant 3 à 4 semaines. Perfect Fit, PRO PLAN, Edgard \\u0026 Cooper... Comment s'inscrire ?\\\\\\\",\\\\\\\"datePublished\\\\\\\":\\\\\\\"2026-03-03\\\\\\\",\\\\\\\"dateModified\\\\\\\":\\\\\\\"2026-03-03\\\\\\\",\\\\\\\"image\\\\\\\":\\\\\\\"https://bonsplansmania.fr/images/articles/dogofriends-test-produit-chien-chat-animaux-gratuit.svg\\\\\\\",\\\\\\\"mainEntityOfPage\\\\\\\":{\\\\\\\"@type\\\\\\\":\\\\\\\"WebPage\\\\\\\",\\\\\\\"@id\\\\\\\":\\\\\\\"https://bonsplansmania.fr/article/dogofriends-test-produit-chien-chat-animaux-gratuit\\\\\\\"},\\\\\\\"author\\\\\\\":{\\\\\\\"@type\\\\\\\":\\\\\\\"Organization\\\\\\\",\\\\\\\"name\\\\\\\":\\\\\\\"Bons Plans Mania\\\\\\\",\\\\\\\"url\\\\\\\":\\\\\\\"https://bonsplansmania.fr\\\\\\\"},\\\\\\\"publisher\\\\\\\":{\\\\\\\"@type\\\\\\\":\\\\\\\"Organization\\\\\\\",\\\\\\\"name\\\\\\\":\\\\\\\"Bons Plans Mania\\\\\\\",\\\\\\\"url\\\\\\\":\\\\\\\"https://bonsplansmania.fr\\\\\\\",\\\\\\\"logo\\\\\\\":{\\\\\\\"@type\\\\\\\":\\\\\\\"ImageObject\\\\\\\",\\\\\\\"url\\\\\\\":\\\\\\\"https://bonsplansmania.fr/icon.svg\\\\\\\"}}}\\\"}}],null,[\\\"$\\\",\\\"script\\\",null,{\\\"type\\\":\\\