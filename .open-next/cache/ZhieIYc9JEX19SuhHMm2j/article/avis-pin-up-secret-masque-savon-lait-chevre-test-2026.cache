/2000/svg\\\",\\\"width\\\":13,\\\"height\\\":13,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-clock\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":[[\\\"$\\\",\\\"path\\\",\\\"mmk7yg\\\",{\\\"d\\\":\\\"M12 6v6l4 2\\\"}],[\\\"$\\\",\\\"circle\\\",\\\"1mglay\\\",{\\\"cx\\\":\\\"12\\\",\\\"cy\\\":\\\"12\\\",\\\"r\\\":\\\"10\\\"}],\\\"$undefined\\\"]}],\\\" \\\",\\\"6 min\\\"]}]]}],[\\\"$\\\",\\\"h1\\\",null,{\\\"children\\\":\\\"Notre Avis sur Pin Up Secret : Test des Masques et Soins Solides au Lait de Chevre\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"article-subtitle\\\",\\\"children\\\":\\\"Test et avis complet sur Pin Up Secret : savon-masque Secret Teint Précieux et masque Curcuma au lait de chèvre. 78 000 avis vérifiés, 4.6/5. Notre verdict honnête.\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"article-rating-bar\\\",\\\"children\\\":[\\\"$undefined\\\",\\\"$undefined\\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://a.time1.me/r?promoid=243139\\u0026progid=8054\\u0026partid=61992\\\",\\\"className\\\":\\\"btn btn-primary btn-sm\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"nofollow sponsored noopener\\\",\\\"children\\\":[\\\"Découvrir Pin Up Secret\\\",\\\" \\\",\\\"$Lf\\\"]}]]}]]}],\\\"$L10\\\",\\\"$L11\\\",\\\"$L12\\\",\\\"$L13\\\",\\\"$L14\\\",\\\"$L15\\\"]}],\\\"$L16\\\",\\\"$L17\\\",\\\"$L18\\\",\\\"$L19\\\"]}]}],\\\"$L1a\\\",\\\"$L1b\\\"]\\n\"])</script><script>self.__next_f.push([1,\"1c:I[5500,[\\\"/_next/static/chunks/cf200c391baea40a.js\\\",\\\"/_next/static/chunks/6e48aeeec84550f8.js\\\"],\\\"Image\\\"]\\n1d:I[96788,[\\\"/_next/static/chunks/cf200c391baea40a.js\\\",\\\"/_next/static/chunks/6e48aeeec84550f8.js\\\"],\\\"default\\\"]\\n1e:I[1586,[\\\"/_next/static/chunks/cf200c391baea40a.js\\\",\\\"/_next/static/chunks/6e48aeeec84550f8.js\\\"],\\\"default\\\"]\\n20:I[67277,[\\\"/_next/static/chunks/cf200c391baea40a.js\\\",\\\"/_next/static/chunks/6e48aeeec84550f8.js\\\"],\\\"default\\\"]\\nf:[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":13,\\\"height\\\":13,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-external-link\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":[[\\\"$\\\",\\\"path\\\",\\\"1q9fwt\\\",{\\\"d\\\":\\\"M15 3h6v6\\\"}],[\\\"$\\\",\\\"path\\\",\\\"gplh6r\\\",{\\\"d\\\":\\\"M10 14 21 3\\\"}],[\\\"$\\\",\\\"path\\\",\\\"a6xqqp\\\",{\\\"d\\\":\\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\\"}],\\\"$undefined\\\"]}]\\n10:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"article-hero-image\\\",\\\"style\\\":{\\\"background\\\":\\\"#fff\\\",\\\"borderRadius\\\":\\\"12px\\\",\\\"overflow\\\":\\\"hidden\\\",\\\"display\\\":\\\"flex\\\",\\\"justifyContent\\\":\\\"center\\\",\\\"alignItems\\\":\\\"center\\\",\\\"maxHeight\\\":\\\"450px\\\"},\\\"children\\\":[\\\"$\\\",\\\"$L1c\\\",null,{\\\"src\\\":\\\"/images/articles/avis-pin-up-secret-masque-savon-lait-chevre-test-2026.svg\\\",\\\"alt\\\":\\\"Pin Up Secret avis test masque savon lait de chèvre 2026\\\",\\\"width\\\":800,\\\"height\\\":450,\\\"style\\\":{\\\"width\\\":\\\"100%\\\",\\\"height\\\":\\\"100%\\\",\\\"objectFit\\\":\\\"contain\\\",\\\"maxHeight\\\":\\\"450px\\\"},\\\"priority\\\":true}]}]\\n11:[\\\"$\\\",\\\"$L1d\\\",null,{}]\\n12:[\\\"$\\\",\\\"$L1e\\\",null,{}]\\n1f:T235f,\"])</script><script>self.__next_f.push([1,\"\\u003cp\\u003e\\n\\u003ch2\\u003ePin Up Secret : on a testé les soins solides au lait de chèvre\\u003c/h2\\u003e\\u003cp\\u003e\\u003cstrong\\u003ePin Up Secret\\u003c/strong\\u003e fait beaucoup parler d'elle depuis quelques années. Cette marque française fondée en 2011 mise tout sur le \\u003cstrong\\u003elait de chèvre\\u003c/strong\\u003e comme ingrédient star de ses soins visage. Avec plus de \\u003cstrong\\u003e78 000 avis vérifiés\\u003c/strong\\u003e et une note moyenne de \\u003cstrong\\u003e4.6/5\\u003c/strong\\u003e, les retours clients sont impressionnants. Mais est-ce que ça vaut vraiment le buzz ? On a testé les deux produits phares de la marque pour te donner notre avis.\\u003c/p\\u003e\\u003chr\\u003e\\u003cp\\u003e\\u003cdiv class=\\\"cta-inline\\\"\\u003e\\u003ca href=\\\"https://a.time1.me/r?promoid=243139\\u0026progid=8054\\u0026partid=61992\\\" class=\\\"btn btn-primary btn-sm\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eDécouvrir Pin Up Secret \\u003csvg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"13\\\" height=\\\"13\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"\\u003e\\u003cpath d=\\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\\"/\\u003e\\u003cpolyline points=\\\"15 3 21 3 21 9\\\"/\\u003e\\u003cline x1=\\\"10\\\" y1=\\\"14\\\" x2=\\\"21\\\" y2=\\\"3\\\"/\\u003e\\u003c/svg\\u003e\\u003c/a\\u003e\\u003c/div\\u003e\\u003ch2\\u003ePin Up Secret, c'est quoi exactement\\u003c/h2\\u003e\\u003cp\\u003ePin Up Secret est une marque de cosmétiques française spécialisée dans les soins au lait de chèvre. Quelques repères :\\u003c/p\\u003e\\u003cul\\u003e\\u003cli\\u003e\\u003cstrong\\u003eFondée en 2011\\u003c/strong\\u003e en France\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eIngrédient signature\\u003c/strong\\u003e : le lait de chèvre, reconnu pour ses propriétés hydratantes et apaisantes\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eFormat solide\\u003c/strong\\u003e : des savons-masques et masques en barre, sans emballage superflu\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e78 000+ avis vérifiés\\u003c/strong\\u003e sur la plateforme Société des Avis Garantis — ce n'est pas rien\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eCertifications\\u003c/strong\\u003e : ISO 13485 et ISO 16128 pour le produit phare\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eAdaptée aux peaux sensibles\\u003c/strong\\u003e : le lait de chèvre a un pH proche de celui de la peau\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\u003c/p\\u003e\\u003cp\\u003e\\u003cdiv id=\\\"ezoic-pub-ad-placeholder-203\\\" class=\\\"ad-container\\\" style=\\\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\\\"\\u003e\\u003c/div\\u003e\\u003ch2\\u003eLes 2 produits qu'on a testés\\u003c/h2\\u003e\\u003ch3\\u003e1. Secret Teint Précieux — le savon-masque signature\\u003c/h3\\u003e\\u003cp\\u003eC'est le best-seller de Pin Up Secret. Un soin solide 2-en-1 qui s'utilise comme nettoyant quotidien et comme masque. On l'applique sur le visage humide, on masse, et on peut soit rincer directement (mode nettoyant) soit laisser poser 2-3 minutes (mode masque).\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003eCe qu'on a aimé :\\u003c/strong\\u003e\\u003c/p\\u003e\\u003cul\\u003e\\u003cli\\u003eLa mousse est onctueuse et douce — rien à voir avec un savon classique qui assèche\\u003c/li\\u003e\\n\\u003cli\\u003eEn mode nettoyant, il enlève bien les impuretés sans laisser la peau qui tiraille\\u003c/li\\u003e\\n\\u003cli\\u003eEn mode masque, la peau est visiblement plus lisse et lumineuse après le rinçage\\u003c/li\\u003e\\n\\u003cli\\u003eLa composition est correcte : lait de chèvre, beurre de karité, huiles essentielles\\u003c/li\\u003e\\n\\u003cli\\u003eLe format solide dure longtemps — facilement 2-3 mois d'utilisation quotidienne\\u003c/li\\u003e\\n\\u003cli\\u003eScore Yuka : \\u003cstrong\\u003e65/100\\u003c/strong\\u003e — note \\\"Bien\\\", quelques allergènes légers (citronellol, géraniol, linalol) mais rien d'alarmant\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003cstrong\\u003eCe qu'on a moins aimé :\\u003c/strong\\u003e\\u003c/p\\u003e\\u003cul\\u003e\\u003cli\\u003eLe parfum est assez présent — si tu es sensible aux odeurs, ça peut gêner\\u003c/li\\u003e\\n\\u003cli\\u003eLe score Yuka à 65/100 est correct mais pas exceptionnel — les puristes de la composition voudront peut-être mieux\\u003c/li\\u003e\\n\\u003cli\\u003eIl faut bien le laisser sécher entre chaque utilisation pour qu'il ne fonde pas trop vite\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003cstrong\\u003eNotre verdict :\\u003c/strong\\u003e le Secret Teint Précieux mérite sa réputation. On l'utilise depuis plusieurs semaines en alternance nettoyant/masque et la peau est clairement plus nette. Ce n'est pas un produit miracle, mais c'est un bon nettoyant visage qui hydrate en même temps — et ça, c'est assez rare.\\u003c/p\\u003e\\u003chr\\u003e\\u003ch3\\u003e2. Masque Curcuma — l'exfoliant doux\\u003c/h3\\u003e\\u003cp\\u003eLe deuxième produit de notre test : un masque solide au curcuma et au lait de chèvre. Celui-ci est un exfoliant enzymatique — il n'utilise pas de grains abrasifs mais des enzymes protéolytiques qui dissolvent les cellules mortes en douceur.\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003eCe qu'on a aimé :\\u003c/strong\\u003e\\u003c/p\\u003e\\u003cul\\u003e\\u003cli\\u003eL'exfoliation est douce et progressive — pas d'irritation ni de rougeurs, même sur peau sensible\\u003c/li\\u003e\\n\\u003cli\\u003eLe curcuma donne un vrai coup d'éclat, le teint est plus lumineux dès la première utilisation\\u003c/li\\u003e\\n\\u003cli\\u003ePas de grains abrasifs : l'exfoliation enzymatique est beaucoup plus respectueuse de la peau\\u003c/li\\u003e\\n\\u003cli\\u003eLe format solide est pratique et économique\\u003c/li\\u003e\\n\\u003cli\\u003eScore Yuka : \\u003cstrong\\u003e65/100\\u003c/strong\\u003e — même niveau que le savon-masque\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003cstrong\\u003eCe qu'on a moins aimé :\\u003c/strong\\u003e\\u003c/p\\u003e\\u003cul\\u003e\\u003cli\\u003eLe curcuma peut légèrement teinter les peaux très claires — bien rincer après utilisation\\u003c/li\\u003e\\n\\u003cli\\u003eL'effet exfoliant est subtil : si tu cherches un peeling intense, ce n'est pas le bon produit\\u003c/li\\u003e\\n\\u003cli\\u003eÀ utiliser 2-3 fois par semaine maximum, pas tous les jours\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003cstrong\\u003eNotre verdict :\\u003c/strong\\u003e un bon complément au Secret Teint Précieux. On alterne les deux dans la semaine (le savon-masque au quotidien, le curcuma 2-3 fois par semaine) et la routine fonctionne bien. L'exfoliation enzymatique est un vrai plus si tu as la peau sensible et que les gommages classiques t'irritent.\\u003c/p\\u003e\\u003chr\\u003e\\u003cp\\u003e\\u003cdiv class=\\\"cta-inline\\\"\\u003e\\u003ca href=\\\"https://a.time1.me/r?promoid=243139\\u0026progid=8054\\u0026partid=61992\\\" class=\\\"btn btn-primary btn-sm\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eDécouvrir Pin Up Secret \\u003csvg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"13\\\" height=\\\"13\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"\\u003e\\u003cpath d=\\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\\"/\\u003e\\u003cpolyline points=\\\"15 3 21 3 21 9\\\"/\\u003e\\u003cline x1=\\\"10\\\" y1=\\\"14\\\" x2=\\\"21\\\" y2=\\\"3\\\"/\\u003e\\u003c/svg\\u003e\\u003c/a\\u003e\\u003c/div\\u003e\\u003ch2\\u003eCe que disent les clientes\\u003c/h2\\u003e\\u003cp\\u003eLes chiffres parlent d'eux-mêmes :\\u003c/p\\u003e\\u003cul\\u003e\\u003cli\\u003e\\u003cstrong\\u003e92% d'avis 5 étoiles\\u003c/strong\\u003e\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e5% d'avis 4 étoiles\\u003c/strong\\u003e\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e3% d'avis 3 étoiles et moins\\u003c/strong\\u003e\\u003c/li\\u003e\\n\\u003cli\\u003eNote globale : \\u003cstrong\\u003e4.6/5\\u003c/strong\\u003e sur plus de 78 000 avis vérifiés\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\nLes retours positifs reviennent sur l'effet sur le teint (plus lumineux, plus net), la douceur du nettoyage (pas de tiraillement), et la durée de vie des produits. Les rares critiques concernent le parfum jugé trop fort par certaines et le prix.\\u003c/p\\u003e\\u003chr\\u003e\\u003ch2\\u003ePour qui on recommande Pin Up Secret\\u003c/h2\\u003e\\u003cul\\u003e\\u003cli\\u003eTu as la \\u003cstrong\\u003epeau mixte à grasse\\u003c/strong\\u003e et tu cherches un nettoyant qui régule sans assécher\\u003c/li\\u003e\\n\\u003cli\\u003eTu as des \\u003cstrong\\u003eimperfections légères\\u003c/strong\\u003e (points noirs, pores dilatés, teint terne)\\u003c/li\\u003e\\n\\u003cli\\u003eTu veux \\u003cstrong\\u003esimplifier ta routine\\u003c/strong\\u003e avec un produit 2-en-1 nettoyant + masque\\u003c/li\\u003e\\n\\u003cli\\u003eTu es sensible au \\u003cstrong\\u003emade in France\\u003c/strong\\u003e et aux compositions sans ingrédients controversés\\u003c/li\\u003e\\n\\u003cli\\u003eTu as la \\u003cstrong\\u003epeau sensible\\u003c/strong\\u003e et les gommages à grains t'irritent — le masque curcuma est une bonne alternative\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\u003c/p\\u003e\\u003cp\\u003e\\u003cdiv id=\\\"ezoic-pub-ad-placeholder-206\\\" class=\\\"ad-container\\\" style=\\\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\\\"\\u003e\\u003c/div\\u003e\\u003ch2\\u003eQuestions fréquentes\\u003c/h2\\u003e\\u003cp\\u003e\\u003cstrong\\u003ePin Up Secret est-elle une marque fiable ?\\u003c/strong\\u003e\\nOui. La marque existe depuis 2011, est fabriquée en France, et cumule plus de 78 000 avis vérifiés avec une note de 4.6/5. Les certifications ISO ajoutent une couche de crédibilité.\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003eLe lait de chèvre est-il bon pour la peau ?\\u003c/strong\\u003e\\nLe lait de chèvre contient des acides gras, des vitamines (A, B, E) et des minéraux. Son pH est proche de celui de la peau, ce qui le rend bien toléré, y compris sur peaux sensibles. Il est utilisé en cosmétique depuis des siècles.\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003ePeut-on utiliser le Secret Teint Précieux tous les jours ?\\u003c/strong\\u003e\\nOui, en mode nettoyant. En mode masque (pose de 2-3 minutes), 2-3 fois par semaine suffisent.\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003eEst-ce que ça convient aux peaux sèches ?\\u003c/strong\\u003e\\nOui, grâce au beurre de karité et au lait de chèvre qui hydratent. Mais si tu as la peau très sèche, complète avec une crème hydratante après.\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003eOù acheter Pin Up Secret ?\\u003c/strong\\u003e\\nLa marque est disponible sur le site officiel Pin Up Secret et sur plusieurs revendeurs en ligne.\\u003c/p\\u003e\\u003chr\\u003e\\u003ch2\\u003eNotre avis final\\u003c/h2\\u003e\\u003cp\\u003eOn donne \\u003cstrong\\u003e4.5/5\\u003c/strong\\u003e à Pin Up Secret. La marque a réussi un pari difficile : créer des soins solides efficaces avec le lait de chèvre comme ingrédient différenciant. Le Secret Teint Précieux est un vrai bon produit — il nettoie, il hydrate, il fait office de masque, et la peau est plus nette après quelques semaines d'utilisation. Le masque Curcuma complète bien la routine avec une exfoliation douce.\\u003c/p\\u003e\\u003cp\\u003eOn retire un demi-point pour les scores Yuka moyens (65/100 — correct mais pas exemplaire) et le parfum un peu trop présent. Mais dans l'ensemble, les 78 000 avis positifs ne mentent pas : Pin Up Secret tient ses promesses. Si tu cherches à améliorer ton teint avec des soins simples et efficaces, ça vaut le coup de tester.\\n\\u003c/p\\u003e\"])</script><script>self.__next_f.push([1,\"13:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"article-content\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"$1f\\\"}}]}]\\n14:[\\\"$\\\",\\\"$L1d\\\",null,{}]\\n15:[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"textAlign\\\":\\\"center\\\",\\\"margin\\\":\\\"40px 0\\\",\\\"padding\\\":\\\"32px\\\",\\\"background\\\":\\\"linear-gradient(135deg, #FFF0F0 0%, #FFF8F0 100%)\\\",\\\"borderRadius\\\":\\\"16px\\\",\\\"border\\\":\\\"2px solid #FECDD3\\\"},\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"style\\\":{\\\"fontWeight\\\":800,\\\"fontSize\\\":\\\"1.2rem\\\",\\\"marginBottom\\\":\\\"16px\\\",\\\"color\\\":\\\"var(--foreground)\\\"},\\\"children\\\":\\\"Profiter de cette offre\\\"}],[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://a.time1.me/r?promoid=243139\\u0026progid=8054\\u0026partid=61992\\\",\\\"className\\\":\\\"btn btn-primary\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"nofollow sponsored noopener\\\",\\\"style\\\":{\\\"padding\\\":\\\"14px 32px\\\",\\\"fontSize\\\":\\\"1rem\\\"},\\\"children\\\":[\\\"Découvrir Pin Up Secret\\\",\\\" \\\",[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":15,\\\"height\\\":15,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-external-link\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":[[\\\"$\\\",\\\"path\\\",\\\"1q9fwt\\\",{\\\"d\\\":\\\"M15 3h6v6\\\"}],[\\\"$\\\",\\\"path\\\",\\\"gplh6r\\\",{\\\"d\\\":\\\"M10 14 21 3\\\"}],[\\\"$\\\",\\\"path\\\",\\\"a6xqqp\\\",{\\\"d\\\":\\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\\"}],\\\"$undefined\\\"]}]]}]]}]\\n16:[\\\"$\\\",\\\"$L1d\\\",null,{}]\\n\"])</script><script>self.__next_f.push([1,\"17:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"related-articles\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"children\\\":\\\"A lire aussi\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"articles-grid\\\",\\\"style\\\":{\\\"gridTemplateColumns\\\":\\\"repeat(auto-fit, minmax(280px, 1fr))\\\"},\\\"children\\\":[[\\\"$\\\",\\\"a\\\",\\\"avis-jod-cosmetics-baumes-fondants-soins-naturels-test-2026\\\",{\\\"href\\\":\\\"/article/avis-jod-cosmetics-baumes-fondants-soins-naturels-test-2026\\\",\\\"className\\\":\\\"card\\\",\\\"style\\\":{\\\"textDecoration\\\":\\\"none\\\"},\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"position\\\":\\\"relative\\\",\\\"height\\\":\\\"160px\\\",\\\"overflow\\\":\\\"hidden\\\"},\\\"children\\\":[\\\"$\\\",\\\"$L1c\\\",null,{\\\"src\\\":\\\"/images/articles/avis-jod-cosmetics-baumes-fondants-soins-naturels-test-2026.svg\\\",\\\"alt\\\":\\\"JOD Cosmetics avis test baumes fondants soins naturels 2026\\\",\\\"fill\\\":true,\\\"style\\\":{\\\"objectFit\\\":\\\"cover\\\"},\\\"sizes\\\":\\\"33vw\\\"}]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"card-body\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"style\\\":{\\\"fontSize\\\":\\\"0.72rem\\\",\\\"fontWeight\\\":600,\\\"color\\\":\\\"var(--primary)\\\",\\\"textTransform\\\":\\\"uppercase\\\",\\\"letterSpacing\\\":\\\"0.5px\\\"},\\\"children\\\":[\\\"🎁\\\",\\\" \\\",\\\"Test Gratuit\\\"]}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"card-title\\\",\\\"children\\\":\\\"Notre Avis sur JOD Cosmetics : Test Complet des Baumes Fondants\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"card-excerpt\\\",\\\"children\\\":\\\"Test et avis complet sur JOD Cosmetics : huile démaquillante stick, soin visage jour et blush baume. Composition 100/100 Yuka, made in France, vegan. On vous dit tout.\\\"}]]}]]}],[\\\"$\\\",\\\"a\\\",\\\"avis-filorga-time-filler-ncef-optim-eyes-test-anti-age-2026\\\",{\\\"href\\\":\\\"/article/avis-filorga-time-filler-ncef-optim-eyes-test-anti-age-2026\\\",\\\"className\\\":\\\"card\\\",\\\"style\\\":{\\\"textDecoration\\\":\\\"none\\\"},\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"