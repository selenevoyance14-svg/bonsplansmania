ren\":\"avis\"}]\n28:[\"$\",\"a\",\"amazon\",{\"href\":\"/marque/amazon\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"amazon\"}]\na:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n29:I[27201,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/d2be314c3ece3fbe.js\"],\"IconMark\"]\n8:null\nc:[[\"$\",\"title\",\"0\",{\"children\":\"Avis déodorant Wild : naturel et rechargeable, on l'a testé\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Notre verdict sur le déodorant Wild après 1 mois. Sans aluminium, rechargeable, noté jusqu'à 93/100 sur Yuka. Composition, efficacité et limites.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"manifest\",\"href\":\"/manifest.json\",\"crossOrigin\":\"$undefined\"}],[\"$\",\"meta\",\"3\",{\"name\":\"keywords\",\"content\":\"bons plans beauté,tests produits gratuits,concours beauté,box beauté,réductions cosmétiques,codes promo beauté,échantillons gratuits\"}],[\"$\",\"link\",\"4\",{\"rel\":\"canonical\",\"href\":\"https://bonsplansmania.fr/article/wild-deodorant-naturel-rechargeable-avis-test-complet\"}],[\"$\",\"meta\",\"5\",{\"property\":\"og:title\",\"content\":\"Déodorant Wild : le déo naturel rechargeable qui fait le buzz (notre avis après 1 mois)\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:description\",\"content\":\"Notre avis sur le déodorant Wild après 1 mois de test. Naturel, rechargeable, sans sels d'aluminium. Composition, efficacité, notes Yuka et avis clients.\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:image\",\"content\":\"http://localhost:3000/images/articles/wild-deodorant-naturel-rechargeable-avis-test-complet.svg\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:type\",\"content\":\"article\"}],[\"$\",\"meta\",\"9\",{\