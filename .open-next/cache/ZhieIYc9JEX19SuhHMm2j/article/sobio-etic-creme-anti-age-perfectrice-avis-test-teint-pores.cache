\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500,\"border\":\"1px solid var(--border, #e5e7eb)\"},\"children\":[\"🎁\",\" \",\"Tests Gratuits\"]}],[\"$\",\"a\",\"concours\",{\"href\":\"/categorie/concours\",\"style\":{\"padding\":\"6px 14px\",\"borderRadius\":\"999px\",\"background\":\"white\",\"fontSize\":\"0.82rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500,\"border\":\"1px solid var(--border, #e5e7eb)\"},\"children\":[\"🏆\",\" \",\"Concours\"]}],[\"$\",\"a\",\"box-beaute\",{\"href\":\"/categorie/box-beaute\",\"style\":{\"padding\":\"6px 14px\",\"borderRadius\":\"999px\",\"background\":\"white\",\"fontSize\":\"0.82rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500,\"border\":\"1px solid var(--border, #e5e7eb)\"},\"children\":[\"💄\",\" \",\"Box Beauté\"]}],[\"$\",\"a\",\"code-promo\",{\"href\":\"/categorie/code-promo\",\"style\":{\"padding\":\"6px 14px\",\"borderRadius\":\"999px\",\"background\":\"white\",\"fontSize\":\"0.82rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500,\"border\":\"1px solid var(--border, #e5e7eb)\"},\"children\":[\"🎟️\",\" \",\"Codes Promo\"]}],[\"$\",\"a\",\"beaute\",{\"href\":\"/categorie/beaute\",\"style\":{\"padding\":\"6px 14px\",\"borderRadius\":\"999px\",\"background\":\"white\",\"fontSize\":\"0.82rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500,\"border\":\"1px solid var(--border, #e5e7eb)\"},\"children\":[\"✨\",\" \",\"Beauté\"]}]]}]]}]\n19:[\"$\",\"div\",null,{\"style\":{\"maxWidth\":\"780px\",\"margin\":\"0 auto\"},\"children\":[[\"$\",\"div\",null,{\"style\":{\"display\":\"flex\",\"alignItems\":\"center\",\"gap\":\"12px\",\"flexWrap\":\"wrap\",\"margin\":\"32px 0 16px\"},\"children\":[[\"$\",\"$L20\",null,{\"slug\":\"sobio-etic-creme-anti-age-perfectrice-avis-test-teint-pores\"}],[\"$\",\"span\",null,{\"style\":{\"fontSize\":\"0.85rem\",\"color\"