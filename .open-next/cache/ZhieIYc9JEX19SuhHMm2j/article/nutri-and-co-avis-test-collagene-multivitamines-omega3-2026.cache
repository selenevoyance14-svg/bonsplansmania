ivitamines\"}]\n25:[\"$\",\"a\",\"oméga-3\",{\"href\":\"/marque/omga-3\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"oméga-3\"}]\n26:[\"$\",\"a\",\"compléments alimentaires\",{\"href\":\"/marque/complments-alimentaires\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"compléments alimentaires\"}]\n27:[\"$\",\"a\",\"made in france\",{\"href\":\"/marque/made-in-france\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"made in france\"}]\na:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n28:I[27201,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/d2be314c3ece3fbe.js\"],\"IconMark\"]\n8:null\nc:[[\"$\",\"title\",\"0\",{\"children\":\"Nutri&Co avis test collagène multivitamines 2026\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"On a testé 3 produits Nutri&Co : collagène marin, multivitamines 25 nutriments, oméga-3. Marque française, 4,4/5 Trustpilot, notre verdict.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"manifest\",\"href\":\"/manifest.json\",\"crossOrigin\":\"$undefined\"}],[\"$\",\"meta\",\"3\",{\"name\":\"keywords\",\"content\":\"bons plans beauté,tests produits gratuits,concours beauté,box beauté,réductions cosmétiques,codes promo beauté,échantillons gratuits\"}],[\"$\",\"link\",\"4\",{\"rel\":\"canonical\",\"href\":\"https://bonsplansmania.fr/article/nutri-and-co-avis-test-collagene-multivitamines-ome