t/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\n22:I[67277,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\nf:[\"$\",\"path\",\"1q9fwt\",{\"d\":\"M15 3h6v6\"}]\n10:[\"$\",\"path\",\"gplh6r\",{\"d\":\"M10 14 21 3\"}]\n11:[\"$\",\"path\",\"a6xqqp\",{\"d\":\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"}]\n12:[\"$\",\"div\",null,{\"className\":\"article-hero-image\",\"style\":{\"background\":\"#fff\",\"borderRadius\":\"12px\",\"overflow\":\"hidden\",\"display\":\"flex\",\"justifyContent\":\"center\",\"alignItems\":\"center\",\"maxHeight\":\"450px\"},\"children\":[\"$\",\"$L1e\",null,{\"src\":\"/images/articles/weleda-sport-arnica-minceur-promo.png\",\"alt\":\"Weleda Sport gamme Arnica gel cooling soin sportif\",\"width\":800,\"height\":450,\"style\":{\"width\":\"100%\",\"height\":\"100%\",\"objectFit\":\"contain\",\"maxHeight\":\"450px\"},\"priority\":true}]}]\n13:[\"$\",\"$L1f\",null,{}]\n14:[\"$\",\"$L20\",null,{}]\n21:Tf68,<p>\n<h2>Double promo Weleda : Sport et Minceur</h2><p>Weleda lance deux offres en parallele sur son site : <strong>-20% sur toute la gamme Sport Arnica</strong> et <strong>-10% sur les soins Minceur</strong>. Les reductions s'appliquent automatiquement au panier, pas besoin de code promo.</p><p>Weleda est la marque reference en cosmetiques naturels et bio — fondee en 1921, plus de 100 ans d'expertise en soins a base de plantes.</p><p><div class=\"cta-inline\"><a href=\"https://lk.gt/a82I2\" class=\"btn btn-primary btn-sm\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Voir les offres Weleda <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/><polyline points=\"15 3 21 3 21 9\"/><line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\"/></svg></a></div><h2>Offre Sport : -20% sur la gamme Arnica</h2><p>La gamme Sport Arnica de Weleda est le compagnon des sportifs :</p><ul><li><strong>Gel douche Sport</strong> — revitalisant apres l'effort</li>\n<li><strong>Huile de massage a l'Arnica</strong> — preparation et recuperation musculaire</li>\n<li><strong>Cooling Gel</strong> — effet froid immediat sur les zones sollicitees</li>\n<li><strong>Baume a l'Arnica</strong> — soulage les tensions musculaires</li>\n</ul>\nL'arnica est reconnu depuis des siecles pour ses proprietes apaisantes sur les muscles et les articulations. Ideal pour le sport, la randonnee, le jardinage.</p><p><div id=\"ezoic-pub-ad-placeholder-203\" class=\"ad-container\" style=\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\"></div><h2>Offre Minceur : -10% sur les soins</h2><p>Les soins minceur Weleda accompagnent la silhouette avec des formules naturelles :</p><ul><li><strong>Huile minceur au Bouleau</strong> — le best-seller, raffermit et lisse la peau</li>\n<li><strong>Gel-creme minceur</strong> — effet drainant</li>\n<li><strong>Soins anti-cellulite</strong> — a base d'extraits vegetaux</li>\n</ul>\nParfait pour preparer l'ete avec des soins naturels et efficaces.</p><p><div class=\"cta-inline\"><a href=\"https://lk.gt/a82I2\" class=\"btn btn-primary btn-sm\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Voir les offres Weleda <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/><polyline points=\"15 3 21 3 21 9\"/><line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\"/></svg></a></div><h2>Les infos pratiques</h2><div class=\"table-wrapper\"><table class=\"comparison-table\"><thead><tr>\n<th><strong>Offre Sport</strong></th><th>-20% gamme Arnica</th>\n</tr></thead><tbody>\n<tr>\n<td><strong>Offre Minceur</strong></td>\n<td>-10% soins minceur</td>\n</tr>\n<tr>\n<td><strong>Code promo</strong></td>\n<td>Aucun, reduction automatique</td>\n</tr>\n<tr>\n<td><strong>Fin offre Sport</strong></td>\n<td>30 avril 2026</td>\n</tr>\n<tr>\n<td><strong>Fin offre Minceur</strong></td>\n<td>30 avril 2026</td>\n</tr>\n<tr>\n<td><strong>Non cumulable</strong></td>\n<td>Avec d'autres offres</td>\n</tr>\n<tr>\n<td><strong>Sur</strong></td>\n<td>weleda.fr uniquement</td>\n</tr>\n</tbody></table></div><h2>Notre avis</h2><p>Weleda ne fait quasiment jamais de promo — c'est une marque premium bio qui garde ses prix toute l'annee. Quand il y a -20% sur la gamme Arnica, c'est rare et ca vaut le coup.</p><p>La gamme Sport Arnica est un incontournable pour les sportifs : le cooling gel apres une seance de sport ou le baume pour les tensions musculaires, c'est efficace et 100% naturel. Et les soins minceur au Bouleau sont une reference dans le domaine.</p><p>Les offres sont valables jusqu'au <strong>30 avril</strong> — les reductions s'appliquent toutes seules au panier, pas besoin de code.</p><p><hr>\n</p>15:[\"$\",\"div\",null,{\"className\":\"article-content\",\"children\":[\"$\",\"div\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"$21\"}}]}]\n16:[\"$\",\"$L1f\",null,{}]\n17:[\"$\",\"div\",null,{\"style\":{\"textAlign\":\"center\",\"margin\":\"40px 0\",\"padding\":\"32px\",\"background\":\"linear-gradient(135deg, #FFF0F0 0%, #FFF8F0 100%)\",\"borderRadius\":\"16px\",\"border\":\"2px solid #FECDD3\"},\"children\":[[\"$\",\"p\",null,{\"style\":{\"fontWeight\":800,\"fontSize\":\"1.2rem\",\"marginBottom\":\"16px\",\"color\":\"var(--foreground)\"},\"children\":\"Profiter de cette offre\"}],[\"$\",\"a\",null,{\"href\":\"https://lk.gt/a82I2\",\"className\":\"btn btn-primary\",\"target\":\"_blank\",\"rel\":\"nofollow sponsored noopener\",\"style\":{\"padding\":\"14px 32px\",\"fontSize\":\"1rem\"},\"children\":[\"Voir les offres Weleda\",\" \",[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",