"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"Image\"]\n1f:I[96788,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\n20:I[1586,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\n22:I[67277,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\nf:[\"$\",\"path\",\"1q9fwt\",{\"d\":\"M15 3h6v6\"}]\n10:[\"$\",\"path\",\"gplh6r\",{\"d\":\"M10 14 21 3\"}]\n11:[\"$\",\"path\",\"a6xqqp\",{\"d\":\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"}]\n12:[\"$\",\"div\",null,{\"className\":\"article-hero-image\",\"style\":{\"background\":\"#fff\",\"borderRadius\":\"12px\",\"overflow\":\"hidden\",\"display\":\"flex\",\"justifyContent\":\"center\",\"alignItems\":\"center\",\"maxHeight\":\"450px\"},\"children\":[\"$\",\"$L1e\",null,{\"src\":\"/images/articles/puma-st-runner-v4-sd-sneakers-promo.png\",\"alt\":\"Puma ST Runner V4 SD sneakers gris unisexe\",\"width\":800,\"height\":450,\"style\":{\"width\":\"100%\",\"height\":\"100%\",\"objectFit\":\"contain\",\"maxHeight\":\"450px\"},\"priority\":true}]}]\n13:[\"$\",\"$L1f\",null,{}]\n14:[\"$\",\"$L20\",null,{}]\n21:Tfc6,<p>\n<h2>Sneakers Puma ST Runner V4 SD a 22,78€ : -62% sur Amazon</h2><p>Les sneakers <strong>Puma ST Runner V4 SD</strong> sont en promo flash sur Amazon : <strong>22,78€ au lieu de 59,95€</strong>, soit <strong>-62% de reduction</strong>. C'est un modele unisexe en daim (SD = suede), ideal pour le quotidien.</p><p>Le modele cumule <strong>472 evaluations</strong> avec une note de <strong>4,4/5</strong>. Puma affiche <strong>94% d'avis positifs</strong> et plus de <strong>100 000 commandes recentes</strong> sur la plateforme.</p><p><div class=\"cta-inline\"><a href=\"https://amzn.to/4mAJWn7\" class=\"btn btn-primary btn-sm\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Voir l'offre sur Amazon <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/><polyline points=\"15 3 21 3 21 9\"/><line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\"/></svg></a></div><h2>Les details de l'offre</h2><div class=\"table-wrapper\"><table class=\"comparison-table\"><thead><tr>\n<th><strong>Produit</strong></th><th>ST Runner V4 SD</th>\n</tr></thead><tbody>\n<tr>\n<td><strong>Marque</strong></td>\n<td>Puma</td>\n</tr>\n<tr>\n<td><strong>Prix promo</strong></td>\n<td>A partir de 22,78€</td>\n</tr>\n<tr>\n<td><strong>Prix conseille</strong></td>\n<td>59,95€</td>\n</tr>\n<tr>\n<td><strong>Reduction</strong></td>\n<td>Jusqu'a -62%</td>\n</tr>\n<tr>\n<td><strong>Bonus</strong></td>\n<td>-10% supplementaires pour 2 articles achetes</td>\n</tr>\n<tr>\n<td><strong>Tailles</strong></td>\n<td>Du 36 au 48</td>\n</tr>\n<tr>\n<td><strong>Coloris</strong></td>\n<td>Dusky Gray / Alpine Snow / Puma Black</td>\n</tr>\n<tr>\n<td><strong>Livraison</strong></td>\n<td>Gratuite avec Prime</td>\n</tr>\n<tr>\n<td><strong>Retours</strong></td>\n<td>Gratuits</td>\n</tr>\n</tbody></table></div><p><div id=\"ezoic-pub-ad-placeholder-203\" class=\"ad-container\" style=\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\"></div><h2>Les meilleurs prix par taille</h2><p>Le prix varie selon la taille — voici les meilleures affaires :</p><ul><li><strong>38, 40, 40.5, 41, 42, 44, 46</strong> — 22,78€ (-62%)</li>\n<li><strong>39</strong> — 29,98€ (-50%)</li>\n<li><strong>44.5, 47</strong> — ~33,25€ (-45%)</li>\n<li><strong>48</strong> — 22,78€ (-45%)</li>\n<li><strong>45</strong> — 36,21€ (-40%)</li>\n<li><strong>37</strong> — 37,42€ (-38%)</li>\n</ul>\n<div class=\"cta-inline\"><a href=\"https://amzn.to/4mAJWn7\" class=\"btn btn-primary btn-sm\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Voir l'offre sur Amazon <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/><polyline points=\"15 3 21 3 21 9\"/><line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\"/></svg></a></div><h2>Ce qu'on aime</h2><ul><li><strong>Prix fou</strong> — des sneakers Puma en daim a moins de 23€</li>\n<li><strong>Modele intemporel</strong> — la ST Runner est un classique Puma depuis des annees</li>\n<li><strong>Daim veritable</strong> — finition premium, pas du synthetique</li>\n<li><strong>Unisexe</strong> — convient aux hommes et aux femmes</li>\n<li><strong>Tailles larges</strong> — du 36 au 48, tout le monde y trouve son compte</li>\n</ul>\n<h2>Notre avis</h2><p>La Puma ST Runner est un classique du streetwear accessible — design epure, silhouette retro running, et finition en daim qui lui donne un cote premium. A 22,78€ au lieu de 59,95€, c'est un des meilleurs rapports qualite-prix qu'on ait vu sur des sneakers de marque.</p><p>Comme pour le sweat Teamgoal, si tu en prends 2 paires tu beneficies de <strong>-10% supplementaires</strong>. C'est une <strong>offre a duree limitee</strong> et toutes les tailles ne sont pas au meme prix — les meilleures affaires partent en premier.</p><p><hr>\n</p>15:[\"$\",\"div\",null,{\"className\":\"article-content\",\"children\":[\"$\",\"div\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"$21\"}}]}]\n16:[\"$\",\"$L1f\",null,{}]\n17:[\"$\",\"div\",null,{\"style\":{\"textAlign\":\"center\",\"margin\":\"40px 0\",\"padding\":\"32px\",\"background\":\"linear-gradient(135deg, #FFF0F0 0%, #FFF8F0 100%)\",\"borderRadius\":\"16px\",\"border\":\"2px solid #FECDD3\"},\"children\":[[\"$\",\"p\",null,{\"style\":{\"fontWeight\":800,\"fontSize\":\"1.2rem\",\"marginBottom\":\"16px\",\"color\":\"var(--foreground)\"},\"children\":\"Profiter de cette 