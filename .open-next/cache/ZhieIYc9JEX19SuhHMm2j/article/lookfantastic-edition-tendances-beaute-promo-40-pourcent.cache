tic/chunks/6e48aeeec84550f8.js\\\"],\\\"default\\\"]\\n18:[\\\"$\\\",\\\"svg\\\",\\\"4\\\",{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":16,\\\"height\\\":16,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"currentColor\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-star\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":[[\\\"$\\\",\\\"path\\\",\\\"r04s7s\\\",{\\\"d\\\":\\\"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z\\\"}],\\\"$undefined\\\"]}]\\n19:[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":[4.6,\\\"/5\\\"]}]\\n1a:[\\\"$\\\",\\\"span\\\",null,{\\\"style\\\":{\\\"fontWeight\\\":700,\\\"color\\\":\\\"var(--primary)\\\",\\\"fontSize\\\":\\\"1.05rem\\\"},\\\"children\\\":\\\"30€\\\"}]\\n1b:[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://tidd.ly/3M5dICM\\\",\\\"className\\\":\\\"btn btn-primary btn-sm\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"nofollow sponsored noopener\\\",\\\"children\\\":[\\\"Commander l'Edition Tendances Beauté\\\",\\\" \\\",[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":13,\\\"height\\\":13,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-external-link\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":[[\\\"$\\\",\\\"path\\\",\\\"1q9fwt\\\",{\\\"d\\\":\\\"M15 3h6v6\\\"}],[\\\"$\\\",\\\"path\\\",\\\"gplh6r\\\",{\\\"d\\\":\\\"M10 14 21 3\\\"}],[\\\"$\\\",\\\"path\\\",\\\"a6xqqp\\\",{\\\"d\\\":\\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\\"}],\\\"$undefined\\\"]}]]}]\\n1c:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"article-hero-image\\\",\\\"style\\\":{\\\"background\\\":\\\"#fff\\\",\\\"borderRadius\\\":\\\"12px\\\",\\\"overflow\\\":\\\"hidden\\\",\\\"display\\\":\\\"flex\\\",\\\"justifyContent\\\":\\\"center\\\",\\\"alignItems\\\":\\\"center\\\",\\\"maxHeight\\\":\\\"450px\\\"},\\\"children\\\":[\\\"$\\\",\\\"$L23\\\",null,{\\\"src\\\":\\\"/images/articles/lookfantastic-edition-tendances-beaute-promo-40-pourcent.svg\\\",\\\"alt\\\":\\\"Lookfantastic Edition Tendances Beauté coffret 6 produits premium à -40%\\\",\\\"width\\\":800,\\\"height\\\":450,\\\"style\\\":{\\\"width\\\":\\\"100%\\\",\\\"height\\\":\\\"100%\\\",\\\"objectFit\\\":\\\"contain\\\",\\\"maxHeight\\\":\\\"450px\\\"},\\\"priority\\\":true}]}]\\n1d:[\\\"$\\\",\\\"$L22\\\",null,{}]\\n1e:[\\\"$\\\",\\\"$L2f\\\",null,{}]\\n30:T1673,\"])</script><script>self.__next_f.push([1,\"\\u003cp\\u003e\\n\\u003ch2\\u003e145€ de produits pour 30€ au lieu de 50€\\u003c/h2\\u003e\\u003cp\\u003eLookfantastic propose son Edition Tendances Beauté, un coffret de 6 produits sélectionnés parmi les marques les plus vendues du moment. La valeur dépasse les 145€ et le coffret passe de 50€ à 30€ soit 40% de remise. On économise 115€ sur des marques dermatologiques et premium.\\u003c/p\\u003e\\u003cp\\u003eLe coffret est disponible et expédié sous 24h.\\u003c/p\\u003e\\u003chr\\u003e\\u003cp\\u003e\\u003cdiv class=\\\"cta-inline\\\"\\u003e\\u003ca href=\\\"https://tidd.ly/3M5dICM\\\" class=\\\"btn btn-primary btn-sm\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eCommander l'Edition Tendances Beauté \\u003csvg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"13\\\" height=\\\"13\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"\\u003e\\u003cpath d=\\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\\"/\\u003e\\u003cpolyline points=\\\"15 3 21 3 21 9\\\"/\\u003e\\u003cline x1=\\\"10\\\" y1=\\\"14\\\" x2=\\\"21\\\" y2=\\\"3\\\"/\\u003e\\u003c/svg\\u003e\\u003c/a\\u003e\\u003c/div\\u003e\\u003ch2\\u003eLes 6 produits dans le coffret\\u003c/h2\\u003e\\u003ch3\\u003eLa Roche-Posay Anthelios UVMune 400 SPF50+\\u003c/h3\\u003e\\u003cp\\u003eLa protection solaire de référence en pharmacie. L'Anthelios UVMune 400 offre une protection très haute contre les UVA et UVB, y compris les UVA ultra-longs. C'est le produit que tous les dermatologues recommandent.\\u003c/p\\u003e\\u003ch3\\u003eCaudalie Golden Glow Gradual Tan\\u003c/h3\\u003e\\u003cp\\u003eL'autobronzant progressif de Caudalie en format généreux. Il donne un hâle naturel et lumineux sans traces, parfait pour préparer sa peau au printemps. Formulé avec des ingrédients d'origine naturelle.\\u003c/p\\u003e\\u003ch3\\u003eGatineau\\u003c/h3\\u003e\\u003cp\\u003eUn soin visage de la maison Gatineau, marque française de soin professionnel depuis 1932. Reconnue pour son expertise anti-âge et ses formules haute performance.\\u003c/p\\u003e\\u003ch3\\u003ebareMinerals Prime Time Original Primer\\u003c/h3\\u003e\\u003cp\\u003eLe primer iconique de bareMinerals. Il lisse la peau, affine les pores et prépare le teint pour un maquillage longue tenue. Un classique qui a fait ses preuves.\\u003c/p\\u003e\\u003ch3\\u003eKate Somerville ExfoliKate\\u003c/h3\\u003e\\u003cp\\u003eLe soin exfoliant intensif de Kate Somerville, marque culte venue de Los Angeles. Il affine le grain de peau en quelques minutes pour un teint lumineux et lisse.\\u003c/p\\u003e\\u003ch3\\u003eSol de Janeiro Cheirosa 76\\u003c/h3\\u003e\\u003cp\\u003eLe parfum brésilien ensoleillé de Sol de Janeiro. Des notes chaudes et gourmandes qui évoquent les plages brésiliennes. Un parfum addictif que beaucoup considèrent comme le meilleur de la gamme.\\u003c/p\\u003e\\u003chr\\u003e\\u003cp\\u003e\\u003cdiv id=\\\"ezoic-pub-ad-placeholder-203\\\" class=\\\"ad-container\\\" style=\\\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\\\"\\u003e\\u003c/div\\u003e\\u003ch2\\u003eLe récap\\u003c/h2\\u003e\\u003cdiv class=\\\"table-wrapper\\\"\\u003e\\u003ctable class=\\\"comparison-table\\\"\\u003e\\u003cthead\\u003e\\u003ctr\\u003e\\n\\u003cth\\u003eProduit\\u003c/th\\u003e\\u003cth\\u003eMarque\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\u003c/thead\\u003e\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eAnthelios UVMune 400 SPF50+\\u003c/td\\u003e\\n\\u003ctd\\u003eLa Roche-Posay\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eGolden Glow Gradual Tan\\u003c/td\\u003e\\n\\u003ctd\\u003eCaudalie\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eSoin visage\\u003c/td\\u003e\\n\\u003ctd\\u003eGatineau\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003ePrime Time Original Primer\\u003c/td\\u003e\\n\\u003ctd\\u003ebareMinerals\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eExfoliKate\\u003c/td\\u003e\\n\\u003ctd\\u003eKate Somerville\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eCheirosa 76\\u003c/td\\u003e\\n\\u003ctd\\u003eSol de Janeiro\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003eValeur totale\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e145€+\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003ePrix\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e30€ (au lieu de 50€)\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\u003c/table\\u003e\\u003c/div\\u003e\\u003chr\\u003e\\u003cp\\u003e\\u003cdiv class=\\\"cta-inline\\\"\\u003e\\u003ca href=\\\"https://tidd.ly/3M5dICM\\\" class=\\\"btn btn-primary btn-sm\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eCommander l'Edition Tendances Beauté \\u003csvg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"13\\\" height=\\\"13\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"\\u003e\\u003cpath d=\\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\\"/\\u003e\\u003cpolyline points=\\\"15 3 21 3 21 9\\\"/\\u003e\\u003cline x1=\\\"10\\\" y1=\\\"14\\\" x2=\\\"21\\\" y2=\\\"3\\\"/\\u003e\\u003c/svg\\u003e\\u003c/a\\u003e\\u003c/div\\u003e\\u003ch2\\u003eCe qu'on aime\\u003c/h2\\u003e\\u003cul\\u003e\\u003cli\\u003e\\u003cstrong\\u003e30€ pour 145€ de produits\\u003c/strong\\u003e : on économise 115€\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e-40% de remise\\u003c/strong\\u003e en plus du rapport qualité-prix déjà excellent\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eLa Roche-Posay Anthelios\\u003c/strong\\u003e : la crème solaire n°1 en pharmacie, indispensable\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eMix tendance\\u003c/strong\\u003e : solaire, autobronzant, primer, exfoliant, parfum\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eIdéal pour le printemps\\u003c/strong\\u003e : les produits sont parfaitement adaptés à la saison\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eMarques de confiance\\u003c/strong\\u003e : La Roche-Posay, Caudalie, bareMinerals\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch2\\u003eCe qui peut freiner\\u003c/h2\\u003e\\u003cul\\u003e\\u003cli\\u003eOn ne connaît pas les formats exacts de tous les produits\\u003c/li\\u003e\\n\\u003cli\\u003eC'est un coffret fixe, on ne choisit pas les produits\\u003c/li\\u003e\\n\\u003cli\\u003eCertaines marques (Kate Somerville, Gatineau) sont moins connues en France\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003cdiv id=\\\"ezoic-pub-ad-placeholder-206\\\" class=\\\"ad-container\\\" style=\\\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\\\"\\u003e\\u003c/div\\u003e\\u003ch2\\u003ePour qui ?\\u003c/h2\\u003e\\u003cp\\u003e\\u003cstrong\\u003eIdéale si :\\u003c/strong\\u003e\\n\\u003cul\\u003e\\u003cli\\u003eOn veut préparer sa routine beauté pour le printemps et l'été\\u003c/li\\u003e\\n\\u003cli\\u003eOn cherche un coffret varié avec des marques dermato et premium\\u003c/li\\u003e\\n\\u003cli\\u003eOn a un budget limité mais on veut des produits de qualité\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003cstrong\\u003eRegardez ailleurs si :\\u003c/strong\\u003e\\n\\u003cul\\u003e\\u003cli\\u003eOn a déjà sa crème solaire et son autobronzant\\u003c/li\\u003e\\n\\u003cli\\u003eOn préfère choisir ses produits un par un\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\u003c/p\\u003e\\u003ch2\\u003eNotre verdict\\u003c/h2\\u003e\\u003cp\\u003eNote : 4.6/5\\u003c/p\\u003e\\u003cp\\u003eA 30€ pour 145€ de produits, c'est un excellent deal. Le coffret est bien pensé pour la saison avec la crème solaire La Roche-Posay, l'autobronzant Caudalie et le parfum Sol de Janeiro. C'est moins spectaculaire que le Beauty Egg, mais à 30€ c'est plus accessible et les produits sont très utiles au quotidien. Le -40% en fait une vraie affaire.\\u003c/p\\u003e\\u003cp\\u003e\\u003cem\\u003eCet article contient un lien affilié. Si vous passez commande via ce lien, nous recevons une petite commission sans surcoût pour vous. Merci de soutenir Bonsplansmania.\\u003c/em\\u003e\\n\\u003c/p\\u003e\"])</script><script>self.__next_f.push([1,\"1f:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"article-content\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"$30\\\"}}]}]\\n20:[\\\"$\\\",\\\"$L22\\\",null,{}]\\n21:[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"textAlign\\\":\\\"center\\\",\\\"margin\\\":\\\"40px 0\\\",\\\"padding\\\":\\