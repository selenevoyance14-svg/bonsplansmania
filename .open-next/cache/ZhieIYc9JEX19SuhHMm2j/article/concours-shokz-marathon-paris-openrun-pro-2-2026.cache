td><strong>Résultats</strong></td>\n<td>20 avril 2026</td>\n</tr>\n<tr>\n<td><strong>Participation</strong></td>\n<td>Gratuite</td>\n</tr>\n</tbody></table></div>\n</p>12:[\"$\",\"div\",null,{\"className\":\"article-content\",\"children\":[\"$\",\"div\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"$1b\"}}]}]\n13:[\"$\",\"$L19\",null,{}]\n14:[\"$\",\"$L19\",null,{}]\n15:[\"$\",\"section\",null,{\"className\":\"related-articles\",\"children\":[[\"$\",\"h2\",null,{\"children\":\"A lire aussi\"}],[\"$\",\"div\",null,{\"className\":\"articles-grid\",\"style\":{\"gridTemplateColumns\":\"repeat(auto-fit, minmax(280px, 1fr))\"},\"children\":[[\"$\",\"a\",\"iad-top14-concours-places-matchs-experiences-exclusives-2026\",{\"href\":\"/article/iad-top14-concours-places-matchs-experiences-exclusives-2026\",\"className\":\"card\",\"style\":{\"textDecoration\":\"none\"},\"children\":[[\"$\",\"div\",null,{\"style\":{\"position\":\"relative\",\"height\":\"160px\",\"overflow\":\"hidden\"},\"children\":[\"$\",\"$Lf\",null,{\"src\":\"/images/articles/iad-top14-places-experiences-concours-2026.png\",\"alt\":\"Concours IAD partenaire Top 14 places et expériences exclusives à gagner\",\"fill\":true,\"style\":{\"objectFit\":\"cover\"},\"sizes\":\"33vw\"}]}],[\"$\",\"div\",null,{\"className\":\"card-body\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"fontSize\":\"0.72rem\",\"fontWeight\":600,\"color\":\"var(--primary)\",\"textTransform\":\"uppercase\",\"letterSpacing\":\"0.5px\"},\"children\":[\"🏆\",\" \",\"Concours\"]}],[\"$\",\"h3\",null,{\"className\":\"card-title\",\"children\":\"Concours IAD x Top 14 : gagnez des places et expériences exclusives pour les matchs\"}],[\"$\",\"p\",null,{\"className\":\"card-excerpt\",\"children\":\"Tentez de gagner des places catégorie 1, des expériences terrain et des produits dédicacés pour les matchs du Top 14. Gratuit, tirages au sort réguliers.\"}]]}]]}],[\"$\",\"a\",\"rugbyshop-jeu-concours-7-au-xv-pack-ruckfield-avril-2026\",{\"href\":\"/arti