round\":\"#fff\",\"borderRadius\":\"12px\",\"overflow\":\"hidden\",\"display\":\"flex\",\"justifyContent\":\"center\",\"alignItems\":\"center\",\"maxHeight\":\"450px\"},\"children\":[\"$\",\"$L3\",null,{\"src\":\"/images/articles/concours-shokz-marathon-paris-openrun-pro-2-2026.svg\",\"alt\":\"Concours Shokz Marathon Paris OpenRun Pro 2 à gagner 2026\",\"width\":800,\"height\":450,\"style\":{\"width\":\"100%\",\"height\":\"100%\",\"objectFit\":\"contain\",\"maxHeight\":\"450px\"},\"priority\":true}]}],\"$L4\",\"$L5\",\"$L6\",\"$L7\",false]}],\"$L8\",\"$L9\",\"$La\",\"$Lb\"]}]}],false,\"$Lc\"],[\"$Ld\"],\"$Le\"]}],\"loading\":null,\"isPartial\":false}\n4:[\"$\",\"$Lf\",null,{}]\n5:[\"$\",\"$L10\",null,{}]\n11:T63d,<p>\n# Concours Shokz : Gagnez un OpenRun Pro 2 — Spécial Marathon de Paris</p><p><strong>Shokz</strong> célèbre le Marathon de Paris avec un <strong>tirage au sort spécial</strong> ! Tentez de remporter un casque <strong>OpenRun Pro 2</strong> gratuitement.</p><hr><h2>Le lot à gagner</h2><ul><li><strong>Casque Shokz OpenRun Pro 2</strong> — le casque à conduction osseuse référence des runners</li>\n</ul>\n<h2>Comment participer</h2><p>1. <strong>Rendez-vous</strong> sur la <a href=\"https://fr.shokz.com/pages/paris-marathon\" target=\"_blank\" rel=\"nofollow sponsored noopener\">page du concours Shokz</a>\n2. <strong>Saisissez</strong> votre adresse email\n3. <strong>Croisez les doigts</strong> — tirage au sort !</p><p><div id=\"ezoic-pub-ad-placeholder-203\" class=\"ad-container\" style=\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\"></div><h2>Conditions</h2><ul><li><strong>Participation</strong> : gratuite, il suffit d'entrer son email</li>\n<li><strong>Tirage au sort</strong> : résultats annoncés le <strong>20 avril 2026</strong></li>\n</ul>\n<h2>Récapitulatif</h2><div class=\"table-wrapper\"><table class=\"comparison-table\"><thead><tr>\n<th></th><th>Détails</th>\n</tr></thead><tbody>\n<tr>\n<td><strong>Organisateur</strong></td>\n<td>Shokz</td>\n</tr>\n<tr>\n<td><strong>Lot</strong></td>\n<td>Casque OpenRun Pro 2</td>\n</tr>\n<tr>\n<td><strong>Type de jeu</strong></td>\n<td>Tirage au sort</td>\n</tr>\n<tr>\n<td><strong>Résultats</strong></td>\n<td>20 avril 2026</td>\n</tr>\n<tr>\n<td><strong>Participation</strong></td>\n<td>Gratuite</td>\n</tr>\n</tbody></table></div>\n</p>6:[\"$\",\"div\",null,{\"className\":\"article-content\",\"children\":[\"$\",\"div\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"$11\"}}]}]\n7:[\"$\",\"$Lf\",null,{}]\n8:[\"$\",\"$Lf\",null,{}]\n9:[\"$\",\"section\",null,{\"className\":\"related-articles\",\"children\":[[\"$\",\"h2\",null,{\"children\":\"A lire aussi\"}],[\"$\",\"div\",null,{\"className\":\"articles-grid\",\"style\":{\"gridTemplateColumns\":\"repeat(auto-fit, minmax(280px, 1fr))\"},\"children\":[[\"$\",\"a\",\"iad-top14-concours-places-matchs-experiences-exclusives-2026\",{\"href\":\"/article/iad-top14-concours-places-matchs-experiences-exclusives-2026\",\"className\":\"card\",\"style\":{\"textDecoration\":\"none\"},\"children\":[[\"$\",\"div\",null,{\"style\":{\"position\":\"relative\",\"height\":\"160px\",\"overflow\":\"hidden\"},\"children\":[\"$\",\"$L3\",null,{\"src\":\"/images/articles/iad-top14-places-experiences-concours-2026.png\",\"alt\":\"Concours IAD partenaire Top 14 places et expériences exclusives à gagner\",\"fill\":true,\"style\":{\"objectFit\":\"cover\"},\"sizes\":\"33vw\"}]}],[\"$\",\"div\",null,{\"className\":\"card-body\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"fontSize\":\"0.72rem\",\"fontWeight\":600,\"color\":\"var(--primary)\",\"textTransform\":\"uppercase\",\"letterSpacing\":\"0.5px\"},\"children\":[\"🏆\",\" \",\"Concours\"]}],[\"$\",\"h3\",null,{\"className\":\"card-title\",\"children\":\"Concours IAD x Top 14 : gagnez des places et expériences exclusives pour les matchs\"}],[\"$\",\"p\",null,{\"className\":\"card-excerpt\",\"children\":\"Tentez de gagner des places catégorie 1, des expériences terrain et des produits