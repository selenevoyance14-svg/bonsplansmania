],\" \",\"3 min\"]}]]}],[\"$\",\"h1\",null,{\"children\":\"Algologie : testez gratuitement les 3 nouveaux solaires SPF50/50+ (sérum, lait, gelée)\"}],[\"$\",\"p\",null,{\"className\":\"article-subtitle\",\"children\":\"Test produit gratuit Algologie : candidatez pour tester le Sérum Illuminateur SPF50, le Lait Haute Protection SPF50 et la Gelée Bronze & Glow SPF50+. Jusqu'au 14 mai.\"}],[\"$\",\"div\",null,{\"className\":\"article-rating-bar\",\"children\":[\"$undefined\",\"$undefined\",[\"$\",\"a\",null,{\"href\":\"https://www.algologie.com/fr/content/7-testez-nos-produits\",\"className\":\"btn btn-primary btn-sm\",\"target\":\"_blank\",\"rel\":\"nofollow sponsored noopener\",\"children\":[\"Candidater au test gratuit\",\" \",\"$Lf\"]}]]}]]}],\"$L10\",\"$L11\",\"$L12\",\"$L13\",\"$L14\",\"$L15\"]}],\"$L16\",\"$L17\",\"$L18\",\"$L19\"]}]}],\"$L1a\",\"$L1b\"]\n1c:I[5500,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"Image\"]\n1d:I[96788,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\n1e:I[1586,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\n20:I[67277,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\nf:[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":13,\"height\":13,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-external-link\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1q9fwt\",{\"d\":\"M15 3h6v6\"}],[\"$\",\"path\",\"gplh6r\",{\"d\":\"M10 14 21 3\"}],[\"$\",\"path\",\"a6xqqp\",{\"d\":\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"}],\"$undefined\"]}]\n10:[\"$\",\"div\",null,{\"className\":\"article-hero-image\",\"style\":{\"background\":\"#fff\",\"borderRadius\":\"12px\",\"overflow\":\"hidden\",\"display\":\"flex\",\"justifyContent\":\"center\",\"alignItems\":\"center\",\"maxHeight\":\"450px\"},\"children\":[\"$\",\"$L1c\",null,{\"src\":\"/images/articles/algologie-solaires-test-gratuit-2026.png\",\"alt\":\"Algologie produits solaires sérum lait gelée SPF50 test gratuit\",\"width\":800,\"height\":450,\"style\":{\"width\":\"100%\",\"height\":\"100%\",\"objectFit\":\"contain\",\"maxHeight\":\"450px\"},\"priority\":true}]}]\n11:[\"$\",\"$L1d\",null,{}]\n12:[\"$\",\"$L1e\",null,{}]\n1f:T1427,<p>\n<h2>Algologie : testez les 3 nouveaux solaires stars</h2><p><strong>Algologie</strong> ouvre les candidatures pour tester gratuitement ses <strong>3 nouveaux produits solaires</strong>. C'est le lancement de leur nouvelle gamme solaire — sérum, lait et gelée, tous en SPF50 ou SPF50+. Candidatures ouvertes <strong>jusqu'au 14 mai</strong>.</p><p><div class=\"cta-inline\"><a href=\"https://www.algologie.com/fr/content/7-testez-nos-produits\" class=\"btn btn-primary btn-sm\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Candidater au test gratuit <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/><polyline points=\"15 3 21 3 21 9\"/><line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\"/></svg></a></div><h2>Les 3 produits à tester</h2><h3>Sérum Solaire Illuminateur SPF50</h3><p>Le multi-protecteur urbain avec effet teint glowy immédiat :</p><ul><li><strong>Triple protection</strong> — UVA/UVB, lumière bleue et pollution</li>\n<li><strong>Hydratation +34%</strong> — lisse la peau et prévient le photo-vieillissement</li>\n<li><strong>Nacres minérales</strong> — effet teint glowy immédiat</li>\n<li><strong>Formule clean</strong> — 0% silicone, parabènes, huiles minérales</li>\n</ul>\n<h3>Lait Solaire Haute Protection SPF50</h3><p>Le solaire familial résistant à l'eau :</p><ul><li><strong>SPF50 haute protection</strong> — contre les dommages solaires</li>\n<li><strong>Anti-oxydant</strong> — préserve la jeunesse de la peau</li>\n<li><strong>Résistant à l'eau</strong> — idéal pour la plage et la piscine</li>\n<li><strong>Toute la famille</strong> — convient aux enfants dès 3 ans</li>\n<li><strong>Formule clean</strong> — sans alcool ni nanoparticules</li>\n</ul>\n<h3>Gelée Solaire Bronze & Glow SPF50+</h3><p>Le solaire qui sublime le bronzage :</p><ul><li><strong>SPF50+</strong> — protection maximale</li>\n<li><strong>Rehausse le bronzage</strong> — même sur les carnations les plus claires</li>\n<li><strong>Nacres bronze</strong> — éclat irrésistible et illuminant</li>\n<li><strong>Texture sensorielle</strong> — sublime la peau instantanément</li>\n<li><strong>Hydratante</strong> — enrichie en glycérine</li>\n</ul>\n<div id=\"ezoic-pub-ad-placeholder-203\" class=\"ad-container\" style=\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\"></div><h2>Les infos du test</h2><div class=\"table-wrapper\"><table class=\"comparison-table\"><thead><tr>\n<th><strong>Marque</strong></th><th>Algologie</th>\n</tr></thead><tbody>\n<tr>\n<td><strong>Produits</strong></td>\n<td>Sérum SPF50 + Lait SPF50 + Gelée SPF50+</td>\n</tr>\n<tr>\n<td><strong>Date limite</strong></td>\n<td>14 mai 2026</td>\n</tr>\n<tr>\n<td><strong>Participation</strong></td>\n<td>Gratuite</td>\n</tr>\n<tr>\n<td><strong>Où candidater</strong></td>\n<td>Sur algologie.com, rubrique \"Testez nos produits\"</td>\n</tr>\n</tbody></table></div><p><div class=\"cta-inline\"><a href=\"https://www.algologie.com/fr/content/7-testez-nos-produits\" class=\"btn btn-primary btn-sm\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Candidater au test gratuit <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/><polyline points=\"15 3 21 3 21 9\"/><line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\"/></svg></a></div><h2>Notre avis</h2><p>Algologie est une marque française de cosmétique marine reconnue pour ses soins à base d'algues et d'actifs marins. Leur nouvelle gamme solaire est ambitieuse avec 3 produits complémentaires : le sérum pour la ville (anti-pollution + glow), le lait pour toute la famille (résistant à l'eau) et la gelée pour celles qui veulent bronzer tout en étant protégées.</p><p>Les formules sont clean (sans silicone, parabènes, nanoparticules) — c'est rassurant pour un usage quotidien. Tester les 3 produits avant leur commercialisation, c'est une belle opportunité.</p><p>Candidatures ouvertes jusqu'au <strong>14 mai</strong> — ne tardez pas.</p><h2>À lire aussi</h2><ul><li><a href=\"/article/6-cremes-solaires-enfants-100-sur-100-yuka-2026\" target=\"_blank\" rel=\"nofollow sponsored noopener\">6 crèmes solaires enfants notées 100/100 sur Yuka</a> — les meilleures compositions pour les enfants</li>\n<li><a href=\"/article/8-autobronzants-bien-notes-yuka-eviter-masque-grossesse-2026\" target=\"_blank\" rel=\"nofollow sponsored noopener\">8 autobronzants bien notés sur Yuka</a> — effet bonne mine sans UV</li>\n<li><a href=\"/article/la-canopee-fluide-solaire-lacte-spf50-test-gratuit-2026\" target=\"_blank\" rel=\"nofollow sponsored noopener\">La Canopée : testez le Fluide solaire SPF 50+</a> — autre test gratuit solaire</li>\n<li><a href=\"/article/selection-meilleures-cremes-solaires-2026\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Notre sélection des meilleures crèmes solaires 2026</a> — le comparatif complet</li>\n</ul>\n<hr>\n</p>13:[\"$\",\"div\",null,{\"className\":\"article-content\",\"children\":[\"$\",\"div\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"$1f\"}}]}]\n14:[\"$\",\"$L1d\",null,{}]\n15:[\"$\",\"div\",null,{\"style\":{\"textAlign\