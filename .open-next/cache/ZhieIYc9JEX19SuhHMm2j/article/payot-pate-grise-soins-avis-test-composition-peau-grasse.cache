9px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"avis\"}]\n27:[\"$\",\"a\",\"composition\",{\"href\":\"/marque/composition\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"composition\"}]\n28:[\"$\",\"a\",\"beauté\",{\"href\":\"/marque/beaut\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"beauté\"}]\na:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n29:I[27201,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/d2be314c3ece3fbe.js\"],\"IconMark\"]\n8:null\nc:[[\"$\",\"title\",\"0\",{\"children\":\"Avis Payot Pâte Grise : 4 soins testés, compositions analysées\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Notre test de 4 soins Payot Pâte Grise. Pâte Grise Originale 86/100 Yuka, pain nettoyant 100/100, sérum AHA, gelée. Compositions et verdict honnête.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"manifest\",\"href\":\"/manifest.json\",\"crossOrigin\":\"$undefined\"}],[\"$\",\"meta\",\"3\",{\"name\":\"keywords\",\"content\":\"bons plans beauté,tests produits gratuits,concours beauté,box beauté,réductions cosmétiques,codes promo beauté,échantillons gratuits\"}],[\"$\",\"link\",\"4\",{\"rel\":\"canonical\",\"href\":\"https://bonsplansmania.fr/article/payot-pate-grise-soins-avis-test-composition-peau-grasse\"}],[\"$\",\"meta\",\"5\",{\"property\":\"og:title\",\"content\":\"Payot Pâte Grise : on a testé la gamme anti-imperfections (avis et compositions)\"}],[\"$\",\"meta\"