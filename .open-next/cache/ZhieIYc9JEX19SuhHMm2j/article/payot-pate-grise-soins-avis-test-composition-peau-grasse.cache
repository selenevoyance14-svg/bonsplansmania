"cover\"},\"sizes\":\"33vw\"}]}],[\"$\",\"div\",null,{\"className\":\"card-body\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"fontSize\":\"0.72rem\",\"fontWeight\":600,\"color\":\"var(--primary)\",\"textTransform\":\"uppercase\",\"letterSpacing\":\"0.5px\"},\"children\":[\"🎁\",\" \",\"Test Gratuit\"]}],[\"$\",\"h3\",null,{\"className\":\"card-title\",\"children\":\"Payot Pâte Grise : On a Testé 4 Soins Anti-Imperfections (Notre Avis)\"}],[\"$\",\"p\",null,{\"className\":\"card-excerpt\",\"children\":\"Notre avis sur la gamme Payot Pâte Grise : pâte originale, gel nettoyant, sérum peeling AHA et pain nettoyant. Test complet avec notes Yuka et Que Choisir.\"}]]}]]}]]}]]}]\nc:[\"$\",\"nav\",null,{\"style\":{\"margin\":\"40px 0\",\"padding\":\"24px\",\"background\":\"var(--muted, #f3f4f6)\",\"borderRadius\":\"16px\"},\"children\":[[\"$\",\"h3\",null,{\"style\":{\"fontSize\":\"1rem\",\"marginBottom\":\"12px\"},\"children\":\"Explorer par catégorie\"}],[\"$\",\"div\",null,{\"style\":{\"display\":\"flex\",\"flexWrap\":\"wrap\",\"gap\":\"8px\"},\"children\":[[\"$\",\"a\",\"bon-plan\",{\"href\":\"/categorie/bon-plan\",\"style\":{\"padding\":\"6px 14px\",\"borderRadius\":\"999px\",\"background\":\"white\",\"fontSize\":\"0.82rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500,\"border\":\"1px solid var(--border, #e5e7eb)\"},\"children\":[\"🏷️\",\" \",\"Bons Plans\"]}],[\"$\",\"a\",\"test-gratuit\",{\"href\":\"/categorie/test-gratuit\",\"style\":{\"padding\":\"6px 14px\",\"borderRadius\":\"999px\",\"background\":\"white\",\"fontSize\":\"0.82rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500,\"border\":\"1px solid var(--border, #e5e7eb)\"},\"children\":[\"🎁\",\" \",\"Tests Gratuits\"]}],[\"$\",\"a\",\"concours\",{\"href\":\"/categorie/concours\",\"style\":{\"padding\":\"6px 14px\",\"borderRadius\":\"999px\",\"background\":\"white\",\"fontSize\":\"0.82rem\",\"color\":\"var(--text, #374151)\",\"textDecor