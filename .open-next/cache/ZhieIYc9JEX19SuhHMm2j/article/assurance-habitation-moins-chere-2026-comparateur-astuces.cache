evice-width, initial-scale=1\"}]]\n2a:I[27201,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/d2be314c3ece3fbe.js\"],\"IconMark\"]\n8:null\nc:[[\"$\",\"title\",\"0\",{\"children\":\"Assurance Habitation Moins Chère en 2026\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Assurance habitation trop chère ? Comparateur gratuit, astuces de négociation et erreurs à éviter pour économiser jusqu'à 200€ par an en 2026.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"manifest\",\"href\":\"/manifest.json\",\"crossOrigin\":\"$undefined\"}],[\"$\",\"meta\",\"3\",{\"name\":\"keywords\",\"content\":\"bons plans beauté,tests produits gratuits,concours beauté,box beauté,réductions cosmétiques,codes promo beauté,échantillons gratuits\"}],[\"$\",\"link\",\"4\",{\"rel\":\"canonical\",\"href\":\"https://bonsplansmania.fr/article/assurance-habitation-moins-chere-2026-comparateur-astuces\"}],[\"$\",\"meta\",\"5\",{\"property\":\"og:title\",\"content\":\"Assurance habitation : comment payer moins cher en 2026\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:description\",\"content\":\"Ton assurance habitation est trop chère ? Voici comment comparer, négocier et changer pour économiser jusqu'à 200€ par an sans perdre en garanties.\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:image\",\"content\":\"http://localhost:3000/images/articles/assurance-habitation-moins-chere-2026-comparateur-astuces.svg\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:type\",\"content\":\"article\"}],[\"$\",\"meta\",\"9\",{\"property\":\"article:published_time\",\"content\":\"2026-04-01\"}],[\"$\",\"meta\",\"10\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"11\",{\"name\":\"twitter:title\",\"content\":\"Bons Plans Mania — Bons plans beauté & tests gratuits\"}],[\"$\",\"meta\",\"12\",{\"name\":\"twitter:description\",\"content\":\"Les meilleurs bons plans beauté, tests gratuits, concours et avis box beauté.\"}],[\"$\",\"meta\",\"13\",{\"name\":\"twitter:image\