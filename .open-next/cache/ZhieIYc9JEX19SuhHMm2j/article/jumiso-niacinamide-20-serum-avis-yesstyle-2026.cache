.\"}]]}]]}],[\"$\",\"a\",\"cosrx-snail-mucin-essence-yesstyle-2026\",{\"href\":\"/article/cosrx-snail-mucin-essence-yesstyle-2026\",\"className\":\"card\",\"style\":{\"textDecoration\":\"none\"},\"children\":[[\"$\",\"div\",null,{\"style\":{\"position\":\"relative\",\"height\":\"160px\",\"overflow\":\"hidden\"},\"children\":[\"$\",\"$L1e\",null,{\"src\":\"/images/articles/cosrx-snail-mucin-essence-yesstyle-2026.svg\",\"alt\":\"COSRX Advanced Snail 96 Mucin Power Essence - K-Beauty YesStyle\",\"fill\":true,\"style\":{\"objectFit\":\"cover\"},\"sizes\":\"33vw\"}]}],[\"$\",\"div\",null,{\"className\":\"card-body\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"fontSize\":\"0.72rem\",\"fontWeight\":600,\"color\":\"var(--primary)\",\"textTransform\":\"uppercase\",\"letterSpacing\":\"0.5px\"},\"children\":[\"🏷️\",\" \",\"Bon Plan\"]}],[\"$\",\"h3\",null,{\"className\":\"card-title\",\"children\":\"COSRX Snail Mucin 96 Essence : Le sérum K-Beauty le plus viral au monde\"}],[\"$\",\"p\",null,{\"className\":\"card-excerpt\",\"children\":\"Le COSRX Advanced Snail 96 Mucin Power Essence est LE produit K-Beauty viral sur TikTok. Hydratation, cicatrisation, éclat — pour moins de 15€ sur YesStyle.\"}]]}]]}],[\"$\",\"a\",\"test-pourquoi-utiliser-serum-visage-routine-soin-meilleurs-serums-amazon-2026\",{\"href\":\"/article/test-pourquoi-utiliser-serum-visage-routine-soin-meilleurs-serums-amazon-2026\",\"className\":\"card\",\"style\":{\"textDecoration\":\"none\"},\"children\":[[\"$\",\"div\",null,{\"style\":{\"position\":\"relative\",\"height\":\"160px\",\"overflow\":\"hidden\"},\"children\":[\"$\",\"$L1e\",null,{\"src\":\"/images/articles/test-pourquoi-utiliser-serum-visage-routine-soin-meilleurs-serums-amazon-2026.svg\",\"alt\":\"Meilleurs serums visage Amazon test et avis routine soin 2026\",\"fill\":true,\"style\":{\"objectFit\":\"cover\"},\"sizes\":\"33vw\"}]}],[\"$\",\"div\",null,{\"className\":\"card-body\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"fontSize\":\"0.72