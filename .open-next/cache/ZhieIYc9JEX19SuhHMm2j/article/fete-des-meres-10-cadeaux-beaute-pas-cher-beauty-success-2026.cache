\\\",\\\"letterSpacing\\\":\\\"0.5px\\\"},\\\"children\\\":[\\\"🏷️\\\",\\\" \\\",\\\"Bon Plan\\\"]}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"card-title\\\",\\\"children\\\":\\\"Clarins : 3 trousses découverte à 30€ (valeur jusqu'à 45€), idéal fête des mères\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"card-excerpt\\\",\\\"children\\\":\\\"Découvrez les 3 trousses Clarins à 30€ : soins visage, corps, maquillage. Valeur de 39 à 45€. Le cadeau parfait pour la fête des mères 2026.\\\"}]]}]]}],[\\\"$\\\",\\\"a\\\",\\\"beauty-success-5-cadeaux-fete-des-meres-moins-15-euros-2026\\\",{\\\"href\\\":\\\"/article/beauty-success-5-cadeaux-fete-des-meres-moins-15-euros-2026\\\",\\\"className\\\":\\\"card\\\",\\\"style\\\":{\\\"textDecoration\\\":\\\"none\\\"},\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"position\\\":\\\"relative\\\",\\\"height\\\":\\\"160px\\\",\\\"overflow\\\":\\\"hidden\\\"},\\\"children\\\":[\\\"$\\\",\\\"$L1e\\\",null,{\\\"src\\\":\\\"/images/articles/beauty-success-baija-moana-coffret-2026.webp\\\",\\\"alt\\\":\\\"Coffret Baïja Moana mousse de douche et crème mains fête des mères\\\",\\\"fill\\\":true,\\\"style\\\":{\\\"objectFit\\\":\\\"cover\\\"},\\\"sizes\\\":\\\"33vw\\\"}]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"card-body\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"style\\\":{\\\"fontSize\\\":\\\"0.72rem\\\",\\\"fontWeight\\\":600,\\\"color\\\":\\\"var(--primary)\\\",\\\"textTransform\\\":\\\"uppercase\\\",\\\"letterSpacing\\\":\\\"0.5px\\\"},\\\"children\\\":[\\\"🏷️\\\",\\\" \\\",\\\"Bon Plan\\\"]}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"card-title\\\",\\\"children\\\":\\\"Fête des mères : 5 coffrets cadeaux à moins de 15€ chez Beauty Success\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"card-excerpt\\\",\\\"children\\\":\\\"5 idées cadeaux fête des mères à moins de 15€ chez Beauty Success. Maquillage, roses de savon, soins Baïja, Algologie, pinceaux. Dès 12,95€.\\\"}]]}]]}],[\\\"$\\\",\\\"a\\\",\\\"comparatif-coffrets-parfum-fete-des-meres-2026\\\",{\\\"href\\\":\\\"/article/comparatif-coffrets-parfum-fete-des-meres-2026\\\",\\\"className\\\":\\\"card\\\",\\\"style\\\":{\\\"textDecoration\\\":\\\"none\\\"},\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"position\\\":\\\"relative\\\",\\\"height\\\":\\\"160px\\\",\\\"overflow\\\":\\\"hidden\\\"},\\\"children\\\":[\\\"$\\\",\\\"$L1e\\\",null,{\\\"src\\\":\\\"/images/articles/comparatif-coffrets-parfum-fete-des-meres-2026.svg\\\",\\\"alt\\\":\\\"Comparatif coffrets parfum fête des mères 2026\\\",\\\"fill\\\":true,\\\"style\\\":{\\\"objectFit\\\":\\\"cover\\\"},\\\"sizes\\\":\\\"33vw\\\"}]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"card-body\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"style\\\":{\\\"fontSize\\\":\\\"0.72rem\\\",\\\"fontWeight\\\":600,\\\"color\\\":\\\"var(--primary)\\\",\\\"textTransform\\\":\\\"uppercase\\\",\\\"letterSpacing\\\":\\\"0.5px\\\"},\\\"children\\\":[\\\"✨\\\",\\\" \\\",\\\"Beauté\\\"]}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"card-title\\\",\\\"children\\\":\\\"Coffrets parfum fête des mères 2026 : comparatif des 6 meilleurs\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"card-excerpt\\\",\\\"children\\\":\\\"Lancôme, Chanel, Dior, YSL, Guerlain, Mugler : on compare les coffrets parfum pour la fête des mères 2026. Lequel offrir ?\\\"}]]}]]}]]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"1a:[\\\"$\\\",\\\"nav\\\",null,{\\\"style\\\":{\\\"margin\\\":\\\"40px 0\\\",\\\"padding\\\":\\\"24px\\\",\\\"background\\\":\\\"var(--muted, #f3f4f6)\\\",\\\"borderRadius\\\":\\\"16px\\\"},\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"style\\\":{\\\"fontSize\\\":\\\"1rem\\\",\\\"marginBottom\\\":\\\"12px\\\"},\\\"children\\\":\\\"Explorer par catégorie\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"display\\\":\\\"flex\\\",\\\"flexWrap\\\":\\\"wrap\\\",\\\"gap\\\":\\\"8px\\\"},\\\"children\\\":[