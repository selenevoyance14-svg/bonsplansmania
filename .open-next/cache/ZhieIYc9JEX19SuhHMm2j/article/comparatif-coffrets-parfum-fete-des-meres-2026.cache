sition\":\"relative\",\"height\":\"160px\",\"overflow\":\"hidden\"},\"children\":[\"$\",\"$L1e\",null,{\"src\":\"/images/articles/belle-au-naturel-coffrets-cadeaux-gamme-2026.webp\",\"alt\":\"Gamme complète des coffrets cadeaux beauté bio Belle au Naturel\",\"fill\":true,\"style\":{\"objectFit\":\"cover\"},\"sizes\":\"33vw\"}]}],[\"$\",\"div\",null,{\"className\":\"card-body\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"fontSize\":\"0.72rem\",\"fontWeight\":600,\"color\":\"var(--primary)\",\"textTransform\":\"uppercase\",\"letterSpacing\":\"0.5px\"},\"children\":[\"✨\",\" \",\"Beauté\"]}],[\"$\",\"h3\",null,{\"className\":\"card-title\",\"children\":\"Belle au Naturel : coffrets cadeaux beauté bio dès 25€, idéal fête des mères\"}],[\"$\",\"p\",null,{\"className\":\"card-excerpt\",\"children\":\"Plus de 50 coffrets cadeaux beauté 100% bio et made in France chez Belle au Naturel. Dès 25€, le cadeau parfait pour la fête des mères 2026.\"}]]}]]}],[\"$\",\"a\",\"fete-des-meres-10-cadeaux-beaute-pas-cher-beauty-success-2026\",{\"href\":\"/article/fete-des-meres-10-cadeaux-beaute-pas-cher-beauty-success-2026\",\"className\":\"card\",\"style\":{\"textDecoration\":\"none\"},\"children\":[[\"$\",\"div\",null,{\"style\":{\"position\":\"relative\",\"height\":\"160px\",\"overflow\":\"hidden\"},\"children\":[\"$\",\"$L1e\",null,{\"src\":\"/images/articles/fete-des-meres-10-cadeaux-beaute-pas-cher-beauty-success-2026.svg\",\"alt\":\"Fête des mères 2026 10 cadeaux beauté pas cher Beauty Success\",\"fill\":true,\"style\":{\"objectFit\":\"cover\"},\"sizes\":\"33vw\"}]}],[\"$\",\"div\",null,{\"className\":\"card-body\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"fontSize\":\"0.72rem\",\"fontWeight\":600,\"color\":\"var(--primary)\",\"textTransform\":\"uppercase\",\"letterSpacing\":\"0.5px\"},\"children\":[\"🏷️\",\" \",\"Bon Plan\"]}],[\"$\",\"h3\",null,{\"className\":\"card-title\",\"children\":\"Fête des Mères 2026 : 10 Cadeaux Beauté Pas Cher chez Beauty Success\"}],[\"$\"