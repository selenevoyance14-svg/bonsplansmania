\":\"4px\"},\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":13,\"height\":13,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-clock\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"mmk7yg\",{\"d\":\"M12 6v6l4 2\"}],[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],\"$undefined\"]}],\" \",\"2 min\"]}]]}],[\"$\",\"h1\",null,{\"children\":\"Gagnez des DVD Marcel et Monsieur Pagnol — Concours Gratuit\"}],[\"$\",\"p\",null,{\"className\":\"article-subtitle\",\"children\":\"Participez gratuitement au concours Ma Famille Zen et tentez de gagner les DVD Marcel et Monsieur Pagnol, des classiques du cinéma français.\"}],\"$L3\"]}],\"$L4\",\"$L5\",\"$L6\",\"$L7\",\"$L8\",\"$L9\"]}],\"$La\",\"$Lb\",\"$Lc\",\"$Ld\"]}]}],\"$Le\",\"$Lf\"],[\"$L10\"],\"$L11\"]}],\"loading\":null,\"isPartial\":false}\n3:[\"$\",\"div\",null,{\"className\":\"article-rating-bar\",\"children\":[\"$undefined\",\"$undefined\",[\"$\",\"a\",null,{\"href\":\"https://www.mafamillezen.com/concours-jeux/gagnez-des-dvd-marcel-et-monsieur-pagnol/\",\"className\":\"btn btn-primary btn-sm\",\"target\":\"_blank\",\"rel\":\"nofollow sponsored noopener\",\"children\":[\"Participer au concours DVD Pagnol\",\" \",[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":13,\"height\":13,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-external-link\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1q9fwt\",{\"d\":\"M15 3h6v6\"}],[\"$\",\"path\",\"gplh6r\",{\"d\":\"M10 14 21 3\"}],[\"$\",\"path\",\"a6xqqp\",{\"d\":\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"}],\"$undefined\"]}]]}]]}]\n4:[\"$\",\"div\",null,{\"className\":\"article-hero-image\",\"style\":{\"background\":\"#fff\",\"borderRadius\":\"12px\",\"overflow\":\"hidden\",\"display\":\"flex\",\"justifyContent\":\"center\",\"alignItems\":\"center\",\"maxHeight\":\"450px\"},\"children\":[\"$\",\"$L12\",null,{\"src\":\"/images/articles/concours-dvd-marcel-monsieur-pagnol-2026.svg\",\"alt\":\"Concours DVD Marcel et Monsieur Pagnol\",\"width\":800,\"height\":450,\"style\":{\"width\":\"100%\",\"height\":\"100%\",\"objectFit\":\"contain\",\"maxHeight\":\"450px\"},\"priority\":true}]}]\n5:[\"$\",\"$L13\",null,{}]\n6:[\"$\",\"$L14\",null,{}]\n15:Tcb7,<p>\n<h2>Gagnez des DVD Marcel et Monsieur Pagnol — Concours Gratuit</h2><p>Vous êtes fan de cinéma français et de grands classiques ? Ma Famille Zen organise un concours entièrement gratuit pour vous permettre de repartir avec les DVD <strong>Marcel</strong> et <strong>Monsieur Pagnol</strong>, deux films incontournables qui rendent hommage à la vie du légendaire cinéaste. Un lot idéal pour toute la famille, à partager entre générations !</p><p><div class=\"cta-inline\"><a href=\"https://www.mafamillezen.com/concours-jeux/gagnez-des-dvd-marcel-et-monsieur-pagnol/\" class=\"btn btn-primary btn-sm\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Participer au concours DVD Pagnol <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/><polyline points=\"15 3 21 3 21 9\"/><line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\"/></svg></a></div><h2>Comment participer ?</h2><p>Rien de plus simple, la participation se fait en quelques secondes :</p><p>1. Rendez-vous sur le site <strong>Ma Famille Zen</strong> via le lien ci-dessous\n2. Remplissez le formulaire de participation avec vos informations\n3. Validez votre inscription et attendez les résultats</p><p>Pas de tirage au sort compliqué, pas d'achat obligatoire — c'est 100% gratuit et ouvert à tous.</p><p><div id=\"ezoic-pub-ad-placeholder-203\" class=\"ad-container\" style=\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\"></div><h2>Pourquoi ces films sont incontournables ?</h2><p>Marcel Pagnol est l'un des plus grands noms du cinéma et de la littérature françaises. Ses œuvres comme <strong>Manon des Sources</strong>, <strong>Jean de Florette</strong> ou <strong>La Gloire de mon père</strong> transportent le spectateur dans la Provence du siècle dernier avec une sincérité et une poésie rares. Ces films traversent le temps et continuent d'émouvoir des millions de spectateurs, des enfants aux grands-parents. Les avoir en DVD, c'est s'offrir un trésor culturel à portée de main.</p><p><a href=\"https://www.mafamillezen.com/concours-jeux/gagnez-des-dvd-marcel-et-monsieur-pagnol/\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Participer au concours DVD Pagnol</a></p><p><div class=\"cta-inline\"><a href=\"https://www.mafamillezen.com/concours-jeux/gagnez-des-dvd-marcel-et-monsieur-pagnol/\" class=\"btn btn-primary btn-sm\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Participer au concours DVD Pagnol <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/><polyline points=\"15 3 21 3 21 9\"/><line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\"/></svg></a></div><h2>Astuce</h2><p>Pour maximiser vos chances, participez dès l'ouverture du concours et invitez vos proches à s'inscrire également si le règlement le permet. Les concours Ma Famille Zen sont connus pour leur sérieux et leur transparence — une plateforme de confiance pour les amateurs de bons plans familiaux !\n</p>7:[\"$\",\"div\",null,{\"className\":\"article-content\",\"children\":[\"$\",\"div\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"$15\"}}]}]\n8:[\"$\",\"$L13\",null,{}]\n9:[\"$\",\"div\",null,{\"style\":{\"textAlign\":\"center\",\"margin\":\"40px 0\",\"padding\":\"32px\",\"background\":\"linear-gradient(135deg, #FFF0F0 0%, #FFF8F0 100%)\",\"borderRadius\":\"16px\",\"border\":\"2px solid #FECDD3\"},\"children\":[[\"$\",\"p\",null,{\"style\":{\"fontWeight\":800,\"fontSize\":\"1.2rem\",\"marginBottom\":\"16px\",\"color\":\"var(--foreground)\"},\"children\":\"Profiter de cette offre\"}],[\"$\",\"a\",null,{\"href\":\"https://www.mafamillezen.com/concours-jeux/gagnez-des-dvd-marcel-et-monsieur-pagnol/\",\"className\":\"btn btn-primary\",\"target\":\"_blank\",\"rel\":\"nofollow sponsored noopener\",\"style\":{\"padding\":\"14px 32px\",\"fontSize\":\"1rem\"},\"children\":[\"Participer au concours DVD Pagnol\",\" \",[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":15,\"height\":15,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-external-link\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1q9fwt\",{\"d\":\"M15 3h6v6\"}],[\"$\",\"path\",\"gplh6r\",{\"d\":\"M10 14 21 3\"}],[\"$\",\"path\",\"a6xqqp\",{\"d\":\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"}],\"$undefined\"]}]]}]]}]\na:[\"$\",\"$L13\",null,{}]\nb:[\"$\",\"section\",null,{\"className\":\"related-articles\",\"children\":[[\"$\",\"h2\",null,{\"children\":\"A lire aussi\"}],[\"$\",\"div\",null,{\"className\":\"articles-grid\",\"style\":{\"gridTemplateColumns\":\"repeat(auto-fit, minmax(280px, 1fr))\"},\"children\":[[\"$\",\"a\",\"printemps-cinema-2026-places-5-euros-concours\",{\"href\":\"/article/printemps-cinema-2026-places-5-euros-concours\",\"className\":\"card\",\"style\":{\"textDecoration\":\"none\"},\"children\":[[\"$\",\"div\",null,{\"style\":{\"position\":\"relative\",\"height\":\"160px\",\"overflow\":\"hidden\"},\"children\":[\"$\",\"$L12\",null,{\"src\":\"/images/articl