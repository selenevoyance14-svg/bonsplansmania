",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L3\",null,{\"children\":[\"$\",\"$4\",null,{\"name\":\"Next.Metadata\",\"children\":[[\"$\",\"title\",\"0\",{\"children\":\"Gillette Labs i7 à 68,90€ : tondeuse corps -34%\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Tondeuse Gillette Labs Body + Intimate i7 à -34% sur Amazon. Technologie SkinFirst, étanche, LED, 100 min d'autonomie. Notre avis et test complet.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"manifest\",\"href\":\"/manifest.json\"}],[\"$\",\"meta\",\"3\",{\"name\":\"keywords\",\"content\":\"bons plans beauté,tests produits gratuits,concours beauté,box beauté,réductions cosmétiques,codes promo beauté,échantillons gratuits\"}],[\"$\",\"link\",\"4\",{\"rel\":\"canonical\",\"href\":\"https://bonsplansmania.fr/article/gillette-labs-i7-tondeuse-corps-intime-promo-amazon-2026\"}],[\"$\",\"meta\",\"5\",{\"property\":\"og:title\",\"content\":\"Gillette Labs i7 à 68,90€ au lieu de 104€ : la tondeuse corps et intime à -34%\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:description\",\"content\":\"La tondeuse Gillette Labs Body + Intimate i7 à 68,90€ sur Amazon. Étanche, LED, 3 sabots, 100 min d'autonomie. Notre avis sur ce bon plan.\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:image\",\"content\":\"http://localhost:3000/images/articles/gillette-labs-i7-tondeuse-corps-intime-2026.jpg\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:type\",\"content\":\"article\"}],[\"$\",\"meta\",\"9\",{\"property\":\"article:published_time\",\"content\":\"2026-04-09\"}],[\"$\",\"meta\",\"10\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"11\",{\"name\":\"twitter:title\",\"content\":\"Bons Plans Mania — Bons plans beauté & tests gratuits\"}],[\"$\",\"meta\",\"12\",{\"name\":\"twitter:description\",\"content\":\"Les meilleurs bons plans beauté, tests gratuits, concours et avis box beauté.\"}],[\"$\",\"meta\",\"13\",{\"name\":\"twitter:image\",\"content\":\"http://localhost:3000/images/