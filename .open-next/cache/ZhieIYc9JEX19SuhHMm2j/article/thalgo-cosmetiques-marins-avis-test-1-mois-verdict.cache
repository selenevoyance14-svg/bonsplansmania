",\\\"cy\\\":\\\"12\\\",\\\"r\\\":\\\"10\\\"}],\\\"$undefined\\\"]}],\\\" \\\",\\\"5 min\\\"]}]]}],[\\\"$\\\",\\\"h1\\\",null,{\\\"children\\\":\\\"Thalgo : les cosmétiques marins valent-ils vraiment leur prix ? Notre verdict après 1 mois\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"article-subtitle\\\",\\\"children\\\":\\\"Notre avis sur Thalgo après 1 mois d'essai. Huile démaquillante, masque Source Marine, gommage des Îles. Efficacité, composition et rapport qualité-prix.\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"article-rating-bar\\\",\\\"children\\\":[\\\"$undefined\\\",\\\"$undefined\\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://lk.gt/adZxs\\\",\\\"className\\\":\\\"btn btn-primary btn-sm\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"nofollow sponsored noopener\\\",\\\"children\\\":[\\\"Voir les produits Thalgo\\\",\\\" \\\",\\\"$Lf\\\"]}]]}]]}],\\\"$L10\\\",\\\"$L11\\\",\\\"$L12\\\",\\\"$L13\\\",\\\"$L14\\\",\\\"$L15\\\"]}],\\\"$L16\\\",\\\"$L17\\\",\\\"$L18\\\",\\\"$L19\\\"]}]}],\\\"$L1a\\\",\\\"$L1b\\\"]\\n\"])</script><script>self.__next_f.push([1,\"1c:I[5500,[\\\"/_next/static/chunks/cf200c391baea40a.js\\\",\\\"/_next/static/chunks/6e48aeeec84550f8.js\\\"],\\\"Image\\\"]\\n1d:I[96788,[\\\"/_next/static/chunks/cf200c391baea40a.js\\\",\\\"/_next/static/chunks/6e48aeeec84550f8.js\\\"],\\\"default\\\"]\\n1e:I[1586,[\\\"/_next/static/chunks/cf200c391baea40a.js\\\",\\\"/_next/static/chunks/6e48aeeec84550f8.js\\\"],\\\"default\\\"]\\n20:I[67277,[\\\"/_next/static/chunks/cf200c391baea40a.js\\\",\\\"/_next/static/chunks/6e48aeeec84550f8.js\\\"],\\\"default\\\"]\\nf:[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":13,\\\"height\\\":13,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-external-link\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":[[\\\"$\\\",\\\"path\\\",\\\"1q9fwt\\\",{\\\"d\\\":\\\"M15 3h6v6\\\"}],[\\\"$\\\",\\\"path\\\",\\\"gplh6r\\\",{\\\"d\\\":\\\"M10 14 21 3\\\"}],[\\\"$\\\",\\\"path\\\",\\\"a6xqqp\\\",{\\\"d\\\":\\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\\"}],\\\"$undefined\\\"]}]\\n10:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"article-hero-image\\\",\\\"style\\\":{\\\"background\\\":\\\"#fff\\\",\\\"borderRadius\\\":\\\"12px\\\",\\\"overflow\\\":\\\"hidden\\\",\\\"display\\\":\\\"flex\\\",\\\"justifyContent\\\":\\\"center\\\",\\\"alignItems\\\":\\\"center\\\",\\\"maxHeight\\\":\\\"450px\\\"},\\\"children\\\":[\\\"$\\\",\\\"$L1c\\\",null,{\\\"src\\\":\\\"/images/articles/thalgo-cosmetiques-marins-avis-test-1-mois-verdict.svg\\\",\\\"alt\\\":\\\"Avis Thalgo cosmétiques marins test après 1 mois\\\",\\\"width\\\":800,\\\"height\\\":450,\\\"style\\\":{\\\"width\\\":\\\"100%\\\",\\\"height\\\":\\\"100%\\\",\\\"objectFit\\\":\\\"contain\\\",\\\"maxHeight\\\":\\\"450px\\\"},\\\"priority\\\":true}]}]\\n11:[\\\"$\\\",\\\"$L1d\\\",null,{}]\\n12:[\\\"$\\\",\\\"$L1e\\\",null,{}]\\n1f:T1b5b,\"])</script><script>self.__next_f.push([1,\"\\u003cp\\u003e\\n\\u003ch2\\u003eThalgo : on a testé la marque pendant 1 mois\\u003c/h2\\u003e\\u003cp\\u003eOn nous pose souvent la question : est-ce que Thalgo vaut vraiment son prix ? Entre les crèmes à 30€ et les gommages à 40€, on comprend l'hésitation. On a décidé de tester trois produits phares pendant un mois pour se faire un vrai avis.\\u003c/p\\u003e\\u003chr\\u003e\\u003cp\\u003e\\u003cdiv class=\\\"cta-inline\\\"\\u003e\\u003ca href=\\\"https://lk.gt/adZxs\\\" class=\\\"btn btn-primary btn-sm\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eVoir les produits Thalgo \\u003csvg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"13\\\" height=\\\"13\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"\\u003e\\u003cpath d=\\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\\"/\\u003e\\u003cpolyline points=\\\"15 3 21 3 21 9\\\"/\\u003e\\u003cline x1=\\\"10\\\" y1=\\\"14\\\" x2=\\\"21\\\" y2=\\\"3\\\"/\\u003e\\u003c/svg\\u003e\\u003c/a\\u003e\\u003c/div\\u003e\\u003ch2\\u003eThalgo, c'est quoi exactement ?\\u003c/h2\\u003e\\u003cp\\u003eFondée en \\u003cstrong\\u003e1964\\u003c/strong\\u003e par le pharmacien André Bouclet, \\u003cstrong\\u003eThalgo\\u003c/strong\\u003e est une marque française spécialisée dans les \\u003cstrong\\u003ecosmétiques marins\\u003c/strong\\u003e. À l'origine présente dans les instituts de thalassothérapie et les spas, la marque s'est ouverte au grand public avec des soins inspirés de l'univers marin.\\u003c/p\\u003e\\u003cp\\u003eSon positionnement : du \\u003cstrong\\u003esemi-luxe\\u003c/strong\\u003e avec des prix qui vont de 8€ pour un gel douche à plus de 40€ pour les soins visage. Pas donné, mais pas du luxe inaccessible non plus.\\u003c/p\\u003e\\u003chr\\u003e\\u003cp\\u003e\\u003cdiv id=\\\"ezoic-pub-ad-placeholder-203\\\" class=\\\"ad-container\\\" style=\\\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\\\"\\u003e\\u003c/div\\u003e\\u003ch2\\u003eCe qu'il y a vraiment dans les produits\\u003c/h2\\u003e\\u003cp\\u003eOn a regardé de près la composition. Comme tous les cosmétiques vendus en France, les produits Thalgo respectent le \\u003cstrong\\u003erèglement cosmétique européen n° 1223/2009\\u003c/strong\\u003e.\\u003c/p\\u003e\\u003cp\\u003eCôté formulation :\\u003c/p\\u003e\\u003cul\\u003e\\u003cli\\u003e\\u003cstrong\\u003eBase classique\\u003c/strong\\u003e — 60 à 80% d'eau déminéralisée, comme la plupart des soins\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eComplexes marins brevetés\\u003c/strong\\u003e — c'est là que Thalgo se distingue, avec \\u003cstrong\\u003e14 minéraux\\u003c/strong\\u003e issus de l'eau de mer\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eSilicium marin\\u003c/strong\\u003e — \\u003cstrong\\u003e14 fois plus concentré\\u003c/strong\\u003e que dans l'eau de mer classique\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eAlgues actives\\u003c/strong\\u003e — Fucus, Laminaire digitée, Lithothamnium (algue calcaire)\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eProcédé d'éclatement cellulaire\\u003c/strong\\u003e — une technologie maison qui réduit les actifs à quelques microns pour une meilleure pénétration\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\nEn résumé : une base standard enrichie d'actifs marins plutôt bien dosés. Ce n'est pas de la poudre de perlimpinpin, mais ce n'est pas non plus une révolution.\\u003c/p\\u003e\\u003chr\\u003e\\u003cp\\u003e\\u003cdiv class=\\\"cta-inline\\\"\\u003e\\u003ca href=\\\"https://lk.gt/adZxs\\\" class=\\\"btn btn-primary btn-sm\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eVoir les produits Thalgo \\u003csvg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"13\\\" height=\\\"13\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"\\u003e\\u003cpath d=\\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\\"/\\u003e\\u003cpolyline points=\\\"15 3 21 3 21 9\\\"/\\u003e\\u003cline x1=\\\"10\\\" y1=\\\"14\\\" x2=\\\"21\\\" y2=\\\"3\\\"/\\u003e\\u003c/svg\\u003e\\u003c/a\\u003e\\u003c/div\\u003e\\u003ch2\\u003eLes chiffres d'efficacité\\u003c/h2\\u003e\\u003cp\\u003eThalgo communique des résultats de tests sur certains produits. On a vérifié :\\u003c/p\\u003e\\u003cul\\u003e\\u003cli\\u003e\\u003cstrong\\u003eSérum Silicium\\u003c/strong\\u003e : +51% d'élasticité et -17% de rides après 42 jours (test instrumenté)\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eHydratation\\u003c/strong\\u003e : les tests au cornéomètre dépassent le seuil de validation de +30% après 4 heures\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eSatisfaction\\u003c/strong\\u003e : 90% des volontaires rapportent une peau plus ferme\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\nCes chiffres sont corrects pour du semi-luxe. On est dans la moyenne haute du marché.\\u003c/p\\u003e\\u003chr\\u003e\\u003ch2\\u003eLes 3 produits qu'on a testés\\u003c/h2\\u003e\\u003ch3\\u003eHuile gélifiée démaquillante — 25€ / 125 ml\\u003c/h3\\u003e\\u003cp\\u003eLa texture gel-huile est agréable et se transforme en lait au contact de l'eau. Elle retire bien le fond de teint et le maquillage léger. En revanche, sur du mascara waterproof, il faut repasser plusieurs fois. Score \\u003cstrong\\u003e100/100 sur Yuka\\u003c/strong\\u003e pour la composition.\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003eNotre note : 7/10\\u003c/strong\\u003e — Bonne composition, mais pas assez efficace sur le maquillage résistant.\\u003c/p\\u003e\\u003ch3\\u003eMasque hydratant Source Marine — 31,50€ / 50 ml\\u003c/h3\\u003e\\u003cp\\u003eC'est le produit qui nous a le plus convaincues. La texture est onctueuse, l'odeur marine est discrète et agréable. Après 10 minutes de pose, la peau est \\u003cstrong\\u003erepulpée et confortable\\u003c/strong\\u003e pendant toute la journée. On l'a utilisé deux fois par semaine pendant un mois et la différence sur la qualité de la peau est visible.\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003eNotre note : 8,5/10\\u003c/strong\\u003e — Très bon masque hydratant, rapport qualité-prix correct.\\u003c/p\\u003e\\u003ch3\\u003eGommage des Îles — 41€ / 100 ml\\u003c/h3\\u003e\\u003cp\\u003eLe \\u003cstrong\\u003ecoup de coeur\\u003c/strong\\u003e du test. Le gommage a une texture sableuse fine avec des notes de monoï. L'exfoliation est douce mais efficace, la peau est lisse sans rougeurs. C'est un vrai moment de plaisir sous la douche. Le seul bémol : le prix au millilitre est élevé.\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003eNotre note : 9/10\\u003c/strong\\u003e — Expérience sensorielle au top, mais le flacon part vite à 41€.\\u003c/p\\u003e\\u003chr\\u003e\\u003cp\\u003e\\u003cdiv id=\\\"ezoic-pub-ad-placeholder-206\\\" class=\\\"ad-container\\\" style=\\\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\\\"\\u003e\\u003c/div\\u003e\\u003ch2\\u003eAlors, est-ce que ça vaut le prix ?\\u003c/h2\\u003e\\u003cp\\u003eNotre verdict après un mois est nuancé :\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003eCe qu'on a aimé :\\u003c/strong\\u003e\\n\\u003cul\\u003e\\u003cli\\u003eDes actifs marins réellement dosés, pas juste un argument marketing\\u003c/li\\u003e\\n\\u003cli\\u003eDes textures soignées et des parfums subtils\\u003c/li\\u003e\\n\\u003cli\\u003eUne efficacité mesurable sur l'hydratation et l'éclat\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003cstrong\\u003eCe qui nous a moins convaincues :\\u003c/strong\\u003e\\n\\u003cul\\u003e\\u003cli\\u003eLa composition reste perfectible (on retrouve des silicones dans certains produits)\\u003c/li\\u003e\\n\\u003cli\\u003eLe prix au millilitre est élevé sur les petits formats\\u003c/li\\u003e\\n\\u003cli\\u003eL'huile démaquillante manque de puissance sur le waterproof\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003cstrong\\u003eEn résumé\\u003c/strong\\u003e : Thalgo est une marque sérieuse avec de vrais actifs. On ne paie pas que pour le packaging. Mais au vu des prix, on recommande de cibler les produits stars (masque et gommage) plutôt que de racheter toute la gamme.\\u003c/p\\u003e\\u003chr\\u003e\\u003ch2\\u003eFAQ\\u003c/h2\\u003e\\u003cp\\u003e\\u003cstrong\\u003eEst-ce que Thalgo hydrate vraiment mieux qu'une crème classique ?\\u003c/strong\\u003e\\u003c/p\\u003e\\u003cp\\u003eLes tests instrumentés montrent une hydratation supérieure à la moyenne grâce aux minéraux marins. Mais sur une peau normale, la différence avec une bonne crème à 15€ reste subtile.\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003ePourquoi c'est plus cher que les marques de supermarché ?\\u003c/strong\\u003e\\u003c/p\\u003e\\u003cp\\u003eLe prix s'explique par les actifs marins brevetés, le procédé d'extraction et le positionnement spa/institut. On paie aussi une partie du marketing.\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003eComment vérifier la qualité d'un produit Thalgo ?\\u003c/strong\\u003e\\u003c/p\\u003e\\u003cp\\u003eRegardez la \\u003cstrong\\u003eliste INCI\\u003c/strong\\u003e au dos du produit. Les ingrédients sont classés par ordre décroissant de concentration. Si les actifs marins apparaissent en fin de liste, leur dosage est faible.\\n\\u003c/p\\u003e\"])</script><script>self.__next_f.push([1,\"13:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"article-content\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"$1f\\\"}}]}]\\n14:[\\\"$\\\",\\\"$L1d\\\",null,{}]\\n15:[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"textAlign\\\":\\\"center\\\",\\\"margin\\\":\\\"40px 0\\\",\\\"padding\\\":\\\"32px\\\",\\\"background\\\":\\\"linear-gradient(135deg, #FFF0F0 0%, #FFF8F0 100%)\\\",\\\"borderRadius\\\":\\\"16px\\\",\\\"border\\\":\\\"2px solid #FECDD3\\\"},\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"style\\\":{\\\"fontWeight\\\":800,\\\"fontSize\\\":\\\"1.2rem\\\",\\\"marginBottom\\\":\\\"16px\\\",\\\"color\\\":\\\"var(--foreground)\\\"},\\\"children\\\":\\\"Profiter de cette offre\\\"}],[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://lk.gt/adZxs\\\",\\\"className\\\":\\\"btn btn-primary\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"nofollow sponsored noopener\\\",\\\"style\\\":{\\\"padding\\\":\\\"14px 32px\\\",\\\"fontSize\\\":\\\"1rem\\\"},\\\"children\\\":[\\\"Voir les produits Thalgo\\\",\\\" \\\",[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":15,\\\"height\\\":15,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-external-link\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":[[\\\"$\\\",\\\"path\\\",\\\"1q9fwt\\\",{\\\"d\\\":\\\"M15 3h6v6\\\"}],[\\\"$\\\",\\\"path\\\",\\\"gplh6r\\\",{\\\"d\\\":\\\"M10 14 21 3\\\"}],[\\\"$\\\",\\\"path\\\",\\\"a6xqqp\\\",{\\\"d\\\":\\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\\"}],\\\"$undefined\\\"]}]]}]]}]\\n16:[\\\"$\\\",\\\"$L1d\\\",null,{}]\\n\"])</script><script>self.__next_f.push([1,\"17:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"related-articles\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"children\\\":\\\"A lire aussi\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"articles-grid\\\",\\\"style\\\":{\\\"gridTemplateColumns\\\":\\\"repeat(auto-fit, minmax(280px, 1fr))\\\"},\\\"children\\\":[[\\\"$\\\",\\\"a\\\",\\\"loreal-professionnel-vitamino-color-shampooing-avis-test-cheveux-colores\\\",{\\\"href\\\":\\\"/article/loreal-professionnel-vitamino-color-shampooing-avis-test-cheveux-colores\\\",\\\"className\\\":\\\"card\\\",\\\"style\\\":{\\\"textDecoration\\\":\\\"none\\\"},\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"position\\\":\\\"relative\\\",\\\"height\\\":\\\"160px\\\",\\\"overflow\\\":\\\"hidden\\\"},\\\"children\\\":[\\\"$\\\",\\\"$L1c\\\",null,{\\\"src\\\":\\\"/images/articles/loreal-professionnel-vitamino-color-shampooing-avis-test-cheveux-colores.svg\\\",\\\"alt\\\":\\\"Avis L'Oréal Professionnel Vitamino Color shampooing cheveux colorés\\\",\\\"fill\\\":true,\\\"style\\\":{\\\"objectFit\\\":\\\"cover\\\"},\\\"sizes\\\":\\\"33vw\\\"}]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"card-body\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"style\\\":{\\\"fontSize\\\":\\\"0.72rem\\\",\\\"fontWeight\\\":600,\\\"color\\\":\\\"var(--primary)\\\",\\\"textTransform\\\":\\\"uppercase\\\",\\\"letterSpacing\\\":\\\"0.5px\\\"},\\\"children\\\":[\\\"🧪\\\",\\\" \\\",\\\"Test \\u0026 Avis\\\"]}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"card-title\\\",\\\"children\\\":\\\"L'Oréal Professionnel Vitamino Color : le shampooing noté 4,5/5 qui préserve l'éclat jusqu'à 8 semaines\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"card-excerpt\\\",\\\"children\\\":\\\"Notre avis sur le shampooing L'Oréal Professionnel Vitamino Color A-OX. Noté 4,5/5, il promet de préserver l'éclat des cheveux colorés jusqu'à 8 semaines.\\\"}]]}]]}],[\\\"$\\\",\\\"a\\\",\\\"payot-pate-grise-soins-avis-test-composition-peau-grasse\\\",{\\\"href\\\":\\\"/article/payot-pate-grise-soins-avis-test-composition-peau-grasse\\\",\\\"className\\\":\\\"card\\\",\\\"style\\\":{\\\"textDecoration\\\":\\\"none\\\"},\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"position\\\":\\\"relative\\\",\\\"height\\\":\\\"160px\\\",\\\"overflow\\\":\\\"hidden\\\"},\\\"children\\\":[\\\"$\\\",\\\"$L1c\\\",null,{\\\"src\\\":\\\"/images/articles/payot-pate-grise-soins-avis-test-composition-peau-grasse.svg\\\",\\\"alt\\\":\\\"Avis Payot Pâte Grise soins anti-imperfections test complet\\\",\\\"fill\\\":true,\\\"style\\\":{\\\"objectFit\\\":\\\"cover\\\"},\\\"sizes\\\":\\\"33vw\\\"}]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"card-body\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"style\\\":{\\\"fontSize\\\":\\\"0.72rem\\\",\\\"fontWeight\\\":600,\\\"color\\\":\\\"var(--primary)\\\",\\\"textTransform\\\":\\\"uppercase\\\",\\\"letterSpacing\\\":\\\"0.5px\\\"},\\\"children\\\":[\\\"🧪\\\",\\\" \\\",\\\"Test \\u0026 Avis\\\"]}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"card-title\\\",\\\"children\\\":\\\"Payot Pâte Grise : on a testé la gamme anti-imperfections (avis et compositions)\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"card-excerpt\\\",\\\"children\\\":\\\"Notre avis sur 4 soins Payot Pâte Grise : Pâte Grise Originale, gelée nettoyante, sérum peeling AHA et pain nettoyant. Compositions, notes Yuka et verdict.\\\"}]]}]]}],[\\\"$\\\",\\\"a\\\",\\\"erborian-bb-eye-touche-parfaite-contour-yeux-promo-amazon-2026\\\",{\\\"href\\\":\\\"/article/erborian-bb-eye-touche-parfaite-contour-yeux-promo-amazon-2026\\\",\\\"className\\\":\\\"card\\\",\\\"style\\\":{\\\"textDecoration\\\":\\\"none\\\"},\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"position\\\":\\\"relative\\\",\\\"height\\\":\\\"160px\\\",\\\"overflow\\\":\\\"hidden\\\"},\\\"children\\\":[\\\"$\\\",\\\"$L1c\\\",null,{\\\"src\\\":\\\"/images/articles/erborian-bb-eye-touche-parfaite-contour-yeux-promo-amazon-2026.svg\\\",\\\"alt\\\":\\\"Erborian BB Eye Touche Parfaite contour yeux promo Amazon -29% 2026\\\",\\\"fill\\\":true,\\\"style\\\":{\\\"objectFit\\\":\\\"cover\\\"},\\\"sizes\\\":\\\"33vw\\\"}]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"card-body\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"style\\\":{\\\"fontSize\\\":\\\"0.72rem\\\",\\\"fontWeight\\\":600,\\\"color\\\":\\\"var(--primary)\\\",\\\"textTransform\\\":\\\"uppercase\\\",\\\"letterSpacing\\\":\\\"0.5px\\\"},\\\"children\\\":[\\\"🏷️\\\",\\\" \\\",\\\"Bon Plan\\\"]}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"card-title\\\",\\\"children\\\":\\\"Erborian BB Eye Touche Parfaite à -29% sur Amazon : 20,89€ au lieu de 29,49€\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"card-excerpt\\\",\\\"children\\\":\\\"Erborian BB Eye Touche Parfaite contour des yeux à 20,89€ au lieu de 29,49€ sur Amazon. -29%, anti-cernes, effet peau de bébé, SPF 20, cosmétique coréen.\\\"}]]}]]}]]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"18:[\\\"$\\\",\\\"nav\\\",null,{\\\"style\\\":{\\\"margin\\\":\\\"40px 0\\\",\\\"padding\\\":\\\"24px\\\",\\\"background\\\":\\\"var(--muted, #f3f4f6)\\\",\\\"borderRadius\\\":\\\"16px\\\"},\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"style\\\":{\\\"fontSize\\\":\\\"1rem\\\",\\\"marginBottom\\\":\\\"12px\\\"},\\\"children\\\":\\\"Explorer par catégorie\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"display\\\":\\\"flex\\\",\\\"flexWrap\\\":\\\"wrap\\\",\\\"gap\\\":\\\"8px\\\"},\\\"children\\\":[[\\\"$\\\",\\\"a\\\",\\\"bon-plan\\\",{\\\"href\\\":\\\"/categorie/bon-plan\\\",\\\"style\\\":{\\\"padding\\\":\\\"6px 14px\\\",\\\"borderRadius\\\":\\\"999px\\\",\\\"background\\\":\\\"white\\\",\\\"fontSize\\\":\\\"0.82rem\\\",\\\"color\\\":\\\"var(--text, #374151)\\\",\\\"textDecoration\\\":\\\"none\\\",\\\"fontWeight\\\":500,\\\"border\\\":\\\"1px solid var(--border, #e5e7eb)\\\"},\\\"children\\\":[\\\"🏷️\\\",\\\" \\\",\\\"Bons Plans\\\"]}],[\\\"$\\\",\\\"a\\\",\\\"test-gratuit\\\",{\\\"href\\\":\\\"/categorie/test-gratuit\\\",\\\"style\\\":{\\\"padding\\\":\\\"6px 14px\\\",\\\"borderRadius\\\":\\\"999px\\\",\\\"background\\\":\\\"white\\\",\\\"fontSize\\\":\\\"0.82rem\\\",\\\"color\\\":\\\"var(--text, #374151)\\\",\\\"textDecoration\\\":\\\"none\\\",\\\"fontWeight\\\":500,\\\"border\\\":\\\"1px solid var(--border, #e5e7eb)\\\"},\\\"children\\\":[\\\"🎁\\\",\\\" \\\",\\\"Tests Gratuits\\\"]}],[\\\"$\\\",\\\"a\\\",\\\"concours\\\",{\\\"href\\\":\\\"/categorie/concours\\\",\\\"style\\\":{\\\"padding\\\":\\\"6px 14px\\\",\\\"borderRadius\\\":\\\"999px\\\",\\\"background\\\":\\\"white\\\",\\\"fontSize\\\":\\\"0.82rem\\\",\\\"color\\\":\\\"var(--text, #374151)\\\",\\\"textDecoration\\\":\\\"none\\\",\\\"fontWeight\\\":500,\\\"border\\\":\\\"1px solid var(--border, #e5e7eb)\\\"},\\\"children\\\":[\\\"🏆\\\",\\\" \\\",\\\"Concours\\\"]}],[\\\"$\\\",\\\"a\\\",\\\"box-beaute\\\",{\\\"href\\\":\\\"/categorie/box-beaute\\\",\\\"style\\\":{\\\"padding\\\":\\\"6px 14px\\\",\\\"borderRadius\\\":\\\"999px\\\",\\\"background\\\":\\\"white\\\",\\\"fontSize\\\":\\\"0.82rem\\\",\\\"color\\\":\\\"var(--text, #374151)\\\",\\\"textDecoration\\\":\\\"none\\\",\\\"fontWeight\\\":500,\\\"border\\\":\\\"1px solid var(--border, #e5e7eb)\\\"},\\\"children\\\":[\\\"💄\\\",\\\" \\\",\\\"Box Beauté\\\"]}],[\\\"$\\\",\\\"a\\\",\\\"code-promo\