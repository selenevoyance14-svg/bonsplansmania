aOutlet\\\",\\\"children\\\":\\\"$@8\\\"}]}]]}],{},null,false,false]},null,false,false]},null,false,false]},null,false,false],[\\\"$\\\",\\\"$1\\\",\\\"h\\\",{\\\"children\\\":[null,[\\\"$\\\",\\\"$L9\\\",null,{\\\"children\\\":\\\"$La\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"hidden\\\":true,\\\"children\\\":[\\\"$\\\",\\\"$Lb\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"$7\\\",null,{\\\"name\\\":\\\"Next.Metadata\\\",\\\"children\\\":\\\"$Lc\\\"}]}]}],[\\\"$\\\",\\\"meta\\\",null,{\\\"name\\\":\\\"next-size-adjust\\\",\\\"content\\\":\\\"\\\"}]]}],false]],\\\"m\\\":\\\"$undefined\\\",\\\"G\\\":[\\\"$d\\\",[]],\\\"S\\\":true}\\n\"])</script><script>self.__next_f.push([1,\"e:I[83608,[\\\"/_next/static/chunks/cf200c391baea40a.js\\\",\\\"/_next/static/chunks/6e48aeeec84550f8.js\\\"],\\\"default\\\"]\\n\"])</script><script>self.__next_f.push([1,\"5:[[\\\"$\\\",\\\"script\\\",null,{\\\"type\\\":\\\"application/ld+json\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"{\\\\\\\"@context\\\\\\\":\\\\\\\"https://schema.org\\\\\\\",\\\\\\\"@type\\\\\\\":\\\\\\\"Article\\\\\\\",\\\\\\\"headline\\\\\\\":\\\\\\\"Masque LED Silk'n : notre avis apres test (faut-il craquer ?)\\\\\\\",\\\\\\\"description\\\\\\\":\\\\\\\"Test complet du masque LED Silk'n pour le visage. Notre avis honnete sur ce masque de luminotherapie : efficacite, utilisation, prix et alternatives.\\\\\\\",\\\\\\\"datePublished\\\\\\\":\\\\\\\"2026-03-20\\\\\\\",\\\\\\\"dateModified\\\\\\\":\\\\\\\"2026-03-20\\\\\\\",\\\\\\\"image\\\\\\\":\\\\\\\"https://bonsplansmania.fr/images/articles/avis-masque-led-silk-n-test-luminotherapie-visage.svg\\\\\\\",\\\\\\\"mainEntityOfPage\\\\\\\":{\\\\\\\"@type\\\\\\\":\\\\\\\"WebPage\\\\\\\",\\\\\\\"@id\\\\\\\":\\\\\\\"https://bonsplansmania.fr/article/avis-masque-led-silk-n-test-luminotherapie-visage\\\\\\\"},\\\\\\\"author\\\\\\\":{\\\\\\\"@type\\\\\\\":\\\\\\\"Organization\\\\\\\",\\\\\\\"name\\\\\\\":\\\\\\\"Bons Plans Mania\\\\\\\",\\\\\\\"url\\\\\\\":\\\\\\\"https://bonsp