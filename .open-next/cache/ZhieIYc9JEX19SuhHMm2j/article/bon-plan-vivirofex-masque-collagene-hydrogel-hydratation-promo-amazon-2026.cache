"image\":\"https://bonsplansmania.fr/images/articles/bon-plan-vivirofex-masque-collagene-hydrogel-hydratation-promo-amazon-2026.svg\",\"aggregateRating\":{\"@type\":\"AggregateRating\",\"ratingValue\":4.5,\"bestRating\":5,\"ratingCount\":12},\"review\":{\"@type\":\"Review\",\"reviewRating\":{\"@type\":\"Rating\",\"ratingValue\":4.5,\"bestRating\":5},\"author\":{\"@type\":\"Organization\",\"name\":\"BonsPlansMania\"},\"reviewBody\":\"Bon plan masques VIVIROFEX Bio-Collagen Deep Hydration à 9,77 euros au lieu de 13,99 euros sur Amazon. Lot de 5, hydrogel, hydratation 24h, tous types de peau.\"},\"offers\":{\"@type\":\"Offer\",\"url\":\"https://bonsplansmania.fr/article/bon-plan-vivirofex-masque-collagene-hydrogel-hydratation-promo-amazon-2026\",\"price\":\"9.77\",\"priceCurrency\":\"EUR\",\"availability\":\"https://schema.org/InStock\"}}5:[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"Article\\\",\\\"headline\\\":\\\"VIVIROFEX Masques Collagène Hydrogel a -30% sur Amazon : 5 masques hydratants pour moins de 10 euros\\\",\\\"description\\\":\\\"Bon plan masques VIVIROFEX Bio-Collagen Deep Hydration à 9,77 euros au lieu de 13,99 euros sur Amazon. Lot de 5, hydrogel, hydratation 24h, tous types de peau.\\\",\\\"datePublished\\\":\\\"2026-03-30\\\",\\\"dateModified\\\":\\\"2026-03-30\\\",\\\"image\\\":\\\"https://bonsplansmania.fr/images/articles/bon-plan-vivirofex-masque-collagene-hydrogel-hydratation-promo-amazon-2026.svg\\\",\\\"mainEntityOfPage\\\":{\\\"@type\\\":\\\"WebPage\\\",\\\"@id\\\":\\\"https://bonsplansmania.fr/article/bon-plan-vivirofex-masque-collagene-hydrogel-hydratation-promo-amazon-2026\\\"},\\\"author\\\":{\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"Bons Plans Mania\\\",\\\"url\\\":\\\"https://bonsplansmania.fr\\\"},\\\"publisher\\\":{\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"Bons Plans Mania\\\",\\\"url\\\":\\\"https://