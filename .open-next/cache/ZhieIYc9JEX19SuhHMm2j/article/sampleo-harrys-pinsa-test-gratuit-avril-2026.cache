\",null,{\"className\":\"article-rating-bar\",\"children\":[\"$undefined\",\"$undefined\",[\"$\",\"a\",null,{\"href\":\"https://www.sampleo.com/fr/campaign/harrys-pinsa-1773153007\",\"className\":\"btn btn-primary btn-sm\",\"target\":\"_blank\",\"rel\":\"nofollow sponsored noopener\",\"children\":[\"Postuler pour tester la Pinsa Harrys gratuitement\",\" \",\"$Lf\"]}]]}]]}],\"$L10\",\"$L11\",\"$L12\",\"$L13\",\"$L14\",\"$L15\"]}],\"$L16\",\"$L17\",\"$L18\",\"$L19\"]}]}],\"$L1a\",\"$L1b\"]\n1c:I[5500,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"Image\"]\n1d:I[96788,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\n1e:I[1586,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\n20:I[67277,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\nf:[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":13,\"height\":13,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-external-link\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1q9fwt\",{\"d\":\"M15 3h6v6\"}],[\"$\",\"path\",\"gplh6r\",{\"d\":\"M10 14 21 3\"}],[\"$\",\"path\",\"a6xqqp\",{\"d\":\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"}],\"$undefined\"]}]\n10:[\"$\",\"div\",null,{\"className\":\"article-hero-image\",\"style\":{\"background\":\"#fff\",\"borderRadius\":\"12px\",\"overflow\":\"hidden\",\"display\":\"flex\",\"justifyContent\":\"center\",\"alignItems\":\"center\",\"maxHeight\":\"450px\"},\"children\":[\"$\",\"$L1c\",null,{\"src\":\"/images/articles/sampleo-harrys-pinsa-test-gratuit-avril-2026.svg\",\"alt\":\"Sampleo Harrys Pinsa à garnir test gratuit\",\"width\":800,\"height\":450,\"style\":{\"width\":\"100%\",\"height\":\"100%\",\"objectFit\":\"contain\",\"maxHeight\":\"450px\"},\"priority\":true}]}]\n11:[\"$\",\"$L1d\",null,{}]\n12:[\"$\",\"$L1e\",null,{}]\n1f:Teaf,<p>\n# Sampleo x Harrys : Testez la Pinsa à Garnir Gratuitement</p><p>Sampleo et <strong>Harrys</strong> lancent une grosse campagne : <strong>660 ambassadeurs</strong> pour tester la <strong>Pinsa à garnir</strong>. C'est une base de pizza artisanale à personnaliser avec tes toppings préférés. Et c'est gratuit.</p><h2>La Pinsa Harrys, c'est quoi</h2><p>La Pinsa, c'est la cousine italienne de la pizza, mais en mieux. La version Harrys est <strong>étirée à la main et précuite sur pierre</strong>, ce qui donne une texture unique : <strong>croustillante à l'extérieur, moelleuse à l'intérieur</strong>. Rien à voir avec une pâte à pizza industrielle classique.</p><p>Le principe est simple : tu ajoutes tes garnitures (sauce tomate, fromage, légumes, jambon...) et en <strong>5 minutes au four ou à l'airfryer</strong>, c'est prêt. Le carton de cuisson est inclus.</p><p><div class=\"cta-inline\"><a href=\"https://www.sampleo.com/fr/campaign/harrys-pinsa-1773153007\" class=\"btn btn-primary btn-sm\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Postuler pour tester la Pinsa Harrys gratuitement <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/><polyline points=\"15 3 21 3 21 9\"/><line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\"/></svg></a></div><h2>Les points forts du produit</h2><ul><li><strong>Sans huile de palme</strong> et sans additifs</li>\n<li><strong>Nutri-Score B</strong> — bien noté nutritionnellement</li>\n<li><strong>Prête en 5 minutes</strong> au four ou airfryer</li>\n<li><strong>Étirée à la main</strong> — texture artisanale</li>\n<li><strong>Précuite sur pierre</strong> — croustillant garanti</li>\n<li><strong>Personnalisable</strong> — chacun met ce qu'il veut dessus</li>\n</ul>\n<div id=\"ezoic-pub-ad-placeholder-203\" class=\"ad-container\" style=\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\"></div><h2>Comment participer</h2><p>1. <strong>Inscris-toi sur Sampleo</strong> via le lien de la campagne\n2. <strong>Postule</strong> pour devenir ambassadeur Pinsa Harrys\n3. <strong>Reçois le produit</strong> gratuitement si tu es sélectionnée\n4. <strong>Teste et partage</strong> ton avis et tes recettes</p><p><div class=\"cta-inline\"><a href=\"https://www.sampleo.com/fr/campaign/harrys-pinsa-1773153007\" class=\"btn btn-primary btn-sm\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Postuler pour tester la Pinsa Harrys gratuitement <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/><polyline points=\"15 3 21 3 21 9\"/><line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\"/></svg></a></div><h2>Ce qu'on sait de la campagne</h2><ul><li><strong>660 ambassadeurs</strong> recherchés (c'est beaucoup, bonnes chances)</li>\n<li><strong>Ouvre aujourd'hui</strong> (5 avril 2026)</li>\n<li>Produit testé : <strong>La Pinsa à garnir Harrys</strong></li>\n<li>Plateforme : <strong>Sampleo</strong></li>\n</ul>\n<h2>Notre avis</h2><p>On change un peu du beauté avec ce test food, et franchement ça fait plaisir. 660 places c'est généreux pour une campagne Sampleo, donc tu as de bonnes chances d'être sélectionnée. La Pinsa Harrys a l'air d'un bon produit : recette clean, Nutri-Score B, et le côté \"étirée à la main sur pierre\" promet une vraie différence de texture par rapport aux pâtes à pizza classiques. Idéal pour un repas rapide en famille ou entre potes. Fonce, c'est gratuit et sans engagement.\n</p>13:[\"$\",\"div\",null,{\"className\":\"article-content\",\"children\":[\"$\",\"div\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"$1f\"}}]}]\n14:[\"$\",\"$L1d\",null,{}]\n15:[\"$\",\"div\",null,{\"style\":{\"textAlign\":\"center\",\"margin\":\"40px 0\",\"padding\":\"32px\",\"background\":\"linear-gradient(135deg, #FFF0F0 0%, #FFF8F0 100%)\",\"borderRadius\":\"16px\",\"border\":\"2px solid #FECDD3\"},\"children\":[[\"$\",\"p\",null,{\"style\":{\"fontWeight\":800,\"fontSize\":\"1.2rem\",\"marginBottom\":\"16px\",\"color\":\"var(--foreground)\"},\"children\":\"Profiter de cette offre\"}],[\"$\",\"a\",null,{\"href\":\"https://www.sampleo.com/fr/campaign/harrys-pinsa-1773153007\",\"className\":\"btn btn-primary\",\"target\":\"_blank\",\"rel\":\"nofollow sponsored noopener\",\"style\":{\"padding\":\"14px 32px\",\"fontSize\":\"1rem\"},\"children\":[\"Postuler pour tester la Pinsa Harrys gratuitement\",\" \",[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":15,\"height\":15,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-external-link\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1q9fwt\",{\"d\":\"M15 3h6v6\"}],[\"$\",\"path\",\"gplh6r\",{\"d\":\"M10 14 21 3\"}],[\"$\",\"path\",\"a6xqqp\",{\"d\":\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"}],\"$undefined\"]}]]}]]}]\n16:[\"$\",\"$L1d\",null,{}]\n17:[\"$\",\"section\",null,{\"className\":\"related-articles\",\"children\":[[\"$\",\"h2\",null,{\"children\":\"A lire aussi\"}],[\"$\",\"div\",null,{\"className\":\"articles-grid\",\"style\":{\"gridTemplateColumns\":\"repeat(auto-fit, minmax(280px, 1fr))\"},\"children\":[[\"$\",\"a\",\"sampleo-cystiphane-fort-complement-cheveux-test-gratuit-avril-2026\",{\"href\":\"/article/sampleo-cystiphane-fort-complement-cheveux-test-gratuit-avril-2026\",\"className\":\"card\",\"style\":{\"textDecoration\":\"none\"},\"children