\\\\\\"2026-03-03\\\\\\\",\\\\\\\"dateModified\\\\\\\":\\\\\\\"2026-03-03\\\\\\\",\\\\\\\"image\\\\\\\":\\\\\\\"https://bonsplansmania.fr/images/articles/la-boite-rose-coffrets-gratuits-grossesse-bebe.svg\\\\\\\",\\\\\\\"mainEntityOfPage\\\\\\\":{\\\\\\\"@type\\\\\\\":\\\\\\\"WebPage\\\\\\\",\\\\\\\"@id\\\\\\\":\\\\\\\"https://bonsplansmania.fr/article/la-boite-rose-coffrets-gratuits-grossesse-bebe\\\\\\\"},\\\\\\\"author\\\\\\\":{\\\\\\\"@type\\\\\\\":\\\\\\\"Organization\\\\\\\",\\\\\\\"name\\\\\\\":\\\\\\\"Bons Plans Mania\\\\\\\",\\\\\\\"url\\\\\\\":\\\\\\\"https://bonsplansmania.fr\\\\\\\"},\\\\\\\"publisher\\\\\\\":{\\\\\\\"@type\\\\\\\":\\\\\\\"Organization\\\\\\\",\\\\\\\"name\\\\\\\":\\\\\\\"Bons Plans Mania\\\\\\\",\\\\\\\"url\\\\\\\":\\\\\\\"https://bonsplansmania.fr\\\\\\\",\\\\\\\"logo\\\\\\\":{\\\\\\\"@type\\\\\\\":\\\\\\\"ImageObject\\\\\\\",\\\\\\\"url\\\\\\\":\\\\\\\"https://bonsplansmania.fr/icon.svg\\\\\\\"}}}\\\"}}],null,[\\\"$\\\",\\\"script\\\",null,{\\\"type\\\":\\\"application/ld+json\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"{\\\\\\\"@context\\\\\\\":\\\\\\\"https://schema.org\\\\\\\",\\\\\\\"@type\\\\\\\":\\\\\\\"BreadcrumbList\\\\\\\",\\\\\\\"itemListElement\\\\\\\":[{\\\\\\\"@type\\\\\\\":\\\\\\\"ListItem\\\\\\\",\\\\\\\"position\\\\\\\":1,\\\\\\\"name\\\\\\\":\\\\\\\"Accueil\\\\\\\",\\\\\\\"item\\\\\\\":\\\\\\\"https://bonsplansmania.fr\\\\\\\"},{\\\\\\\"@type\\\\\\\":\\\\\\\"ListItem\\\\\\\",\\\\\\\"position\\\\\\\":2,\\\\\\\"name\\\\\\\":\\\\\\\"Test Gratuit\\\\\\\",\\\\\\\"item\\\\\\\":\\\\\\\"https://bonsplansmania.fr/categorie/test-gratuit\\\\\\\"},{\\\\\\\"@type\\\\\\\":\\\\\\\"ListItem\\\\\\\",\\\\\\\"position\\\\\\\":3,\\\\\\\"name\\\\\\\":\\\\\\\"La Boite Rose : Coffrets Grossesse et Bébé Gratuits (Valeur 400 €)\\\\\\\"}]}\\\"}}],[\\\"$\\\",\\\"$Le\\\",null,{\\\"activePage\\\":\\\"/blog\\\"}],[\\\"$\\\",\\\"main\\\",null,{\\\"className\\\":\\\"article-page\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"class