s\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"bricolage\"}]\n29:[\"$\",\"a\",\"reduction\",{\"href\":\"/marque/reduction\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"reduction\"}]\n2a:[\"$\",\"a\",\"bon-plan\",{\"href\":\"/marque/bon-plan\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"bon-plan\"}]\na:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n2b:I[27201,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/d2be314c3ece3fbe.js\"],\"IconMark\"]\n8:null\nc:[[\"$\",\"title\",\"0\",{\"children\":\"STIGA Tornado 398 : 2098 euros Amazon (-16%)\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"STIGA Tornado 398 à 2 098,99 euros sur Amazon au lieu de 2 499 euros (-16%). Tracteur tondeuse 432cc, coupe 98cm, hydrostatique. Jusqu'a 5000 m2. Paiement 24x.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"manifest\",\"href\":\"/manifest.json\",\"crossOrigin\":\"$undefined\"}],[\"$\",\"meta\",\"3\",{\"name\":\"keywords\",\"content\":\"bons plans beauté,tests produits gratuits,concours beauté,box beauté,réductions cosmétiques,codes promo beauté,échantillons gratuits\"}],[\"$\",\"link\",\"4\",{\"rel\":\"canonical\",\"href\":\"https://bonsplansmania.fr/article/bon-plan-stiga-tornado-398-tracteur-tondeuse-2098-euros-amazon-2026\"}],[\"$\",\"meta\",\"5\",{\"property\":\"og:title\",\"content\":\"STIGA Tornado 398 Tracteur Tondeuse a 2098,99 euros sur Amazon (-16%)\"}],[\"$\",\