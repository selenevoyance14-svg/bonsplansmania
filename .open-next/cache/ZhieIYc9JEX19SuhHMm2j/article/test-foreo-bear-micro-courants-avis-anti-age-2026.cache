L9\\\",null,{\\\"children\\\":\\\"$La\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"hidden\\\":true,\\\"children\\\":[\\\"$\\\",\\\"$Lb\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"$7\\\",null,{\\\"name\\\":\\\"Next.Metadata\\\",\\\"children\\\":\\\"$Lc\\\"}]}]}],[\\\"$\\\",\\\"meta\\\",null,{\\\"name\\\":\\\"next-size-adjust\\\",\\\"content\\\":\\\"\\\"}]]}],false]],\\\"m\\\":\\\"$undefined\\\",\\\"G\\\":[\\\"$d\\\",[]],\\\"S\\\":true}\\n\"])</script><script>self.__next_f.push([1,\"e:I[83608,[\\\"/_next/static/chunks/cf200c391baea40a.js\\\",\\\"/_next/static/chunks/6e48aeeec84550f8.js\\\"],\\\"default\\\"]\\n\"])</script><script>self.__next_f.push([1,\"5:[[\\\"$\\\",\\\"script\\\",null,{\\\"type\\\":\\\"application/ld+json\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"{\\\\\\\"@context\\\\\\\":\\\\\\\"https://schema.org\\\\\\\",\\\\\\\"@type\\\\\\\":\\\\\\\"Article\\\\\\\",\\\\\\\"headline\\\\\\\":\\\\\\\"Foreo Bear : Test, Avis et Guide Micro Courants Anti-Age 2026\\\\\\\",\\\\\\\"description\\\\\\\":\\\\\\\"Test et avis du Foreo Bear : micro courants pour tonifier le visage, anti-age, raffermissement. Guide complet, comment l'utiliser et ou l'acheter.\\\\\\\",\\\\\\\"datePublished\\\\\\\":\\\\\\\"2026-03-25\\\\\\\",\\\\\\\"dateModified\\\\\\\":\\\\\\\"2026-03-25\\\\\\\",\\\\\\\"image\\\\\\\":\\\\\\\"https://bonsplansmania.fr/images/articles/test-foreo-bear-micro-courants-avis-anti-age-2026.svg\\\\\\\",\\\\\\\"mainEntityOfPage\\\\\\\":{\\\\\\\"@type\\\\\\\":\\\\\\\"WebPage\\\\\\\",\\\\\\\"@id\\\\\\\":\\\\\\\"https://bonsplansmania.fr/article/test-foreo-bear-micro-courants-avis-anti-age-2026\\\\\\\"},\\\\\\\"author\\\\\\\":{\\\\\\\"@type\\\\\\\":\\\\\\\"Organization\\\\\\\",\\\\\\\"name\\\\\\\":\\\\\\\"Bons Plans Mania\\\\\\\",\\\\\\\"url\\\\\\\":\\\\\\\"https://bonsplansmania.fr\\\\\\\"},\\\\\\\"publisher\\\\\\\":{\\\\\\\"@type\\\\\\\":\\\\\\\"Organization\\\\\\\",\\\\\\\"name\\\\\\\":\\\\\\\"Bons Plans Mania\\\\\\\",\\\\\\\"url\\\\\\\":\\\\\\\"https://bonsplansma