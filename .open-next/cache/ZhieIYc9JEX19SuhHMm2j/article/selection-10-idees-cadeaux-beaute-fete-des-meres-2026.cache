assName\":\"card-excerpt\",\"children\":\"Nouveau Clarins Double Serum Fond de Teint : double texture, double éclat, 12h de perfection. Un fond de teint-soin avec papaïne et curcuma. Notre avis.\"}]]}]]}],[\"$\",\"a\",\"belle-au-naturel-coffrets-beaute-bio-fete-des-meres-2026\",{\"href\":\"/article/belle-au-naturel-coffrets-beaute-bio-fete-des-meres-2026\",\"className\":\"card\",\"style\":{\"textDecoration\":\"none\"},\"children\":[[\"$\",\"div\",null,{\"style\":{\"position\":\"relative\",\"height\":\"160px\",\"overflow\":\"hidden\"},\"children\":[\"$\",\"$L14\",null,{\"src\":\"/images/articles/belle-au-naturel-coffrets-bio-fete-des-meres-2026.png\",\"alt\":\"Belle au Naturel coffrets beaute bio made in France Fete des Meres\",\"fill\":true,\"style\":{\"objectFit\":\"cover\"},\"sizes\":\"33vw\"}]}],[\"$\",\"div\",null,{\"className\":\"card-body\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"fontSize\":\"0.72rem\",\"fontWeight\":600,\"color\":\"var(--primary)\",\"textTransform\":\"uppercase\",\"letterSpacing\":\"0.5px\"},\"children\":[\"🏷️\",\" \",\"Bon Plan\"]}],[\"$\",\"h3\",null,{\"className\":\"card-title\",\"children\":\"Belle au Naturel : coffrets beaute bio Fete des Meres des 25€ (jusqu'a -46%)\"}],[\"$\",\"p\",null,{\"className\":\"card-excerpt\",\"children\":\"Belle au Naturel : plus de 50 coffrets beaute 100% bio made in France pour la Fete des Meres. Bon d'achat 80€ a 49,90€, coffret maquillage 6 pieces a 59,90€.\"}]]}]]}]]}]]}]\ne:[\"$\",\"nav\",null,{\"style\":{\"margin\":\"40px 0\",\"padding\":\"24px\",\"background\":\"var(--muted, #f3f4f6)\",\"borderRadius\":\"16px\"},\"children\":[[\"$\",\"h3\",null,{\"style\":{\"fontSize\":\"1rem\",\"marginBottom\":\"12px\"},\"children\":\"Explorer par catégorie\"}],[\"$\",\"div\",null,{\"style\":{\"display\":\"flex\",\"flexWrap\":\"wrap\",\"gap\":\"8px\"},\"children\":[[\"$\",\"a\",\"bon-plan\",{\"href\":\"/categorie/bon-plan\",\"style\":{\"padding\":\"6px 14px\",\"borderRadius\":\"999px\",\"background\":\"white\",\"fontSize\":\"0.82rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500,\"border\":\"1px solid var(--border, #e5e7eb)\"},\"children\":[\"🏷️\",\" \",\"Bons Plans\"]}],[\"$\",\"a\",\"test-gratuit\",{\"href\":\"/categorie/test-gratuit\",\"style\":{\"padding\":\"6px 14px\",\"borderRadius\":\"999px\",\"background\":\"white\",\"fontSize\":\"0.82rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500,\"border\":\"1px solid var(--border, #e5e7eb)\"},\"children\":[\"🎁\",\" \",\"Tests Gratuits\"]}],[\"$\",\"a\",\"concours\",{\"href\":\"/categorie/concours\",\"style\":{\"padding\":\"6px 14px\",\"borderRadius\":\"999px\",\"background\":\"white\",\"fontSize\":\"0.82rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500,\"border\":\"1px solid var(--border, #e5e7eb)\"},\"children\":[\"🏆\",\" \",\"Concours\"]}],[\"$\",\"a\",\"box-beaute\",{\"href\":\"/categorie/box-beaute\",\"style\":{\"padding\":\"6px 14px\",\"borderRadius\":\"999px\",\"background\":\"white\",\"fontSize\":\"0.82rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500,\"border\":\"1px solid var(--border, #e5e7eb)\"},\"children\":[\"💄\",\" \",\"Box Beauté\"]}],[\"$\",\"a\",\"code-promo\",{\"href\":\"/categorie/code-promo\",\"style\":{\"padding\":\"6px 14px\",\"borderRadius\":\"999px\",\"background\":\"white\",\"fontSize\":\"0.82rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500,\"border\":\"1px solid var(--border, #e5e7eb)\"},\"children\":[\"🎟️\",\" \",\"Codes Promo\"]}]]}]]}]\nf:[\"$\",\"div\",null,{\"style\":{\"maxWidth\":\"780px\",\"margin\":\"0 auto\"},\"children\":[[\"$\",\"div\",null,{\"style\":{\"display\":\"flex\",\"alignItems\":\"center\",\"gap\":\"12px\",\"flexWrap\":\"wrap\",\"margin\":\"32px 0 16px\"},\"children\":[[\"$\",\"$L18\",null,{\"slug\":\"selection-10-idees-cadeaux-beaute-fete-des-meres-2026\"}],[\"$\",\"span\",null,{\"style\":