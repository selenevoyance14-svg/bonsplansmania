{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/article/layout,_N_T_/article/[slug]/layout,_N_T_/article/[slug]/page,_N_T_/article/cecotec-seche-cheveux-voyage-pliable-2000w-promo-amazon-2026"},"segmentPaths":["/_tree","/_full","/article/$d$slug/__PAGE__","/article/$d$slug","/article","/_index","/_head"]},"html":"<!DOCTYPE html><!--ZhieIYc9JEX19SuhHMm2j--><html lang=\"fr\" class=\"poppins_5c7fdea4-module__KszEFa__variable\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/829ba4228c966254-s.p.a61bc753.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/a218039a3287bcfd-s.p.4a23d71b.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/e2334d715941921e-s.p.d82a9aff.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" as=\"image\" href=\"/images/articles/cecotec-seche-cheveux-voyage-pliable-2026.jpg\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/e90239902b00a299.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/ae6ea63e89c8827e.js\"/><script src=\"/_next/static/chunks/aee6c7720838f8a2.js\" async=\"\"></script><script src=\"/_next/static/chunks/2812d922c6213753.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-e39cc3428e0d9fdf.js\" async=\"\"></script><script src=\"/_next/static/chunks/ff1a16fafef87110.js\" async=\"\"></script><script src=\"/_next/static/chunks/d2be314c3ece3fbe.js\" async=\"\"></script><script src=\"/_next/static/chunks/cf200c391baea40a.js\" async=\"\"></script><script async=\"\" src=\"https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5064203547863113\" crossorigin=\"anonymous\"></script><script src=\"/_next/static/chunks/6e48aeeec84550f8.js\" async=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>Cecotec sèche-cheveux voyage pliable à 12,90€</title><meta name=\"description\" content=\"Sèche-cheveux Cecotec IoniCare pliable 2000W à 12,90€. Diffuseur et buse inclus, 2 vitesses, air froid, idéal voyage. Choix d&#x27;Amazon, 968 avis.\"/><link rel=\"manifest\" href=\"/manifest.json\"/><meta name=\"keywords\" content=\"bons plans beauté,tests produits gratuits,concours beauté,box beauté,réductions cosmétiques,codes promo beauté,échantillons gratuits\"/><link rel=\"canonical\" href=\"https://bonsplansmania.fr/article/cecotec-seche-cheveux-voyage-pliable-2000w-promo-amazon-2026\"/><meta property=\"og:title\" content=\"Cecotec sèche-cheveux de voyage pliable 2000W à 12,90€ : le Choix d&#x27;Amazon\"/><meta property=\"og:description\" content=\"Le sèche-cheveux Cecotec IoniCare Power&amp;Go Heaven à 12,90€ sur Amazon. Pliable, 2000W, diffuseur inclus, 4,3/5 sur 968 avis. Le bon plan voyage.\"/><meta property=\"og:image\" content=\"http://localhost:3000/images/articles/cecotec-seche-cheveux-voyage-pliable-2026.jpg\"/><meta property=\"og:type\" content=\"article\"/><meta property=\"article:published_time\" content=\"2026-04-09\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Bons Plans Mania — Bons plans beauté &amp; tests gratuits\"/><meta name=\"twitter:description\" content=\"Les meilleurs bons plans beauté, tests gratuits, concours et avis box beauté.\"/><meta name=\"twitter:image\" content=\"http://localhost:3000/images/articles/cecotec-seche-cheveux-voyage-pliable-2026.jpg\"/><link rel=\"icon\" href=\"/favicon.svg\" type=\"image/svg+xml\"/><link rel=\"icon\" href=\"/favicon.ico\" sizes=\"32x32\"/><link rel=\"apple-touch-icon\" href=\"/apple-touch-icon.png\"/><script src=\"/_next/static/chunks/a6dad97d9634a72d.js\" noModule=\"\"></script></head><body class=\"poppins_5c7fdea4-module__KszEFa__className\"><div hidden=