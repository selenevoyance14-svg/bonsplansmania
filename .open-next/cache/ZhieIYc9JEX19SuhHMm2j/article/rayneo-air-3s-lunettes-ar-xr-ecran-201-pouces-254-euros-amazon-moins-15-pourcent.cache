00c391baea40a.js\\\",\\\"/_next/static/chunks/6e48aeeec84550f8.js\\\"],\\\"default\\\"]\\n1e:I[1586,[\\\"/_next/static/chunks/cf200c391baea40a.js\\\",\\\"/_next/static/chunks/6e48aeeec84550f8.js\\\"],\\\"default\\\"]\\n20:I[67277,[\\\"/_next/static/chunks/cf200c391baea40a.js\\\",\\\"/_next/static/chunks/6e48aeeec84550f8.js\\\"],\\\"default\\\"]\\nf:[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":13,\\\"height\\\":13,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-external-link\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":[[\\\"$\\\",\\\"path\\\",\\\"1q9fwt\\\",{\\\"d\\\":\\\"M15 3h6v6\\\"}],[\\\"$\\\",\\\"path\\\",\\\"gplh6r\\\",{\\\"d\\\":\\\"M10 14 21 3\\\"}],[\\\"$\\\",\\\"path\\\",\\\"a6xqqp\\\",{\\\"d\\\":\\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\\"}],\\\"$undefined\\\"]}]\\n10:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"article-hero-image\\\",\\\"style\\\":{\\\"background\\\":\\\"#fff\\\",\\\"borderRadius\\\":\\\"12px\\\",\\\"overflow\\\":\\\"hidden\\\",\\\"display\\\":\\\"flex\\\",\\\"justifyContent\\\":\\\"center\\\",\\\"alignItems\\\":\\\"center\\\",\\\"maxHeight\\\":\\\"450px\\\"},\\\"children\\\":[\\\"$\\\",\\\"$L1c\\\",null,{\\\"src\\\":\\\"/images/articles/rayneo-air-3s-lunettes-ar-xr-ecran-201-pouces-254-euros-amazon-moins-15-pourcent.svg\\\",\\\"alt\\\":\\\"Lunettes AR/XR RayNeo Air 3s écran 201 pouces à 254,15€ Amazon -15%\\\",\\\"width\\\":800,\\\"height\\\":450,\\\"style\\\":{\\\"width\\\":\\\"100%\\\",\\\"height\\\":\\\"100%\\\",\\\"objectFit\\\":\\\"contain\\\",\\\"maxHeight\\\":\\\"450px\\\"},\\\"priority\\\":true}]}]\\n11:[\\\"$\\\",\\\"$L1d\\\",null,{}]\\n12:[\\\"$\\\",\\\"$L1e\\\",null,{}]\\n1f:T1495,\"])</script><script>self.__next_f.push([1,\"\\u003cp\\u003e\\n# Lunettes AR/XR RayNeo Air 3s à 254,15€ (-15%)\\u003c/p\\u003e\\u003cp\\u003eLes \\u003cstrong\\u003eRayNeo Air 3s\\u003c/strong\\u003e sont en promo flash sur Amazon : \\u003cstrong\\u003e254,15€ au lieu de 299€\\u003c/strong\\u003e, soit \\u003cstrong\\u003e45€ d'économie\\u003c/strong\\u003e. Ce sont les lunettes AR/XR n°1 des ventes dans la catégorie lunettes vidéo, et on comprend vite pourquoi quand on voit ce qu'elles proposent.\\u003c/p\\u003e\\u003ch2\\u003eCe qui nous a convaincus\\u003c/h2\\u003e\\u003cul\\u003e\\u003cli\\u003e\\u003cstrong\\u003e254,15€ au lieu de 299€\\u003c/strong\\u003e — 15% de réduction sur le best-seller de la catégorie\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eN°1 des ventes\\u003c/strong\\u003e — meilleure vente en lunettes vidéo sur Amazon\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e3,9/5 sur 74 avis\\u003c/strong\\u003e — bonne note pour un produit tech de niche\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eÉcran virtuel 201 pouces\\u003c/strong\\u003e — un cinéma privé sur le nez\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e120Hz FHD\\u003c/strong\\u003e — fluidité parfaite pour le gaming et la vidéo\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eCompatible tout\\u003c/strong\\u003e — iPhone, Android, Mac, Switch, PS5, Steam Deck\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eRetours gratuits\\u003c/strong\\u003e — tu peux tester sans risque\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003ePaiement en 4 fois\\u003c/strong\\u003e — 64,99€/mois\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003cdiv class=\\\"cta-inline\\\"\\u003e\\u003ca href=\\\"https://amzn.to/4sNSgCt\\\" class=\\\"btn btn-primary btn-sm\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eVoir sur Amazon \\u003csvg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"13\\\" height=\\\"13\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"\\u003e\\u003cpath d=\\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\\"/\\u003e\\u003cpolyline points=\\\"15 3 21 3 21 9\\\"/\\u003e\\u003cline x1=\\\"10\\\" y1=\\\"14\\\" x2=\\\"21\\\" y2=\\\"3\\\"/\\u003e\\u003c/svg\\u003e\\u003c/a\\u003e\\u003c/div\\u003e\\u003ch2\\u003eLa fiche technique\\u003c/h2\\u003e\\u003cdiv class=\\\"table-wrapper\\\"\\u003e\\u003ctable class=\\\"comparison-table\\\"\\u003e\\u003cthead\\u003e\\u003ctr\\u003e\\n\\u003cth\\u003e\\u003cstrong\\u003eType\\u003c/strong\\u003e\\u003c/th\\u003e\\u003cth\\u003eLunettes AR/XR portables\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\u003c/thead\\u003e\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003eÉcran\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eHueView 201 pouces virtuel\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003eRésolution\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eFull HD\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003eTaux de rafraîchissement\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e120 Hz\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003eCompatibilité\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eiPhone 16/15, Android, Mac, Switch, PS5, Steam Deck\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003eUsage\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eThéâtre portable, gaming, streaming\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003eClassement\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eN°1 Meilleure vente (Lunettes vidéo)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003eNote\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e3,9/5 (74 avis)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\u003c/table\\u003e\\u003c/div\\u003e\\u003cp\\u003e\\u003cdiv id=\\\"ezoic-pub-ad-placeholder-203\\\" class=\\\"ad-container\\\" style=\\\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\\\"\\u003e\\u003c/div\\u003e\\u003ch2\\u003eUn cinéma portable sur le nez\\u003c/h2\\u003e\\u003cp\\u003eOn a longtemps été sceptiques sur les lunettes AR grand public, mais les RayNeo Air 3s changent la donne. L'écran HueView simule un \\u003cstrong\\u003eécran de 201 pouces\\u003c/strong\\u003e devant tes yeux, en Full HD et 120Hz. Concrètement, c'est comme regarder un film sur un écran géant de cinéma, sauf que tu es dans ton lit, dans le train ou dans l'avion.\\u003c/p\\u003e\\u003cp\\u003eLa compatibilité est ultra large : tu branches les lunettes sur ton \\u003cstrong\\u003eiPhone, Android, Mac, Switch, PS5 ou Steam Deck\\u003c/strong\\u003e et c'est parti. Pas besoin d'appli compliquée, c'est du plug and play.\\u003c/p\\u003e\\u003cp\\u003e\\u003cdiv class=\\\"cta-inline\\\"\\u003e\\u003ca href=\\\"https://amzn.to/4sNSgCt\\\" class=\\\"btn btn-primary btn-sm\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eVoir sur Amazon \\u003csvg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"13\\\" height=\\\"13\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"\\u003e\\u003cpath d=\\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\\"/\\u003e\\u003cpolyline points=\\\"15 3 21 3 21 9\\\"/\\u003e\\u003cline x1=\\\"10\\\" y1=\\\"14\\\" x2=\\\"21\\\" y2=\\\"3\\\"/\\u003e\\u003c/svg\\u003e\\u003c/a\\u003e\\u003c/div\\u003e\\u003ch2\\u003ePour qui c'est fait\\u003c/h2\\u003e\\u003cul\\u003e\\u003cli\\u003eLes \\u003cstrong\\u003egamers\\u003c/strong\\u003e qui veulent un écran immersif pour leur Switch, PS5 ou Steam Deck\\u003c/li\\u003e\\n\\u003cli\\u003eLes fans de \\u003cstrong\\u003efilms et séries\\u003c/strong\\u003e qui veulent un cinéma portable dans le train ou l'avion\\u003c/li\\u003e\\n\\u003cli\\u003eCeux qui travaillent en \\u003cstrong\\u003emobilité\\u003c/strong\\u003e et veulent un grand écran sans encombrement\\u003c/li\\u003e\\n\\u003cli\\u003eLes curieux de \\u003cstrong\\u003eréalité augmentée\\u003c/strong\\u003e qui veulent tester sans se ruiner\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch2\\u003eCe qu'il faut savoir\\u003c/h2\\u003e\\u003cul\\u003e\\u003cli\\u003eC'est un écran virtuel, pas de la vraie réalité augmentée avec des hologrammes dans le salon — on est sur du théâtre portable\\u003c/li\\u003e\\n\\u003cli\\u003eLes porteurs de lunettes de vue devront vérifier la compatibilité avec leurs montures\\u003c/li\\u003e\\n\\u003cli\\u003eRayNeo est une marque spécialisée dans les lunettes AR, pas un inconnu du secteur\\u003c/li\\u003e\\n\\u003cli\\u003eL'offre est flash — le compteur tourne, il reste environ 13 heures au moment où on écrit\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003cdiv id=\\\"ezoic-pub-ad-placeholder-206\\\" class=\\\"ad-container\\\" style=\\\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\\\"\\u003e\\u003c/div\\u003e\\u003ch2\\u003eNotre avis\\u003c/h2\\u003e\\u003cp\\u003eÀ 254€, les RayNeo Air 3s rendent les lunettes AR accessibles. Un écran 201 pouces en 120Hz que tu emmènes partout, compatible avec quasiment tous tes appareils, pour le prix d'un écran PC moyen — c'est difficile de faire mieux. Le fait qu'elles soient n°1 des ventes avec une note correcte de 3,9/5 sur 74 avis est plutôt rassurant. Si tu voyages souvent, si tu joues sur Switch ou Steam Deck, ou si tu veux simplement regarder Netflix sur un écran géant sans déranger personne, c'est le moment de craquer avec cette promo flash.\\n\\u003c/p\\u003e\"])</script><script>self.__next_f.push([1,\"13:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"article-content\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"dan