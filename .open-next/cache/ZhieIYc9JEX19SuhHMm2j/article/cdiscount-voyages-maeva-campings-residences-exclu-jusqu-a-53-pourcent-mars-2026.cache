ww.cdiscount.com%2Fvoyages%2Fv-145-0.html%23cm_sp%3Doverlayer%3Avoyage\",\"className\":\"btn btn-primary btn-sm\",\"target\":\"_blank\",\"rel\":\"nofollow sponsored noopener\",\"children\":[\"Voir toutes les offres CDiscount Voyages x Maeva\",\" \",\"$L3\"]}]]}]]}],\"$L4\",\"$L5\",\"$L6\",\"$L7\",\"$L8\",\"$L9\"]}],\"$La\",\"$Lb\",\"$Lc\",\"$Ld\"]}]}],\"$Le\",\"$Lf\"],[\"$L10\"],\"$L11\"]}],\"loading\":null,\"isPartial\":false}\n3:[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":13,\"height\":13,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-external-link\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1q9fwt\",{\"d\":\"M15 3h6v6\"}],[\"$\",\"path\",\"gplh6r\",{\"d\":\"M10 14 21 3\"}],[\"$\",\"path\",\"a6xqqp\",{\"d\":\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"}],\"$undefined\"]}]\n4:[\"$\",\"div\",null,{\"className\":\"article-hero-image\",\"style\":{\"background\":\"#fff\",\"borderRadius\":\"12px\",\"overflow\":\"hidden\",\"display\":\"flex\",\"justifyContent\":\"center\",\"alignItems\":\"center\",\"maxHeight\":\"450px\"},\"children\":[\"$\",\"$L12\",null,{\"src\":\"/images/articles/cdiscount-voyages-maeva-campings-residences-exclu-jusqu-a-53-pourcent-mars-2026.svg\",\"alt\":\"Partenariat exclusif CDiscount Voyages x Maeva campings et résidences jusqu'à -53%\",\"width\":800,\"height\":450,\"style\":{\"width\":\"100%\",\"height\":\"100%\",\"objectFit\":\"contain\",\"maxHeight\":\"450px\"},\"priority\":true}]}]\n5:[\"$\",\"$L13\",null,{}]\n6:[\"$\",\"$L14\",null,{}]\n15:T321a,<p>\n<h2>CDiscount Voyages x Maeva : le partenariat exclu qui va faire parler</h2><p>CDiscount Voyages frappe fort pour cet été. À partir du <strong>mercredi 25 mars</strong>, un nouveau partenariat exclusif avec Maeva débarque avec <strong>19 campings et 9 résidences</strong> à prix cassés. On parle de réductions allant jusqu'à <strong>-53%</strong> sur certains campings, du 4x sans frais et des codes promo en plus. Si tu cherches tes vacances d'été, c'est maintenant qu'il faut réserver.</p><hr><p><div class=\"cta-inline\"><a href=\"https://www.awin1.com/cread.php?awinmid=14021&awinaffid=990397&ued=https%3A%2F%2Fwww.cdiscount.com%2Fvoyages%2Fv-145-0.html%23cm_sp%3Doverlayer%3Avoyage\" class=\"btn btn-primary btn-sm\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Voir toutes les offres CDiscount Voyages x Maeva <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/><polyline points=\"15 3 21 3 21 9\"/><line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\"/></svg></a></div><h2>Les codes promo à retenir</h2><p>Avant de plonger dans les offres, voici les mécaniques promo à ne surtout pas rater :</p><ul><li><strong>Du 25/03 au 07/04</strong> : paiement en <strong>4x sans frais</strong> sur toute la sélection Maeva (campings + locations)</li>\n<li><strong>Du 25/03 au 31/03</strong> : code <strong>BR100</strong> = <strong>100€ offerts dès 499€ d'achat</strong> (valable sur tout CDiscount Voyages)</li>\n<li><strong>Du 01/04 au 14/04</strong> : code <strong>SOLEIL100</strong> = <strong>100€ offerts dès 999€ d'achat</strong></li>\n</ul>\nLe code BR100 est clairement le plus intéressant : 100€ offerts dès 499€, ça fait quasiment -20% sur un séjour en camping. Et ça se cumule avec les réductions Maeva déjà appliquées. On a rarement vu mieux pour réserver l'été.</p><hr><p><div id=\"ezoic-pub-ad-placeholder-203\" class=\"ad-container\" style=\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\"></div><h2>Les campings à -53% : les meilleures affaires</h2><p>Trois campings bénéficient de la remise maximale de <strong>-53%</strong> (réduction Maeva + exclusivité négociée). Ce sont les vrais coups de coeur de cette sélection :</p><ul><li><strong><a href=\"https://location.cdiscount.com/fr-fr/camping-maeva-escapades-colomba_116149.html\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Camping maeva Escapades Colomba </strong><strong></a></strong> : en Corse, cadre exceptionnel, jusqu'à -53%</li>\n<li><strong><a href=\"https://location.cdiscount.com/fr-fr/camping-de-la-clape-village_311204.html\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Camping de la Clape Village </strong><strong>*</a></strong> : 5 étoiles dans l'Aude, proche mer, jusqu'à -53%</li>\n<li><strong><a href=\"https://location.cdiscount.com/fr-fr/camping-sandaya-l-etoile-d-argens_110377.html\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Camping Sandaya l'Etoile d'Argens </strong><strong>* - Maeva</a></strong> : 5 étoiles à Fréjus, piscines, spa, rivière, jusqu'à -53%</li>\n</ul>\nUn camping 5 étoiles à -53% plus le code BR100, on est sur des tarifs qu'on ne voit jamais en pleine saison.</p><hr><p><div class=\"cta-inline\"><a href=\"https://www.awin1.com/cread.php?awinmid=14021&awinaffid=990397&ued=https%3A%2F%2Fwww.cdiscount.com%2Fvoyages%2Fv-145-0.html%23cm_sp%3Doverlayer%3Avoyage\" class=\"btn btn-primary btn-sm\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Voir toutes les offres CDiscount Voyages x Maeva <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/><polyline points=\"15 3 21 3 21 9\"/><line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\"/></svg></a></div><h2>Les campings à -45% : 15 destinations en France et en Europe</h2><p>La sélection principale avec des remises allant jusqu'à <strong>-45%</strong> :</p><p><strong>France :</strong></p><ul><li><strong><a href=\"https://location.cdiscount.com/fr-fr/camping-le-bel-air_58743.html\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Camping Le Bel-Air </strong><strong>*</a></strong> : 5 étoiles, la référence</li>\n<li><strong><a href=\"https://location.cdiscount.com/fr-fr/camping-les-pecheurs_739904.html\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Camping Les Pêcheurs </strong><strong></a></strong> : 4 étoiles, au bord de l'eau</li>\n<li><strong><a href=\"https://location.cdiscount.com/fr-fr/camping-le-panoramic_494544.html\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Camping Le Panoramic </strong><strong></a></strong> : 4 étoiles, vue imprenable</li>\n<li><strong><a href=\"https://location.cdiscount.com/fr-fr/camping-au-port-de-l-houmeau_1389693.html\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Camping au Port de l'Houmeau </strong><strong></a></strong> : 4 étoiles, Charente-Maritime</li>\n<li><strong><a href=\"https://location.cdiscount.com/fr-fr/camping-tikayan-la-vallee-du-paradis_109588.html\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Camping Tikayan La Vallée du Paradis </strong><strong></a></strong> : 4 étoiles, Provence</li>\n<li><strong><a href=\"https://location.cdiscount.com/fr-fr/camping-les-muriers_505754.html\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Camping Les Muriers </strong><strong></a></strong> : 4 étoiles</li>\n<li><strong><a href=\"https://location.cdiscount.com/fr-fr/camping-a-la-corniche_1389643.html\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Camping à la Corniche </strong><strong></a></strong> : 4 étoiles, front de mer</li>\n<li><strong><a href=\"https://location.cdiscount.com/fr-fr/camping-maeva-respire-le-bois-de-la-gachere_536134.html\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Camping maeva Respire Le Bois de La Gachère </strong><strong></a></strong> : 4 étoiles, Vendée</li>\n<li><strong><a href=\"https://location.cdiscount.com/fr-fr/camping-maeva-club-l-arbre-d-or_86826.html\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Camping maeva Club l'Arbre d'Or </strong><strong></a></strong> : 4 étoiles, club avec activités</li>\n<li><strong><a href=\"https://location.cdiscount.com/fr-fr/camping-maeva-escapades-le-hameau-des-pins_864341.html\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Camping maeva Escapades Le Hameau des Pins </strong>*</a>** : 3 étoiles, rapport qualité-prix top</li>\n<li><strong><a href=\"https://location.cdiscount.com/fr-fr/camping-maeva-escapades-sun-ocean_549444.html\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Camping maeva Escapades Sun Océan </strong>*</a>** : 3 étoiles, océan</li>\n<li><strong><a href=\"https://location.cdiscount.com/fr-fr/camping-maeva-escapades-les-abricotiers_1170381.html\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Camping maeva Escapades Les Abricotiers</a></strong> : sud de la France</li>\n</ul>\n<strong>Europe :</strong></p><ul><li><strong><a href=\"https://location.cdiscount.com/fr-fr/croatie/camping-bi-village_1407733.html\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Camping Bi Village </strong><strong> - Croatie</a></strong> : 4 étoiles en Istrie, mer Adriatique</li>\n<li><strong><a href=\"https://location.cdiscount.com/fr-fr/croatie/valamar-camping-lanterna_829451.html\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Camping Lanterna </strong><strong> - Croatie</a></strong> : 4 étoiles, station balnéaire</li>\n<li><strong><a href=\"https://location.cdiscount.com/fr-fr/espagne/camping-la-masia_888481.html\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Camping La Masia </strong>* - Espagne</a>** : 3 étoiles, Costa Brava</li>\n</ul>\n<hr></p><h2>Le camping à -35%</h2><ul><li><strong><a href=\"https://location.cdiscount.com/fr-fr/camping-maeva-escapades-la-clairiere_59533.html\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Camping maeva Escapades La Clairière </strong><strong></a></strong> : 4 étoiles, ambiance nature, jusqu'à -35%</li>\n</ul>\n<hr></p><p><div id=\"ezoic-pub-ad-placeholder-206\" class=\"ad-container\" style=\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\"></div><h2>Les 9 résidences maeva Home à -10% vs Maeva direct</h2><p>En plus des campings, 9 résidences maeva Home sont proposées avec <strong>-10% par rapport aux prix affichés sur le site Maeva</strong>. Idéal pour ceux qui préfèrent la résidence au camping :</p><ul><li><strong><a href=\"https://location.cdiscount.com/fr-fr/residence-saint-raphael-valescure-maeva-home_50154.html\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Résidence Saint-Raphaël Valescure</a></strong> : Côte d'Azur</li>\n<li><strong><a href=\"https://location.cdiscount.com/fr-fr/residence-cannes-villa-francia-maeva-home_49993.html\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Résidence Cannes Villa Francia</a></strong> : Cannes, la classe</li>\n<li><strong><a href=\"https://location.cdiscount.com/fr-fr/les-issambres-lauriers-maeva-home_209254.html\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Les Issambres Lauriers</a></strong> : Var, entre mer et collines</li>\n<li><strong><a href=\"https://location.cdiscount.com/fr-fr/residence-port-du-crouesty-maeva-home_49803.html\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Résidence Port du Crouesty</a></strong> : Bretagne sud, face au port</li>\n<li><strong><a href=\"https://location.cdiscount.com/fr-fr/residence-saint-goustan-maeva-home_66406.html\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Résidence Saint Goustan</a></strong> : Bretagne, charme breton</li>\n<li><strong><a href=\"https://location.cdiscount.com/fr-fr/residence-port-bourgenay-maeva-home_47414.html\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Résidence Port Bourgenay</a></strong> : Vendée, bord de mer</li>\n<li><strong><a href=\"https://location.cdiscount.com/fr-fr/village-moliets-maeva-home_49781.html\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Village Moliets</a></strong> : Landes, surf et forêt</li>\n<li><strong><a href=\"https://location.cdiscount.com/fr-fr/residence-lacanau-les-pins-maeva-home_57415.html\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Résidence Lacanau Les Pins</a></strong> : Gironde, océan</li>\n<li><strong><a href=\"https://location.cdiscount.com/fr-fr/la-residence-du-golf-maeva-home_57413.html\" target=\"_blank\" rel=\"nofollow sponsored noopener\">La Résidence du Golf</a></strong> : pour les amateurs de green</li>\n</ul>\n<hr></p><h2>Notre avis</h2><p>C'est clairement l'un des meilleurs deals vacances qu'on a vus pour l'été 2026. La combinaison réduction Maeva + exclusivité CDiscount + code promo 100€, ça donne des tarifs qu'on ne trouve nulle part ailleurs. Notre conseil : vise les campings à -53% avec le code <strong>BR100</strong> (100€ offerts dès 499€) avant le 31 mars. Sur un séjour à 600€ en camping 5 étoiles, tu paies réellement 500€ avec le code, soit un séjour haut de gamme au prix du milieu de gamme. Et le 4x sans frais jusqu'au 7 avril permet d'étaler sans surcoût. Les meilleures dates partent vite, surtout sur les 5 étoiles comme l'Etoile d'Argens ou La Clape Village. Ne traîne pas.</p><hr><p>> <a href=\"https://www.awin1.com/cread.php?awinmid=14021&awinaffid=990397&ued=https%3A%2F%2Fwww.cdiscount.com%2Fvoyages%2Fv-145-0.html%23cm_sp%3Doverlayer%3Avoyage\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Voir toutes les offres CDiscount Voyages x Maeva</a></p><hr><p><div class=\"cta-inline\"><a href=\"https://www.awin1.com/cread.php?awinmid=14021&awinaffid=990397&ued=https%3A%2F%2Fwww.cdiscount.com%2Fvoyages%2Fv-145-0.html%23cm_sp%3Doverlayer%3Avoyage\" class=\"btn btn-primary btn-sm\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Voir toutes les offres CDiscount Voyages x Maeva <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/><polyline points=\"15 3 21 3 21 9\"/><line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\"/></svg></a></div><h2>Récap des codes promo</h2><div class=\"table-wrapper\"><table class=\"comparison-table\"><thead><tr>\n<th>Période</th><th>Code</th><th>Avantage</th><th>Minimum</th>\n</tr></thead><tbody>\n<tr>\n<td>25/03 → 31/03</td>\n<td><strong>BR100</strong></td>\n<td>100€ offerts</td>\n<td>499€ d'achat</td>\n</tr>\n<tr>\n<td>01/04 → 14/04</td>\n<td><strong>SOLEIL100</strong></td>\n<td>100€ offerts</td>\n<td>999€ d'achat</td>\n</tr>\n<tr>\n<td>25/03 → 07/04</td>\n<td>—</td>\n<td>4x sans frais</td>\n<td>Toute la sélection Maeva</td>\n</tr>\n</tbody></table></div>\n</p>7:[\"$\",\"div\",null,{\"className\":\"article-content\",\"children\":[\"$\",\"div\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"$15\"}}]}]\n8:[\"$\",\"$L13\",null,{}]\n9:[\"$\",\"div\",null,{\"style\":{\"textAlign\":\"center\",\"margin\":\"40px 0\",\"padding\":\"32px\",\"background\":\"linear-gradient(135deg, #FFF0F0 0%, #FFF8F0 100%)\",\"borderRadius\":\"16px\",\"border\":\"2px solid #FECDD3\"},\"children\":[[\"$\",\"p\",null,{\"style\":{\"fontWeight\":800,\"fontSize\":\"1.2rem\",\"marginBottom\":\"16px\",\"color\":\"var(--foreground)\"},\"children\":\"Profiter de cette offre\"}],[\"$\",\"a\",null,{\"href\":\"https://www.awin1.com/cread.php?awinmid=14021&awinaffid=990397&ued=https%3A%2F%2Fwww.cdiscount.com%2Fvoyages%2Fv-145-0.html%23cm_sp%3Doverlayer%3Avoyage\",\"className\":\"btn btn-primary\",\"target\":\"_blank\",\"rel\":\"nofollow sponsored noopener\",\"style\":{\"padding\":\"14px 32px\",\"fontSize\":\"1rem\"},\"children\":[\"Voir toutes les offres CDiscount Voyages x Maeva\",\" \",[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":15,\"height\":15,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-external