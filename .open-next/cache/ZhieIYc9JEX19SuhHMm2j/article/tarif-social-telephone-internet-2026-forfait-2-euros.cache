one\",\"fontWeight\":500},\"children\":\"internet pas cher\"}]\n20:[\"$\",\"a\",\"RSA\",{\"href\":\"/marque/rsa\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"RSA\"}]\n21:[\"$\",\"a\",\"AAH\",{\"href\":\"/marque/aah\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"AAH\"}]\n22:[\"$\",\"a\",\"Orange\",{\"href\":\"/marque/orange\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"Orange\"}]\n23:[\"$\",\"a\",\"SFR\",{\"href\":\"/marque/sfr\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"SFR\"}]\n24:[\"$\",\"a\",\"Free\",{\"href\":\"/marque/free\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"Free\"}]\n25:[\"$\",\"a\",\"pouvoir achat\",{\"href\":\"/marque/pouvoir-achat\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"pouvoir achat\"}]\n26:[\"$\",\"a\",\"2026\",{\"href\":\"/marque/2026\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem