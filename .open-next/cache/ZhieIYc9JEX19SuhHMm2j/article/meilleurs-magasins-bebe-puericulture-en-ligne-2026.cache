it\":\"cover\"},\"sizes\":\"33vw\"}]}],[\"$\",\"div\",null,{\"className\":\"card-body\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"fontSize\":\"0.72rem\",\"fontWeight\":600,\"color\":\"var(--primary)\",\"textTransform\":\"uppercase\",\"letterSpacing\":\"0.5px\"},\"children\":[\"🏷️\",\" \",\"Bon Plan\"]}],[\"$\",\"h3\",null,{\"className\":\"card-title\",\"children\":\"Inglesina Zenit Poussette Compacte : 174,99€ (-32%)\"}],[\"$\",\"p\",null,{\"className\":\"card-excerpt\",\"children\":\"Bon plan Amazon : poussette compacte Inglesina Zenit verte jusqu'a 22 kg a 174,99€ au lieu de 259€. Grandes roues, capote UV 50+, exclusivite Amazon. Choix d'Amazon.\"}]]}]]}]]}]]}]\n1a:[\"$\",\"nav\",null,{\"style\":{\"margin\":\"40px 0\",\"padding\":\"24px\",\"background\":\"var(--muted, #f3f4f6)\",\"borderRadius\":\"16px\"},\"children\":[[\"$\",\"h3\",null,{\"style\":{\"fontSize\":\"1rem\",\"marginBottom\":\"12px\"},\"children\":\"Explorer par catégorie\"}],[\"$\",\"div\",null,{\"style\":{\"display\":\"flex\",\"flexWrap\":\"wrap\",\"gap\":\"8px\"},\"children\":[[\"$\",\"a\",\"bon-plan\",{\"href\":\"/categorie/bon-plan\",\"style\":{\"padding\":\"6px 14px\",\"borderRadius\":\"999px\",\"background\":\"white\",\"fontSize\":\"0.82rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500,\"border\":\"1px solid var(--border, #e5e7eb)\"},\"children\":[\"🏷️\",\" \",\"Bons Plans\"]}],[\"$\",\"a\",\"test-gratuit\",{\"href\":\"/categorie/test-gratuit\",\"style\":{\"padding\":\"6px 14px\",\"borderRadius\":\"999px\",\"background\":\"white\",\"fontSize\":\"0.82rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500,\"border\":\"1px solid var(--border, #e5e7eb)\"},\"children\":[\"🎁\",\" \",\"Tests Gratuits\"]}],[\"$\",\"a\",\"concours\",{\"href\":\"/categorie/concours\",\"style\":{\"padding\":\"6px 14px\",\"borderRadius\":\"999px\",\"background\":\"white\",\"fontSize\":\"0.82rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500,\"border\":\"1px solid var(--border, #e5e7eb)\"},\"children\":[\"🏆\",\" \",\"Concours\"]}],[\"$\",\"a\",\"box-beaute\",{\"href\":\"/categorie/box-beaute\",\"style\":{\"padding\":\"6px 14px\",\"borderRadius\":\"999px\",\"background\":\"white\",\"fontSize\":\"0.82rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500,\"border\":\"1px solid var(--border, #e5e7eb)\"},\"children\":[\"💄\",\" \",\"Box Beauté\"]}],[\"$\",\"a\",\"code-promo\",{\"href\":\"/categorie/code-promo\",\"style\":{\"padding\":\"6px 14px\",\"borderRadius\":\"999px\",\"background\":\"white\",\"fontSize\":\"0.82rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500,\"border\":\"1px solid var(--border, #e5e7eb)\"},\"children\":[\"🎟️\",\" \",\"Codes Promo\"]}]]}]]}]\n1b:[\"$\",\"div\",null,{\"style\":{\"maxWidth\":\"780px\",\"margin\":\"0 auto\"},\"children\":[[\"$\",\"div\",null,{\"style\":{\"display\":\"flex\",\"alignItems\":\"center\",\"gap\":\"12px\",\"flexWrap\":\"wrap\",\"margin\":\"32px 0 16px\"},\"children\":[[\"$\",\"$L22\",null,{\"slug\":\"meilleurs-magasins-bebe-puericulture-en-ligne-2026\"}],[\"$\",\"span\",null,{\"style\":{\"fontSize\":\"0.85rem\",\"color\":\"var(--text-muted, #6b7280)\"},\"children\":\"Partager :\"}],[[\"$\",\"a\",\"WhatsApp\",{\"href\":\"https://wa.me/?text=Top%2010%20des%20meilleurs%20magasins%20bebe%20et%20puericulture%20en%20ligne%20(2026)%20-%20https%3A%2F%2Fbonsplansmania.fr%2Farticle%2Fmeilleurs-magasins-bebe-puericulture-en-ligne-2026\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"style\":{\"padding\":\"6px 14px\",\"borderRadius\":\"999px\",\"background\":\"#25d366\",\"color\":\"white\",\"fontSize\":\"0.82rem\",\"fontWeight\":600,\"textDecoration\":\"none\"},\"children\":\"WhatsApp\"}],[\"$\",\"a\",\"Facebook\",{\"href\":\"https://www.facebook.com/sharer/sharer.php?u=https%3A%2F%2Fbonsplansmania.fr%2Farticle%2Fmeilleurs-magasins-bebe-puericulture-en-ligne-2026