0a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"Image\"]\n1f:I[96788,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\n20:I[1586,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\n22:I[67277,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\nf:[\"$\",\"path\",\"1q9fwt\",{\"d\":\"M15 3h6v6\"}]\n10:[\"$\",\"path\",\"gplh6r\",{\"d\":\"M10 14 21 3\"}]\n11:[\"$\",\"path\",\"a6xqqp\",{\"d\":\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"}]\n12:[\"$\",\"div\",null,{\"className\":\"article-hero-image\",\"style\":{\"background\":\"#fff\",\"borderRadius\":\"12px\",\"overflow\":\"hidden\",\"display\":\"flex\",\"justifyContent\":\"center\",\"alignItems\":\"center\",\"maxHeight\":\"450px\"},\"children\":[\"$\",\"$L1e\",null,{\"src\":\"/images/articles/guide-malin-jardin-potager-economique-2026.svg\",\"alt\":\"Guide malin jardin potager economique 2026\",\"width\":800,\"height\":450,\"style\":{\"width\":\"100%\",\"height\":\"100%\",\"objectFit\":\"contain\",\"maxHeight\":\"450px\"},\"priority\":true}]}]\n13:[\"$\",\"$L1f\",null,{}]\n14:[\"$\",\"$L20\",null,{}]\n21:T2b13,<p>\n<h2>Un potager qui fait economiser</h2><p>Un potager de <strong>10 m2</strong> bien gere produit <strong>100 a 200 kg de legumes par an</strong>, soit l'equivalent de <strong>300 a 500€ d'economies</strong> au supermarche. Et pas besoin d'un grand jardin : un balcon avec quelques <a href=\"https://www.amazon.fr/s?k=jardiniere+balcon+grande+potager&tag=lebrunnathali-21\" target=\"_blank\" rel=\"nofollow sponsored noopener\">jardinieres</a> suffit pour demarrer.</p><hr><p><div class=\"cta-inline\"><a href=\"https://www.amazon.fr/s?k=potager+graines+outils+jardin&tag=lebrunnathali-21\" class=\"btn btn-primary btn-sm\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Voir le materiel sur Amazon <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/><polyline points=\"15 3 21 3 21 9\"/><line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\"/></svg></a></div><h2>Le materiel de base</h2><h3>Pour demarrer (moins de 50€)</h3><div class=\"table-wrapper\"><table class=\"comparison-table\"><thead><tr>\n<th>Materiel</th><th>Utilite</th><th>Lien</th>\n</tr></thead><tbody>\n<tr>\n<td><a href=\"https://www.amazon.fr/s?k=kit+outils+jardin+beche+rateau+transplantoir&tag=lebrunnathali-21\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Kit outils jardin (beche, rateau, transplantoir)</a></td>\n<td>Les basiques indispensables</td>\n<td>Amazon</td>\n</tr>\n<tr>\n<td><a href=\"https://www.amazon.fr/s?k=arrosoir+10+litres+jardin&tag=lebrunnathali-21\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Arrosoir 10L</a></td>\n<td>Arrosage precis au pied</td>\n<td>Amazon</td>\n</tr>\n<tr>\n<td><a href=\"https://www.amazon.fr/s?k=graines+potageres+lot+legumes+bio&tag=lebrunnathali-21\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Graines potageres lot</a></td>\n<td>Tomates, courgettes, salades, radis, haricots</td>\n<td>Amazon</td>\n</tr>\n<tr>\n<td><a href=\"https://www.amazon.fr/s?k=terreau+potager+bio+40+litres&tag=lebrunnathali-21\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Terreau potager</a></td>\n<td>Pour les semis et remplir les bacs</td>\n<td>Amazon</td>\n</tr>\n<tr>\n<td><a href=\"https://www.amazon.fr/s?k=godets+semis+biodegradables+lot&tag=lebrunnathali-21\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Godets de semis biodegradables</a></td>\n<td>Pour demarrer les plants a l'interieur</td>\n<td>Amazon</td>\n</tr>\n</tbody></table></div><h3>Pour un balcon ou petit espace</h3><div class=\"table-wrapper\"><table class=\"comparison-table\"><thead><tr>\n<th>Materiel</th><th>Utilite</th><th>Lien</th>\n</tr></thead><tbody>\n<tr>\n<td><a href=\"https://www.amazon.fr/s?k=carre+potager+sureleve+bois&tag=lebrunnathali-21\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Carre potager sureleve</a></td>\n<td>Potager sans se baisser, meme sur terrasse</td>\n<td>Amazon</td>\n</tr>\n<tr>\n<td><a href=\"https://www.amazon.fr/s?k=sac+culture+tissu+potager+legumes+lot&tag=lebrunnathali-21\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Sac de culture tissu</a></td>\n<td>Pour les tomates et pommes de terre</td>\n<td>Amazon</td>\n</tr>\n<tr>\n<td><a href=\"https://www.amazon.fr/s?k=jardiniere+treillage+balcon+potager&tag=lebrunnathali-21\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Jardiniere avec treillage</a></td>\n<td>Pour les plantes grimpantes (haricots, pois)</td>\n<td>Amazon</td>\n</tr>\n<tr>\n<td><a href=\"https://www.amazon.fr/s?k=pot+auto+arrosant+plante+balcon&tag=lebrunnathali-21\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Pot auto-arrosant</a></td>\n<td>Pas besoin d'arroser tous les jours</td>\n<td>Amazon</td>\n</tr>\n</tbody></table></div><hr><p><div id=\"ezoic-pub-ad-placeholder-203\" class=\"ad-container\" style=\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\"></div><h2>Les legumes les plus rentables</h2><p>Tous les legumes ne se valent pas en termes de rentabilite. Voici ceux qui rapportent le plus par rapport a l'investissement :</p><div class=\"table-wrapper\"><table class=\"comparison-table\"><thead><tr>\n<th>Legume</th><th>Cout graines</th><th>Production estimee</th><th>Valeur supermarche</th><th>Rentabilite</th>\n</tr></thead><tbody>\n<tr>\n<td>Tomates</td>\n<td>2€</td>\n<td>15-25 kg</td>\n<td>45-75€</td>\n<td>x20 a x35</td>\n</tr>\n<tr>\n<td>Courgettes</td>\n<td>2€</td>\n<td>10-20 kg</td>\n<td>20-40€</td>\n<td>x10 a x20</td>\n</tr>\n<tr>\n<td>Salades</td>\n<td>2€</td>\n<td>20-30 pieds</td>\n<td>20-30€</td>\n<td>x10 a x15</td>\n</tr>\n<tr>\n<td>Haricots verts</td>\n<td>3€</td>\n<td>5-10 kg</td>\n<td>20-40€</td>\n<td>x7 a x13</td>\n</tr>\n<tr>\n<td>Radis</td>\n<td>1,50€</td>\n<td>5-8 kg</td>\n<td>10-16€</td>\n<td>x7 a x10</td>\n</tr>\n<tr>\n<td>Herbes aromatiques</td>\n<td>5€</td>\n<td>Toute l'annee</td>\n<td>50-80€</td>\n<td>x10 a x16</td>\n</tr>\n<tr>\n<td>Fraises</td>\n<td>5€ (plants)</td>\n<td>3-5 kg</td>\n<td>20-35€</td>\n<td>x4 a x7</td>\n</tr>\n</tbody></table></div><p>Les <strong>herbes aromatiques</strong> sont les plus rentables : un pot de basilic du supermarche coute 2-3€ et dure 1 semaine. Un <a href=\"https://www.amazon.fr/s?k=graines+basilic+bio+potager&tag=lebrunnathali-21\" target=\"_blank\" rel=\"nofollow sponsored noopener\">plant de basilic</a> a 1,50€ produit pendant 4-5 mois.</p><hr><p><div class=\"cta-inline\"><a href=\"https://www.amazon.fr/s?k=potager+graines+outils+jardin&tag=lebrunnathali-21\" class=\"btn btn-primary btn-sm\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Voir le materiel sur Amazon <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/><polyline points=\"15 3 21 3 21 9\"/><line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\"/></svg></a></div><h2>Calendrier de semis simplifie</h2><div class=\"table-wrapper\"><table class=\"comparison-table\"><thead><tr>\n<th>Mois</th><th>A semer</th><th>A planter</th>\n</tr></thead><tbody>\n<tr>\n<td>Mars</td>\n<td>Tomates, poivrons (interieur)</td>\n<td>-</td>\n</tr>\n<tr>\n<td>Avril</td>\n<td>Courgettes, haricots (interieur)</td>\n<td>Salades, radis (exterieur)</td>\n</tr>\n<tr>\n<td>Mai</td>\n<td>Haricots, radis (exterieur)</td>\n<td>Tomates, courgettes (exterieur)</td>\n</tr>\n<tr>\n<td>Juin</td>\n<td>Haricots, salades</td>\n<td>-</td>\n</tr>\n<tr>\n<td>Juillet</td>\n<td>Salades, radis (2eme serie)</td>\n<td>-</td>\n</tr>\n<tr>\n<td>Aout</td>\n<td>Salades d'hiver, epinards</td>\n<td>-</td>\n</tr>\n<tr>\n<td>Septembre</td>\n<td>Mache, radis d'hiver</td>\n<td>-</td>\n</tr>\n</tbody></table></div><p>Un <a href=\"https://www.amazon.fr/s?k=calendrier+semis+potager+jardin&tag=lebrunnathali-21\" target=\"_blank\" rel=\"nofollow sponsored noopener\">calendrier de semis magnetique</a> dans la cuisine aide a ne rien oublier.</p><hr><h2>Le compost : engrais gratuit a vie</h2><p>Au lieu d'acheter de l'engrais (30-50€/an), fais ton compost avec tes dechets de cuisine.</p><div class=\"table-wrapper\"><table class=\"comparison-table\"><thead><tr>\n<th>Materiel</th><th>Pour qui</th><th>Lien</th>\n</tr></thead><tbody>\n<tr>\n<td><a href=\"https://www.amazon.fr/s?k=composteur+jardin+300+litres&tag=lebrunnathali-21\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Composteur jardin 300L</a></td>\n<td>Si tu as un jardin</td>\n<td>Amazon</td>\n</tr>\n<tr>\n<td><a href=\"https://www.amazon.fr/s?k=lombricomposteur+interieur+appartement&tag=lebrunnathali-21\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Lombricomposteur</a></td>\n<td>En appartement, sans odeur</td>\n<td>Amazon</td>\n</tr>\n<tr>\n<td><a href=\"https://www.amazon.fr/s?k=seau+compost+cuisine+anti+odeur&tag=lebrunnathali-21\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Seau a compost cuisine</a></td>\n<td>Pour stocker les dechets avant le composteur</td>\n<td>Amazon</td>\n</tr>\n<tr>\n<td><a href=\"https://www.amazon.fr/s?k=activateur+compost+naturel&tag=lebrunnathali-21\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Activateur de compost</a></td>\n<td>Accelere la decomposition</td>\n<td>Amazon</td>\n</tr>\n</tbody></table></div><p>Ce qui va au compost : epluchures, marc de cafe, coquilles d'oeuf, feuilles mortes, tontes de gazon.</p><hr><p><div id=\"ezoic-pub-ad-placeholder-206\" class=\"ad-container\" style=\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\"></div><h2>Les astuces pour depenser zero</h2><ul><li><strong>Recuperer les graines</strong> : laisse monter en graines 1 plant de tomate, courge, poivron en fin de saison → graines gratuites pour l'annee suivante</li>\n<li><strong>Boutures</strong> : les herbes aromatiques (menthe, romarin, thym) se bouturent dans un verre d'eau</li>\n<li><strong>Troc de plants</strong> : echange des plants avec les voisins</li>\n<li><strong>Eau de cuisson</strong> : l'eau de cuisson des legumes (refroidie) est un excellent engrais</li>\n<li><strong>Paillage</strong> : tontes de gazon, feuilles mortes, carton → garde l'humidite et reduit l'arrosage</li>\n</ul>\n<hr></p><h2>Recapitulatif premiere annee</h2><div class=\"table-wrapper\"><table class=\"comparison-table\"><thead><tr>\n<th>Poste</th><th>Investissement</th>\n</tr></thead><tbody>\n<tr>\n<td>Outils de base</td>\n<td>30€</td>\n</tr>\n<tr>\n<td>Graines</td>\n<td>15€</td>\n</tr>\n<tr>\n<td>Terreau</td>\n<td>15€</td>\n</tr>\n<tr>\n<td>Composteur</td>\n<td>30€</td>\n</tr>\n<tr>\n<td><strong>Total</strong></td>\n<td><strong>90€</strong></td>\n</tr>\n<tr>\n<td><strong>Production estimee</strong></td>\n<td><strong>300-500€ de legumes</strong></td>\n</tr>\n<tr>\n<td><strong>Benefice net</strong></td>\n<td><strong>210-410€</strong></td>\n</tr>\n</tbody></table></div><p>A partir de la 2eme annee, tu n'achetes quasiment plus rien (graines recuperees, compost maison) → <strong>300-500€ d'economie pure</strong>.</p><hr><p><div class=\"cta-inline\"><a href=\"https://www.amazon.fr/s?k=potager+graines+outils+jardin&tag=lebrunnathali-21\" class=\"btn btn-primary btn-sm\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Voir le materiel sur Amazon <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/><polyline points=\"15 3 21 3 21 9\"/><line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\"/></svg></a></div><h2>Notre avis</h2><p>Le potager c'est l'activite qui cumule le plus d'avantages : economie, qualite des legumes (bio et frais), activite physique et plaisir. Meme sur un balcon avec 3-4 bacs, tu produis assez de tomates, salades et herbes pour reduire serieusement les courses.</p><p>Le secret c'est de commencer petit : tomates cerises + basilic + salades la premiere annee. C'est quasi impossible a rater et ca donne confiance pour la suite. Un <a href=\"https://www.amazon.fr/s?k=livre+potager+debutant+facile&tag=lebrunnathali-21\" target=\"_blank\" rel=\"nofollow sponsored noopener\">livre du potager pour debutants</a> aide beaucoup la premiere annee.\n</p>15:[\"$\",\"div\",null,{\"className\":\"article-content\",\"children\":[\"$\",\"div\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"$21\"}}]}]\n16:[\"$\",\"$L1f\",null,{}]\n17:[\"$\",\"div\",null,{\"style\":{\"textAlign\":\"center\",\"margin\":\"40px 0\",\"padding\":\"32px\",\"background\":\"linear-gradient(135deg, #FFF0F0 0%, #FFF8F0 100%)\",\"borderRadius\":\"16px\",\"border\":\"2px solid #FECDD3\"},\"children\":[[\"$\",\"p\",null,{\"style\":{\"fontWeight\":800,\"fontSize\":\"1.2rem\",\"marginBottom\":\"16px\",\"color\":\"var(--foreground)\"},\"children\":\"Profiter de cette offre\"}],[\"$\",\"a\",null,{\"href\":\"https://www.amazon.fr/s?k=potager+graines+outils+jardin&tag=lebrunnathali-21\",\"className\":\"btn btn-primary\",\"target\":\"_blank\",\"rel\":\"nofollow sponsored noopener\",\"style\":{\"padding\":\"14px 32px\",\"fontSize\":\"1rem\"},\"children\":[\"Voir le materiel sur Amazon\",\" \",[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":15,\"height\":15,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-external-link\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1q9fwt\",{\"d\":\"M15 3h6v6\"}],[\"$\",\"path\",\"gplh6r\",{\"d\":\"M10 14 21 3\"}],[\"$\",\"path\",\"a6xqqp\",{\"d\":\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"}],\"$undefined\"]}]]}]]}]\n18:[\"$\",\"$L1f\",null,{}]\n19:[\"$\",\"section\",null,{\"className\":\"related-articles\",\"children\":[[\"$\",\"h2\",null,{\"children\":\"A lire aussi\"}],[\"$\",\"div\",null,{\"className\":\"articles-grid\",\"style\":{\"gridTemplateColumns\":\"repeat(auto-fit, minmax(280px, 1fr))\"},\"children\":[[\"$\",\"a\",\"guide-malin-batch-cooking-cuisine-economique-2026\",{\"href\":\"/article/guide-malin-batch-cooking-cuisine-economique-2026\",\"className\":\"card\",\"style\":{\"textDecoration\":\"none\"},\"children\":[[\"$\",\"div\",null,{\"style\":{\"position\":\"relative\",\"height\":\"160px\",\"overflow\":\"hidden\"},\"children\":[\"$\",\"$L1e\",null,{\"src\":\"/images/articles/guide-malin-batch-cooking-cuisine-economique-2026.svg\",\"alt\":\"Guide malin batch cooking cuisine economique 2026\",\"fill\":true,\"style\":{\"objectFit\":\"cover\"},\"sizes\":\"33vw\"}]}],[\"$\",\"div\",null,{\"className\":\"card-body\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"fontSize\":\"0.72rem\",\"fontWeight\":600,\"color\":\"var(--primary)\",\"textTransform\":\"uppercase\",\"letterSpacing\":\"0.5px\"},\"children\":[\"🏷️\",\" \",\"Bon Plan\"]}],[\"$\",\"h3\",null,{\"className\":\"card-title\",\"children\":\"Guide Malin Batch Cooking : Cuisine une Fois, Mange Toute la Semaine\"}],[\"$\",\"p\",null,{\"className\":\"card-excerpt\",\"children\":\"Le guide complet du batch cooking pour economiser temps et argent. Menus, organisation, materiel indispensable. Jusqu'a 200€ d'economie par mois.\"}]]}]]}],[\"$\",\"a\",\"guide-malin-beaute-soins-naturels-pas-cher-2026\",{\"href\":\"/article/guide-malin-beaute-soins-naturels-pas-cher-2026\",\"className\":\"card\",\"style\":{\"textDecoration\":\"none\"},\"children\":[[\"$\",\"div\",null,{\"style\":{\"position\":\"relative\",\"height\":\"160px\",\"overflow\":\"hidden\"},\"children\":[\"$\",\"$L1e\",null,{\"src\":\"/images/articles/guide-malin-beaute-soins-naturels-pas-cher-2026.svg\",\"alt\":\"Guide malin beaute soins naturels pas cher 2026\",\"fill\":true,\"style\":{\"objectFit\":\"cover\"},\"sizes\":\"33vw\"}]}],[\"$\",\"div\",null,{\"className\":\"card-body\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"fontSize\":\"0.72rem\",\"fontWeight\":600,\"color\":\"var(--primary)\",\"textTransform\":\"uppercase\",\"letterSpacing\":\"0.5px\"},\"children\":[\"🏷️\",\" \",\"Bon Plan\"]}],[\"$\",\"h3\",null,{\"className\":\"card-title\",\"children\":\"Guide Malin Beaute : Soins Naturels Efficaces a Moins de 5€\"}],[\"$\",\"p\",null,{\"className\":\"card-excerpt\",\"children\":\"Remplace tes cosmetiques par des soins naturels pas chers et efficaces. Huiles vegetales, beurre de karite, accessoires reutilisables. 300€ d'economie/an.\"}]]}]]}],[\"$\",\"a\",\"test-gratuit-vilmorin-testeur-jardin-graines-2026\",{\"href\":\"/article/test-gratuit-vilmorin-testeur-jardin-graines-2026\",\"className\":\"card\",\"style\":{\"textDecoration\":\"none\"},\"children\":[[\"$\",\"div\",null,{\"style\":{\"position\":\"relative\",\"height\":\"160px\",\"overflow\":\"hidden\"},\"children\":[\"$\",\"$L1e\",null,{\"src\":\"/images/articles/test-gratuit-vilmorin-testeur-jardin-graines-2026.svg\",\"alt\":\"Vilmorin devenez testeur gratuit produits jardin graines\",\"fill\":true,\"style\":{\"objectFit\":\"cover\"},\"sizes\":\"33vw\"}]}],[\"$\",\"div\",null,{\"className\":\"card-body\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"fontSize\":\"0.72rem\",\"fontWeight\":600,\"color\":\"var(--primary)\",\"textTransform\":\"uppercase\",\"letterSpacing\":\"0.5px\"},\"children\":[\"🎁\",\" \",\"Test Gratuit\"]}],[\"$\",\"h3\",null,{\"className\":\"card-title\",\"children\":\"Vilmorin : Devenez Testeur et Recevez des Produits de Jardin Gratuitement\"}],[\"$\",\"p\",null,{\"className\":\"card-excerpt\",\"children\":\"Rejoignez le Club Vilmorin et devenez testeur officiel. Recevez