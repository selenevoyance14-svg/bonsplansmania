03e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eCourgettes\\u003c/td\\u003e\\n\\u003ctd\\u003e2€\\u003c/td\\u003e\\n\\u003ctd\\u003e10-20 kg\\u003c/td\\u003e\\n\\u003ctd\\u003e20-40€\\u003c/td\\u003e\\n\\u003ctd\\u003ex10 a x20\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eSalades\\u003c/td\\u003e\\n\\u003ctd\\u003e2€\\u003c/td\\u003e\\n\\u003ctd\\u003e20-30 pieds\\u003c/td\\u003e\\n\\u003ctd\\u003e20-30€\\u003c/td\\u003e\\n\\u003ctd\\u003ex10 a x15\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eHaricots verts\\u003c/td\\u003e\\n\\u003ctd\\u003e3€\\u003c/td\\u003e\\n\\u003ctd\\u003e5-10 kg\\u003c/td\\u003e\\n\\u003ctd\\u003e20-40€\\u003c/td\\u003e\\n\\u003ctd\\u003ex7 a x13\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eRadis\\u003c/td\\u003e\\n\\u003ctd\\u003e1,50€\\u003c/td\\u003e\\n\\u003ctd\\u003e5-8 kg\\u003c/td\\u003e\\n\\u003ctd\\u003e10-16€\\u003c/td\\u003e\\n\\u003ctd\\u003ex7 a x10\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eHerbes aromatiques\\u003c/td\\u003e\\n\\u003ctd\\u003e5€\\u003c/td\\u003e\\n\\u003ctd\\u003eToute l'annee\\u003c/td\\u003e\\n\\u003ctd\\u003e50-80€\\u003c/td\\u003e\\n\\u003ctd\\u003ex10 a x16\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eFraises\\u003c/td\\u003e\\n\\u003ctd\\u003e5€ (plants)\\u003c/td\\u003e\\n\\u003ctd\\u003e3-5 kg\\u003c/td\\u003e\\n\\u003ctd\\u003e20-35€\\u003c/td\\u003e\\n\\u003ctd\\u003ex4 a x7\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\u003c/table\\u003e\\u003c/div\\u003e\\u003cp\\u003eLes \\u003cstrong\\u003eherbes aromatiques\\u003c/strong\\u003e sont les plus rentables : un pot de basilic du supermarche coute 2-3€ et dure 1 semaine. Un \\u003ca href=\\\"https://www.amazon.fr/s?k=graines+basilic+bio+potager\\u0026tag=lebrunnathali-21\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eplant de basilic\\u003c/a\\u003e a 1,50€ produit pendant 4