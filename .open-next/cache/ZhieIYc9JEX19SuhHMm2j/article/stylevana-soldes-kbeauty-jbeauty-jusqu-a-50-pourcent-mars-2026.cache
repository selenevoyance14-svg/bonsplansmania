uty\"}]\n23:[\"$\",\"a\",\"jbeauty\",{\"href\":\"/marque/jbeauty\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"jbeauty\"}]\n24:[\"$\",\"a\",\"cosmetique coreenne\",{\"href\":\"/marque/cosmetique-coreenne\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"cosmetique coreenne\"}]\n25:[\"$\",\"a\",\"skincare\",{\"href\":\"/marque/skincare\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"skincare\"}]\n26:[\"$\",\"a\",\"maquillage\",{\"href\":\"/marque/maquillage\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"maquillage\"}]\n27:[\"$\",\"a\",\"promo\",{\"href\":\"/marque/promo\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"promo\"}]\na:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n28:I[27201,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/d2be314c3ece3fbe.js\"],\"IconMark\"]\n8:null\nc:[[\"$\",\"title\",\"0\",{\"children\":\"Stylevana Soldes K-beauty J-beauty Jusqu'à -50% Mars 2026\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Promos Stylevana mars 2026 : SK-II -15%, BANILA CO -50%, coralhaze -50%, VT -30%, SANA -40%, CNP Laboratory -50%. K-beauty et J-beauty à prix cassés.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"manifest\",\"href\":\"/manifest.json\",\"crossOrigin\":\"$undefined\"}],[\"$\",\"meta\",\"3\",{\"name\":\"keywords\",\"content\":\"bons plans beauté,tests produits gratuits,concours beauté,box beauté,réductions cosmétiques,codes promo beauté,échantillons gratuits\"}],[\"$\",\"link\",\"4\",{\"rel\":\"canonical\",\"href\":\"https://bonsplansmania.fr/article/stylevana-soldes-kbeauty-jbeauty-jusqu-a-50-pourcent-mars-2026\"}],[\"$\",\"meta\",\"5\",{\"property\":\"og:title\",\"content\":\"Stylevana : Jusqu'à -50% sur les Meilleures Marques K-beauty et J-beauty\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:description\",\"content\":\"Grosses promos Stylevana : SK-II à -15%, SANA -40%, BANILA CO -50%, VT -30%, CNP Laboratory -50%... Les meilleures marques coréennes et japonaises soldées.\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:image\",\"content\":\"http://localhost:3000/images/articles/stylevana-soldes-kbeauty-jbeauty-jusqu-a-50-pourcent-mars-2026.svg\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:type\",\"content\":\"article\"}],[\"$\",\"meta\",\"9\",{\"property\":\"article:published_time\",\"content\":\"2026-03-23\"}],[\"$\",\"meta\",\"10\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"11\",{\"name\":\"twitter:title\",\"content\":\"Bons Plans Mania — Bons plans beauté & tests gratuits\"}],[\"$\",\"meta\",\"12\",{\"name\":\"twitter:description\",\"content\":\"Les meilleurs bons plans beauté, tests gratuits, concours et avis box beauté.\"}],[\"$\",\"meta\",\"13\",{\"name\":\"twitter:image\",\"content\":\"http://localhost:3000/images/articles/stylevana-soldes-kbeauty-jbeauty-jusqu-a-50-pourcent-mars-2026.svg\"}],[\"$\",\"link\",\"14\",{\"rel\":\"icon\",\"href\":\"/favicon.svg\",\"type\":\"image/svg+xml\"}],[\"$\",\"link\",\"15\",{\"rel\":\"icon\",\"href\":\"/favicon.ic