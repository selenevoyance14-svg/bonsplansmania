\\",null,{\\\"style\\\":{\\\"fontSize\\\":\\\"0.72rem\\\",\\\"fontWeight\\\":600,\\\"color\\\":\\\"var(--primary)\\\",\\\"textTransform\\\":\\\"uppercase\\\",\\\"letterSpacing\\\":\\\"0.5px\\\"},\\\"children\\\":[\\\"✨\\\",\\\" \\\",\\\"Beauté\\\"]}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"card-title\\\",\\\"children\\\":\\\"Fête des mères 2026 : les plus beaux coffrets beauté à offrir\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"card-excerpt\\\",\\\"children\\\":\\\"Notre sélection des plus beaux coffrets beauté pour la fête des mères 2026. Nuxe, L'Occitane, Clarins, Caudalie, Rituals : pour tous les budgets.\\\"}]]}]]}],[\\\"$\\\",\\\"a\\\",\\\"belle-au-naturel-box-beaute-bio-avril-2026\\\",{\\\"href\\\":\\\"/article/belle-au-naturel-box-beaute-bio-avril-2026\\\",\\\"className\\\":\\\"card\\\",\\\"style\\\":{\\\"textDecoration\\\":\\\"none\\\"},\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"position\\\":\\\"relative\\\",\\\"height\\\":\\\"160px\\\",\\\"overflow\\\":\\\"hidden\\\"},\\\"children\\\":[\\\"$\\\",\\\"$L1c\\\",null,{\\\"src\\\":\\\"/images/articles/belle-au-naturel-box-avril-2026-contenu.png\\\",\\\"alt\\\":\\\"Contenu de la box beauté bio Belle au Naturel avril 2026\\\",\\\"fill\\\":true,\\\"style\\\":{\\\"objectFit\\\":\\\"cover\\\"},\\\"sizes\\\":\\\"33vw\\\"}]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"card-body\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"style\\\":{\\\"fontSize\\\":\\\"0.72rem\\\",\\\"fontWeight\\\":600,\\\"color\\\":\\\"var(--primary)\\\",\\\"textTransform\\\":\\\"uppercase\\\",\\\"letterSpacing\\\":\\\"0.5px\\\"},\\\"children\\\":[\\\"💄\\\",\\\" \\\",\\\"Box Beauté\\\"]}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"card-title\\\",\\\"children\\\":\\\"Belle au Naturel : la box beauté bio d'avril 2026 avec plus de 100€ de soins\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"card-excerpt\\\",\\\"children\\\":\\\"Découvrez la box beauté bio Belle au Naturel d'avril 2026 : 5 soins naturels full-size pour 29,90€. Royer, Marilou Bio, Kadalys, Antonin B., Coslys.\\\"}]]}]]}],[\\\"$\\\",\\\"a\\\",\\\"comparatif-coffrets-parfum-fete-des-meres-2026\\\",{\\\"href\\\":\\\"/article/comparatif-coffrets-parfum-fete-des-meres-2026\\\",\\\"className\\\":\\\"card\\\",\\\"style\\\":{\\\"textDecoration\\\":\\\"none\\\"},\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"position\\\":\\\"relative\\\",\\\"height\\\":\\\"160px\\\",\\\"overflow\\\":\\\"hidden\\\"},\\\"children\\\":[\\\"$\\\",\\\"$L1c\\\",null,{\\\"src\\\":\\\"/images/articles/comparatif-coffrets-parfum-fete-des-meres-2026.svg\\\",\\\"alt\\\":\\\"Comparatif coffrets parfum fête des mères 2026\\\",\\\"fill\\\":true,\\\"style\\\":{\\\"objectFit\\\":\\\"cover\\\"},\\\"sizes\\\":\\\"33vw\\\"}]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"card-body\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"style\\\":{\\\"fontSize\\\":\\\"0.72rem\\\",\\\"fontWeight\\\":600,\\\"color\\\":\\\"var(--primary)\\\",\\\"textTransform\\\":\\\"uppercase\\\",\\\"letterSpacing\\\":\\\"0.5px\\\"},\\\"children\\\":[\\\"✨\\\",\\\" \\\",\\\"Beauté\\\"]}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"card-title\\\",\\\"children\\\":\\\"Coffrets parfum fête des mères 2026 : comparatif des 6 meilleurs\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"card-excerpt\\\",\\\"children\\\":\\\"Lancôme, Chanel, Dior, YSL, Guerlain, Mugler : on compare les coffrets parfum pour la fête des mères 2026. Lequel offrir ?\\\"}]]}]]}]]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"18:[\\\"$\\\",\\\"nav\\\",null,{\\\"style\\\":{\\\"margin\\\":\\\"40px 0\\\",\\\"padding\\\":\\\"24px\\\",\\\"background\\\":\\\"var(--muted, #f3f4f6)\\\",\\\"borderRadius\\\":\\\"16px\\\"},\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"style\\\":{\\\"fontSize\\\":\\\"1rem\\\",\\\"marginBottom\\\":\\\"12px\\\"},\\\"children\\\":\\\"Explorer par catégorie\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"style\\