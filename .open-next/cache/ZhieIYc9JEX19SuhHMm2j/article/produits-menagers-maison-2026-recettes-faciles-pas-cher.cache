ight\":13,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-clock\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"mmk7yg\",{\"d\":\"M12 6v6l4 2\"}],[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],\"$undefined\"]}],\" \",\"5 min\"]}]]}],[\"$\",\"h1\",null,{\"children\":\"Produits ménagers maison : 8 recettes faciles à moins de 1€ le litre\"}],[\"$\",\"p\",null,{\"className\":\"article-subtitle\",\"children\":\"Fabrique tes produits ménagers maison pour moins de 1€ le litre. Nettoyant multi-usage, lessive, liquide vaisselle : recettes simples et efficaces.\"}],[\"$\",\"div\",null,{\"className\":\"article-rating-bar\",\"children\":[\"$undefined\",\"$undefined\",[\"$\",\"a\",null,{\"href\":\"https://www.amazon.fr/s?k=kit+produits+menagers+maison+vinaigre+bicarbonate&tag=lebrunnathali-21\",\"className\":\"btn btn-primary btn-sm\",\"target\":\"_blank\",\"rel\":\"nofollow sponsored noopener\",\"children\":[\"Voir les ingrédients sur Amazon\",\" \",\"$L3\"]}]]}]]}],\"$L4\",\"$L5\",\"$L6\",\"$L7\",\"$L8\",\"$L9\"]}],\"$La\",\"$Lb\",\"$Lc\",\"$Ld\"]}]}],\"$Le\",\"$Lf\"],[\"$L10\"],\"$L11\"]}],\"loading\":null,\"isPartial\":false}\n3:[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":13,\"height\":13,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-external-link\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1q9fwt\",{\"d\":\"M15 3h6v6\"}],[\"$\",\"path\",\"gplh6r\",{\"d\":\"M10 14 21 3\"}],[\"$\",\"path\",\"a6xqqp\",{\"d\":\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"}],\"$undefined\"]}]\n4:[\"$\",\"div\",null,{\"className\":\"article-hero-image\",\"style\":{\"background\":\"#fff\",\"borderRadius\":\"12px\",\"overflow\":\"hidden\",\"display\":\"flex\",\"justifyContent\":\"center\",\"alignItems\":\"center\",\"maxHeight\":\"450px\"},\"children\":[\"$\",\"$L12\",null,{\"src\":\"/images/articles/produits-menagers-maison-2026-recettes-faciles-pas-cher.svg\",\"alt\":\"Produits ménagers maison 2026 recettes faciles et pas chères\",\"width\":800,\"height\":450,\"style\":{\"width\":\"100%\",\"height\":\"100%\",\"objectFit\":\"contain\",\"maxHeight\":\"450px\"},\"priority\":true}]}]\n5:[\"$\",\"$L13\",null,{}]\n6:[\"$\",\"$L14\",null,{}]\n15:T2ca7,<p>\n<h2>Pourquoi fabriquer ses produits ménagers</h2><p>Un foyer français dépense en moyenne 200 à 300€ par an en produits d'entretien. Avec 4 ingrédients de base, tu peux fabriquer quasiment tous tes produits ménagers pour moins de 30€ par an. C'est 10 fois moins cher, meilleur pour la santé et pour l'environnement.</p><hr><p><div class=\"cta-inline\"><a href=\"https://www.amazon.fr/s?k=kit+produits+menagers+maison+vinaigre+bicarbonate&tag=lebrunnathali-21\" class=\"btn btn-primary btn-sm\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Voir les ingrédients sur Amazon <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/><polyline points=\"15 3 21 3 21 9\"/><line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\"/></svg></a></div><h2>Les 4 ingrédients indispensables</h2><p>Avec ces 4 produits, tu fabriques tout :</p><div class=\"table-wrapper\"><table class=\"comparison-table\"><thead><tr>\n<th>Ingrédient</th><th>Prix moyen</th><th>Où l'acheter</th>\n</tr></thead><tbody>\n<tr>\n<td><a href=\"https://www.amazon.fr/s?k=vinaigre+blanc+14+degres+menager&tag=lebrunnathali-21\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Vinaigre blanc 14°</a></td>\n<td>1 à 2€ les 5L</td>\n<td>Supermarché ou Amazon</td>\n</tr>\n<tr>\n<td><a href=\"https://www.amazon.fr/s?k=bicarbonate+de+soude+alimentaire+1kg&tag=lebrunnathali-21\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Bicarbonate de soude</a></td>\n<td>3 à 5€ le kg</td>\n<td>Supermarché ou Amazon</td>\n</tr>\n<tr>\n<td><a href=\"https://www.amazon.fr/s?k=savon+noir+liquide+menager+1+litre&tag=lebrunnathali-21\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Savon noir liquide</a></td>\n<td>5 à 8€ le litre</td>\n<td>Amazon ou magasin bio</td>\n</tr>\n<tr>\n<td><a href=\"https://www.amazon.fr/s?k=cristaux+de+soude+menager&tag=lebrunnathali-21\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Cristaux de soude</a></td>\n<td>3 à 5€ le kg</td>\n<td>Supermarché ou Amazon</td>\n</tr>\n</tbody></table></div><p>En option pour parfumer : quelques gouttes d'<a href=\"https://www.amazon.fr/s?k=huile+essentielle+citron+lavande+tea+tree+bio&tag=lebrunnathali-21\" target=\"_blank\" rel=\"nofollow sponsored noopener\">huile essentielle de citron, lavande ou tea tree</a>.</p><hr><p><div id=\"ezoic-pub-ad-placeholder-203\" class=\"ad-container\" style=\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\"></div><h2>Recette 1 : nettoyant multi-usage (0,30€ le litre)</h2><p>Le produit qui remplace le spray nettoyant de cuisine, le nettoyant salle de bain et le nettoyant vitres.</p><p><strong>Ingrédients</strong> :\n<ul><li>1 litre d'eau tiède</li>\n<li>2 cuillères à soupe de vinaigre blanc</li>\n<li>1 cuillère à soupe de savon noir</li>\n<li>10 gouttes d'huile essentielle de citron (facultatif)</li>\n</ul>\n<strong>Préparation</strong> : mélange tout dans un <a href=\"https://www.amazon.fr/s?k=flacon+spray+vide+500ml+menager&tag=lebrunnathali-21\" target=\"_blank\" rel=\"nofollow sponsored noopener\">flacon spray réutilisable</a>. Secoue avant chaque utilisation. C'est prêt.</p><p><strong>Utilisation</strong> : cuisine, salle de bain, vitres, sols, plan de travail. Ça nettoie et ça dégraisse.</p><hr><p><div class=\"cta-inline\"><a href=\"https://www.amazon.fr/s?k=kit+produits+menagers+maison+vinaigre+bicarbonate&tag=lebrunnathali-21\" class=\"btn btn-primary btn-sm\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Voir les ingrédients sur Amazon <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/><polyline points=\"15 3 21 3 21 9\"/><line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\"/></svg></a></div><h2>Recette 2 : lessive maison (0,50€ le litre)</h2><p><strong>Ingrédients</strong> :\n<ul><li>1 litre d'eau chaude</li>\n<li>20g de <a href=\"https://www.amazon.fr/s?k=savon+de+marseille+copeaux+lessive&tag=lebrunnathali-21\" target=\"_blank\" rel=\"nofollow sponsored noopener\">savon de Marseille en copeaux</a></li>\n<li>1 cuillère à soupe de bicarbonate de soude</li>\n<li>10 gouttes d'huile essentielle de lavande (facultatif)</li>\n</ul>\n<strong>Préparation</strong> : fais fondre les copeaux dans l'eau chaude en remuant. Ajoute le bicarbonate et l'huile essentielle. Laisse refroidir. La texture est un peu gélatineuse, c'est normal. Secoue avant chaque utilisation.</p><p><strong>Dosage</strong> : un verre (environ 100ml) par machine.</p><hr><h2>Recette 3 : liquide vaisselle maison (0,80€ le litre)</h2><p><strong>Ingrédients</strong> :\n<ul><li>500ml d'eau chaude</li>\n<li>2 cuillères à soupe de savon noir</li>\n<li>1 cuillère à soupe de bicarbonate de soude</li>\n<li>1 cuillère à soupe de vinaigre blanc</li>\n<li>10 gouttes d'huile essentielle de citron (facultatif)</li>\n</ul>\n<strong>Préparation</strong> : mélange le savon noir dans l'eau chaude. Ajoute le bicarbonate, le vinaigre (ça va mousser un peu, c'est normal), puis l'huile essentielle. Verse dans un <a href=\"https://www.amazon.fr/s?k=flacon+pompe+vide+500ml&tag=lebrunnathali-21\" target=\"_blank\" rel=\"nofollow sponsored noopener\">flacon pompe</a>.</p><p><strong>Efficacité</strong> : ça mousse moins qu'un liquide vaisselle classique mais ça dégraisse aussi bien. Si tu veux plus de mousse, ajoute une cuillère de <a href=\"https://www.amazon.fr/s?k=SCI+tensioactif+poudre&tag=lebrunnathali-21\" target=\"_blank\" rel=\"nofollow sponsored noopener\">SCI en poudre</a> (tensioactif naturel).</p><hr><p><div id=\"ezoic-pub-ad-placeholder-206\" class=\"ad-container\" style=\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\"></div><h2>Recette 4 : détartrant WC (0,20€ par utilisation)</h2><p><strong>Ingrédients</strong> :\n<ul><li>200ml de vinaigre blanc</li>\n<li>2 cuillères à soupe de bicarbonate de soude</li>\n</ul>\n<strong>Préparation</strong> : verse le vinaigre dans la cuvette, saupoudre le bicarbonate. Ça mousse, c'est la réaction chimique qui décolle le tartre. Laisse agir 30 minutes puis frotte avec la brosse et tire la chasse.</p><p>Pour les traces tenaces, laisse agir toute la nuit.</p><hr><h2>Recette 5 : nettoyant sols (0,15€ le litre)</h2><p><strong>Ingrédients</strong> :\n<ul><li>1 seau d'eau chaude (5 litres)</li>\n<li>3 cuillères à soupe de savon noir</li>\n<li>2 cuillères à soupe de vinaigre blanc</li>\n</ul>\n<strong>Préparation</strong> : mélange dans le seau. Passe la serpillière normalement. Pas besoin de rincer.</p><p>Ça fonctionne sur le carrelage, le lino, le parquet vitrifié et même le marbre (sans le vinaigre pour le marbre, il est trop acide).</p><hr><p><div class=\"cta-inline\"><a href=\"https://www.amazon.fr/s?k=kit+produits+menagers+maison+vinaigre+bicarbonate&tag=lebrunnathali-21\" class=\"btn btn-primary btn-sm\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Voir les ingrédients sur Amazon <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/><polyline points=\"15 3 21 3 21 9\"/><line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\"/></svg></a></div><h2>Recette 6 : spray anti-calcaire (0,25€ le litre)</h2><p><strong>Ingrédients</strong> :\n<ul><li>500ml de vinaigre blanc</li>\n<li>500ml d'eau</li>\n<li>Zeste de citron ou d'orange (facultatif, pour l'odeur)</li>\n</ul>\n<strong>Préparation</strong> : mélange dans un flacon spray. Pour atténuer l'odeur du vinaigre, laisse macérer des zestes d'agrumes dans le vinaigre pendant une semaine avant de l'utiliser.</p><p><strong>Utilisation</strong> : robinets, paroi de douche, évier, bouilloire. Pulvérise, laisse agir 10 minutes, essuie.</p><hr><p><div id=\"ezoic-pub-ad-placeholder-209\" class=\"ad-container\" style=\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\"></div><h2>Recette 7 : déboucheur de canalisation (0,30€)</h2><p><strong>Ingrédients</strong> :\n<ul><li>3 cuillères à soupe de bicarbonate de soude</li>\n<li>200ml de vinaigre blanc</li>\n<li>1 litre d'eau bouillante</li>\n</ul>\n<strong>Préparation</strong> : verse le bicarbonate dans la canalisation, ajoute le vinaigre (ça mousse fort), laisse agir 30 minutes, puis verse l'eau bouillante.</p><p>Pour l'entretien préventif, fais-le une fois par mois. Ça évite les bouchons et les mauvaises odeurs.</p><hr><p><div class=\"cta-inline\"><a href=\"https://www.amazon.fr/s?k=kit+produits+menagers+maison+vinaigre+bicarbonate&tag=lebrunnathali-21\" class=\"btn btn-primary btn-sm\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Voir les ingrédients sur Amazon <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/><polyline points=\"15 3 21 3 21 9\"/><line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\"/></svg></a></div><h2>Recette 8 : désodorisant maison (0,50€)</h2><p><strong>Ingrédients</strong> :\n<ul><li>1 <a href=\"https://www.amazon.fr/s?k=petit+pot+verre+couvercle&tag=lebrunnathali-21\" target=\"_blank\" rel=\"nofollow sponsored noopener\">petit pot en verre</a></li>\n<li>3 cuillères à soupe de bicarbonate de soude</li>\n<li>10 gouttes d'huile essentielle au choix</li>\n</ul>\n<strong>Préparation</strong> : verse le bicarbonate dans le pot, ajoute les gouttes d'huile essentielle, mélange. Place le pot ouvert dans la pièce à désodoriser (salle de bain, toilettes, placard). Renouvelle les gouttes d'HE toutes les 2 semaines, change le bicarbonate tous les mois.</p><hr><h2>Combien tu économises</h2><div class=\"table-wrapper\"><table class=\"comparison-table\"><thead><tr>\n<th>Produit</th><th>Prix industriel/an</th><th>Prix maison/an</th><th>Économie</th>\n</tr></thead><tbody>\n<tr>\n<td>Nettoyant multi-usage</td>\n<td>30€</td>\n<td>3€</td>\n<td>27€</td>\n</tr>\n<tr>\n<td>Lessive</td>\n<td>80€</td>\n<td>10€</td>\n<td>70€</td>\n</tr>\n<tr>\n<td>Liquide vaisselle</td>\n<td>25€</td>\n<td>5€</td>\n<td>20€</td>\n</tr>\n<tr>\n<td>Détartrant WC</td>\n<td>15€</td>\n<td>2€</td>\n<td>13€</td>\n</tr>\n<tr>\n<td>Nettoyant sol</td>\n<td>20€</td>\n<td>2€</td>\n<td>18€</td>\n</tr>\n<tr>\n<td>Anti-calcaire</td>\n<td>20€</td>\n<td>3€</td>\n<td>17€</td>\n</tr>\n<tr>\n<td>Désodorisant</td>\n<td>30€</td>\n<td>5€</td>\n<td>25€</td>\n</tr>\n<tr>\n<td><strong>Total</strong></td>\n<td><strong>220€</strong></td>\n<td><strong>30€</strong></td>\n<td><strong>190€</strong></td>\n</tr>\n</tbody></table></div><hr><p><div id=\"ezoic-pub-ad-placeholder-212\" class=\"ad-container\" style=\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\"></div><h2>Notre avis</h2><p>On fabrique nos produits ménagers maison depuis un bon moment et franchement, on ne reviendrait pas en arrière. C'est efficace, ça sent bon, c'est pas cher et on sait ce qu'il y a dedans. Le plus dur c'est de se lancer : la première fois tu te dis \"est-ce que ça va vraiment marcher ?\". La réponse est oui. Commence par le nettoyant multi-usage, c'est le plus simple et le plus polyvalent. Si ça te convient, tu passes aux autres un par un.\n</p>7:[\"$\",\"div\",null,{\"className\":\"article-content\",\"children\":[\"$\",\"div\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"$15\"}}]}]\n8:[\"$\",\"$L13\",null,{}]\n9:[\"$\",\"div\",null,{\"style\":{\"textAlign\":\"center\",\"margin\":\"40px 0\",\"padding\":\"32px\",\"background\":\"linear-gradient(135deg, #FFF0F0 0%, #FFF8F0 100%)\",\"borderRadius\":\"16px\",\"border\":\"2px solid #FECDD3\"},\"children\":[[\"$\",\"p\",null,{\"style\":{\"fontWeight\":800,\"fontSize\":\"1.2rem\",\"marginBottom\":\"16px\",\"color\":\"var(--foreground)\"},\"children\":\"Profiter de cette offre\"}],[\"$\",\"a\",null,{\"href\":\"https://www.amazon.fr/s?k=kit+produits+menagers+maison+vinaigre+bicarbonate&tag=lebrunnathali-21\",\"className\":\"btn btn-primary\",\"target\":\"_blank\",\"rel\":\"nofollow sponsored noopener\",\"style\":{\"padding\":\"14px 32px\",\"fontSize\":\"1rem\"},\"children\":[\"Voir les ingrédients sur Amazon\",\" \",[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":15,\"height\":15,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-external-link\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1q9fwt\",{\"d\":\"M15 3h6v6\"}],[\"$\",\"path\",\"gplh6r\",{\"d\":\"M10 14 21 3\"}],[\"$\",\"path\",\"a6xqqp\",{\"d\":\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"}],\"$undefined\"]}]]}]]}]\na:[\"$\",\"$L13\",null,{}]\nb:[\"$\",\"section\",null,{\"className\":\"related-articles\",\"children\":[[\"$\",\"h2\",null,{\"children\":\"A lire aussi\"}],[\"$\",\"div\",null,{\"className\":\"articles-grid\",\"style\":{\"gridTemplateColumns\":\"repeat(auto-fit, minmax(280px, 1fr))\"},\"children\":[[\"$\",\"a\",\"lessive-maison-2026-recette-savon-marseille-facile-pas-cher\",{\"href\":\"/article/lessive-maison-2026-recette-savon-marseille-facile-pas-cher\",\"className\":\"card\",\"style\":{\"textDecoration\":\"none\"},\"children\":[[\"$\",\"div\",null,{\"style\":{\"position\":\"relative\",\"height\":\"160px\",\"overflow\":\"hidden\"},\"children\":[\"$\",\"$L12\",null,{\"src\":\"/images/articles/lessive-maison-2026-recette-savon-marseille-facile-pas-cher.svg\",\"alt\":\"Lessive maison au savon de Marseille 2026 recette facile et pas chère\",\"fill\":true,\"style\":{\"objectFit\":\"cover\"},\"sizes\":\"33vw\"}]}],[\"$\",\"div\",null,{\"className\":\"card-body\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"fontSize\":\"0.72rem\",\"fontWeight\":600,\"color\":\"var(--primary)\",\"textTransform\":\"uppercase\",\"letterSpacing\":\"0.5px\"},\"children\":[\"🏷️\",\" \",\"Bon Plan\"]}],[\"$\",\"h3\",null,{\"className\":\"card-title\",\"children\":\"Lessive maison au savon de Marseille : la recette en 5 minutes pour 0,50€ le litre\"}],[\"$\",\"p\",null,{\"className\":\"card-excerpt\",\"children\":\"Fabrique ta lessive maison au savon de Marseille en 5 minutes. Recette facile, efficace et 10 fois moins chère que la lessive du commerce.\"}]]}]]}],[\"$\",\"a\",\"recette-biscuits-cookies-maison-facile-2026\",{\"href\":\"/article/recette-biscuits-cookies-maison-facile-2026\",\"className\":\"card\",\"style\":{\"textDecoration\":\"none\"},\"children\":[[\"$\",\"div\",null,{\"style\":{\"position\":\"relative\",\"height\":\"160px\",\"overflow\":\"hidden\"},\"children\":[\"$\",\"$L12\",null,{\"src\":\"/images/articles/recette-biscuits-cookies-maison-facile-2026.svg\",\"alt\":\"Recettes de biscuits et cookies maison faciles 2026\",\"fill\":true,\"style\":{\"objectFit\":\"cover\"},\"sizes\":\"33vw\"}]}],[\"$\",\"div\",null,{\"className\":\"card-body\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"fontSize\":\"0.72rem\",\"fontWeight\":600,\"color\":\"var(--primary)\",\"textTransform\":\"uppercase\",\"letterSpacing\":\"0.5px\"},\"children\":[\"🏷️\",\" \",\"Bon Plan\"]}],[\"$\