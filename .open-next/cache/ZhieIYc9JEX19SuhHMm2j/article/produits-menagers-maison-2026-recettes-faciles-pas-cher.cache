\"🏷️\",\" \",\"Bon Plan\"]}],[\"$\",\"h3\",null,{\"className\":\"card-title\",\"children\":\"Biscuits et Cookies Maison : 5 Recettes Faciles à Moins de 2€\"}],[\"$\",\"p\",null,{\"className\":\"card-excerpt\",\"children\":\"5 recettes de biscuits et cookies maison faciles et pas chers. Cookies chocolat, sablés, madeleines, financiers, biscuits avoine. Moins de 2€ la fournée.\"}]]}]]}],[\"$\",\"a\",\"8-autobronzants-bien-notes-yuka-eviter-masque-grossesse-2026\",{\"href\":\"/article/8-autobronzants-bien-notes-yuka-eviter-masque-grossesse-2026\",\"className\":\"card\",\"style\":{\"textDecoration\":\"none\"},\"children\":[[\"$\",\"div\",null,{\"style\":{\"position\":\"relative\",\"height\":\"160px\",\"overflow\":\"hidden\"},\"children\":[\"$\",\"$L1c\",null,{\"src\":\"/images/articles/autobronzants-yuka-masque-grossesse-2026.png\",\"alt\":\"8 autobronzants bien notés sur Yuka pour éviter le masque de grossesse\",\"fill\":true,\"style\":{\"objectFit\":\"cover\"},\"sizes\":\"33vw\"}]}],[\"$\",\"div\",null,{\"className\":\"card-body\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"fontSize\":\"0.72rem\",\"fontWeight\":600,\"color\":\"var(--primary)\",\"textTransform\":\"uppercase\",\"letterSpacing\":\"0.5px\"},\"children\":[\"✨\",\" \",\"Beauté\"]}],[\"$\",\"h3\",null,{\"className\":\"card-title\",\"children\":\"8 autobronzants bien notés sur Yuka qui évitent le masque de grossesse\"}],[\"$\",\"p\",null,{\"className\":\"card-excerpt\",\"children\":\"Sélection de 8 autobronzants bien notés sur Yuka, sûrs pendant la grossesse. Les Petits Prodiges, Aroma-Zone, Weleda, Garnier, SVR, Clarins. Dès 7,95€.\"}]]}]]}]]}]]}]\n18:[\"$\",\"nav\",null,{\"style\":{\"margin\":\"40px 0\",\"padding\":\"24px\",\"background\":\"var(--muted, #f3f4f6)\",\"borderRadius\":\"16px\"},\"children\":[[\"$\",\"h3\",null,{\"style\":{\"fontSize\":\"1rem\",\"marginBottom\":\"12px\"},\"children\":\"Explorer par catégorie\"}],[\"$\",\"div\",null,{\"style\":{\"display\":\"flex\",\"flexWrap\":\"wrap\",\"ga