on\":\"none\",\"fontWeight\":500},\"children\":\"soin visage\"}],[\"$\",\"a\",\"soin corps\",{\"href\":\"/marque/soin-corps\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"soin corps\"}],[\"$\",\"a\",\"maquillage\",{\"href\":\"/marque/maquillage\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"maquillage\"}],[\"$\",\"a\",\"cadeau\",{\"href\":\"/marque/cadeau\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"cadeau\"}],[\"$\",\"a\",\"2026\",{\"href\":\"/marque/2026\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"2026\"}]]]}]\na:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n1e:I[27201,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/d2be314c3ece3fbe.js\"],\"IconMark\"]\n8:null\nc:[[\"$\",\"title\",\"0\",{\"children\":\"Clarins trousses découverte à 30€ : fête des mères\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"3 trousses Clarins à 30€ avec des soins premium (valeur 39 à 45€). Visage, corps, maquillage. Le cadeau fête des mères parfait + cadeaux dès 80€ d'achat.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"manifest\",\"href\":\"/manifest.json\",\"crossOrigin\":\"$undefined\"}],[\"$\",\"meta\",\"3\",{\"name\":\"keywords\",\"content\":\"bons plans beauté,tests produits gratuits,concours beauté,box beauté,réductions cosmétiques,codes promo beauté,échantillons gratuits\"}],[\"$\",\"link\",\"4\",{\"rel\":\"canonical\",\"href\":\"https://bonsplansmania.fr/article/clarins-trousses-decouverte-30-euros-fete-des-meres-2026\"}],[\"$\",\"meta\",\"5\",{\"property\":\"og:title\",\"content\":\"Clarins : 3 trousses découverte à 30€ (valeur jusqu'à 45€), idéal fête des mères\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:description\",\"content\":\"Découvrez les 3 trousses Clarins à 30€ : soins visage, corps, maquillage. Valeur de 39 à 45€. Le cadeau parfait pour la fête des mères 2026.\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:image\",\"content\":\"http://localhost:3000/images/articles/clarins-trousse-essentiels-beaute-2026.png\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:type\",\"content\":\"article\"}],[\"$\",\"meta\",\"9\",{\"property\":\"article:published_time\",\"content\":\"2026-04-10\"}],[\"$\",\"meta\",\"10\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"11\",{\"name\":\"twitter:title\",\"content\":\"Bons Plans Mania — Bons plans beauté & tests gratuits\"}],[\"$\",\"meta\",\"12\",{\"name\":\"twitter:description\",\"content\":\"Les meilleurs bons plans beauté, tests gratuits, concours et avis box beauté.\"}],[\"$\",\"meta\",\"13\",{\"name\":\"twitter:image\",\"content\":\"http://localhost:3000/images/articles/clarins-trousse-essentiels-beaute-2026.png\"}],[\"$\",\"link\",\"14\",{\"rel\":\"icon\",\"href\":\"/favicon.svg\",\"type\":\"image/svg+xml\"}],[\"$\",\"link\",\"15\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"sizes\":\"32x32\"}],[\"$\",\"link\",\"16\",{\"rel\":\"apple-touch-icon\",\"href\":\"/apple-touch-icon.png\"}],[\"$\",\"$L1e\",\"17\",{}]]\n","/article/$d$slug/__PAGE__":"1:\"$Sreact.fragment\"\n2:I[83608,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\nd:I[5500,[\"/_next/static/chunks/cf20