ime\":\"2026-03-06\",\"children\":\"6 mars 2026\"}],\"$undefined\",[\"$\",\"span\",null,{\"style\":{\"display\":\"flex\",\"alignItems\":\"center\",\"gap\":\"4px\"},\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":13,\"height\":13,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-clock\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"mmk7yg\",{\"d\":\"M12 6v6l4 2\"}],[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],\"$undefined\"]}],\" \",\"2 min\"]}]]}],[\"$\",\"h1\",null,{\"children\":\"Haribo — jeux concours réguliers : Nintendo Switch, coffrets bonbons et cadeaux\"}],[\"$\",\"p\",null,{\"className\":\"article-subtitle\",\"children\":\"Haribo organise des jeux concours toute l'année : Nintendo Switch, coffrets bonbons, peluches, mugs et goodies. Jouez en ligne ou en magasin gratuitement.\"}],false]}],[\"$\",\"div\",null,{\"className\":\"article-hero-image\",\"style\":{\"background\":\"#fff\",\"borderRadius\":\"12px\",\"overflow\":\"hidden\",\"display\":\"flex\",\"justifyContent\":\"center\",\"alignItems\":\"center\",\"maxHeight\":\"450px\"},\"children\":[\"$\",\"$Lf\",null,{\"src\":\"/images/articles/haribo-jeux-concours-nintendo-switch-bonbons-2026.svg\",\"alt\":\"Haribo jeux concours Nintendo Switch bonbons 2026\",\"width\":800,\"height\":450,\"style\":{\"width\":\"100%\",\"height\":\"100%\",\"objectFit\":\"contain\",\"maxHeight\":\"450px\"},\"priority\":true}]}],\"$L10\",\"$L11\",\"$L12\",\"$L13\",false]}],\"$L14\",\"$L15\",\"$L16\",\"$L17\"]}]}],false,\"$L18\"]\n19:I[96788,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\n1a:I[1586,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\n1c:I[67277,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\n10:[\"$\",\"$L19\",null,{}]\n11:[\"$\",\"$L1a\",null,{}]\n1b:T7cd,<p>\n<strong>Haribo</strong> propose des <strong>jeux concours</strong> tout au long de l'année avec de super lots à gagner ! La marque de bonbons préférée des Français gâte ses fans.</p><h2>Les lots habituellement proposés</h2><div class=\"table-wrapper\"><table class=\"comparison-table\"><thead><tr>\n<th>Lot</th><th>Type</th>\n</tr></thead><tbody>\n<tr>\n<td><strong>Nintendo Switch</strong></td>\n<td>Console de jeu</td>\n</tr>\n<tr>\n<td><strong>Coffrets bonbons</strong></td>\n<td>Assortiments Haribo exclusifs</td>\n</tr>\n<tr>\n<td><strong>Peluches Haribo</strong></td>\n<td>Ours d'Or géants et personnages</td>\n</tr>\n<tr>\n<td><strong>Mugs et goodies</strong></td>\n<td>Objets collector Haribo</td>\n</tr>\n<tr>\n<td><strong>Bons d'achat</strong></td>\n<td>À dépenser en magasin</td>\n</tr>\n</tbody></table></div><h2>Comment participer ?</h2><p>1. Rendez-vous sur le site <strong>Haribo France</strong>\n2. Consultez les jeux concours en cours\n3. Participez <strong>gratuitement</strong> en ligne\n4. Certains jeux sont aussi disponibles <strong>en magasin</strong> (QR codes sur les paquets)</p><p>👉 <a href=\"https://www.haribo.com/fr-fr\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Voir les jeux Haribo</a></p><p><div id=\"ezoic-pub-ad-placeholder-203\" class=\"ad-container\" style=\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\"></div><h2>Astuce</h2><p>Haribo lance de <strong>nouveaux concours régulièrement</strong> (souvent chaque mois). Pensez à consulter leur site et leurs réseaux sociaux pour ne rien rater. Les concours en magasin nécessitent parfois un achat, mais les jeux en ligne sont souvent <strong>100% gratuits</strong> !</p><h2>Pourquoi jouer ?</h2><ul><li><strong>Marque fun</strong> — les jeux sont ludiques et bien faits</li>\n<li><strong>Lots variés</strong> — de la console au paquet de bonbons</li>\n<li><strong>Régulier</strong> — nouveaux jeux chaque mois</li>\n<li><strong>Pour toute la famille</strong> — les enfants adorent !</li>\n</ul>12:[\"$\",\"div\",null,{\"className\":\"article-content\",\"children\":[\"$\",\"div\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"$1b\"}}]}]\n13:[\"$\",\"$L19\",null,{}]\n14:[\"$\",\"$L19\",null,{}]\n15:[\"$\",\"section\",null,{\"className\":\"related-articles\",\"children\":[[\"$\",\"h2\",null,{\"children\":\"A lire aussi\"}],[\"$\",\"div\",null,{\"className\":\"articles-grid\",\"style\":{\"gridTemplateColumns\":\"repeat(auto-fit, minmax(280px, 1fr))\"},\"children\":[[\"$\",\"a\",\"jardin-bio-etic-jeu-concours-jumpers-disney-pixar-sejour-vvf\",{\"href\":\"/article/jardin-bio-etic-jeu-concours-jumpers-disney-pixar-sejour-vvf\",\"className\":\"card\",\"style\":{\"textDecoration\":\"none\"},\"children\":[[\"$\",\"div\",null,{\"style\":{\"position\":\"relative\",\"height\":\"160px\",\"overflow\":\"hidden\"},\"children\":[\"$\",\"$Lf\",null,{\"src\":\"/images/articles/jardin-bio-etic-jeu-concours-jumpers-disney-pixar-sejour-vvf.svg\",\"alt\":\"Jardin BiO etic jeu concours Jumpers Disney Pixar sejour VVF a gagner\",\"fill\":true,\"style\":{\"objectFit\":\"cover\"},\"sizes\":\"33vw\"}]}],[\"$\",\"div\",null,{\"className\":\"card-body\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"fontSize\":\"0.72rem\",\"fontWeight\":600,\"color\":\"var(--primary)\",\"textTransform\":\"uppercase\",\"letterSpacing\":\"0.5px\"},\"children\":[\"🏆\",\" \",\"Concours\"]}],[\"$\",\"h3\",null,{\"className\":\"card-title\",\"children\":\"Jardin BiO etic x Jumpers : sejour VVF et goodies a gagner (100% gagnant)\"}],[\"$\",\"p\",null,{\"className\":\"card-excerpt\",\"children\":\"Jeu concours Jardin BiO etic pour la sortie du film Disney Pixar Jumpers. Tentez de gagner un sejour en famille VVF, des goodies et des codes promo. 100% gagnant.\"}]]}]]}],[\"$\",\"a\",\"concours-brico-cash-einhell-aspirateur-eaux-poussieres-avril-2026\",{\"href\":\"/arti