]}],[\"$\",\"h3\",null,{\"className\":\"card-title\",\"children\":\"iGraal : les Meilleurs Cashback de la Semaine (Dyson 4,5%, NordVPN 35%, Redcare 7%)\"}],[\"$\",\"p\",null,{\"className\":\"card-excerpt\",\"children\":\"Retrouvez les meilleurs taux de cashback iGraal cette semaine : Dyson 4,5%, NordVPN 35%, Redcare Pharmacie 7%, SkinCeuticals 5%. Plus de 1500 sites partenaires.\"}]]}]]}],[\"$\",\"a\",\"code-promo-marionnaud-offres-beaute-mars-2026\",{\"href\":\"/article/code-promo-marionnaud-offres-beaute-mars-2026\",\"className\":\"card\",\"style\":{\"textDecoration\":\"none\"},\"children\":[[\"$\",\"div\",null,{\"style\":{\"position\":\"relative\",\"height\":\"160px\",\"overflow\":\"hidden\"},\"children\":[\"$\",\"$L1c\",null,{\"src\":\"/images/articles/code-promo-marionnaud-offres-beaute-mars-2026.svg\",\"alt\":\"Marionnaud codes promo offres beauté mars 2026\",\"fill\":true,\"style\":{\"objectFit\":\"cover\"},\"sizes\":\"33vw\"}]}],[\"$\",\"div\",null,{\"className\":\"card-body\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"fontSize\":\"0.72rem\",\"fontWeight\":600,\"color\":\"var(--primary)\",\"textTransform\":\"uppercase\",\"letterSpacing\":\"0.5px\"},\"children\":[\"$undefined\",\" \",\"$undefined\"]}],[\"$\",\"h3\",null,{\"className\":\"card-title\",\"children\":\"Marionnaud : Codes Promo & Offres Beauté — Jusqu'à -40% (Mars 2026)\"}],[\"$\",\"p\",null,{\"className\":\"card-excerpt\",\"children\":\"Toutes les offres Marionnaud en cours : -30% sans minimum, boîte à bijoux offerte dès 99€, Beauty Deals dès 29€, outlet -40%, offres Clarins, Clinique, IKKS, Jacadi.\"}]]}]]}]]}]]}]\n18:[\"$\",\"nav\",null,{\"style\":{\"margin\":\"40px 0\",\"padding\":\"24px\",\"background\":\"var(--muted, #f3f4f6)\",\"borderRadius\":\"16px\"},\"children\":[[\"$\",\"h3\",null,{\"style\":{\"fontSize\":\"1rem\",\"marginBottom\":\"12px\"},\"children\":\"Explorer par catégorie\"}],[\"$\",\"div\",null,{\"style\":{\"display\":\"flex\",\"flexWrap\":\"wrap\",\"gap\":\"8px\"},\"childr