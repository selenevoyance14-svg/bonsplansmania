ript\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"Article\\\",\\\"headline\\\":\\\"Prescription Lab : 3 Nouvelles Routines pour 16 euros, sans engagement (valeur jusqu'a 107 euros)\\\",\\\"description\\\":\\\"Offre Prescription Lab beaux jours : 3 routines beaute pour 16 euros sans engagement. 100% Glow (65E), Week-end en Normandie (107E), Essentiels Make-Up (50E). Garancia, Polaar, Viogne, ErthSkin.\\\",\\\"datePublished\\\":\\\"2026-03-27\\\",\\\"dateModified\\\":\\\"2026-03-27\\\",\\\"image\\\":\\\"https://bonsplansmania.fr/images/articles/prescription-lab-3-routines-beaute-16-euros-sans-engagement-printemps-2026.svg\\\",\\\"mainEntityOfPage\\\":{\\\"@type\\\":\\\"WebPage\\\",\\\"@id\\\":\\\"https://bonsplansmania.fr/article/prescription-lab-3-routines-beaute-16-euros-sans-engagement-printemps-2026\\\"},\\\"author\\\":{\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"Bons Plans Mania\\\",\\\"url\\\":\\\"https://bonsplansmania.fr\\\"},\\\"publisher\\\":{\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"Bons Plans Mania\\\",\\\"url\\\":\\\"https://bonsplansmania.fr\\\",\\\"logo\\\":{\\\"@type\\\":\\\"ImageObject\\\",\\\"url\\\":\\\"https://bonsplansmania.fr/icon.svg\\\"}}}\"}}],null,[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"BreadcrumbList\\\",\\\"itemListElement\\\":[{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":1,\\\"name\\\":\\\"Accueil\\\",\\\"item\\\":\\\"https://bonsplansmania.fr\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":2,\\\"name\\\":\\\"Box Beauté\\\",\\\"item\\\":\\\"https://bonsplansmania.fr/categorie/box-beaute\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":3,\\\"name\\\":\\\"Prescription Lab : 3 Nouvelles Routines pour 16 euros, sans engagement (valeur jusqu'a 107 euros)\\\"}]}\"}}],[\"$\",\"$Le\",null,{\"acti