\"className\":\"article-rating-bar\",\"children\":[\"$undefined\",\"$undefined\",[\"$\",\"a\",null,{\"href\":\"https://story.tl/sanmarco-mozart-quiz2\",\"className\":\"btn btn-primary btn-sm\",\"target\":\"_blank\",\"rel\":\"nofollow sponsored noopener\",\"children\":[\"Jouer au quiz San Marco\",\" \",[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":13,\"height\":13,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-external-link\",\"aria-hidden\":\"true\",\"children\":[\"$Lf\",\"$L10\",\"$L11\",\"$undefined\"]}]]}]]}]]}],\"$L12\",\"$L13\",\"$L14\",\"$L15\",\"$L16\",\"$L17\"]}],\"$L18\",\"$L19\",\"$L1a\",\"$L1b\"]}]}],\"$L1c\",\"$L1d\"]\n1e:I[5500,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"Image\"]\n1f:I[96788,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\n20:I[1586,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\n22:I[67277,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\nf:[\"$\",\"path\",\"1q9fwt\",{\"d\":\"M15 3h6v6\"}]\n10:[\"$\",\"path\",\"gplh6r\",{\"d\":\"M10 14 21 3\"}]\n11:[\"$\",\"path\",\"a6xqqp\",{\"d\":\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"}]\n12:[\"$\",\"div\",null,{\"className\":\"article-hero-image\",\"style\":{\"background\":\"#fff\",\"borderRadius\":\"12px\",\"overflow\":\"hidden\",\"display\":\"flex\",\"justifyContent\":\"center\",\"alignItems\":\"center\",\"maxHeight\":\"450px\"},\"children\":[\"$\",\"$L1e\",null,{\"src\":\"/images/articles/san-marco-mozart-quiz-concours-2026.svg\",\"alt\":\"Quiz concours San Marco Mozart voyage Venise 2026\",\"width\":800,\"height\":450,\"style\":{\"width\":\"100%\",\"height\":\"100%\",\"objectFit\":\"contain\",\"maxHeight\":\"450px\"},\"priority\":true}]}]\n13:[\"$\",\"$L1f\",null,{}]\n14:[\"$\",\"$L20\",null,{}]\n21:Tac6,<p>\n<strong>San Marco</strong>, la marque de café, vous invite à jouer au <strong>quiz Mozart</strong> pour tenter de gagner un <strong>voyage à Venise pour 2 personnes</strong> et des cadeaux café au quotidien !</p><h2>Les lots à gagner</h2><h3>Grand lot</h3>\n<ul><li><strong>1 voyage à Venise pour 2 personnes</strong> — la ville de San Marco !</li>\n</ul>\n<h3>Lots quotidiens</h3>\n<ul><li><strong>Cadeaux liés au café</strong> — invitations, produits et surprises distribués chaque jour</li>\n</ul>\n<div class=\"cta-inline\"><a href=\"https://story.tl/sanmarco-mozart-quiz2\" class=\"btn btn-primary btn-sm\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Jouer au quiz San Marco <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/><polyline points=\"15 3 21 3 21 9\"/><line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\"/></svg></a></div><h2>Comment participer ?</h2><p>1. Rendez-vous sur la page du quiz\n2. Répondez aux <strong>5 questions</strong> sur Mozart et San Marco\n3. Remplissez vos coordonnées\n4. Tentez l'<strong>instant gagnant</strong> après le quiz</p><p>Quiz ouvert du 3 novembre 2025 au <strong>31 mars 2026</strong>.</p><p><div id=\"ezoic-pub-ad-placeholder-203\" class=\"ad-container\" style=\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\"></div><h2>Les 5 questions du quiz</h2><p>Le quiz porte sur la vie de Mozart et la place San Marco :\n<ul><li>L'année de naissance de Mozart (1756)</li>\n<li>Ses compositions célèbres</li>\n<li>Son premier opéra</li>\n<li>Le nombre d'œuvres cataloguées</li>\n<li>La place San Marco (Venise)</li>\n</ul>\n<div class=\"cta-inline\"><a href=\"https://story.tl/sanmarco-mozart-quiz2\" class=\"btn btn-primary btn-sm\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Jouer au quiz San Marco <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/><polyline points=\"15 3 21 3 21 9\"/><line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\"/></svg></a></div><h2>Pourquoi participer ?</h2><ul><li><strong>Voyage à Venise</strong> — un grand lot exceptionnel</li>\n<li><strong>Lots quotidiens</strong> — des chances chaque jour</li>\n<li><strong>Quiz rapide</strong> — 5 questions en quelques minutes</li>\n<li><strong>Instant gagnant</strong> — résultat immédiat après le quiz</li>\n<li><strong>Gratuit</strong> — participation sans achat</li>\n<li><strong>Jusqu'au 31 mars</strong> — encore du temps pour jouer</li>\n</ul>15:[\"$\",\"div\",null,{\"className\":\"article-content\",\"children\":[\"$\",\"div\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"$21\"}}]}]\n16:[\"$\",\"$L1f\",null,{}]\n17:[\"$\",\"div\",null,{\"style\":{\"textAlign\":\"center\",\"margin\":\"40px 0\",\"padding\":\"32px\",\"background\":\"linear-gradient(135deg, #FFF0F0 0%, #FFF8F0 100%)\",\"borderRadius\":\"16px\",\"border\":\"2px solid #FECDD3\"},\"children\":[[\"$\",\"p\",null,{\"style\":{\"fontWeight\":800,\"fontSize\":\"1.2rem\",\"marginBottom\":\"16px\",\"color\":\"var(--foreground)\"},\"children\":\"Profiter de cette offre\"}],[\"$\",\"a\",null,{\"href\":\"https://story.tl/sanmarco-mozart-quiz2\",\"className\":\"btn btn-primary\",\"target\":\"_blank\",\"rel\":\"nofollow sponsored noopener\",\"style\":{\"padding\":\"14px 32px\",\"fontSize\":\"1rem\"},\"children\":[\"Jouer au quiz San Marco\",\" \",[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":15,\"height\":15,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"curren