",\\\"div\\\",null,{\\\"className\\\":\\\"article-meta-top\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"pill pill-bon-plan\\\",\\\"children\\\":[\\\"🏷️\\\",\\\" \\\",\\\"Bon Plan\\\"]}],[\\\"$\\\",\\\"time\\\",null,{\\\"dateTime\\\":\\\"2026-04-01\\\",\\\"children\\\":\\\"1 avril 2026\\\"}],\\\"$undefined\\\",[\\\"$\\\",\\\"span\\\",null,{\\\"style\\\":{\\\"display\\\":\\\"flex\\\",\\\"alignItems\\\":\\\"center\\\",\\\"gap\\\":\\\"4px\\\"},\\\"children\\\":[[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":13,\\\"height\\\":13,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-clock\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":[[\\\"$\\\",\\\"path\\\",\\\"mmk7yg\\\",{\\\"d\\\":\\\"M12 6v6l4 2\\\"}],[\\\"$\\\",\\\"circle\\\",\\\"1mglay\\\",{\\\"cx\\\":\\\"12\\\",\\\"cy\\\":\\\"12\\\",\\\"r\\\":\\\"10\\\"}],\\\"$undefined\\\"]}],\\\" \\\",\\\"4 min\\\"]}]]}],[\\\"$\\\",\\\"h1\\\",null,{\\\"children\\\":\\\"APL 2026 : aide au logement, comment savoir si tu y as droit\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"article-subtitle\\\",\\\"children\\\":\\\"Les APL réduisent ton loyer chaque mois. Simulation rapide sur la CAF, conditions d'éligibilité et montants détaillés pour 2026.\\\"}],false]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"article-hero-image\\\",\\\"style\\\":{\\\"background\\\":\\\"#fff\\\",\\\"borderRadius\\\":\\\"12px\\\",\\\"overflow\\\":\\\"hidden\\\",\\\"display\\\":\\\"flex\\\",\\\"justifyContent\\\":\\\"center\\\",\\\"alignItems\\\":\\\"center\\\",\\\"maxHeight\\\":\\\"450px\\\"},\\\"children\\\":[\\\"$\\\",\\\"$Lf\\\",null,{\\\"src\\\":\\\"/images/articles/apl-aide-logement-2026-simulation-conditions-montant.svg\\\",\\\"alt\\\":\\\"APL aide au logement 2026 simulation conditions et montant\\\",\\\"width\\\":800,\\\"height\\\":450,\\\"style\\\":{\\\"width\\\":\\\"100%\\\",\\\"height\\\":\\\"100%\\\",\\\"objectFit\\\":\\\"contain\\\",\\\"maxHeight\\\":\\\"450px\\\"},\\\"priority\\\":true}]}],\\\"$L10\\\",\\\"$L11\\\",\\\"$L12\\\",\\\"$L13\\\",false]}],\\\"$L14\\\",\\\"$L15\\\",\\\"$L16\\\",\\\"$L17\\\"]}]}],false,\\\"$L18\\\"]\\n\"])</script><script>self.__next_f.push([1,\"19:I[96788,[\\\"/_next/static/chunks/cf200c391baea40a.js\\\",\\\"/_next/static/chunks/6e48aeeec84550f8.js\\\"],\\\"default\\\"]\\n1a:I[1586,[\\\"/_next/static/chunks/cf200c391baea40a.js\\\",\\\"/_next/static/chunks/6e48aeeec84550f8.js\\\"],\\\"default\\\"]\\n1c:I[67277,[\\\"/_next/static/chunks/cf200c391baea40a.js\\\",\\\"/_next/static/chunks/6e48aeeec84550f8.js\\\"],\\\"default\\\"]\\n10:[\\\"$\\\",\\\"$L19\\\",null,{}]\\n11:[\\\"$\\\",\\\"$L1a\\\",null,{}]\\n1b:T12b0,\"])</script><script>self.__next_f.push([1,\"\\u003cp\\u003e\\n\\u003ch2\\u003eLes APL en deux mots\\u003c/h2\\u003e\\u003cp\\u003eLes APL (aide personnalisée au logement), c'est une aide de la CAF qui réduit le montant de ton loyer chaque mois. Tu es locataire, ton logement est conventionné, et tes revenus sont modestes : tu y as probablement droit.\\u003c/p\\u003e\\u003cp\\u003eC'est l'aide au logement la plus connue mais aussi celle qu'on demande le moins vite. Beaucoup de locataires attendent des mois avant de faire leur demande, alors que l'aide n'est pas rétroactive. Chaque mois sans APL, c'est de l'argent perdu.\\u003c/p\\u003e\\u003chr\\u003e\\u003ch2\\u003eQui peut en bénéficier\\u003c/h2\\u003e\\u003cp\\u003eLes conditions de base :\\u003c/p\\u003e\\u003cul\\u003e\\u003cli\\u003e\\u003cstrong\\u003eÊtre locataire\\u003c/strong\\u003e d'un logement conventionné (la grande majorité des logements le sont)\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eLe logement est ta résidence principale\\u003c/strong\\u003e\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eTes revenus sont modestes\\u003c/strong\\u003e par rapport à la composition de ton foyer\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eTu es de nationalité française ou en séjour régulier\\u003c/strong\\u003e\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\nQuelques cas qu'on oublie souvent :\\u003c/p\\u003e\\u003cul\\u003e\\u003cli\\u003e\\u003cstrong\\u003eLes étudiants\\u003c/strong\\u003e : même en logement étudiant ou en colocation, les APL sont accessibles. Beaucoup d'étudiants ne les demandent pas\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eLes personnes en couple\\u003c/strong\\u003e : les revenus du couple sont pris en compte, mais le plafond est plus élevé\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eLes colocataires\\u003c/strong\\u003e : chaque colocataire peut faire sa propre demande d'APL sur sa part de loyer\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eLes résidents en foyer\\u003c/strong\\u003e : foyer de jeunes travailleurs, résidence sociale, EHPAD\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\u003c/p\\u003e\\u003cp\\u003e\\u003cdiv id=\\\"ezoic-pub-ad-placeholder-203\\\" class=\\\"ad-container\\\" style=\\\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\\\"\\u003e\\u003c/div\\u003e\\u003ch2\\u003eCombien tu peux recevoir\\u003c/h2\\u003e\\u003cp\\u003eLe montant dépend de ton loyer, tes revenus, ta zone géographique et la composition de ton foyer :\\u003c/p\\u003e\\u003cdiv class=\\\"table-wrapper\\\"\\u003e\\u003ctable class=\\\"comparison-table\\\"\\u003e\\u003cthead\\u003e\\u003ctr\\u003e\\n\\u003cth\\u003eSituation\\u003c/th\\u003e\\u003cth\\u003eLoyer\\u003c/th\\u003e\\u003cth\\u003eAPL estimée\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\u003c/thead\\u003e\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eÉtudiant seul, Paris\\u003c/td\\u003e\\n\\u003ctd\\u003e600€\\u003c/td\\u003e\\n\\u003ctd\\u003e~150-250€/mois\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eÉtudiant seul, province\\u003c/td\\u003e\\n\\u003ctd\\u003e400€\\u003c/td\\u003e\\n\\u003ctd\\u003e~130-200€/mois\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003ePersonne seule au SMIC, ville moyenne\\u003c/td\\u003e\\n\\u003ctd\\u003e550€\\u003c/td\\u003e\\n\\u003ctd\\u003e~100-180€/mois\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eCouple avec 1 enfant, revenus modestes\\u003c/td\\u003e\\n\\u003ctd\\u003e700€\\u003c/td\\u003e\\n\\u003ctd\\u003e~200-350€/mois\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eParent isolé, 2 enfants\\u003c/td\\u003e\\n\\u003ctd\\u003e650€\\u003c/td\\u003e\\n\\u003ctd\\u003e~250-400€/mois\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\u003c/table\\u003e\\u003c/div\\u003e\\u003cp\\u003eEn zone tendue (Paris, Lyon, Marseille), les plafonds de loyer pris en compte sont plus élevés. Le montant exact dépend de beaucoup de paramètres, d'où l'intérêt de passer par le simulateur.\\u003c/p\\u003e\\u003chr\\u003e\\u003ch2\\u003eComment simuler et demander\\u003c/h2\\u003e\\u003cp\\u003eTout se fait sur caf.fr :\\u003c/p\\u003e\\u003cp\\u003e1. \\u003cstrong\\u003eSimulateur\\u003c/strong\\u003e : va sur caf.fr, rubrique \\\"Aides et démarches\\\", puis \\\"Simuler mes droits\\\". Renseigne ton loyer, tes revenus et ta situation familiale. Résultat en 5 minutes\\n2. \\u003cstrong\\u003eDemande en ligne\\u003c/strong\\u003e : si le simulateur confirme tes droits, fais ta demande directement depuis ton espace CAF. Tu auras besoin de ton bail, tes revenus et ton RIB\\n3. \\u003cstrong\\u003eDélai\\u003c/strong\\u003e : compte environ 1 à 2 mois pour le premier versement. L'aide est versée directement à ton propriétaire ou sur ton compte selon les cas\\u003c/p\\u003e\\u003chr\\u003e\\u003ch2\\u003eLes erreurs qui coûtent cher\\u003c/h2\\u003e\\u003cul\\u003e\\u003cli\\u003e\\u003cstrong\\u003eAttendre pour faire la demande\\u003c/strong\\u003e : les APL ne sont pas rétroactives. Si tu emménages en septembre et que tu demandes en décembre, tu perds 3 mois d'aide\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eOublier de déclarer un changement\\u003c/strong\\u003e : nouveau salaire, arrivée d'un enfant, déménagement, séparation. Tout changement doit être déclaré rapidement à la CAF pour ajuster le montant\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eNe pas savoir que les APL sont recalculées chaque année\\u003c/strong\\u003e : depuis 2021, les APL sont calculées sur tes revenus des 12 derniers mois (et non plus ceux d'il y a 2 ans). Si tes revenus baissent, ton APL augmente plus vite\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eCroire que les propriétaires refusent les locataires APL\\u003c/strong\\u003e : c'est illégal. Un propriétaire n'a pas le droit de refuser un locataire au motif qu'il touche les APL\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\u003c/p\\u003e\\u003cp\\u003e\\u003cdiv id=\\\"ezoic-pub-ad-placeholder-206\\\" class=\\\"ad-container\\\" style=\\\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\\\"\\u003e\\u003c/div\\u003e\\u003ch2\\u003eNotre avis\\u003c/h2\\u003e\\u003cp\\u003eSi tu es locataire et que tu n'as jamais simulé tes droits APL, fais-le aujourd'hui. La simulation est gratuite, anonyme et prend 5 minutes sur caf.fr. On voit régulièrement des gens qui découvrent qu'ils avaient droit à 150 ou 200€ par mois sans jamais avoir fait la demande. Surtout les étudiants en début d'année et les personnes qui viennent d'emménager. C'est de l'argent en moins sur ton loyer chaque mois, il n'y a vraiment aucune raison de ne pas vérifier.\\n\\u003c/p\\u003e\"])</script><script>self.__next_f.push([1,\"12:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"article-content\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"$1b\\\"}}]}]\\n13:[\\\"$\\\",\\\"$L19\\\",null,{}]\\n14:[\\\"$\\\",\\\"$L19\\\",null,{}]\\n\"])</script><script>self.__next_f.push([1,\"15:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"related-articles\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"children\\\":\\\"A lire aussi\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"articles-grid\\\",\\\"style\\\":{\\\"gridTemplateColumns\\\":\\\"repeat(auto-fit, minmax(280px, 1fr))\\\"},\\\"children\\\":[[\\\"$\\\",\\\"a\\\",\\\"allocation-rentree-scolaire-2026-montant-date-conditions\\\",{\\\"href\\\":\\\"/article/allocation-rentree-scolaire-2026-montant-date-conditions\\\",\\\"className\\\":\\\"card\\\",\\\"style\\\":{\\\"textDecoration\\\":\\\"none\\\"},\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"position\\\":\\\"relative\\\",\\\"height\\\":\\\"160px\\\",\\\"overflow\\\":\\\"hidden\\\"},\\\"children\\\":[\\\"$\\\",\\\"$Lf\\\",null,{\\\"src\\\":\\\"/images/articles/allocation-rentree-scolaire-2026-montant-date-conditions.svg\\\",\\\"alt\\\":\\\"Allocation de rentrée scolaire 2026 montant date et conditions\\\",\\\"fill\\\":true,\\\"style\\\":{\\\"objectFit\\\":\\\"cover\\\"},\\\"sizes\\\":\\\"33vw\\\"}]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"card-body\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"style\\\":{\\\"fontSize\\\":\\\"0.72rem\\\",\\\"fontWeight\\\":600,\\\"color\\\":\\\"var(--primary)\\\",\\\"textTransform\\\":\\\"uppercase\\\",\\\"letterSpacing\\\":\\\"0.5px\\\"},\\\"children\\\":[\\\"🏷️\\\",\\\" \\\",\\\"Bon Plan\\\"]}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"card-title\\\",\\\"children\\\":\\\"Allocation de rentrée scolaire 2026 : montant, date de versement et conditions\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"card-excerpt\\\",\\\"children\\\":\\\"L'allocation de rentrée scolaire aide à financer fournitures et vêtements. Montants par âge, conditions de revenus et date de versement en août 2026.\\\"}]]}]]}],[\\\"$\\\",\\\"a\\\",\\\"assurance-habitation-moins-chere-2026-comparateur-astuces\\\",