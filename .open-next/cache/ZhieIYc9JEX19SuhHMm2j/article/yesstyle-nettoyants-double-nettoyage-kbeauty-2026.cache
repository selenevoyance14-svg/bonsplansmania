0c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"Image\"]\n1f:I[96788,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\n20:I[1586,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\n22:I[67277,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\nf:[\"$\",\"path\",\"1q9fwt\",{\"d\":\"M15 3h6v6\"}]\n10:[\"$\",\"path\",\"gplh6r\",{\"d\":\"M10 14 21 3\"}]\n11:[\"$\",\"path\",\"a6xqqp\",{\"d\":\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"}]\n12:[\"$\",\"div\",null,{\"className\":\"article-hero-image\",\"style\":{\"background\":\"#fff\",\"borderRadius\":\"12px\",\"overflow\":\"hidden\",\"display\":\"flex\",\"justifyContent\":\"center\",\"alignItems\":\"center\",\"maxHeight\":\"450px\"},\"children\":[\"$\",\"$L1e\",null,{\"src\":\"/images/articles/yesstyle-nettoyants-double-nettoyage-kbeauty-2026.svg\",\"alt\":\"Nettoyants K-Beauty YesStyle double nettoyage coréen\",\"width\":800,\"height\":450,\"style\":{\"width\":\"100%\",\"height\":\"100%\",\"objectFit\":\"contain\",\"maxHeight\":\"450px\"},\"priority\":true}]}]\n13:[\"$\",\"$L1f\",null,{}]\n14:[\"$\",\"$L20\",null,{}]\n21:T185a,<p>\n<h2>Le double nettoyage : le secret n°1 de la K-Beauty</h2><p>Le <strong>double nettoyage</strong> (이중세안) est la base de toute routine coréenne. Le principe : un <strong>nettoyant huileux</strong> pour dissoudre le maquillage et la crème solaire, suivi d'un <strong>nettoyant aqueux</strong> pour éliminer les impuretés restantes.</p><p>C'est la raison pour laquelle les Coréennes ont une peau aussi nette. Et ça commence à <strong>8€ sur YesStyle</strong>.</p><p><div class=\"cta-inline\"><a href=\"https://ystyle.co/kqCm2\" class=\"btn btn-primary btn-sm\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Voir les nettoyants sur YesStyle <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/><polyline points=\"15 3 21 3 21 9\"/><line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\"/></svg></a></div><h2>Les 5 meilleurs nettoyants K-Beauty</h2><h3>1. SKIN1004 — Madagascar Centella Light Cleansing Oil (200ml)</h3><div class=\"table-wrapper\"><table class=\"comparison-table\"><thead><tr>\n<th><strong>Prix</strong></th><th><strong>~12€</strong></th>\n</tr></thead><tbody>\n<tr>\n<td><strong>Type</strong></td>\n<td>Huile démaquillante (1ère étape)</td>\n</tr>\n<tr>\n<td><strong>Actifs</strong></td>\n<td>Centella, huile de jojoba</td>\n</tr>\n<tr>\n<td><strong>Pour</strong></td>\n<td>Démaquillage + crème solaire</td>\n</tr>\n</tbody></table></div><p>L'huile démaquillante qui respecte la peau. Émulsionne au contact de l'eau et se rince parfaitement sans laisser de film gras. Le centella apaise pendant le nettoyage. Élimine même le waterproof.</p><p>→ <a href=\"https://ystyle.co/kqCm2\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Voir les nettoyants SKIN1004 sur YesStyle</a></p><h3>2. COSRX — Low pH Good Morning Gel Cleanser (150ml)</h3><div class=\"table-wrapper\"><table class=\"comparison-table\"><thead><tr>\n<th><strong>Prix</strong></th><th><strong>~10€</strong></th>\n</tr></thead><tbody>\n<tr>\n<td><strong>Type</strong></td>\n<td>Gel moussant (2ème étape)</td>\n</tr>\n<tr>\n<td><strong>Actifs</strong></td>\n<td>BHA doux, tea tree</td>\n</tr>\n<tr>\n<td><strong>pH</strong></td>\n<td>~5 (respecte la barrière cutanée)</td>\n</tr>\n</tbody></table></div><p>Le nettoyant matinal le plus populaire de toute la K-Beauty. Son pH bas (~5) ne perturbe pas l'équilibre de la peau. Le BHA doux nettoie les pores, le tea tree purifie. Mousse légère et fraîche.</p><h3>3. innisfree — Green Tea Amino Hydrating Cleansing Foam (150ml)</h3><div class=\"table-wrapper\"><table class=\"comparison-table\"><thead><tr>\n<th><strong>Prix</strong></th><th><strong>~10€</strong></th>\n</tr></thead><tbody>\n<tr>\n<td><strong>Type</strong></td>\n<td>Mousse nettoyante (2ème étape)</td>\n</tr>\n<tr>\n<td><strong>Actifs</strong></td>\n<td>Thé vert de Jeju, acides aminés</td>\n</tr>\n<tr>\n<td><strong>Pour</strong></td>\n<td>Peau normale à sèche</td>\n</tr>\n</tbody></table></div><p>La mousse ultra-douce d'innisfree. Les acides aminés nettoient sans dessécher, le thé vert de Jeju apporte des antioxydants. Texture crémeuse qui se transforme en mousse fine.</p><h3>4. Banila Co — Clean It Zero Cleansing Balm Original (100ml)</h3><div class=\"table-wrapper\"><table class=\"comparison-table\"><thead><tr>\n<th><strong>Prix</strong></th><th><strong>~15€</strong></th>\n</tr></thead><tbody>\n<tr>\n<td><strong>Type</strong></td>\n<td>Baume démaquillant (1ère étape)</td>\n</tr>\n<tr>\n<td><strong>Actifs</strong></td>\n<td>Vitamine C, huile de rose musquée</td>\n</tr>\n<tr>\n<td><strong>Pour</strong></td>\n<td>Démaquillage + éclat</td>\n</tr>\n</tbody></table></div><p>Le baume démaquillant qui a popularisé le double nettoyage dans le monde entier. Texture baume qui fond au contact de la peau et se transforme en huile. Efficace sur le maquillage le plus tenace. Best-seller mondial depuis 10 ans.</p><h3>5. THE FACE SHOP — Rice Water Bright Light Cleansing Foam (150ml)</h3><div class=\"table-wrapper\"><table class=\"comparison-table\"><thead><tr>\n<th><strong>Prix</strong></th><th><strong>~5€</strong></th>\n</tr></thead><tbody>\n<tr>\n<td><strong>Type</strong></td>\n<td>Mousse nettoyante (2ème étape)</td>\n</tr>\n<tr>\n<td><strong>Actifs</strong></td>\n<td>Eau de riz, céramides</td>\n</tr>\n<tr>\n<td><strong>Pour</strong></td>\n<td>Tous types de peau, petit budget</td>\n</tr>\n</tbody></table></div><p>Le nettoyant K-Beauty le plus accessible. L'eau de riz illumine le teint, les céramides protègent la barrière cutanée. À 5€, c'est l'entrée parfaite dans le double nettoyage coréen.</p><p><div id=\"ezoic-pub-ad-placeholder-203\" class=\"ad-container\" style=\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\"></div><h2>Le duo double nettoyage idéal</h2><div class=\"table-wrapper\"><table class=\"comparison-table\"><thead><tr>\n<th>Étape</th><th>Option budget</th><th>Option premium</th>\n</tr></thead><tbody>\n<tr>\n<td><strong>1. Huile</strong></td>\n<td>SKIN1004 Cleansing Oil (~12€)</td>\n<td>Banila Co Clean It Zero (~15€)</td>\n</tr>\n<tr>\n<td><strong>2. Mousse</strong></td>\n<td>THE FACE SHOP Rice Water (~5€)</td>\n<td>COSRX Low pH Cleanser (~10€)</td>\n</tr>\n<tr>\n<td><strong>Total</strong></td>\n<td><strong>~17€</strong></td>\n<td><strong>~25€</strong></td>\n</tr>\n</tbody></table></div><p><div class=\"cta-inline\"><a href=\"https://ystyle.co/kqCm2\" class=\"btn btn-primary btn-sm\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Voir les nettoyants sur YesStyle <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/><polyline points=\"15 3 21 3 21 9\"/><line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\"/></svg></a></div><h2>Pourquoi acheter sur YesStyle</h2><ul><li>✅ <strong>Nettoyants dès 5€</strong> — introuvables en France</li>\n<li>✅ <strong>Livraison gratuite</strong> dès 48€</li>\n<li>✅ <strong>Formules douces</strong> pH respectueux</li>\n<li>✅ <strong>Code promo WDAY26</strong> : -8% à -15% en plus</li>\n</ul>\n<hr>\n</p>15:[\"$\",\"div\",null,{\"className\":\"article-content\",\"children\":[\"$\",\"div\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"$21\"}}]}]\n16:[\"$\",\"$L1f\",null,{}]\n17:[\"$\",\"div\",null,{\"style\":{\"textAlign\":\"center\",\"margin\":\"40px 0\",\"padding\":\"32px\",\"background\":\"linear-gradient(135deg, #FFF0F0 0%, #FFF8F0 100%)\",\"borderRadius\":\"16px\",\"border