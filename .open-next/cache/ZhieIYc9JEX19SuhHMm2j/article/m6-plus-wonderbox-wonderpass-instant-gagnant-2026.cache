],\"Image\"]\n1d:I[96788,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\n1e:I[1586,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\n20:I[67277,[\"/_next/static/chunks/cf200c391baea40a.js\",\"/_next/static/chunks/6e48aeeec84550f8.js\"],\"default\"]\nf:[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":13,\"height\":13,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-external-link\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1q9fwt\",{\"d\":\"M15 3h6v6\"}],[\"$\",\"path\",\"gplh6r\",{\"d\":\"M10 14 21 3\"}],[\"$\",\"path\",\"a6xqqp\",{\"d\":\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"}],\"$undefined\"]}]\n10:[\"$\",\"div\",null,{\"className\":\"article-hero-image\",\"style\":{\"background\":\"#fff\",\"borderRadius\":\"12px\",\"overflow\":\"hidden\",\"display\":\"flex\",\"justifyContent\":\"center\",\"alignItems\":\"center\",\"maxHeight\":\"450px\"},\"children\":[\"$\",\"$L1c\",null,{\"src\":\"/images/articles/m6-plus-wonderbox-wonderpass-instant-gagnant-2026.svg\",\"alt\":\"M6+ instant gagnant Wonderpass Wonderbox 159€ 50 lots à gagner mars 2026\",\"width\":800,\"height\":450,\"style\":{\"width\":\"100%\",\"height\":\"100%\",\"objectFit\":\"contain\",\"maxHeight\":\"450px\"},\"priority\":true}]}]\n11:[\"$\",\"$L1d\",null,{}]\n12:[\"$\",\"$L1e\",null,{}]\n1f:Tc6e,<p>\n<h2>Urgent — Il reste moins de 11 jours pour participer !</h2><p><strong>M6+</strong>, la plateforme streaming du groupe M6, offre <strong>50 Wonderpass Wonderbox d'une valeur de 159€ chacun</strong> via un jeu instant gagnant 100% gratuit. La valeur totale des lots dépasse <strong>7 950€</strong> !</p><p>> <strong>Fin du jeu : 15 mars 2026</strong> — ne tardez pas !</p><hr><p><div class=\"cta-inline\"><a href=\"https://www.m6.fr/\" class=\"btn btn-primary btn-sm\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Jouer au jeu M6+ maintenant <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/><polyline points=\"15 3 21 3 21 9\"/><line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\"/></svg></a></div><h2>Le lot à gagner</h2><h3>Wonderpass Wonderbox — 159€ chacun (50 lots)</h3><p>Un <strong>Wonderpass Wonderbox</strong> est une carte cadeau expérience permettant de choisir parmi des centaines d'activités dans toute la France :\n<ul><li><strong>Voyages et séjours</strong> : week-ends romantiques, hôtels spa, escapades</li>\n<li><strong>Gastronomie</strong> : dîners étoilés, cours de cuisine, dégustations</li>\n<li><strong>Aventure & sport</strong> : saut en parachute, karting, escalade</li>\n<li><strong>Bien-être</strong> : soins en spa, massages, thalasso</li>\n</ul>\nValeur unitaire : <strong>159€</strong> par Wonderpass.</p><hr><p><div id=\"ezoic-pub-ad-placeholder-203\" class=\"ad-container\" style=\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\"></div><h2>Comment participer</h2><p>1. <strong>Rendez-vous</strong> sur la plateforme M6+\n2. <strong>Laissez vos coordonnées</strong> (nom, email)\n3. <strong>Jouez</strong> à l'instant gagnant et découvrez immédiatement votre résultat\n4. Si vous gagnez, vous serez contacté pour recevoir votre Wonderpass</p><p>> Participation gratuite, une seule tentative autorisée.</p><hr><p><div class=\"cta-inline\"><a href=\"https://www.m6.fr/\" class=\"btn btn-primary btn-sm\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Jouer au jeu M6+ maintenant <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/><polyline points=\"15 3 21 3 21 9\"/><line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\"/></svg></a></div><h2>Pourquoi ne pas rater ce jeu</h2><ul><li><strong>50 lots</strong> distribués — de bonnes chances de gagner</li>\n<li><strong>Wonderpass de 159€</strong> : une vraie valeur pour s'offrir une belle expérience</li>\n<li><strong>Résultat immédiat</strong> : on sait tout de suite si on a gagné</li>\n<li><strong>Fin le 15 mars 2026</strong> : ne pas attendre !</li>\n</ul>\n<hr></p><h2>Notre verdict</h2><p><strong>Note : 5/5</strong> — Un excellent instant gagnant avec de beaux lots à forte valeur. Les Wonderbox sont des cadeaux très appréciés. Participez maintenant, il ne reste que quelques jours !\n</p>13:[\"$\",\"div\",null,{\"className\":\"article-content\",\"children\":[\"$\",\"div\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"$1f\"}}]}]\n14:[\"$\",\"$L1d\",null,{}]\n15:[\"$\",\"div\",null,{\"style\":{\"textAlign\":\"center\",\"margin\":\"40px 0\",\"padding\":\"32px\",\"background\":\"linear-gradient(135deg, #FFF0F0 0%, #FFF8F0 100%)\",\"borderRadius\":\"16px\",\"border\":\"2px solid #FECDD3\"},\"children\":[[\"$\",\"p\",null,{\"style\":{\"fontWeight\":800,\"fontSize\":\"1.2rem\",\"marginBottom\":\"16px\",\"color\":\"var(--foreground)\"},\"children\":\"Profiter de cette offre\"}],[\"$\",\"a\",null,{\"href\":\"https://www.m6.fr/\",\"className\":\"btn btn-primary\",\"target\":\"_blank\",\"rel\":\"nofollow sponsored noopener\",\"style\":{\"padding\":\"14px 32px\",\"fontSize\":\"1rem\"},\"children\":[\"Jouer au jeu M6+ maintenant\",\" \",[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":15,\"height\":15,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-external-link\",\"ari