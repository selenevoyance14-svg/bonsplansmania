ntWeight\":500},\"children\":\"hydratation\"}]\n28:[\"$\",\"a\",\"australie\",{\"href\":\"/marque/australie\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"australie\"}]\n29:[\"$\",\"a\",\"skincare\",{\"href\":\"/marque/skincare\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"skincare\"}]\na:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n2a:I[27201,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/d2be314c3ece3fbe.js\"],\"IconMark\"]\n8:null\nc:[[\"$\",\"title\",\"0\",{\"children\":\"Lanolips 101 Ointment : notre avis baume multi-usage\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Notre test du 101 Ointment de Lanolips. Baume a la lanoline multi-usage pour levres, visage, corps et cheveux. Le best-seller australien qui fait tout.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"manifest\",\"href\":\"/manifest.json\",\"crossOrigin\":\"$undefined\"}],[\"$\",\"meta\",\"3\",{\"name\":\"keywords\",\"content\":\"bons plans beauté,tests produits gratuits,concours beauté,box beauté,réductions cosmétiques,codes promo beauté,échantillons gratuits\"}],[\"$\",\"link\",\"4\",{\"rel\":\"canonical\",\"href\":\"https://bonsplansmania.fr/article/lanolips-101-ointment-baume-multi-usage-avis-2026\"}],[\"$\",\"meta\",\"5\",{\"property\":\"og:title\",\"content\":\"Lanolips 101 Ointment : on a teste le baume australien multi-usage qui a conquis le monde\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:description\",\"content\":\"Notre avis sur le 101 Ointment de Lanolips. Baume a la lanoline multi-usage : levr