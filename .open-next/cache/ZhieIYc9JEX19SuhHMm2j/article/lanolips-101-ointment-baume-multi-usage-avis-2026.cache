,{\\\"style\\\":{\\\"maxWidth\\\":\\\"780px\\\",\\\"margin\\\":\\\"0 auto\\\"},\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"display\\\":\\\"flex\\\",\\\"alignItems\\\":\\\"center\\\",\\\"gap\\\":\\\"12px\\\",\\\"flexWrap\\\":\\\"wrap\\\",\\\"margin\\\":\\\"32px 0 16px\\\"},\\\"children\\\":[[\\\"$\\\",\\\"$L20\\\",null,{\\\"slug\\\":\\\"lanolips-101-ointment-baume-multi-usage-avis-2026\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"style\\\":{\\\"fontSize\\\":\\\"0.85rem\\\",\\\"color\\\":\\\"var(--text-muted, #6b7280)\\\"},\\\"children\\\":\\\"Partager :\\\"}],[[\\\"$\\\",\\\"a\\\",\\\"WhatsApp\\\",{\\\"href\\\":\\\"https://wa.me/?text=Lanolips%20101%20Ointment%20%3A%20on%20a%20teste%20le%20baume%20australien%20multi-usage%20qui%20a%20conquis%20le%20monde%20-%20https%3A%2F%2Fbonsplansmania.fr%2Farticle%2Flanolips-101-ointment-baume-multi-usage-avis-2026\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noopener noreferrer\\\",\\\"style\\\":{\\\"padding\\\":\\\"6px 14px\\\",\\\"borderRadius\\\":\\\"999px\\\",\\\"background\\\":\\\"#25d366\\\",\\\"color\\\":\\\"white\\\",\\\"fontSize\\\":\\\"0.82rem\\\",\\\"fontWeight\\\":600,\\\"textDecoration\\\":\\\"none\\\"},\\\"children\\\":\\\"WhatsApp\\\"}],[\\\"$\\\",\\\"a\\\",\\\"Facebook\\\",{\\\"href\\\":\\\"https://www.facebook.com/sharer/sharer.php?u=https%3A%2F%2Fbonsplansmania.fr%2Farticle%2Flanolips-101-ointment-baume-multi-usage-avis-2026\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noopener noreferrer\\\",\\\"style\\\":{\\\"padding\\\":\\\"6px 14px\\\",\\\"borderRadius\\\":\\\"999px\\\",\\\"background\\\":\\\"#1877f2\\\",\\\"color\\\":\\\"white\\\",\\\"fontSize\\\":\\\"0.82rem\\\",\\\"fontWeight\\\":600,\\\"textDecoration\\\":\\\"none\\\"},\\\"children\\\":\\\"Facebook\\\"}],[\\\"$\\\",\\\"a\\\",\\\"Pinterest\\\",{\\\"href\\\":\\\"https://pinterest.com/pin/create/button/?url=https%3A%2F%2Fbonsplansmania.fr%2Farticle%2Flanolips-101-ointment-baume-multi-usage-avis-2026\\u0026description=Lanolips%201