\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":13,\\\"height\\\":13,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-external-link\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":[[\\\"$\\\",\\\"path\\\",\\\"1q9fwt\\\",{\\\"d\\\":\\\"M15 3h6v6\\\"}],[\\\"$\\\",\\\"path\\\",\\\"gplh6r\\\",{\\\"d\\\":\\\"M10 14 21 3\\\"}],[\\\"$\\\",\\\"path\\\",\\\"a6xqqp\\\",{\\\"d\\\":\\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\\"}],\\\"$undefined\\\"]}]]}]\\n10:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"article-hero-image\\\",\\\"style\\\":{\\\"background\\\":\\\"#fff\\\",\\\"borderRadius\\\":\\\"12px\\\",\\\"overflow\\\":\\\"hidden\\\",\\\"display\\\":\\\"flex\\\",\\\"justifyContent\\\":\\\"center\\\",\\\"alignItems\\\":\\\"center\\\",\\\"maxHeight\\\":\\\"450px\\\"},\\\"children\\\":[\\\"$\\\",\\\"$L1c\\\",null,{\\\"src\\\":\\\"/images/articles/garancia-magic-club-ambassadeur-test-produit-beaute.svg\\\",\\\"alt\\\":\\\"Garancia Magic Club ambassadeur test produit soins botaniques gratuits\\\",\\\"width\\\":800,\\\"height\\\":450,\\\"style\\\":{\\\"width\\\":\\\"100%\\\",\\\"height\\\":\\\"100%\\\",\\\"objectFit\\\":\\\"contain\\\",\\\"maxHeight\\\":\\\"450px\\\"},\\\"priority\\\":true}]}]\\n11:[\\\"$\\\",\\\"$L1d\\\",null,{}]\\n12:[\\\"$\\\",\\\"$L1e\\\",null,{}]\\n1f:T1abc,\"])</script><script>self.__next_f.push([1,\"\\u003cp\\u003e\\n\\u003ch2\\u003eGarancia — L'alchimie botanique du futur\\u003c/h2\\u003e\\u003cp\\u003e\\u003cstrong\\u003eGarancia\\u003c/strong\\u003e est un laboratoire français qui cultive une philosophie unique dans l'univers de la beauté : \\u003cstrong\\u003el'alchimie botanique du futur\\u003c/strong\\u003e. Des formules à 98 % d'ingrédients d'origine naturelle, des noms poétiques évocateurs d'un univers mystérieux, et une efficacité prouvée reconnue chez Sephora et en pharmacie.\\u003c/p\\u003e\\u003cp\\u003eLe \\u003cstrong\\u003ePschitt Magique\\u003c/strong\\u003e, né en 2004, est devenu l'un des best-sellers de la marque — un micro-peeling pétillant qui transforme le grain de peau en quelques semaines. La \\u003cstrong\\u003eDiabolique Tomate\\u003c/strong\\u003e, le \\u003cstrong\\u003eSérum Babyskin\\u003c/strong\\u003e, les soins solaires... Autant de produits que vous pouvez découvrir gratuitement grâce au \\u003cstrong\\u003eGarancia Magic Club\\u003c/strong\\u003e.\\u003c/p\\u003e\\u003chr\\u003e\\u003cp\\u003e\\u003cdiv class=\\\"cta-inline\\\"\\u003e\\u003ca href=\\\"https://garancia-ambassadeur.snkt.io/\\\" class=\\\"btn btn-primary btn-sm\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eRejoindre le Garancia Magic Club \\u003csvg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"13\\\" height=\\\"13\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"\\u003e\\u003cpath d=\\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\\"/\\u003e\\u003cpolyline points=\\\"15 3 21 3 21 9\\\"/\\u003e\\u003cline x1=\\\"10\\\" y1=\\\"14\\\" x2=\\\"21\\\" y2=\\\"3\\\"/\\u003e\\u003c/svg\\u003e\\u003c/a\\u003e\\u003c/div\\u003e\\u003ch2\\u003eLe Magic Club — Le programme ambassadeur Garancia\\u003c/h2\\u003e\\u003cp\\u003eLe \\u003cstrong\\u003eGarancia Magic Club\\u003c/strong\\u003e est la plateforme officielle de la marque pour sélectionner des ambassadeurs testeurs. L'objectif : combiner botanique et science en recueillant des retours authentiques de vrais consommateurs, pour améliorer les formules et aider les futurs acheteurs à choisir.\\u003c/p\\u003e\\u003chr\\u003e\\u003cp\\u003e\\u003cdiv id=\\\"ezoic-pub-ad-placeholder-203\\\" class=\\\"ad-container\\\" style=\\\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\\\"\\u003e\\u003c/div\\u003e\\u003ch2\\u003eCe que vous pouvez tester\\u003c/h2\\u003e\\u003cp\\u003eLes campagnes du Magic Club portent sur toute la gamme Garancia :\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003e✨ Soins visage iconiques\\u003c/strong\\u003e\\n\\u003cul\\u003e\\u003cli\\u003e\\u003cem\\u003ePschitt Magique\\u003c/em\\u003e — le micro-peeling pétillant qui affine le grain de peau et unifie le teint\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cem\\u003eDiabolique Tomate\\u003c/em\\u003e — soin hydratant léger à la tomate pour un éclat immédiat\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cem\\u003eSérum Babyskin\\u003c/em\\u003e — soin concentré pour une peau lisse et rebondie\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003cstrong\\u003e☀️ Protection solaire SPF50+\\u003c/strong\\u003e\\n\\u003cul\\u003e\\u003cli\\u003e\\u003cem\\u003eFluide Incroyable Douceur Invisible Sun Protect SPF50+\\u003c/em\\u003e\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cem\\u003eDuo solaire SPF50+\\u003c/em\\u003e (fluide + lait solaire)\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cem\\u003eStick Solaire Invisible SPF50\\u003c/em\\u003e\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003cstrong\\u003e💆 Soins corps\\u003c/strong\\u003e\\n\\u003cul\\u003e\\u003cli\\u003e\\u003cem\\u003eFormule Ensorcelante\\u003c/em\\u003e — crème corps hydratation 24h pour les peaux sèches\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\u003c/p\\u003e\\u003cp\\u003e\\u003cdiv class=\\\"cta-inline\\\"\\u003e\\u003ca href=\\\"https://garancia-ambassadeur.snkt.io/\\\" class=\\\"btn btn-primary btn-sm\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003eRejoindre le Garancia Magic Club \\u003csvg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"13\\\" height=\\\"13\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"\\u003e\\u003cpath d=\\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\\"/\\u003e\\u003cpolyline points=\\\"15 3 21 3 21 9\\\"/\\u003e\\u003cline x1=\\\"10\\\" y1=\\\"14\\\" x2=\\\"21\\\" y2=\\\"3\\\"/\\u003e\\u003c/svg\\u003e\\u003c/a\\u003e\\u003c/div\\u003e\\u003ch2\\u003eComment rejoindre le Magic Club ?\\u003c/h2\\u003e\\u003ch3\\u003eÉtape 1 : Inscrivez-vous sur la plateforme\\u003c/h3\\u003e\\u003cp\\u003eRendez-vous sur \\u003ca href=\\\"https://garancia-ambassadeur.snkt.io/\\\" target=\\\"_blank\\\" rel=\\\"nofollow sponsored noopener\\\"\\u003egarancia-ambassadeur.snkt.io\\u003c/a\\u003e et créez votre compte ambassadeur Garancia. L'inscription est gratuite.\\u003c/p\\u003e\\u003ch3\\u003eÉtape 2 : Candidatez aux campagnes disponibles\\u003c/h3\\u003e\\u003cp\\u003eParcourez les tests en cours et candidatez à ceux qui correspondent à votre type de peau et vos besoins. Chaque campagne précise le produit à tester et le profil recherché.\\u003c/p\\u003e\\u003ch3\\u003eÉtape 3 : Soyez sélectionné(e)\\u003c/h3\\u003e\\u003cp\\u003eL'équipe Garancia sélectionne les profils les plus pertinents pour chaque produit — en tenant compte de votre type de peau, de vos habitudes de soin et de votre motivation.\\u003c/p\\u003e\\u003ch3\\u003eÉtape 4 : Recevez votre produit\\u003c/h3\\u003e\\u003cp\\u003eSi vous êtes retenu(e), le produit Garancia est envoyé \\u003cstrong\\u003egratuitement\\u003c/strong\\u003e à votre domicile, en format complet — pour un test en conditions réelles.\\u003c/p\\u003e\\u003ch3\\u003eÉtape 5 : Partagez votre avis\\u003c/h3\\u003e\\u003cp\\u003eAprès le test, vous partagez votre retour sincère sur la plateforme. Votre avis aide la marque à améliorer ses formules et guide les futurs consommateurs.\\u003c/p\\u003e\\u003chr\\u003e\\u003ch2\\u003ePourquoi tester des produits Garancia ?\\u003c/h2\\u003e\\u003cp\\u003e\\u003cstrong\\u003eUne marque Sephora accessible via un test\\u003c/strong\\u003e\\nGarancia est vendue chez Sephora et en pharmacie — avec des prix compris entre 20 et 50 €. Le Magic Club vous permet de découvrir ces soins premium sans dépenser un centime.\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003e98 % d'ingrédients naturels\\u003c/strong\\u003e\\nPour celles et ceux qui sont attentifs à la composition de leurs soins, Garancia coche toutes les cases : formules botaniques, sans ingrédients controversés, efficacité prouvée.\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003eDes produits vraiment cultes\\u003c/strong\\u003e\\nLe Pschitt Magique compte des milliers d'adeptes depuis 20 ans. Pouvoir le tester avant d'investir, c'est un luxe rare.\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003eUn univers de marque unique\\u003c/strong\\u003e\\nGarancia a construit un univers poétique et mystérieux avec des noms comme \\u003cem\\u003eLarmes de Fantômes\\u003c/em\\u003e, \\u003cem\\u003ePâte du Marabout\\u003c/em\\u003e ou \\u003cem\\u003eBal Masqué des Sorciers\\u003c/em\\u003e. Rejoindre le Magic Club, c'est entrer dans cet univers en avant-première.\\u003c/p\\u003e\\u003chr\\u003e\\u003cp\\u003e\\u003cdiv id=\\\"ezoic-pub-ad-placeholder-206\\\" class=\\\"ad-container\\\" style=\\\"text-align:center;margin:24px 0;min-height:90px;overflow:hidden\\\"\\u003e\\u003c/div\\u003e\\u003ch2\\u003ePour qui est ce programme ?\\u003c/h2\\u003e\\u003cp\\u003eCe programme convient si vous :\\n\\u003cul\\u003e\\u003cli\\u003eAimez les \\u003cstrong\\u003esoins naturels et botaniques\\u003c/strong\\u003e\\u003c/li\\u003e\\n\\u003cli\\u003eAvez une peau à \\u003cstrong\\u003echouchouter\\u003c/strong\\u003e (sèche, terne, sensible, à imperfections)\\u003c/li\\u003e\\n\\u003cli\\u003eÊtes curieux(se) de découvrir les \\u003cstrong\\u003eiconiques Garancia\\u003c/strong\\u003e\\u003c/li\\u003e\\n\\u003cli\\u003eÊtes prêt(e) à tester sérieusement et à partager un avis détaillé\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\u003c/p\\u003e\\u003ch2\\u003eEn résumé\\u003c/h2\\u003e\\u003cdiv class=\\\"table-wrapper\\\"\\u003e\\u003ctable class=\\\"comparison-table\\\"\\u003e\\u003cthead\\u003e\\u003ctr\\u003e\\n\\u003cth\\u003e\\u003c/th\\u003e\\u003cth\\u003eDétails\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\u003c/thead\\u003e\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003eMarque\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eGarancia — laboratoire français botanique\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003eUnivers\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eSoins visage · Corps · Solaires\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003eProduits stars\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003ePschitt Magique · Diabolique Tomate · Solaires SPF50+\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003eFormat reçu\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eProduit complet\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003eCoût\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eGratuit\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003eContrepartie\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eAvis sincère\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003eSélection\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003ePar profil peau + motivation\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003ePlateforme\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003egarancia-ambassadeur.snkt.io\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\u003c/table\\u003e\\u003c/div\\u003e\\n\\u003c/p\\u003e\"])</script><script>self.__next_f.push([1,\"13:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"article-content\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"$1f\\\"}}]}]\\