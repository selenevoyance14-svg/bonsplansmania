9 avis.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"manifest\",\"href\":\"/manifest.json\",\"crossOrigin\":\"$undefined\"}],[\"$\",\"meta\",\"3\",{\"name\":\"keywords\",\"content\":\"bons plans beauté,tests produits gratuits,concours beauté,box beauté,réductions cosmétiques,codes promo beauté,échantillons gratuits\"}],[\"$\",\"link\",\"4\",{\"rel\":\"canonical\",\"href\":\"https://bonsplansmania.fr/article/bon-plan-taktark-babyphone-camera-720p-vision-nocturne-promo-amazon-2026\"}],[\"$\",\"meta\",\"5\",{\"property\":\"og:title\",\"content\":\"TakTark Babyphone Caméra 2,8 pouces a -51% sur Amazon : le vidéo-babyphone à 34 euros\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:description\",\"content\":\"Bon plan babyphone TakTark avec caméra 2,8 pouces 720p à 34,28 euros au lieu de 69,99 euros sur Amazon. Vision nocturne, VOX, zoom 3x, sans WiFi, Choix Amazon.\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:image\",\"content\":\"http://localhost:3000/images/articles/bon-plan-taktark-babyphone-camera-720p-vision-nocturne-promo-amazon-2026.svg\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:type\",\"content\":\"article\"}],[\"$\",\"meta\",\"9\",{\"property\":\"article:published_time\",\"content\":\"2026-03-30\"}],[\"$\",\"meta\",\"10\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"11\",{\"name\":\"twitter:title\",\"content\":\"Bons Plans Mania — Bons plans beauté & tests gratuits\"}],[\"$\",\"meta\",\"12\",{\"name\":\"twitter:description\",\"content\":\"Les meilleurs bons plans beauté, tests gratuits, concours et avis box beauté.\"}],[\"$\",\"meta\",\"13\",{\"name\":\"twitter:image\",\"content\":\"http://localhost:3000/images/articles/bon-plan-taktark-babyphone-camera-720p-vision-nocturne-promo-amazon-2026.svg\"}],[\"$\",\"link\",\"14\",{\"rel\":\"icon\",\"href\":\"/favicon.svg\",\"type\":\"image/svg+xml\"}],[\"$\",\"link\",\"15\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"sizes\":\"32x32\"}],[\"$\",\"link\",\"16\",{\"rel\":\"apple-touch-icon\",