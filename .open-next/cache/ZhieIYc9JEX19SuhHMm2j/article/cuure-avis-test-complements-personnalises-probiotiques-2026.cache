"children\":\"bien-être\"}]\n29:[\"$\",\"a\",\"made in france\",{\"href\":\"/marque/made-in-france\",\"style\":{\"padding\":\"4px 12px\",\"borderRadius\":\"999px\",\"background\":\"var(--muted, #f3f4f6)\",\"fontSize\":\"0.78rem\",\"color\":\"var(--text, #374151)\",\"textDecoration\":\"none\",\"fontWeight\":500},\"children\":\"made in france\"}]\na:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n2a:I[27201,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/d2be314c3ece3fbe.js\"],\"IconMark\"]\n8:null\nc:[[\"$\",\"title\",\"0\",{\"children\":\"Cuure avis test compléments probiotiques 2026\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"On a testé Cuure et son probiotique FS-3B : 25 souches, 50 milliards UFC, tri-biotique. -68% ballonnements prouvé en étude clinique. Notre verdict.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"manifest\",\"href\":\"/manifest.json\",\"crossOrigin\":\"$undefined\"}],[\"$\",\"meta\",\"3\",{\"name\":\"keywords\",\"content\":\"bons plans beauté,tests produits gratuits,concours beauté,box beauté,réductions cosmétiques,codes promo beauté,échantillons gratuits\"}],[\"$\",\"link\",\"4\",{\"rel\":\"canonical\",\"href\":\"https://bonsplansmania.fr/article/cuure-avis-test-complements-personnalises-probiotiques-2026\"}],[\"$\",\"meta\",\"5\",{\"property\":\"og:title\",\"content\":\"Cuure : On a Testé les Compléments Personnalisés et le Probiotique FS-3B (Notre Avis)\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:description\",\"content\":\"Notre avis sur Cuure : diagnostic personnalisé et probiotique FS-3B tri-biotique. 25 souches, 50 milliards UFC, -68% ballonnements. 4,5/5 Trustpilot.\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:image\",\"content\":\"http://localhost:3000/images/articles/cuure-avis-test-complements-personnalises-probiotiques-2026.svg\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:type\",\"content\":\"article