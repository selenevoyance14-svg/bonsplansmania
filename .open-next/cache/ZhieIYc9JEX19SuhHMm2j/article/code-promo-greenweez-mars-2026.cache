pt><script>self.__next_f.push([1,\"e:I[83608,[\\\"/_next/static/chunks/cf200c391baea40a.js\\\",\\\"/_next/static/chunks/6e48aeeec84550f8.js\\\"],\\\"default\\\"]\\n\"])</script><script>self.__next_f.push([1,\"5:[[\\\"$\\\",\\\"script\\\",null,{\\\"type\\\":\\\"application/ld+json\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"{\\\\\\\"@context\\\\\\\":\\\\\\\"https://schema.org\\\\\\\",\\\\\\\"@type\\\\\\\":\\\\\\\"Article\\\\\\\",\\\\\\\"headline\\\\\\\":\\\\\\\"Code Promo Greenweez Mars 2026 : 15% + Livraison Gratuite + 12 Offres Actives\\\\\\\",\\\\\\\"description\\\\\\\":\\\\\\\"Tous les codes promo Greenweez mars 2026 : 15% reduction, 10% + livraison gratuite, -5€ des 49€, -10€ des 79€. 12 offres actives verifiees.\\\\\\\",\\\\\\\"datePublished\\\\\\\":\\\\\\\"2026-03-17\\\\\\\",\\\\\\\"dateModified\\\\\\\":\\\\\\\"2026-03-17\\\\\\\",\\\\\\\"image\\\\\\\":\\\\\\\"https://bonsplansmania.fr/images/articles/code-promo-greenweez-mars-2026.svg\\\\\\\",\\\\\\\"mainEntityOfPage\\\\\\\":{\\\\\\\"@type\\\\\\\":\\\\\\\"WebPage\\\\\\\",\\\\\\\"@id\\\\\\\":\\\\\\\"https://bonsplansmania.fr/article/code-promo-greenweez-mars-2026\\\\\\\"},\\\\\\\"author\\\\\\\":{\\\\\\\"@type\\\\\\\":\\\\\\\"Organization\\\\\\\",\\\\\\\"name\\\\\\\":\\\\\\\"Bons Plans Mania\\\\\\\",\\\\\\\"url\\\\\\\":\\\\\\\"https://bonsplansmania.fr\\\\\\\"},\\\\\\\"publisher\\\\\\\":{\\\\\\\"@type\\\\\\\":\\\\\\\"Organization\\\\\\\",\\\\\\\"name\\\\\\\":\\\\\\\"Bons Plans Mania\\\\\\\",\\\\\\\"url\\\\\\\":\\\\\\\"https://bonsplansmania.fr\\\\\\\",\\\\\\\"logo\\\\\\\":{\\\\\\\"@type\\\\\\\":\\\\\\\"ImageObject\\\\\\\",\\\\\\\"url\\\\\\\":\\\\\\\"https://bonsplansmania.fr/icon.svg\\\\\\\"}}}\\\"}}],null,[\\\"$\\\",\\\"script\\\",null,{\\\"type\\\":\\\"application/ld+json\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"{\\\\\\\"@context\\\\\\\":\\\\\\\"https://schema.org\\\\\\\",\\\\\\\"@type\\\\\\\":\\\\\\\"BreadcrumbList\\\\\\\",\\\\\\\"itemListElement\\\\\\\":[{\\\\\\\"@type\\\\\\\":\\\\