,{\"className\":\"card-excerpt\",\"children\":\"Notre avis sur le serum Hydra-AOX de Filorga. Vitamine C, acide hyaluronique, complexe NCTF : un soin anti-age inspire de la medecine esthetique. On te dit tout.\"}]]}]]}],[\"$\",\"a\",\"test-routine-beaute-printemps-guide-complet-produits-2026\",{\"href\":\"/article/test-routine-beaute-printemps-guide-complet-produits-2026\",\"className\":\"card\",\"style\":{\"textDecoration\":\"none\"},\"children\":[[\"$\",\"div\",null,{\"style\":{\"position\":\"relative\",\"height\":\"160px\",\"overflow\":\"hidden\"},\"children\":[\"$\",\"$L1e\",null,{\"src\":\"/images/articles/test-routine-beaute-printemps-guide-complet-produits-2026.svg\",\"alt\":\"Routine beaute printemps guide complet soin visage 2026\",\"fill\":true,\"style\":{\"objectFit\":\"cover\"},\"sizes\":\"33vw\"}]}],[\"$\",\"div\",null,{\"className\":\"card-body\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"fontSize\":\"0.72rem\",\"fontWeight\":600,\"color\":\"var(--primary)\",\"textTransform\":\"uppercase\",\"letterSpacing\":\"0.5px\"},\"children\":[\"🎁\",\" \",\"Test Gratuit\"]}],[\"$\",\"h3\",null,{\"className\":\"card-title\",\"children\":\"Routine Beaute de Printemps : le Guide Complet pour Preparer sa Peau a la Belle Saison\"}],[\"$\",\"p\",null,{\"className\":\"card-excerpt\",\"children\":\"Notre guide complet pour adapter sa routine beaute au printemps. Nettoyage, exfoliation, serum, hydratation, SPF — chaque etape expliquee avec nos produits preferes.\"}]]}]]}]]}]]}]\n1a:[\"$\",\"nav\",null,{\"style\":{\"margin\":\"40px 0\",\"padding\":\"24px\",\"background\":\"var(--muted, #f3f4f6)\",\"borderRadius\":\"16px\"},\"children\":[[\"$\",\"h3\",null,{\"style\":{\"fontSize\":\"1rem\",\"marginBottom\":\"12px\"},\"children\":\"Explorer par catégorie\"}],[\"$\",\"div\",null,{\"style\":{\"display\":\"flex\",\"flexWrap\":\"wrap\",\"gap\":\"8px\"},\"children\":[[\"$\",\"a\",\"bon-plan\",{\"href\":\"/categorie/bon-plan\",\"style\":{\"padding\":\"6px 14px\",\"borderRadiu