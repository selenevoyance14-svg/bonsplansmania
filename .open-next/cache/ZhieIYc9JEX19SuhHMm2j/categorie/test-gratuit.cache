addingBottom\":\"0\"},\"children\":[\"$\",\"$L17\",null,{}]}]\n15:[\"$\",\"section\",null,{\"className\":\"section\",\"children\":[\"$\",\"div\",null,{\"className\":\"container\",\"children\":[\"$\",\"$L18\",null,{\"articles\":[{\"slug\":\"algologie-solaires-serum-lait-gelee-spf50-test-gratuit-2026\",\"title\":\"Algologie : testez gratuitement les 3 nouveaux solaires SPF50/50+ (sérum, lait, gelée)\",\"description\":\"Test produit gratuit Algologie : candidatez pour tester le Sérum Illuminateur SPF50, le Lait Haute Protection SPF50 et la Gelée Bronze & Glow SPF50+. Jusqu'au 14 mai.\",\"date\":\"2026-04-18\",\"image\":\"/images/articles/algologie-solaires-test-gratuit-2026.png\",\"imageAlt\":\"Algologie produits solaires sérum lait gelée SPF50 test gratuit\",\"category\":\"test-gratuit\",\"categoryLabel\":\"Test Gratuit\",\"categoryColor\":\"test-gratuit\",\"readingTime\":\"3 min\",\"expired\":false},{\"slug\":\"cerave-patchs-bouton-anti-imperfections-test-gratuit-2026\",\"title\":\"CeraVe : 18 patchs bouton anti-imperfections à tester gratuitement\",\"description\":\"Test produit gratuit CeraVe : 18 patchs hydrocolloïdes anti-imperfections enrichis en niacinamide et 3 céramides à tester. Tirage au sort le 6 juillet 2026.\",\"date\":\"2026-04-18\",\"image\":\"/images/articles/cerave-patchs-bouton-anti-imperfections-test-gratuit.png\",\"imageAlt\":\"CeraVe patchs bouton anti-imperfections test gratuit\",\"category\":\"test-gratuit\",\"categoryLabel\":\"Test Gratuit\",\"categoryColor\":\"test-gratuit\",\"readingTime\":\"2 min\",\"expired\":false},{\"slug\":\"carryboo-kit-essai-couches-gratuites-5-couches-bebe-2026\",\"title\":\"Carryboo : kit d'essai de 5 couches gratuites (1,95€ de livraison)\",\"description\":\"Kit d'essai Carryboo gratuit : 5 couches francaises offertes, seuls 1,95€ de frais de livraison. Taille 1 a 4, fabriquees en Hauts-de-France.\",\"date\":\"2026-04-17\",\"image\":\"/images/articles/carryboo-kit-essai-couches-gratuites.png\",\"imageAlt\":\"Carryboo kit d'essai couches gratuites bebe\",\"category\":\"test-gratuit\",\"categoryLabel\":\"Test Gratuit\",\"categoryColor\":\"test-gratuit\",\"readingTime\":\"2 min\",\"expired\":false},{\"slug\":\"la-canopee-fluide-solaire-lacte-spf30-test-gratuit-2026\",\"title\":\"La Canopee : testez gratuitement le nouveau Fluide solaire lacte SPF 30\",\"description\":\"Test produit gratuit La Canopee : candidatez pour tester le nouveau Fluide solaire lacte SPF 30 100% mineral. Selection le 22 avril, test des le 4 mai 2026.\",\"date\":\"2026-04-17\",\"image\":\"/images/articles/la-canopee-fluide-solaire-lacte-spf30-test-gratuit.png\",\"imageAlt\":\"La Canopee Fluide solaire lacte SPF 30 test gratuit\",\"category\":\"test-gratuit\",\"categoryLabel\":\"Test Gratuit\",\"categoryColor\":\"test-gratuit\",\"readingTime\":\"2 min\",\"expired\":false},{\"slug\":\"la-canopee-fluide-solaire-lacte-spf50-test-gratuit-2026\",\"title\":\"La Canopee : testez gratuitement le nouveau Fluide solaire lacte SPF 50+\",\"description\":\"Test produit gratuit La Canopee : candidatez pour tester le nouveau Fluide solaire lacte SPF 50+ tres haute protection 100% mineral. Selection le 22 avril 2026.\",\"date\":\"2026-04-17\",\"image\":\"/images/articles/la-canopee-fluide-solaire-lacte-spf50-test-gratuit.png\",\"imageAlt\":\"La Canopee Fluide solaire lacte SPF 50+ test gratuit\",\"category\":\"test-gratuit\",\"categoryLabel\":\"Test Gratuit\",\"categoryColor\":\"test-gratuit\",\"readingTime\":\"2 min\",\"expired\":false},{\"slug\":\"peggy-sage-rubber-base-milky-4-teintes-test-gratuit-2026\",\"title\":\"Peggy Sage : testez gratuitement les nouvelles Rubber Base Milky (4 teintes)\",\"description\":\"Test produit gratuit Peggy Sage : candidatez pour tester les nouvelles Rubber Base Milky en 4 teintes (Pillow White, Quiet Nude, Dreamy Pink, Early Peach). Jusqu'au 22 avril.\",\"date\":\"2026-04-17\",\"image\":\"/images/articles/peggy-sage-rubber-base-milky-test-gratuit-2026.png\",\"imageAlt\":\"Peggy Sage Rubber Base Milky 4 teintes test gratuit\",\"category\":\"test-gratuit\",\"categoryLabel\":\"Test Gratuit\",\"categoryColor\":\"test-gratuit\",\"readingTime\":\"2 min\",\"expired\":false},{\"slug\":\"eno-codexial-enotime-creme-complexe-global-test-gratuit-25-places-2026\",\"title\":\"ENO Codexial Enotime : 25 cremes anti-age Complexe Global a tester gratuitement\",\"description\":\"Test produit gratuit ENO Codexial : 25 cremes Complexe Global Enotime anti-age a recevoir. Tri-peptide tenseur, acide hyaluronique. Candidatez avant le 21 avril.\",\"date\":\"2026-04-16\",\"image\":\"/images/articles/eno-codexial-enotime-creme-complexe-global-test-gratuit-2026.png\",\"imageAlt\":\"ENO Codexial Enotime Creme Complexe Global anti-age\",\"category\":\"test-gratuit\",\"categoryLabel\":\"Test Gratuit\",\"categoryColor\":\"test-gratuit\",\"readingTime\":\"2 min\",\"expired\":false},{\"slug\":\"garancia-diabolique-tomate-nouvelle-routine-test-gratuit-2026\",\"title\":\"Garancia : testez en avant-premiere la nouvelle Creme Diabolique Tomate\",\"description\":\"Test produit gratuit Garancia : candidatez pour tester en exclusivite la nouvelle Creme Diabolique Tomate, soin bonne mine iconique. Jusqu'au 29 avril 2026.\",\"date\":\"2026-04-16\",\"image\":\"/images/articles/garancia-diabolique-tomate-nouvelle-routine-test-gratuit-2026.png\",\"imageAlt\":\"Garancia nouveau duo Diabolique Tomate serum et creme bonne mine\",\"category\":\"test-gratuit\",\"categoryLabel\":\"Test Gratuit\",\"categoryColor\":\"test-gratuit\",\"readingTime\":\"1 min\",\"expired\":false},{\"slug\":\"haepi-julia-brosse-dents-sonique-3-en-1-test-gratuit-beaute-test-2026\",\"title\":\"Haepi Julia : testez la brosse a dents sonique 3-en-1 gratuitement (80 places)\",\"description\":\"Test produit gratuit Beaute Test : brosse a dents electrique sonique 3-en-1 Haepi Julia (brossage + jet interdentaire + detartrage). 80 testeuses selectionnees.\",\"date\":\"2026-04-16\",\"image\":\"/images/articles/haepi-julia-brosse-dents-sonique-3-en-1-test-gratuit-2026.png\",\"imageAlt\":\"Haepi Julia brosse a dents electrique sonique 3 en 1 avec accessoires\",\"category\":\"test-gratuit\",\"categoryLabel\":\"Test Gratuit\",\"categoryColor\":\"test-gratuit\",\"readingTime\":\"2 min\",\"expired\":false},{\"slug\":\"payot-masque-peeling-intense-nue-test-gratuit-club-testeuses-2026\",\"title\":\"Payot : testez gratuitement le nouveau Masque Peeling Intense (3 echantillons)\",\"description\":\"Test produit gratuit Payot : inscrivez-vous au Club des Testeuses et tentez de recevoir 3 echantillons du nouveau Masque Peeling Intense de la gamme Nue.\",\"date\":\"2026-04-16\",\"image\":\"/images/articles/payot-masque-peeling-intense-test-gratuit-2026.png\",\"imageAlt\":\"Payot Nue Masque Peeling Intense nouveau produit test gratuit\",\"category\":\"test-gratuit\",\"categoryLabel\":\"Test Gratuit\",\"categoryColor\":\"test-gratuit\",\"readingTime\":\"2 min\",\"expired\":false},{\"slug\":\"catrice-diamond-glaze-lip-gloss-holographique-test-gratuit-2026\",\"title\":\"Catrice Diamond Glaze Lip Gloss holographique : 10 a tester gratuitement\",\"description\":\"Test produit gratuit : 10 gloss Catrice Diamond Glaze holographique couleur 030 Less Bitter More Glitter a recevoir. Paillettes, formule non collante.\",\"date\":\"2026-04-15\",\"image\":\"/images/articles/catrice-diamond-glaze-lip-gloss-test-gratuit-2026.png\",\"imageAlt\":\"Catrice Diamond Glaze Lip Gloss holographique 030 Less Bitter More Glitter\",\"category\":\"test-gratuit\",\"categoryLabel\":\"Test Gratuit\",\"categoryColor\":\"test-gratuit\",\"readingTime\":\"2 min\",\"expired\":false},{\"slug\":\"institut-esthederm-eau-cellulaire-test-gratuit-100-places-2026\",\"title\":\"Institut Esthederm : testez gratuitement un soin Eau Cellulaire (100 places)\",\"description\":\"Test produit gratuit Institut Esthederm : choisissez le soin Eau Cellulaire que vous voulez tester parmi la gamme. 100 personnes selectionnees.\",\"date\":\"2026-04-15\",\"image\":\"/i